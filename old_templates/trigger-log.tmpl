{{define "trigger-log.tmpl"}}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Trigger Log | Psiloconvalley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            margin: 0;
            background: #020617;
            color: #e5e7eb;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            padding: 1.5rem;
        }
        .card {
            max-width: 480px;
            width: 100%;
            background: rgba(15,23,42,0.95);
            border: 1px solid rgba(148,163,184,0.3);
            border-radius: 16px;
            padding: 1.8rem 1.6rem;
            box-shadow: 0 24px 60px rgba(0,0,0,0.8);
        }
        .card h2 {
            margin-top: 0;
        }
        .muted {
            color: #9ca3af;
            font-size: 0.9rem;
        }
        .options {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 1rem;
        }
        .option {
            padding: 0.5rem 1.1rem;
            border-radius: 999px;
            border: 1px solid #4b5563;
            background: #020617;
            color: #e5e7eb;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .option.active {
            border-color: #6366f1;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }
        input {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border-radius: 999px;
            border: 1px solid #4b5563;
            background: #020617;
            color: #e5e7eb;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }
        .btn {
            padding: 0.8rem 2rem;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #f9fafb;
            font-weight: 600;
            cursor: pointer;
            margin-bottom: 1.2rem;
        }
        .timer {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .row {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn.secondary {
            background: transparent;
            border: 1px solid #4b5563;
        }
        a.back {
            display:block;
            margin-top:1rem;
            text-align:center;
            color:#93c5fd;
            text-decoration:none;
            font-size:0.85rem;
        }
        a.back:hover { color:#bfdbfe; }
    </style>
</head>
<body>
<div class="card">
    <h2>Enter a focus session</h2>
    <div id="pre-session">
        <p class="muted">Choose a length, set your intention, and start.</p>
        <div class="options">
            <button class="option" data-min="25">25 min</button>
            <button class="option active" data-min="50">50 min</button>
            <button class="option" data-min="90">90 min</button>
        </div>
        <input id="intentInput" type="text" placeholder="What are you focusing on?">
        <button id="startBtn" class="btn">Enter Flow</button>
        <a class="back" href="/">← Back to Psiloconvalley</a>
    </div>

    <div id="session" class="hidden">
        <div id="timer" class="timer">50:00</div>
        <p class="muted" id="intentDisplay"></p>
        <div class="row">
            <button id="shareBtn" class="btn">Share Session</button>
            <button id="pauseBtn" class="btn secondary">Pause</button>
        </div>
    </div>

    <div id="complete" class="hidden">
        <h3>Session complete.</h3>
        <p class="muted">Capture what you finished before you leave.</p>
        <a class="back" href="/">← Back to Psiloconvalley</a>
    </div>
</div>

<script>
    const startBtn = document.getElementById("startBtn");
    const preSession = document.getElementById("pre-session");
    const session = document.getElementById("session");
    const complete = document.getElementById("complete");
    const timerDisplay = document.getElementById("timer");
    const optionButtons = Array.from(document.querySelectorAll(".option"));
    const pauseBtn = document.getElementById("pauseBtn");
    const shareBtn = document.getElementById("shareBtn");
    const intentInput = document.getElementById("intentInput");
    const intentDisplay = document.getElementById("intentDisplay");

    let selectedMinutes = 50;
    let remainingSeconds = selectedMinutes * 60;
    let intervalId = null;
    let paused = false;

    function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
    }

    function updateTimerDisplay() {
        if (timerDisplay) {
            timerDisplay.textContent = formatTime(Math.max(0, remainingSeconds));
        }
    }

    optionButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            optionButtons.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            selectedMinutes = parseInt(btn.dataset.min, 10);
            remainingSeconds = selectedMinutes * 60;
            updateTimerDisplay();
        });
    });

    updateTimerDisplay();

    startBtn.addEventListener("click", () => {
        preSession.classList.add("hidden");
        session.classList.remove("hidden");
        complete.classList.add("hidden");
        remainingSeconds = selectedMinutes * 60;
        paused = false;
        pauseBtn.textContent = "Pause";
        intentDisplay.textContent = intentInput.value.trim()
            ? "Focus: " + intentInput.value.trim()
            : "";

        clearInterval(intervalId);
        intervalId = setInterval(() => {
            if (paused) return;
            remainingSeconds -= 1;
            if (remainingSeconds <= 0) {
                clearInterval(intervalId);
                session.classList.add("hidden");
                complete.classList.remove("hidden");
                return;
            }
            updateTimerDisplay();
        }, 1000);
    });

    pauseBtn.addEventListener("click", () => {
        paused = !paused;
        pauseBtn.textContent = paused ? "Resume" : "Pause";
    });

    shareBtn.addEventListener("click", async () => {
        const url = location.origin + "/trigger-log";
        const text = "I'm in a " + selectedMinutes + "-minute focus session.";
        try {
            if (navigator.share) {
                await navigator.share({ title: "Trigger Log Session", text: text, url });
            } else {
                await navigator.clipboard.writeText(url);
                alert("Link copied: " + url);
            }
        } catch (_) {}
    });
</script>
<style>.hidden{display:none;}</style>
</body>
</html>
{{end}}
