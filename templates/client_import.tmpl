<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head-no-title" .}}
    <title>{{.T.ClientsImport}} | PSILOCONVALLEY</title>
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    <style>
        .container {
            max-width: 640px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        .top {
            margin-bottom: 32px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin: 0;
        }
        .top-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            font-family: monospace;
            margin-top: 4px;
            line-height: 1.6;
        }

        .error-banner {
            background: rgba(220,38,38,0.1);
            border: 1px solid rgba(220,38,38,0.2);
            color: #fca5a5;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 24px;
        }

        .result-banner {
            padding: 16px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 13px;
            line-height: 1.6;
        }
        .result-success {
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.2);
            color: #4ade80;
        }
        .result-errors {
            margin-top: 12px;
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            padding-left: 20px;
        }
        .result-errors li { margin-bottom: 4px; }

        .form-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 40px;
        }

        .template-section {
            text-align: center;
            margin-bottom: 28px;
        }

        .btn-template {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.2);
            border-radius: 8px;
            color: #4ade80;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.15s ease;
        }
        .btn-template:hover {
            background: rgba(74,222,128,0.15);
        }

        .upload-zone {
            border: 2px dashed rgba(255,255,255,0.12);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            margin-bottom: 24px;
            transition: border-color 0.2s;
            cursor: pointer;
        }
        .upload-zone:hover { 
            border-color: rgba(74,222,128,0.3); 
        }
        .upload-zone input[type="file"] {
            margin: 16px auto 0;
            font-size: 13px;
            color: rgba(255,255,255,0.6);
            cursor: pointer;
        }
        .upload-icon {
            font-size: 36px;
            margin-bottom: 12px;
            opacity: 0.4;
        }
        .upload-text {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 4px;
        }
        .upload-hint {
            font-size: 12px;
            color: rgba(255,255,255,0.25);
        }

        .btn-primary {
            background: #fff;
            color: #0a0f1a;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            width: 100%;
            transition: background 0.15s;
        }
        .btn-primary:hover { background: #e5e5e5; }

        .format-hint {
            margin-top: 28px;
            padding: 16px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
        }
        .format-hint-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
            margin-bottom: 8px;
        }
        .format-hint code {
            display: block;
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            line-height: 1.8;
            overflow-x: auto;
            white-space: pre;
            font-family: monospace;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            text-decoration: none;
            transition: color 0.15s;
        }
        .back-link:hover { color: #fff; }

        @media (max-width: 600px) {
            .form-card { padding: 28px 20px; }
            .upload-zone { padding: 28px 12px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="container">
    <div class="top">
        <h1>{{.T.ClientsImport}}</h1>
        <p class="top-subtitle">{{.T.ClientsImportSubtitle}}</p>
    </div>

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}

    {{if .Result}}
    <div class="result-banner result-success">
        ✅ {{.Result.Imported}} {{.T.ClientsImportedCount}}
        {{if gt .Result.Skipped 0}}
        · {{.Result.Skipped}} {{.T.ClientsImportSkipped}}
        {{end}}
        {{if .Result.Errors}}
        <ul class="result-errors">
            {{range .Result.Errors}}<li>{{.}}</li>{{end}}
        </ul>
        {{end}}
    </div>
    {{end}}

    <div class="form-card">
        <div class="template-section">
            <a href="/clients/import/template.csv" class="btn-template">
                📋 {{.T.ClientsImportDownloadTemplate}}
            </a>
        </div>

        <form method="POST" action="/clients/import" enctype="multipart/form-data">
            {{.csrfField}}
            <div class="upload-zone">
                <div class="upload-icon">📄</div>
                <div class="upload-text">{{.T.ClientsImportUploadText}}</div>
                <div class="upload-hint">CSV · {{.T.ClientsImportMaxSize}}</div>
                <input type="file" name="csv_file" accept=".csv" required>
            </div>
            <button type="submit" class="btn-primary">{{.T.ClientsImportSubmit}}</button>
        </form>

        <div class="format-hint">
            <div class="format-hint-title">{{.T.ClientsImportFormatTitle}}</div>
            <code>Name,Email,Phone,Address,City,State,Zip,Country,Notes
John Smith,john@example.com,555-123-4567,123 Main St,San Jose,CA,95112,US,Pool service</code>
        </div>
    </div>

    <a href="/clients" class="back-link">← {{.T.ClientsImportBackToClients}}</a>
</div>

</body>
</html>
