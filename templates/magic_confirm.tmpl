<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "auth-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">{{.T.MagicConfirmTitle}}</h1>
        <p class="auth-subtitle">{{.T.MagicConfirmSub}}</p>

        <div class="auth-info">
            <div class="auth-info-title">{{.T.MagicInfoTitle}}</div>
            <div class="auth-info-body">{{.T.MagicInfoBody}}</div>
        </div>

        <form method="POST" action="/auth/magic" id="magic-confirm-form">
            {{.csrfField}}
            <input type="hidden" name="token" value="{{.Token}}">
            <button type="submit" class="submit-btn" id="magic-confirm-btn">{{.T.MagicConfirmBtn}}</button>
        </form>

        <div class="auth-footer">
            {{.T.MagicFooterNote}}<br><br>
            <a href="/forgot-password">{{.T.MagicFooterLink}}</a>
        </div>
    </div>
</div>

<script>
var f = document.getElementById('magic-confirm-form');
if (f) f.addEventListener('submit', function() {
    var btn = document.getElementById('magic-confirm-btn');
    if (btn) { btn.disabled = true; btn.textContent = '{{.T.MagicConfirmWait}}'; }
});
</script>

</body>
</html>
