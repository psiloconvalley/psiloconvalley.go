<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #060e1a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 64px;
    position: relative;
}
.grid {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(57,255,138,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(57,255,138,0.025) 1px, transparent 1px);
    background-size: 60px 60px;
}
.bg-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,212,255,0.06) 0%, transparent 70%);
    top: 50%;
    right: -100px;
    transform: translateY(-50%);
}
.left {
    position: relative;
    z-index: 10;
    flex: 0 0 380px;
}
.eyebrow {
    font-size: 12px;
    font-weight: 700;
    color: #00d4ff;
    opacity: 0.7;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 20px;
}
.headline {
    font-size: 52px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -2px;
    line-height: 1.1;
    margin-bottom: 16px;
}
.headline span { color: #00d4ff; }
.sub {
    font-size: 16px;
    color: rgba(255,255,255,0.4);
    margin-bottom: 40px;
    line-height: 1.5;
}
.domain {
    font-size: 14px;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.5px;
}
.card {
    position: relative;
    z-index: 10;
    width: 580px;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
        0 0 0 1px rgba(0,212,255,0.15),
        0 8px 48px rgba(0,0,0,0.6),
        0 0 80px rgba(0,212,255,0.08);
}
.card-header {
    background: #0a1628;
    padding: 20px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.card-logo {
    display: flex;
    align-items: center;
    gap: 10px;
}
.card-logo-name {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
}
.card-est-label .label {
    font-size: 10px;
    font-weight: 600;
    color: #00d4ff;
    opacity: 0.7;
    letter-spacing: 2px;
    text-transform: uppercase;
}
.card-est-label .number {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2px;
    text-align: right;
}
.card-body { padding: 20px 28px 0; }
.card-parties {
    display: flex;
    gap: 32px;
    margin-bottom: 16px;
}
.party-label {
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 4px;
}
.party-name { font-size: 13px; font-weight: 700; color: #0f172a; }
.party-sub { font-size: 11px; color: #64748b; margin-top: 2px; }
.divider { height: 1px; background: #e2e8f0; margin: 0 0 12px; }
.line-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}
.line-header span {
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 2px;
    text-transform: uppercase;
}
.line-item {
    display: flex;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom: 1px solid #f1f5f9;
}
.line-desc { font-size: 12px; font-weight: 500; color: #0f172a; }
.line-amount { font-size: 12px; font-weight: 600; color: #0f172a; }
.card-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    margin-top: 8px;
}
.total-label {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.total-amount { font-size: 22px; font-weight: 800; color: #0f172a; }
.status-badge {
    position: absolute;
    top: 148px;
    left: 28px;
    transform: rotate(-12deg);
    border: 3px solid #00d4ff;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 16px;
    font-weight: 900;
    color: #00d4ff;
    letter-spacing: 3px;
    opacity: 0.85;
}
.status-badge.approved {
    border-color: #22c55e;
    color: #22c55e;
}
</style>
</head>
<body>
<div class="grid"></div>
<div class="bg-glow"></div>

<div class="left">
    <div class="eyebrow">PSILOCONVALLEY</div>
    <div class="headline">Send the<br>estimate.<br><span>Close the deal.</span></div>
    <div class="sub">From proposal to payment<br>in one flow.</div>
    <div class="domain">psiloconvalley.com</div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-logo">
            <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9" cy="12" r="7" fill="none" stroke="#00d4ff" stroke-width="1.2" opacity="0.8"/>
                <circle cx="15" cy="12" r="7" fill="none" stroke="#00d4ff" stroke-width="1.2" opacity="0.8"/>
                <circle cx="12" cy="12" r="2" fill="#00d4ff" opacity="0.9"/>
            </svg>
            <span class="card-logo-name">PSILOCONVALLEY</span>
        </div>
        <div class="card-est-label">
            <div class="label">Estimate</div>
            <div class="number">#EST-2025-001</div>
        </div>
    </div>

    <div class="card-body">
        <div class="card-parties">
            <div>
                <div class="party-label">From</div>
                <div class="party-name">{{.FromName}}</div>
                <div class="party-sub">{{.FromBiz}}</div>
            </div>
            <div>
                <div class="party-label">Proposed To</div>
                <div class="party-name">{{.ToName}}</div>
                <div class="party-sub">{{.ToSub}}</div>
            </div>
            <div>
                <div class="party-label">Valid Until</div>
                <div class="party-name">{{.DueDate}}</div>
            </div>
        </div>

        <div class="divider"></div>

        <div class="line-header">
            <span>Description</span>
            <span>Amount</span>
        </div>

        {{range .LineItems}}
        <div class="line-item">
            <span class="line-desc">{{.Description}}</span>
            <span class="line-amount">{{.Amount}}</span>
        </div>
        {{end}}
    </div>

    <div class="card-total-row">
        <span class="total-label">Total</span>
        <span class="total-amount">{{.Total}}</span>
    </div>

    {{if .IsApproved}}
    <div class="status-badge approved">APPROVED</div>
    {{else}}
    <div class="status-badge">PENDING</div>
    {{end}}
</div>

</body>
</html>
