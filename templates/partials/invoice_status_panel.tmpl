{{define "invoice-status-panel"}}
{{if .User}}
{{if not .IsEstimate}}
<div class="hud-status-group" style="display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;">

    {{if eq .Invoice.Status "paid"}}
        <!-- Undo Payment and Request Endorsement inline -->
        <form method="POST" action="/invoices/{{.Invoice.ID}}/status" style="display: inline-block; margin: 0;">
            {{.csrfField}}
            <input type="hidden" name="status" value="sent">
            <button type="submit" class="action-btn">↩ {{.T.InvoicesUndoPayment}}</button>
        </form>
        {{if .Invoice.ClientEmail}}
        <form method="POST" action="/invoices/{{.Invoice.ID}}/endorse" style="display: inline-block; margin: 0;">
            {{.csrfField}}
            <button type="submit" class="action-btn" style="background: #0f172a; color: #ffffff; border-color: #0f172a;">⭐ {{.T.EndorseRequestBtn}}</button>
        </form>
        {{end}}

    {{else if eq .Invoice.Status "void"}}
        <form method="POST" action="/invoices/{{.Invoice.ID}}/status" style="display: inline-block; margin: 0;">
            {{.csrfField}}
            <input type="hidden" name="status" value="draft">
            <button type="submit" class="action-btn">↩ {{.T.InvoicesReopenDraft}}</button>
        </form>

    {{else if eq .Invoice.Status "draft"}}
        <form method="POST" action="/invoices/{{.Invoice.ID}}/status" style="display: inline-block; margin: 0;">
            {{.csrfField}}
            <input type="hidden" name="status" value="sent">
            <button type="submit" class="action-btn" style="background: #0f172a; color: #ffffff; border-color: #0f172a;">🚀 {{.T.InvoicesMarkSent}}</button>
        </form>

    {{else if or (eq .Invoice.Status "sent") (eq .Invoice.Status "overdue")}}
        <!-- Sleek Inline Mark Paid Dropdown Console -->
        <form method="POST" action="/invoices/{{.Invoice.ID}}/status" style="display: inline-flex; align-items: center; gap: 6px; margin: 0; flex-wrap: wrap;">
            {{.csrfField}}
            <input type="hidden" name="status" value="paid">
            <select name="payment_method" class="hud-status-select" style="
                padding: 0 32px 0 12px;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                font-size: 12.5px;
                font-weight: 600;
                font-family: inherit;
                background: #ffffff;
                color: #0f172a;
                appearance: none;
                -webkit-appearance: none;
                background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%2364748b%22 stroke-width=%222%22><polyline points=%226 9 12 15 18 9%22/></svg>');
                background-repeat: no-repeat;
                background-position: right 10px center;
                cursor: pointer;
                height: 36px;
                box-sizing: border-box;
            ">
                <option value="cash">💵 {{.T.InvoicesPayCash}}</option>
                <option value="zelle">⚡ {{.T.InvoicesPayZelle}}</option>
                <option value="venmo">📱 {{.T.InvoicesPayVenmo}}</option>
                <option value="check">📝 {{.T.InvoicesPayCheck}}</option>
                <option value="card">💳 {{.T.InvoicesPayCard}}</option>
                <option value="other">📦 {{.T.InvoicesPayOther}}</option>
            </select>
            <button type="submit" class="action-btn" style="background: #0f172a; color: #ffffff; border-color: #0f172a; height: 36px;">✓ {{.T.InvoicesMarkPaid}}</button>
        </form>
    {{end}}

</div>
{{end}}
{{end}}
{{end}}