{{define "invoice-new-preview"}}
<div id="invoice-preview-header" style="
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px 24px;
    margin-bottom: 32px;
">
    <div style="
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 14px;
">{{if eq .DocumentType "estimate"}}{{.T.InvoiceNewPreviewEst}}{{else}}{{.T.InvoiceNewPreviewInv}}{{end}}</div>

    <div style="height: 4px; background: #0d1422; border-radius: 2px; margin-bottom: 16px;"></div>

    <div id="preview_logo" style="margin-bottom: 12px; text-align:{{if .Invoice.LogoPosition}}{{.Invoice.LogoPosition}}{{else}}left{{end}};">
        {{if .Invoice.LogoURL}}
        <img
            src="{{.Invoice.LogoURL}}"
            alt="{{.Invoice.CompanyName}}"
            style="max-width:200px; max-height:80px; object-fit:contain; display:inline-block;"
        >
        {{else}}
            {{if .User}}
            <a href="/profile" style="
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 16px;
                background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
                border: 1.5px dashed #93c5fd;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.25s ease;
                max-width: 280px;
                animation: hintPulse 2.5s ease-in-out infinite;
            " onmouseover="this.style.borderColor='#3b82f6';this.style.background='linear-gradient(135deg,#dbeafe 0%,#dcfce7 100%)';this.style.transform='translateY(-1px)';this.style.boxShadow='0 4px 12px rgba(59,130,246,0.15)'"
               onmouseout="this.style.borderColor='#93c5fd';this.style.background='linear-gradient(135deg,#eff6ff 0%,#f0fdf4 100%)';this.style.transform='none';this.style.boxShadow='none'">
                <span style="
                    font-size: 22px;
                    line-height: 1;
                    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
                ">📸</span>
                <span style="
                    font-size: 12px;
                    font-weight: 600;
                    color: #1e40af;
                    line-height: 1.3;
                ">{{.T.InvoiceNewAddLogo}}<br>
                <span style="font-weight: 400; color: #64748b; font-size: 11px;">{{.T.InvoiceNewAddLogoHint}}</span>
                </span>
            </a>
            {{else}}
            <a href="/register" style="
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 16px;
                background: linear-gradient(135deg, #fdf4ff 0%, #eff6ff 100%);
                border: 1.5px dashed #c084fc;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.25s ease;
                max-width: 280px;
                animation: hintPulse 2.5s ease-in-out infinite;
            " onmouseover="this.style.borderColor='#a855f7';this.style.background='linear-gradient(135deg,#fae8ff 0%,#dbeafe 100%)';this.style.transform='translateY(-1px)';this.style.boxShadow='0 4px 12px rgba(168,85,247,0.15)'"
               onmouseout="this.style.borderColor='#c084fc';this.style.background='linear-gradient(135deg,#fdf4ff 0%,#eff6ff 100%)';this.style.transform='none';this.style.boxShadow='none'">
                <span style="
                    font-size: 22px;
                    line-height: 1;
                    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
                ">✨</span>
                <span style="
                    font-size: 12px;
                    font-weight: 600;
                    color: #7e22ce;
                    line-height: 1.3;
                ">{{.T.InvoiceNewCreateAccount}}<br>
                <span style="font-weight: 400; color: #64748b; font-size: 11px;">{{.T.InvoiceNewCreateAcctHint}}</span>
                </span>
            </a>
            {{end}}
        {{end}}
    </div>

    <div style="display: flex; align-items: baseline; gap: 12px;">
        <span id="preview_title" style="
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0d1422;
        ">{{if eq .DocumentType "estimate"}}{{.T.InvoiceNewPreviewEstLabel}}{{else}}{{.T.InvoiceNewPreviewInvLabel}}{{end}}</span>
        <span style="font-size: 16px; font-weight: 700; color: #64748b;">#{{.Invoice.InvoiceNumber}}</span>
    </div>
</div>
{{end}}
