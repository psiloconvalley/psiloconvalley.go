{{define "home-steps"}}
    <!-- HOW IT WORKS -->
      <section class="steps-section">
        <p class="section-title">How it works</p>
        <h2 class="section-headline">Four steps. From estimate to paid.</h2>

        <div class="steps-grid reveal-stagger">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3 class="step-title">Create estimate</h3>
                <p class="step-desc">
                    Build a professional estimate with line items, tax, and your branding. Takes under a minute.
                </p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h3 class="step-title">Client responds</h3>
                <p class="step-desc">
                    Your client receives a link to accept, decline, or suggest changes — no login required.
                </p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h3 class="step-title">Convert to invoice</h3>
                <p class="step-desc">
                    One click converts an accepted estimate into a professional invoice. No re-entering data.
                </p>
            </div>
            <div class="step-card">
                <div class="step-number">4</div>
                <h3 class="step-title">Get paid</h3>
                <p class="step-desc">
                    Send the invoice, collect payment via Stripe, and set up automatic reminders for overdue clients.
                </p>
            </div>
        </div>
    </section> 
{{end}}
