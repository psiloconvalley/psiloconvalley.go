{{define "home-steps"}}
    <!-- HOW IT WORKS -->
    <section class="steps-section" id="how-it-works">
        <p class="section-title">{{.T.HomeStepsTitle}}</p>
        <h2 class="section-headline">{{.T.HomeStepsHeadline}}</h2>

        <div class="steps-columns">

            <!-- PATH A -->
            <div class="steps-path">
                <div class="steps-path-label">{{.T.HomeStepsPathALabel}}</div>
                <div class="steps-grid">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h3 class="step-title">{{.T.HomeStepsA1Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsA1Desc}}</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h3 class="step-title">{{.T.HomeStepsA2Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsA2Desc}}</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h3 class="step-title">{{.T.HomeStepsA3Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsA3Desc}}</p>
                    </div>
                </div>
            </div>

            <div class="steps-divider">{{.T.HomeStepsDivider}}</div>

            <!-- PATH B -->
            <div class="steps-path">
                <div class="steps-path-label">{{.T.HomeStepsPathBLabel}}</div>
                <div class="steps-grid">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h3 class="step-title">{{.T.HomeStepsB1Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsB1Desc}}</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h3 class="step-title">{{.T.HomeStepsB2Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsB2Desc}}</p>
                    </div>
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h3 class="step-title">{{.T.HomeStepsB3Title}}</h3>
                        <p class="step-desc">{{.T.HomeStepsB3Desc}}</p>
                    </div>
                </div>
            </div>

        </div>
    </section>
{{end}}
