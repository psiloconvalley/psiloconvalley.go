{{define "endorsements-styles"}}
<style>
    :root {
        --en-surface: rgba(255,255,255,0.03);
        --en-surface-hover: rgba(255,255,255,0.05);
        --en-border: rgba(255,255,255,0.08);
        --en-border-hover: rgba(255,255,255,0.14);
        --en-text: #ffffff;
        --en-text-secondary: rgba(255,255,255,0.7);
        --en-text-muted: rgba(255,255,255,0.4);
        --en-text-faint: rgba(255,255,255,0.3);
        --en-green: #4ade80;
        --en-amber: #fbbf24;
        --en-red: #f87171;
        --en-radius: 14px;
        --en-radius-sm: 8px;
        --en-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --en-dur: 0.25s;
    }

    .page {
        max-width: 720px;
        margin: 48px auto;
        padding: 0 24px;
    }

    .page-header {
        margin-bottom: 28px;
        border-left: 2px solid rgba(255,255,255,0.15);
        padding-left: 20px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -1px;
        color: var(--en-text);
        margin-bottom: 6px;
    }

    .page-sub {
        font-size: 14px;
        color: rgba(255,255,255,0.5);
        line-height: 1.5;
    }

    .en-stats {
        display: flex;
        gap: 20px;
        margin-bottom: 28px;
    }

    .en-stat {
        font-size: 13px;
        color: var(--en-text-muted);
    }

    .en-stat strong {
        color: var(--en-text);
        font-weight: 700;
    }

    /* ── Endorsement card ── */
    .en-card {
        background: var(--en-surface);
        border: 1px solid var(--en-border);
        border-radius: var(--en-radius);
        padding: 22px;
        margin-bottom: 12px;
        transition:
            background var(--en-dur) ease,
            border-color var(--en-dur) ease;
    }

    .en-card:hover {
        background: var(--en-surface-hover);
        border-color: var(--en-border-hover);
    }

    .en-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
        gap: 12px;
    }

    .en-card-name {
        font-weight: 700;
        font-size: 15px;
        color: var(--en-text);
    }

    .en-card-location {
        font-size: 12px;
        color: var(--en-text-muted);
    }

    /* ── Stars ── */
    .en-card-stars {
        display: flex;
        align-items: center;
        gap: 2px;
        font-size: 14px;
        margin-bottom: 10px;
        line-height: 1;
    }

    /* ── Body ── */
    .en-card-body {
        font-size: 14px;
        color: var(--en-text-secondary);
        line-height: 1.65;
        margin-bottom: 12px;
    }

    .en-card-body::before { content: '\201C'; }
    .en-card-body::after  { content: '\201D'; }

    /* ── Meta ── */
    .en-card-meta {
        font-size: 12px;
        color: var(--en-text-faint);
        margin-bottom: 10px;
    }

    /* ── Actions ── */
    .en-card-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .en-copy-link {
        font-size: 12px;
        font-weight: 600;
        color: var(--en-text-muted);
        cursor: pointer;
        text-decoration: none;
        border: 1px solid var(--en-border);
        padding: 6px 12px;
        border-radius: var(--en-radius-sm);
        background: none;
        font-family: inherit;
        transition:
            color var(--en-dur) ease,
            border-color var(--en-dur) ease;
    }

    .en-copy-link:hover {
        color: var(--en-text);
        border-color: var(--en-border-hover);
    }

    .en-btn-delete {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
        color: var(--en-red);
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: var(--en-radius-sm);
        cursor: pointer;
        font-family: inherit;
        transition:
            background var(--en-dur) ease,
            border-color var(--en-dur) ease;
    }

    .en-btn-delete:hover {
        background: rgba(239,68,68,0.15);
        border-color: rgba(239,68,68,0.35);
    }

    .en-btn-delete:focus-visible,
    .en-copy-link:focus-visible {
        outline: 2px solid rgba(255,255,255,0.3);
        outline-offset: 2px;
    }

    /* ── Status badges ── */
    .en-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 100px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .en-badge-pending {
        background: rgba(251,191,36,0.12);
        color: var(--en-amber);
    }

    .en-badge-submitted {
        background: rgba(74,222,128,0.12);
        color: var(--en-green);
    }

    .en-badge-declined {
        background: rgba(255,255,255,0.05);
        color: var(--en-text-faint);
    }

    /* ── Empty state ── */
    .en-empty {
        text-align: center;
        padding: 80px 20px;
        background: var(--en-surface);
        border: 1px dashed var(--en-border);
        border-radius: var(--en-radius);
    }

    .en-empty-icon {
        font-size: 42px;
        margin-bottom: 16px;
        opacity: 0.4;
    }

    .en-empty-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--en-text-muted);
        margin-bottom: 8px;
    }

    .en-empty-sub {
        font-size: 14px;
        color: var(--en-text-faint);
        max-width: 400px;
        margin: 0 auto;
        line-height: 1.6;
    }
</style>
{{end}}
