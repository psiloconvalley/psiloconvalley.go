{{define "profile-styles"}}
<style>
       	.page { max-width: 1200px; margin: 48px auto; padding: 0 24px; }
        .page-header { margin-bottom: 32px; border-left: 2px solid #fff; padding-left: 25px; }
        .page-title { font-size: 32px; font-weight: 700; letter-spacing: -1px; margin-bottom: 8px; text-transform: uppercase; }
        .page-subtitle { font-size: 13px; color: rgba(255,255,255,0.4); font-family: monospace; }

        .success-banner { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 24px; }
        .error-banner { background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.3); color: #fca5a5; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 24px; }

        .studio { display: grid; grid-template-columns: 1fr 380px; gap: 32px; align-items: start; }
        .controls { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 40px; }

        .section-title { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .section { margin-bottom: 36px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.6); margin-bottom: 8px; }
        .form-group input, .form-group select { width: 100%; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 14px; font-family: inherit; color: #fff; background: rgba(255,255,255,0.05); }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.08); }
        .form-group select option { background: #1e293b; color: #fff; }
        .hint { font-size: 12px; color: rgba(255,255,255,0.3); margin-top: 6px; }

        .btn-primary { background: #fff; color: #0a0f1a; border: none; padding: 12px 28px; border-radius: 8px; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; width: 100%; margin-top: 8px; }
        .btn-primary:hover { background: #e5e5e5; }

        .preview-rail { position: sticky; top: 80px; }
        .preview-label { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #94a3b8; margin-bottom: 12px; }
        .preview-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
        .preview-accent { height: 5px; background: #0d1422; }
        .preview-body { padding: 24px; }

        .preview-logo-area { margin-bottom: 14px; min-height: 40px; }
        .preview-logo-placeholder { width: 120px; height: 40px; background: #f1f5f9; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #94a3b8; font-weight: 600; }
        .preview-logo-img { max-width: 140px; max-height: 55px; object-fit: contain; display: block; }

        .preview-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
        .preview-title { font-size: 15px; font-weight: 800; color: #0d1422; letter-spacing: -0.3px; }
        .preview-company-name { font-size: 11px; font-weight: 600; color: #64748b; margin-top: 3px; }
        .preview-inv-label { font-size: 9px; font-weight: 700; text-transform: uppercase; color: #94a3b8; letter-spacing: 0.8px; }
        .preview-inv-number { font-size: 11px; font-weight: 600; color: #0d1422; }

        .preview-items { border-top: 1px solid #e2e8f0; padding-top: 12px; }
        .preview-item { display: flex; justify-content: space-between; font-size: 11px; color: #64748b; margin-bottom: 7px; }
        .preview-item-name { font-weight: 700; color: #0d1422; }
        .preview-item-amount { font-variant-numeric: tabular-nums; }

        .preview-total { border-top: 1px solid #cbd5e1; margin-top: 14px; padding-top: 12px; display: flex; justify-content: space-between; font-size: 14px; font-weight: 800; color: #0d1422; }
        .preview-total-amount { font-variant-numeric: tabular-nums; }
        .preview-hint { font-size: 10px; color: #94a3b8; text-align: center; margin-top: 16px; font-style: italic; }

        .mobile-preview-btn { display: none; position: fixed; bottom: 24px; right: 24px; background: #0d1422; color: white; border: none; border-radius: 50px; padding: 14px 20px; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; z-index: 100; box-shadow: 0 4px 20px rgba(0,0,0,0.2); }
        .mobile-preview-btn:hover { background: #1e293b; }

        .preview-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 200; }
        .preview-sheet { position: fixed; bottom: 0; left: 0; right: 0; background: white; border-radius: 20px 20px 0 0; padding: 24px; max-height: 80vh; overflow-y: auto; z-index: 201; transform: translateY(100%); transition: transform 0.3s ease; }
        .preview-sheet.open { transform: translateY(0); }
        .preview-sheet-handle { width: 40px; height: 4px; background: #ddd; border-radius: 2px; margin: 0 auto 20px; }
        .preview-sheet-close { position: absolute; top: 16px; right: 20px; background: none; border: none; font-size: 20px; cursor: pointer; color: #999; }

        @media (max-width: 860px) {
            .studio { grid-template-columns: 1fr; }
            .preview-rail { display: none; }
            .mobile-preview-btn { display: flex; align-items: center; gap: 8px; }
        }
        @media (max-width: 600px) {
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .controls { padding: 28px 20px; }
        }
</style>
{{end}}

