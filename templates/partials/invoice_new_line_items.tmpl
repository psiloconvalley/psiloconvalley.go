{{define "invoice-new-line-items"}}
                <section class="section">
                    <div class="step-badge">
                        <span class="step-dot active"></span>
                        <span class="step-dot active"></span>
                        <span class="step-dot active"></span>
                        {{.T.InvoiceNewStep3}}
                    </div>
                    <h2>{{.T.InvoiceNewItemsToBill}}</h2>

                    {{if .Errors}}
                    {{range .Errors}}
                    {{if eq .Field "items"}}
                    <div class="field-error" style="margin-bottom:12px;">{{.Message}}</div>
                    {{end}}
                    {{end}}
                    {{end}}

                    {{/* ── DESKTOP: 6-column table ── */}}
                    <div class="items-desktop items-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:33%;">{{.T.InvoiceNewThDesc}}</th>
                                    <th style="width:27%;">{{.T.InvoiceNewThDetails}}</th>
                                    <th style="width:10%;">{{.T.InvoiceNewThQty}}</th>
                                    <th style="width:14%;">{{.T.InvoiceNewThUnitPrice}}</th>
                                    <th style="width:10%; text-align:right;">{{.T.InvoiceNewThAmount}}</th>
                                    <th style="width:6%;"></th>
                                </tr>
                            </thead>
                            <tbody id="items_body_desktop">
                                {{if .Invoice.Items}}
                                    {{range .Invoice.Items}}
                                    <tr>
                                        <td><input type="text" name="description[]" class="item-desc"
                                                   value="{{.Description}}" placeholder="{{$.T.InvoiceNewPlaceholderLineDesc}}"></td>
                                        <td><input type="text" name="details[]" class="item-details"
                                                   value="{{.Details}}" placeholder="{{$.T.InvoiceNewPlaceholderLineDet}}"></td>
                                        <td><input type="number" step="0.01" min="0.01" name="quantity[]"
                                                   class="qty" value="{{.QuantityRaw}}" inputmode="decimal"></td>
                                        <td><input type="number" step="0.01" min="0" name="unit_price[]"
                                                   class="price"
                                                   value="{{if .UnitPriceCents}}{{formatCents .UnitPriceCents}}{{else}}0.00{{end}}"
                                                   inputmode="decimal"></td>
                                        <td class="right row-amount">{{if .LineTotal}}{{.LineTotal}}{{else}}$0.00{{end}}</td>
                                        <td style="text-align:center;">
                                            <button type="button" class="remove-btn" onclick="removeRow(this,'desktop')">×</button>
                                        </td>
                                    </tr>
                                    {{end}}
                                {{else}}
                                    <tr>
                                        <td><input type="text" name="description[]" class="item-desc"
                                                   placeholder="{{.T.InvoiceNewPlaceholderLineDesc}}"></td>
                                        <td><input type="text" name="details[]" class="item-details"
                                                   placeholder="{{.T.InvoiceNewPlaceholderLineDet}}"></td>
                                        <td><input type="number" step="0.01" min="0.01" name="quantity[]"
                                                   class="qty" value="1" inputmode="decimal"></td>
                                        <td><input type="number" step="0.01" min="0" name="unit_price[]"
                                                   class="price" value="0.00" inputmode="decimal"></td>
                                        <td class="right row-amount">$0.00</td>
                                        <td style="text-align:center;">
                                            <button type="button" class="remove-btn" onclick="removeRow(this,'desktop')">×</button>
                                        </td>
                                    </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>

                    {{/* ── MOBILE: stacked item cards ── */}}
                    <div class="items-mobile-list" id="items_body_mobile">
                        {{if .Invoice.Items}}
                            {{range .Invoice.Items}}
                            <div class="item-card-mobile">
                                <label style="font-size:11px;">{{$.T.InvoiceNewThDesc}}</label>
                                <input type="text" name="description[]" class="item-desc"
                                       value="{{.Description}}" placeholder="{{$.T.InvoiceNewPlaceholderLineDesc}}">
                                <label style="font-size:11px;">{{$.T.InvoiceNewDetailsOptional}}</label>
                                <input type="text" name="details[]" class="item-details"
                                       value="{{.Details}}" placeholder="{{$.T.InvoiceNewPlaceholderLineDet}}">
                                <div class="item-row-meta">
                                    <div>
                                        <label>{{$.T.InvoiceNewThQty}}</label>
                                        <input type="number" step="0.01" min="0.01" name="quantity[]"
                                               class="qty" value="{{.QuantityRaw}}" inputmode="decimal">
                                    </div>
                                    <div>
                                        <label>{{$.T.InvoiceNewPrice}}</label>
                                        <input type="number" step="0.01" min="0" name="unit_price[]"
                                               class="price"
                                               value="{{if .UnitPriceCents}}{{formatCents .UnitPriceCents}}{{else}}0.00{{end}}"
                                               inputmode="decimal">
                                    </div>
                                    <div class="row-total">$0.00</div>
                                    <button type="button" class="remove-btn" onclick="removeRow(this,'mobile')">×</button>
                                </div>
                            </div>
                            {{end}}
                        {{else}}
                            <div class="item-card-mobile">
                                <label style="font-size:11px;">{{.T.InvoiceNewThDesc}}</label>
                                <input type="text" name="description[]" class="item-desc"
                                       placeholder="{{.T.InvoiceNewPlaceholderLineDesc}}">
                                <label style="font-size:11px;">{{.T.InvoiceNewDetailsOptional}}</label>
                                <input type="text" name="details[]" class="item-details"
                                       placeholder="{{.T.InvoiceNewPlaceholderLineDet}}">
                                <div class="item-row-meta">
                                    <div>
                                        <label>{{.T.InvoiceNewThQty}}</label>
                                        <input type="number" step="0.01" min="0.01" name="quantity[]"
                                               class="qty" value="1" inputmode="decimal">
                                    </div>
                                    <div>
                                        <label>{{.T.InvoiceNewPrice}}</label>
                                        <input type="number" step="0.01" min="0" name="unit_price[]"
                                               class="price" value="0.00" inputmode="decimal">
                                    </div>
                                    <div class="row-total">$0.00</div>
                                    <button type="button" class="remove-btn" onclick="removeRow(this,'mobile')">×</button>
                                </div>
                            </div>
                        {{end}}
                    </div>

                    <button type="button" class="add-btn" onclick="addRow()">{{.T.InvoiceNewAddLineItem}}</button>

                    <div style="margin-top:32px;">
                        <label>{{.T.InvoiceNewMemo}}</label>
                        <textarea name="notes"
                                  placeholder="{{.T.InvoiceNewMemoPlaceholder}}">{{.Invoice.Notes}}</textarea>
                    </div>
                </section>
{{end}}
