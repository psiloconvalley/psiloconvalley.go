{{define "profile-sections-styles"}}
<style>
    /* ── Public page link ── */
    .pr-public-section {
        background: var(--pr-green-surface);
        border: 1px solid var(--pr-green-border);
        border-radius: var(--pr-radius-md);
        padding: 20px 24px;
        margin-bottom: 24px;
    }

    .pr-public-row {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .pr-url-input {
        flex: 1;
        min-width: 200px;
        padding: 10px 14px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: var(--pr-radius-sm);
        color: var(--pr-text);
        font-size: 13px;
        font-family: monospace;
        outline: none;
    }

    .pr-copy-btn {
        padding: 10px 18px;
        background: var(--pr-green);
        color: var(--pr-green-text);
        border: none;
        border-radius: var(--pr-radius-sm);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        white-space: nowrap;
        transition:
            transform var(--pr-dur-fast) ease,
            box-shadow var(--pr-dur-fast) ease;
    }

    .pr-copy-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(74,222,128,0.2);
    }

    .pr-preview-link {
        padding: 10px 18px;
        background: transparent;
        color: var(--pr-text-secondary);
        border: 1px solid var(--pr-border-hover);
        border-radius: var(--pr-radius-sm);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--pr-dur-fast) ease,
            border-color var(--pr-dur-fast) ease;
    }

    .pr-preview-link:hover {
        color: var(--pr-text);
        border-color: rgba(255,255,255,0.3);
    }

    .pr-public-hint {
        font-size: 11px;
        color: var(--pr-text-faint);
        margin-top: 10px;
    }

    .pr-logo-preview {
        max-width: 140px;
        max-height: 60px;
        object-fit: contain;
        background: #fff;
        border: 1px solid #eee;
        border-radius: var(--pr-radius-sm);
        padding: 10px;
        margin-bottom: 12px;
        display: block;
    }

    /* ── Stripe ── */
    .pr-stripe-connected {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: rgba(16,185,129,0.08);
        border: 1px solid rgba(16,185,129,0.25);
        border-radius: var(--pr-radius-md);
    }

    .pr-stripe-connected-icon { font-size: 20px; }

    .pr-stripe-connected-name {
        font-weight: 700;
        font-size: 13px;
        color: #6ee7b7;
    }

    .pr-stripe-connected-sub {
        font-size: 11px;
        color: var(--pr-text-muted);
        margin-top: 2px;
    }

    .pr-stripe-disconnected {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        background: var(--pr-surface);
        border: 1px solid var(--pr-border);
        border-radius: var(--pr-radius-md);
    }

    .pr-stripe-disconnected-icon { font-size: 24px; }

    .pr-stripe-disconnected-body { flex: 1; }

    .pr-stripe-disconnected-name {
        font-weight: 700;
        font-size: 13px;
        color: var(--pr-text);
    }

    .pr-stripe-disconnected-sub {
        font-size: 11px;
        color: var(--pr-text-muted);
        margin-top: 2px;
    }

    .pr-stripe-btn {
        background: var(--pr-stripe);
        color: #ffffff;
        padding: 9px 18px;
        border-radius: var(--pr-radius-sm);
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition:
            opacity var(--pr-dur-fast) ease,
            transform var(--pr-dur-fast) ease;
    }

    .pr-stripe-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    /* ── Security / Passkeys ── */
    .pr-security-heading {
        font-size: 18px;
        font-weight: 800;
        color: var(--pr-text);
        margin-bottom: 24px;
    }

    .pr-passkey-list-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--pr-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 10px;
    }

    .pr-passkey-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--pr-border);
        border-radius: var(--pr-radius-sm);
        margin-bottom: 8px;
    }

    .pr-passkey-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--pr-text);
    }

    .pr-passkey-meta {
        font-size: 11px;
        color: var(--pr-text-faint);
        margin-top: 2px;
    }

    .pr-passkey-delete {
        background: rgba(239,68,68,0.08);
        color: var(--pr-red-text);
        border: 1px solid var(--pr-red-border);
        padding: 5px 12px;
        border-radius: var(--pr-radius-sm);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition:
            background var(--pr-dur-fast) ease,
            border-color var(--pr-dur-fast) ease;
    }

    .pr-passkey-delete:hover {
        background: rgba(239,68,68,0.15);
        border-color: rgba(239,68,68,0.35);
    }

    .pr-passkey-empty {
        font-size: 12px;
        color: var(--pr-text-faint);
        margin-bottom: 16px;
    }

    .pr-passkey-status {
        margin-bottom: 16px;
        font-size: 13px;
        min-height: 20px;
    }

    .btn-primary-sm {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        background: linear-gradient(135deg, var(--pr-green) 0%, var(--pr-green-strong) 100%);
        color: var(--pr-green-text);
        border: none;
        border-radius: var(--pr-radius-sm);
        font-size: 13px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition:
            transform var(--pr-dur) ease,
            box-shadow var(--pr-dur) ease;
    }

    .btn-primary-sm:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(74,222,128,0.2);
    }

    /* ── Password ── */
    .pr-pw-hint {
        font-size: 12px;
        color: var(--pr-text-faint);
        margin-bottom: 16px;
        min-height: 18px;
    }

    .pr-google-note {
        font-size: 12px;
        color: var(--pr-text-faint);
        margin-top: 14px;
        line-height: 1.6;
    }

    /* ── Business card preview ── */
    .preview-rail { position: sticky; top: 80px; }

    .preview-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--pr-text-muted);
        margin-bottom: 12px;
    }

    .biz-preview {
        background: #080c14;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: var(--pr-radius);
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .biz-preview-inner {
        padding: 28px 24px;
        text-align: center;
    }

    .biz-preview-logo-area {
        margin-bottom: 14px;
        min-height: 40px;
        display: flex;
        justify-content: center;
    }

    .biz-preview-logo {
        max-width: 120px;
        max-height: 50px;
        object-fit: contain;
        background: rgba(255,255,255,0.05);
        border-radius: var(--pr-radius-sm);
        padding: 6px;
    }

    .biz-preview-logo-placeholder {
        width: 80px;
        height: 36px;
        background: rgba(255,255,255,0.06);
        border-radius: var(--pr-radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        color: rgba(255,255,255,0.2);
    }

    .biz-preview-name {
        font-size: 20px;
        font-weight: 900;
        letter-spacing: -1px;
        color: #ffffff;
        margin-bottom: 6px;
        line-height: 1.2;
    }

    .biz-preview-location {
        font-size: 13px;
        color: rgba(255,255,255,0.6);
        margin-bottom: 14px;
        min-height: 18px;
    }

    .biz-preview-contacts {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
    }

    .biz-preview-contact {
        font-size: 13px;
        color: rgba(255,255,255,0.65);
    }

    .biz-preview-service-areas {
        font-size: 12px;
        color: rgba(255,255,255,0.4);
        margin-bottom: 14px;
        padding-top: 10px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .biz-preview-url {
        font-size: 11px;
        font-family: monospace;
        color: rgba(74,222,128,0.6);
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.06);
        letter-spacing: 0.3px;
    }

    .preview-hint {
        font-size: 10px;
        color: var(--pr-text-faint);
        text-align: center;
        margin-top: 14px;
        font-style: italic;
    }

    .mobile-preview-btn {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #0d1422;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 14px 20px;
        font-size: 13px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        z-index: 100;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        transition: background 0.2s ease;
    }

    .mobile-preview-btn:hover { background: #1e293b; }

    .preview-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 200;
    }

    .preview-sheet {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #0a0f1a;
        border-radius: 20px 20px 0 0;
        padding: 24px;
        max-height: 80vh;
        overflow-y: auto;
        z-index: 201;
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }

    .preview-sheet.open { transform: translateY(0); }

    .preview-sheet-handle {
        width: 40px;
        height: 4px;
        background: rgba(255,255,255,0.15);
        border-radius: 2px;
        margin: 0 auto 20px;
    }

    .preview-sheet-close {
        position: absolute;
        top: 16px;
        right: 20px;
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: rgba(255,255,255,0.4);
    }

    @media (max-width: 860px) {
        .mobile-preview-btn { display: flex; align-items: center; gap: 8px; }
    }

    /* ── Preview tabs ── */
    .preview-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: var(--pr-radius-sm);
        padding: 3px;
    }

    .preview-tab {
        flex: 1;
        padding: 8px 12px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        background: none;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        transition:
            color var(--pr-dur-fast) ease,
            background var(--pr-dur-fast) ease;
    }

    .preview-tab:hover {
        color: rgba(255,255,255,0.7);
    }

    .preview-tab.active {
        color: var(--pr-text);
        background: rgba(255,255,255,0.08);
    }

    .preview-pane {
        display: none;
    }

    .preview-pane.active {
        display: block;
    }

    /* ── Invoice preview card ── */
    .inv-preview {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: var(--pr-radius-md);
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .inv-preview-accent {
        height: 5px;
        background: #0d1422;
    }

    .inv-preview-body {
        padding: 24px;
    }

    .inv-preview-logo-area {
        margin-bottom: 14px;
        min-height: 24px;
    }

    .inv-preview-logo-img {
        max-width: 140px;
        max-height: 55px;
        object-fit: contain;
        display: block;
    }

    .inv-preview-logo-placeholder {
        width: 80px;
        height: 28px;
        background: #f1f5f9;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #94a3b8;
    }

    .inv-preview-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .inv-preview-title {
        font-size: 15px;
        font-weight: 800;
        color: #0d1422;
        letter-spacing: -0.3px;
    }

    .inv-preview-company {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        margin-top: 3px;
    }

    .inv-preview-address {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .inv-preview-contact-line {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 1px;
    }

    .inv-preview-right {
        text-align: right;
    }

    .inv-preview-inv-label {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.8px;
    }

    .inv-preview-inv-number {
        font-size: 11px;
        font-weight: 600;
        color: #0d1422;
    }

    .inv-preview-items {
        border-top: 1px solid #e2e8f0;
        padding-top: 12px;
    }

    .inv-preview-item {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #64748b;
        margin-bottom: 7px;
    }

    .inv-preview-item-name {
        font-weight: 700;
        color: #0d1422;
    }

    .inv-preview-item-amount {
        font-variant-numeric: tabular-nums;
    }

    .inv-preview-total {
        border-top: 1px solid #cbd5e1;
        margin-top: 14px;
        padding-top: 12px;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        font-weight: 800;
        color: #0d1422;
    }

    .inv-preview-total-amount {
        font-variant-numeric: tabular-nums;
    }
</style>
{{end}}
