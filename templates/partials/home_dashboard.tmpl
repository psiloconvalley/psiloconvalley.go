{{define "home-dashboard"}}
<div class="dashboard">

    <div class="dash-header">
        <p class="dash-greeting">{{.T.HomeDashWelcome}}</p>
        <h1 class="dash-title">{{.User.DisplayName}}</h1>
    </div>

    <div class="dash-grid">
        <div class="stat-card">
            <div class="stat-label">{{.T.HomeDashPlan}}</div>
            <div class="stat-value">
                {{if eq .User.Plan "pro"}}{{.T.HomeDashPlanPro}}
                {{else if eq .User.Plan "growth"}}{{.T.HomeDashPlanGrowth}}
                {{else}}{{.T.HomeDashPlanFree}}{{end}}
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.HomeDashRevenue}}</div>
            <div class="stat-value">
                {{if .Stats}}{{money .Stats.RevenueCents}}{{else}}—{{end}}
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.HomeDashOutstanding}}</div>
            <div class="stat-value">
                {{if .Stats}}{{money .Stats.OutstandingCents}}{{else}}—{{end}}
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.HomeDashMonthly}}</div>
            <div class="stat-value">
                {{if .Stats}}{{.Stats.MonthlyCount}}{{else}}—{{end}}
            </div>
        </div>
    </div>

    <div class="quick-actions">
        <a href="/invoices/new" class="action-card">
            <span class="action-icon">📄</span>
            <div class="action-text">
                <h3>{{.T.HomeDashNewInvoice}}</h3>
                <p>{{.T.HomeDashNewInvSub}}</p>
            </div>
        </a>
        <a href="/invoices" class="action-card">
            <span class="action-icon">📊</span>
            <div class="action-text">
                <h3>{{.T.HomeDashViewInvoices}}</h3>
                <p>{{.T.HomeDashViewInvSub}}</p>
            </div>
        </a>
        <a href="/clients" class="action-card">
            <span class="action-icon">👥</span>
            <div class="action-text">
                <h3>{{.T.HomeDashClients}}</h3>
                <p>{{.T.HomeDashClientsSub}}</p>
            </div>
        </a>
        <a href="/profile" class="action-card">
            <span class="action-icon">⚙️</span>
            <div class="action-text">
                <h3>{{.T.HomeDashSettings}}</h3>
                <p>{{.T.HomeDashSettingsSub}}</p>
            </div>
        </a>
    </div>

</div>
{{end}}
