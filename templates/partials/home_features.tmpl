{{define "home-features"}}
    <!-- FEATURES -->
    <section class="features-section">
        <div class="features-grid reveal-stagger">
            <div class="feature-item">
                <span class="feature-icon">⚡</span>
                <div class="feature-text">
                    <h4>Instant PDF</h4>
                    <p>High-quality PDF generation in seconds</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">🔒</span>
                <div class="feature-text">
                    <h4>No tracking</h4>
                    <p>Your data stays yours. No analytics.</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">📱</span>
                <div class="feature-text">
                    <h4>Mobile ready</h4>
                    <p>Create invoices from any device</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">✉️</span>
                <div class="feature-text">
                    <h4>Email delivery</h4>
                    <p>Send invoices directly to clients</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">💾</span>
                <div class="feature-text">
                    <h4>Save clients</h4>
                    <p>Reuse client info on future invoices</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">🎨</span>
                <div class="feature-text">
                    <h4>Your branding</h4>
                    <p>Add your logo and company details</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">📝</span>
                <div class="feature-text">
                    <h4>Smart estimates</h4>
                    <p>Send a quote. Client approves with one tap — no account needed.</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">🔄</span>
                <div class="feature-text">
                    <h4>One-click convert</h4>
                    <p>Approved quote becomes an invoice in one tap. No retyping.</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">🔁</span>
                <div class="feature-text">
                    <h4>Recurring invoices</h4>
                    <p>Set it up once. Invoices send themselves every month.</p>
                </div>
            </div>
            <div class="feature-item">
                <span class="feature-icon">🔔</span>
                <div class="feature-text">
                    <h4>Payment reminders</h4>
                    <p>Late payment? We follow up automatically so you don't have to.</p>
                </div>
            </div>
        </div>

    </section>

{{end}}
