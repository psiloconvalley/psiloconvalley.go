{{define "public-profile-bg"}}
<style>
    .pp-cosmos {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .pp-cosmos::before {
        content: '';
        position: absolute;
        width: 80vmax;
        height: 80vmax;
        top: -20%;
        left: -25%;
        background: radial-gradient(
            circle,
            var(--pp-green-glow-cosmos-1) 0%,
            var(--pp-green-glow-cosmos-2) 40%,
            transparent 70%
        );
        animation: pp-drift1 16s ease-in-out infinite alternate;
    }

    .pp-cosmos::after {
        content: '';
        position: absolute;
        width: 70vmax;
        height: 70vmax;
        bottom: -15%;
        right: -20%;
        background: radial-gradient(
            circle,
            var(--pp-green-glow-cosmos-3) 0%,
            var(--pp-green-glow-cosmos-4) 40%,
            transparent 70%
        );
        animation: pp-drift2 20s ease-in-out infinite alternate;
    }

    .pp-cosmos-mid {
        position: absolute;
        width: 50vmax;
        height: 50vmax;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, var(--pp-green-glow-cosmos-mid) 0%, transparent 60%);
        animation: pp-drift3 14s ease-in-out infinite alternate;
    }

    #pp-stars {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    @keyframes pp-drift1 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(5vw, 3vw) scale(1.3); }
    }

    @keyframes pp-drift2 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(-4vw, -3vw) scale(1.2); }
    }

    @keyframes pp-drift3 {
        0% {
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0.5;
        }
        100% {
            transform: translate(-40%, -60%) scale(1.4);
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pp-cosmos::before,
        .pp-cosmos::after,
        .pp-cosmos-mid {
            animation: none;
        }
        #pp-stars { display: none; }
    }
</style>
{{end}}
