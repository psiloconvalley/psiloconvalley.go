{{define "public-profile-bg"}}
<style>
    .pp-cosmos {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .pp-cosmos::before {
        content: '';
        position: absolute;
        width: 700px;
        height: 700px;
        top: -20%;
        left: -25%;
        background: radial-gradient(
            circle,
            var(--pp-green-glow-cosmos-1) 0%,
            var(--pp-green-glow-cosmos-2) 40%,
            transparent 70%
        );
        animation: pp-drift1 16s ease-in-out infinite alternate;
    }

    .pp-cosmos::after {
        content: '';
        position: absolute;
        width: 600px;
        height: 600px;
        bottom: -15%;
        right: -20%;
        background: radial-gradient(
            circle,
            var(--pp-green-glow-cosmos-3) 0%,
            var(--pp-green-glow-cosmos-4) 40%,
            transparent 70%
        );
        animation: pp-drift2 20s ease-in-out infinite alternate;
    }

    .pp-cosmos-mid {
        position: absolute;
        width: 400px;
        height: 400px;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, var(--pp-green-glow-cosmos-mid) 0%, transparent 60%);
        animation: pp-drift3 14s ease-in-out infinite alternate;
    }

    #pp-stars {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    @keyframes pp-drift1 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(100px, 60px) scale(1.3); }
    }

    @keyframes pp-drift2 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(-70px, -50px) scale(1.2); }
    }

    @keyframes pp-drift3 {
        0% {
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0.5;
        }
        100% {
            transform: translate(-40%, -60%) scale(1.4);
            opacity: 1;
        }
    }
</style>
{{end}}
