{{define "public-profile-quote-section"}}
    <!-- ── Request a Quote ── -->
    <details class="pp-section"{{if or .QuoteError .QuoteSuccess}} open{{end}}>
        <summary class="pp-section-title">
            <span class="pp-section-icon" aria-hidden="true">💬</span>
            <span class="pp-section-heading">{{.T.PubProfileRequestQuote}}</span>
            <span class="pp-section-chevron" aria-hidden="true">›</span>
        </summary>

        <div class="pp-section-content">
            {{if .QuoteSuccess}}
            <div class="pp-success">✓ {{.QuoteSuccess}}</div>
            {{end}}
            {{if .QuoteError}}
            <div class="pp-error">{{.QuoteError}}</div>
            {{end}}

            {{if not .QuoteSuccess}}
            <form method="POST" action="/biz/{{.Slug}}/quote" autocomplete="on">
                {{.csrfField}}
                <div class="pp-field">
                    <label class="pp-label" for="qr-name">{{.T.PubProfileYourName}}</label>
                    <input type="text" name="client_name" id="qr-name" class="pp-input"
                           placeholder="{{.T.PubProfileNamePlaceholder}}" autocomplete="name" required>
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="qr-phone">{{.T.PubProfilePhone}}</label>
                    <input type="tel" name="client_phone" id="qr-phone" class="pp-input"
                           placeholder="{{.T.PubProfilePhonePlaceholder}}" autocomplete="tel" inputmode="tel">
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="qr-desc">{{.T.PubProfileWhatDoYouNeed}}</label>
                    <textarea name="description" id="qr-desc" class="pp-textarea"
                              placeholder="{{.T.PubProfileDescPlaceholder}}"></textarea>
                </div>
                <button type="submit" class="pp-btn pp-btn-green">{{.T.PubProfileSendRequest}}</button>
            </form>
            {{end}}
        </div>
    </details>
{{end}}
