{{define "home-styles-dashboard"}}
<style>
        /* ═══════════════════════════════════════════════════════════════
           FOOTER
           ═══════════════════════════════════════════════════════════════ */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        footer a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        footer a:hover { color: #fff; }

        /* ═══════════════════════════════════════════════════════════════
           LOGGED-IN DASHBOARD VIEW
           ═══════════════════════════════════════════════════════════════ */
        .dashboard {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 24px 100px;
        }

        .dash-header {
            margin-bottom: 48px;
        }

        .dash-greeting {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 8px;
        }

        .dash-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 48px;
        }

        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .action-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
        }
        .action-card:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.06);
            transform: translateY(-2px);
        }

        .action-icon {
            font-size: 32px;
        }

        .action-text h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .action-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        @media (max-width: 640px) {
            .hero { padding: 60px 20px 60px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
            .trust-inner { gap: 24px; }
            .steps-section, .features-section { padding: 60px 20px; }
	    .pricing-cta .pricing-grid { grid-template-columns: 1fr; }
        }
</style>
{{end}}
