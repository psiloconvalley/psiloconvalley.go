{{define "research-hero"}}
    <!-- ── Thesis Hero ── -->
    <div class="thesis-hero">
        <div class="thesis-eyebrow">The Thesis</div>
        <h1>The underground<br>network of<br><em>American business.</em></h1>

        <div class="thesis-body">
            <div class="thesis-block">
                <div class="thesis-block-label">The Name</div>
                <p>
                    Mycelium is the underground network of fungal threads that connects trees,
                    moves nutrients across a forest, and enables life above the surface.
                    It does <strong>invisible work that makes everything else possible.</strong>
                </p>
            </div>
            <div class="thesis-block">
                <div class="thesis-block-label">The Mission</div>
                <p>
                    <strong>That is exactly what blue collar business owners do.</strong>
                    Contractors, doctors, attorneys, landscapers — they are the underground network
                    of the American economy. The name is not an accident.
                    <strong>It is the thesis.</strong>
                </p>
            </div>
        </div>
    </div>

    <!-- ── Roadmap Header ── -->
    <div class="roadmap-header">
        <div class="roadmap-eyebrow">Roadmap & Changelog</div>
        <h2>Everything we've built.<br>Everything we're building.</h2>
        <p>
            A living document. Updated with every release.
            <strong>No marketing. Just the work.</strong>
        </p>
    </div>
{{end}}
