{{define "dashboard-onboarding-styles"}}
<style>
        /* ── Onboarding ── */
        .onboarding-wrap {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 32px 36px;
            margin-bottom: 32px;
        }
        .onboarding-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .onboarding-title {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }
        .onboarding-sub {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            margin-top: 4px;
        }
        .onboarding-count {
            font-size: 28px;
            font-weight: 900;
            color: rgba(255,255,255,0.15);
        }
        .onboarding-progress {
            height: 4px;
            background: rgba(255,255,255,0.06);
            border-radius: 2px;
            margin-bottom: 28px;
            overflow: hidden;
        }
        .onboarding-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #4ade80, #22c55e);
            border-radius: 2px;
            transition: width 0.6s ease;
        }
        .onboarding-steps {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .onboarding-step {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 18px;
            border-radius: 10px;
        }
        .onboarding-step.done {
            background: rgba(74,222,128,0.06);
            border: 1px solid rgba(74,222,128,0.15);
        }
        .onboarding-step.pending {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
        }
        .onboarding-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 800;
            flex-shrink: 0;
        }
        .onboarding-icon.done {
            background: #4ade80;
            color: #000;
        }
        .onboarding-icon.pending {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.3);
        }
        .onboarding-step-body { flex: 1; }
        .onboarding-step-title {
            font-size: 14px;
            font-weight: 700;
        }
        .onboarding-step-title.done { color: #4ade80; }
        .onboarding-step-title.pending { color: #fff; }
        .onboarding-step-sub {
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            margin-top: 2px;
        }
        .onboarding-cta {
            padding: 8px 16px;
            border-radius: 6px;
            background: #fff;
            color: #0a0f1a;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
        }
</style>
{{end}}
