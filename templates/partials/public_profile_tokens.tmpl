{{define "public-profile-tokens"}}
<style>
    :root {
        --pp-bg: #0a0f1a;
        --pp-text: #ffffff;
        --pp-text-body: rgba(255,255,255,0.88);
        --pp-text-secondary: rgba(255,255,255,0.75);
        --pp-text-location: rgba(255,255,255,0.7);
        --pp-text-label: rgba(255,255,255,0.6);
        --pp-text-muted: rgba(255,255,255,0.45);
        --pp-text-faint: rgba(255,255,255,0.3);
        --pp-text-link: rgba(255,255,255,0.8);
        --pp-text-footer: rgba(255,255,255,0.72);

        --pp-surface-logo: rgba(255,255,255,0.05);
        --pp-surface-rating: rgba(74,222,128,0.06);
        --pp-surface-endorsement: rgba(255,255,255,0.04);
        --pp-surface-endorsement-hover: rgba(255,255,255,0.07);
        --pp-surface-section: rgba(255,255,255,0.03);
        --pp-surface-section-open: rgba(255,255,255,0.05);
        --pp-surface-section-hover: rgba(255,255,255,0.06);
        --pp-surface-input: rgba(255,255,255,0.04);
        --pp-surface-input-focus: rgba(255,255,255,0.07);
        --pp-surface-success: rgba(74,222,128,0.08);
        --pp-surface-danger: rgba(239,68,68,0.08);
        --pp-surface-branding: rgba(74,222,128,0.06);
        --pp-surface-branding-hover: rgba(74,222,128,0.12);
        --pp-surface-ripple: rgba(255,255,255,0.25);

        --pp-border-divider: rgba(255,255,255,0.06);
        --pp-border-default: rgba(255,255,255,0.08);
        --pp-border-strong: rgba(255,255,255,0.14);
        --pp-border-input: rgba(255,255,255,0.1);
        --pp-border-rating: rgba(74,222,128,0.2);
        --pp-border-green: rgba(74,222,128,0.25);
        --pp-border-green-soft: rgba(74,222,128,0.2);
        --pp-border-green-mid: rgba(74,222,128,0.35);
        --pp-border-green-strong: rgba(74,222,128,0.55);
        --pp-border-endorsement-accent: rgba(74,222,128,0.4);
        --pp-border-endorsement-accent-hover: rgba(74,222,128,0.7);
        --pp-border-danger: rgba(239,68,68,0.25);

        --pp-green: #4ade80;
        --pp-green-strong: #16a34a;
        --pp-green-text: #052e16;
        --pp-green-glow-soft: rgba(74,222,128,0.04);
        --pp-green-glow-card: rgba(74,222,128,0.05);
        --pp-green-glow-open: rgba(74,222,128,0.06);
        --pp-green-glow-focus: rgba(74,222,128,0.08);
        --pp-green-glow-logo: rgba(74,222,128,0.1);
        --pp-green-glow-star: rgba(74,222,128,0.22);
        --pp-green-glow-hero-star: rgba(74,222,128,0.8);
        --pp-green-glow-byline: rgba(74,222,128,0.5);
        --pp-green-glow-cosmos-1: rgba(74,222,128,0.35);
        --pp-green-glow-cosmos-2: rgba(16,185,129,0.12);
        --pp-green-glow-cosmos-3: rgba(52,211,153,0.28);
        --pp-green-glow-cosmos-4: rgba(74,222,128,0.08);
        --pp-green-glow-cosmos-mid: rgba(74,222,128,0.22);

        --pp-amber-glow: rgba(251,191,36,0.45);
        --pp-red-text: #fca5a5;

        --pp-black-30: rgba(0,0,0,0.3);
        --pp-black-40: rgba(0,0,0,0.4);
        --pp-black-50: rgba(0,0,0,0.5);

        --pp-shadow-logo: 0 0 40px var(--pp-green-glow-logo), 0 4px 20px var(--pp-black-50);
        --pp-shadow-endorsement-hover: 0 8px 32px var(--pp-black-30), 0 0 20px var(--pp-green-glow-card);
        --pp-shadow-section-hover: 0 0 20px var(--pp-green-glow-soft);
        --pp-shadow-section-open: 0 0 30px var(--pp-green-glow-open);
        --pp-shadow-button: 0 0 30px rgba(74,222,128,0.2), 0 4px 16px var(--pp-black-30);
        --pp-shadow-button-hover: 0 0 40px rgba(74,222,128,0.3), 0 8px 24px var(--pp-black-40);
        --pp-shadow-button-active: 0 0 20px rgba(74,222,128,0.15), 0 2px 8px var(--pp-black-30);
        --pp-shadow-qr: 0 0 40px var(--pp-green-glow-focus), 0 4px 20px var(--pp-black-40);
        --pp-shadow-branding-hover: 0 0 30px rgba(74,222,128,0.12);

        --pp-radius-lg: 16px;
        --pp-radius-md: 12px;
        --pp-radius-logo: 22px;
        --pp-radius-pill: 100px;
        --pp-blur-lg: 20px;
        --pp-max-width: 480px;

        --pp-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --pp-dur-fast: 0.2s;
        --pp-dur: 0.3s;
    }
</style>
{{end}}
