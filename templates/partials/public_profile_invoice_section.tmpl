{{define "public-profile-invoice-section"}}
    <!-- ── Pay an Invoice ── -->
    <details class="pp-section"{{if .InvoiceError}} open{{end}}>
        <summary class="pp-section-title">
            <span class="pp-section-icon" aria-hidden="true">💳</span>
            <span class="pp-section-heading">{{.T.PubProfilePayInvoice}}</span>
            <span class="pp-section-chevron" aria-hidden="true">›</span>
        </summary>

        <div class="pp-section-content">
            {{if .InvoiceError}}
            <div class="pp-error">{{.T.PubProfileInvNotFound}}</div>
            {{end}}

            <form method="POST" action="/biz/{{.Slug}}/invoice" autocomplete="on">
                {{.csrfField}}
                <div class="pp-field">
                    <label class="pp-label" for="inv-num">{{.T.PubProfileInvoiceNumber}}</label>
                    <input type="text" name="invoice_number" id="inv-num" class="pp-input"
                           placeholder="{{.T.PubProfileInvPlaceholder}}" required>
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="inv-phone">{{.T.PubProfileYourPhone}}</label>
                    <input type="tel" name="client_phone" id="inv-phone" class="pp-input"
                           placeholder="{{.T.PubProfilePhonePlaceholder}}" autocomplete="tel" inputmode="tel">
                </div>
                <button type="submit" class="pp-btn pp-btn-green">{{.T.PubProfileFindInvoice}}</button>
            </form>
        </div>
    </details>
{{end}}
