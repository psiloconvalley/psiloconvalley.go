{{define "invoice-new-form-styles"}}
<style>
        /* ── Form controls ── */
        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--ink-muted);
        }

        input, textarea, select {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            font-family: inherit;
            background: var(--card);
            color: var(--ink);
            transition: border-color 0.2s, box-shadow 0.2s;
            min-height: 44px;
        }
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(15,23,42,0.05);
        }
        input[readonly] { background: #f1f5f9; color: var(--ink-muted); cursor: not-allowed; }
        textarea { min-height: 100px; resize: vertical; }

        /* ── Live validation ── */
        input.field-invalid {
            border-color: var(--danger);
            box-shadow: 0 0 0 3px rgba(220,38,38,0.08);
        }
        input.field-valid {
            border-color: var(--success);
            box-shadow: 0 0 0 3px rgba(21,128,61,0.08);
        }

        /* ── Sidebar form control overrides ── */
        .sidebar input, .sidebar textarea, .sidebar select {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.15);
            color: white;
        }
        .sidebar input:focus, .sidebar textarea:focus, .sidebar select:focus {
            border-color: rgba(255,255,255,0.5);
            box-shadow: 0 0 0 3px rgba(255,255,255,0.1);
        }
        .sidebar label { color: rgba(255,255,255,0.7); }
        .sidebar select option { background: #1e293b; color: white; }

        /* ── Inline validation errors ── */
        .error-banner {
            background: var(--danger-bg);
            border: 1px solid #fca5a5;
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 32px;
            font-size: 13px;
            color: var(--danger);
            font-weight: 600;
        }
        .error-banner ul { margin-top: 8px; padding-left: 20px; font-weight: 400; }
        .error-banner li { margin-bottom: 4px; }

        .field-error {
            font-size: 12px;
            color: var(--danger);
            font-weight: 600;
            margin-top: 6px;
        }
        input.has-error, select.has-error, textarea.has-error {
            border-color: var(--danger);
        }

        /* ── Banner (edit / duplicate mode) ── */
        .banner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fef3c7;
            color: #854d0e;
            padding: 16px 24px;
            border-radius: 12px;
            margin-bottom: 24px;
            font-size: 14px;
            font-weight: 600;
            border: 1px solid #fde68a;
            flex-wrap: wrap;
            gap: 8px;
        }

        /* ── Company override banner ── */
        .co-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            border-radius: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .co-banner--profile {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .co-banner--override {
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

        .co-banner-text {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .co-banner-icon { font-size: 20px; flex-shrink: 0; }

        .co-banner-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink);
        }

        .co-banner--profile .co-banner-title { color: #15803d; }
        .co-banner--override .co-banner-title { color: #92400e; }

        .co-banner-sub {
            font-size: 11px;
            color: var(--ink-muted);
            margin-top: 2px;
        }

        .co-action-btn {
            padding: 7px 14px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--card);
            color: var(--ink-muted);
            white-space: nowrap;
            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                color 0.2s ease;
        }

        .co-action-btn:hover {
            background: #f1f5f9;
            border-color: #94a3b8;
            color: var(--ink);
        }

        .co-action-btn--reset {
            border-color: #bbf7d0;
            color: #15803d;
            background: #f0fdf4;
        }

        .co-action-btn--reset:hover {
            background: #dcfce7;
            border-color: #86efac;
        }

        .co-summary {
            padding: 12px 16px;
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .co-summary-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .co-summary-detail {
            font-size: 12px;
            color: var(--ink-muted);
            margin-top: 2px;
        }
</style>
{{end}}
