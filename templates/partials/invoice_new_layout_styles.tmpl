{{define "invoice-new-layout-styles"}}
<style>
        :root {
            --bg: #f8fafc;
            --card: #ffffff;
            --ink: #0d1422;
            --ink-muted: #64748b;
            --border: #e2e8f0;
            --accent: #0d1422;
            --danger: #dc2626;
            --danger-bg: #fee2e2;
            --success-bg: #dcfce7;
            --success: #15803d;
            --sidebar: #0d1422;
            --radius: 14px;
            --shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            max-width: 1400px;
            margin: auto;
            padding: 40px 20px;
        }

        /* ── Two-column layout: form left, sidebar right ── */
        .layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 40px;
            align-items: start;
        }

        .main {
            background: var(--card);
            padding: 48px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid rgba(0,0,0,0.04);
        }

        .sidebar {
            position: sticky;
            top: 80px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            height: fit-content;
        }
        .sidebar-box {
            background: var(--sidebar);
            color: white;
            padding: 28px;
            border-radius: var(--radius);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        }
        .integration-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }
        .integration-item:last-child { margin-bottom: 0; }
        .integration-icon {
            font-size: 20px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.08);
            border-radius: 8px;
            flex-shrink: 0;
        }
        .integration-name {
            font-size: 13px;
            font-weight: 600;
            color: white;
        }
        .integration-desc {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }
        .integration-desc.coming-soon {
            color: #fbbf24;
            font-weight: 600;
        }
        h1 { font-size: 36px; font-weight: 700; letter-spacing: -1.5px; margin-bottom: 8px; }
        h2 { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 24px; color: var(--ink); }

        .section { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
        .section:first-of-type { margin-top: 0; padding-top: 0; border-top: none; }

        .step-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--ink-muted);
            margin-bottom: 12px;
        }
        .step-dot { width: 8px; height: 8px; border-radius: 50%; background: #cbd5e1; }
        .step-dot.active { background: var(--accent); }

        /* ── Grid helpers ── */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
</style>
{{end}}
