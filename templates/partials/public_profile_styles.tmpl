{{define "public-profile-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0a0f1a;
        color: #ffffff;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    .pp-wrap {
        max-width: 480px;
        margin: 0 auto;
        padding: 60px 20px 80px;
    }

    /* ── Business card ── */
    .pp-card {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 32px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .pp-logo {
        width: 96px;
        height: 96px;
        border-radius: 24px;
        object-fit: contain;
        margin-bottom: 20px;
        background: rgba(255,255,255,0.05);
        padding: 10px;
        border: 1px solid rgba(255,255,255,0.08);
    }
    .pp-name {
        font-size: clamp(28px, 6vw, 36px);
        font-weight: 900;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 12px;
    }
    .pp-location {
        font-size: 15px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 20px;
    }

    /* ── Contact buttons ── */
    .pp-contact-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .pp-contact-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s;
        min-height: 48px;
    }
    .pp-contact-btn:hover {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.2);
        color: #ffffff;
    }
    .pp-contact-icon {
        font-size: 18px;
    }

    /* ── Sections ── */
    .pp-section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 16px;
    }
    .pp-section-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pp-section-icon {
        font-size: 16px;
    }

    /* ── Form elements ── */
    .pp-field {
        margin-bottom: 14px;
    }
    .pp-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.5);
        margin-bottom: 6px;
        letter-spacing: 0.5px;
    }
    .pp-input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        font-size: 15px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        min-height: 48px;
    }
    .pp-input:focus {
        border-color: rgba(74,222,128,0.5);
        box-shadow: 0 0 0 3px rgba(74,222,128,0.1);
    }
    .pp-input::placeholder {
        color: rgba(255,255,255,0.2);
    }
    .pp-textarea {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        font-size: 15px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        outline: none;
        resize: vertical;
        min-height: 100px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pp-textarea:focus {
        border-color: rgba(74,222,128,0.5);
        box-shadow: 0 0 0 3px rgba(74,222,128,0.1);
    }
    .pp-textarea::placeholder {
        color: rgba(255,255,255,0.2);
    }

    /* ── Buttons ── */
    .pp-btn {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 4px;
        min-height: 52px;
        letter-spacing: -0.2px;
    }
    .pp-btn-green {
        background: #15803d;
        color: #ffffff;
    }
    .pp-btn-green:hover {
        background: #166534;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(21,128,61,0.3);
    }
    .pp-btn-green:active {
        transform: translateY(0);
    }

    /* ── Messages ── */
    .pp-success {
        background: rgba(74,222,128,0.1);
        border: 1px solid rgba(74,222,128,0.3);
        color: #4ade80;
        padding: 14px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 16px;
        text-align: center;
    }
    .pp-error {
        background: rgba(220,38,38,0.1);
        border: 1px solid rgba(220,38,38,0.3);
        color: #fca5a5;
        padding: 14px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 16px;
        text-align: center;
    }

    /* ── Footer branding ── */
    .pp-branding {
        text-align: center;
        margin-top: 48px;
        padding-top: 28px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }
    .pp-branding-text {
        font-size: 12px;
        color: rgba(255,255,255,0.25);
        margin-bottom: 14px;
    }
    .pp-branding-link {
        display: inline-block;
        font-size: 13px;
        font-weight: 700;
        color: #4ade80;
        text-decoration: none;
        padding: 10px 20px;
        border: 1px solid rgba(74,222,128,0.3);
        border-radius: 8px;
        transition: all 0.2s;
    }
    .pp-branding-link:hover {
        background: rgba(74,222,128,0.1);
        border-color: #4ade80;
    }

    /* ── Mobile refinements ── */
    @media (max-width: 480px) {
        .pp-wrap { padding: 40px 16px 60px; }
        .pp-contact-row { flex-direction: column; }
        .pp-contact-btn { justify-content: center; }
    }
</style>
{{end}}
