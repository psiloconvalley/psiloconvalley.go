{{define "public-profile-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #030108;
        color: #ffffff;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    /* ── Cosmic background ── */
    .pp-cosmos {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .pp-cosmos::before {
        content: '';
        position: absolute;
        width: 600px;
        height: 600px;
        top: -10%;
        left: -15%;
        background: radial-gradient(circle, rgba(88,28,135,0.15) 0%, transparent 70%);
        animation: pp-drift1 20s ease-in-out infinite alternate;
    }

    .pp-cosmos::after {
        content: '';
        position: absolute;
        width: 500px;
        height: 500px;
        bottom: -5%;
        right: -10%;
        background: radial-gradient(circle, rgba(30,64,175,0.12) 0%, transparent 70%);
        animation: pp-drift2 25s ease-in-out infinite alternate;
    }

    @keyframes pp-drift1 {
        0%   { transform: translate(0, 0) scale(1); }
        100% { transform: translate(60px, 40px) scale(1.15); }
    }

    @keyframes pp-drift2 {
        0%   { transform: translate(0, 0) scale(1); }
        100% { transform: translate(-40px, -30px) scale(1.1); }
    }

    /* ── Starfield canvas ── */
    #pp-stars {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    /* ── Main content ── */
    .pp-wrap {
        position: relative;
        z-index: 1;
        max-width: 480px;
        margin: 0 auto;
        padding: 48px 20px 60px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ── Business card ── */
    .pp-card {
        text-align: center;
        margin-bottom: 36px;
        padding-bottom: 32px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .pp-logo {
        width: 88px;
        height: 88px;
        border-radius: 22px;
        object-fit: contain;
        margin-bottom: 18px;
        background: rgba(255,255,255,0.05);
        padding: 8px;
        box-shadow: 0 0 40px rgba(88,28,135,0.2), 0 4px 20px rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .pp-name {
        font-size: clamp(30px, 8vw, 42px);
        font-weight: 900;
        letter-spacing: -2px;
        line-height: 1.05;
        margin-bottom: 10px;
        color: #ffffff;
        text-shadow: 0 0 60px rgba(139,92,246,0.15);
    }

    .pp-hero-rating {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        padding: 6px 16px;
        border-radius: 100px;
        background: rgba(245,158,11,0.08);
        border: 1px solid rgba(245,158,11,0.2);
        font-size: 14px;
        font-weight: 700;
        color: #fbbf24;
    }

    .pp-hero-star {
        font-size: 16px;
        filter: drop-shadow(0 0 4px rgba(251,191,36,0.8));
    }

    .pp-location {
        font-size: 15px;
        color: rgba(255,255,255,0.7);
        margin-bottom: 6px;
        font-weight: 500;
    }

    .pp-service-areas {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        margin-bottom: 8px;
    }

    .pp-contact {
        font-size: 15px;
        color: rgba(255,255,255,0.75);
        margin-bottom: 6px;
        font-weight: 500;
    }

    .pp-contact a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        transition: color 0.2s;
    }

    .pp-contact a:hover { color: #ffffff; }

    /* ── Endorsement section ── */
    .pp-endorse-section {
        margin-bottom: 24px;
    }

    .pp-endorse-label {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 14px;
    }

    .pp-endorse-card {
        position: relative;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-left: 3px solid rgba(245,158,11,0.5);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 12px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: all 0.3s ease;
    }

    .pp-endorse-card:hover {
        background: rgba(255,255,255,0.06);
        border-color: rgba(255,255,255,0.14);
        border-left-color: rgba(245,158,11,0.8);
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .pp-stars {
        font-size: 20px;
        letter-spacing: 4px;
        margin-bottom: 12px;
        line-height: 1;
    }

    .pp-star-filled {
        filter: drop-shadow(0 0 6px rgba(251,191,36,0.7));
    }

    .pp-star-empty {
        opacity: 0.12;
    }

    .pp-endorse-body {
        font-size: 15px;
        color: rgba(255,255,255,0.88);
        line-height: 1.65;
        margin-bottom: 12px;
    }

    .pp-endorse-body::before { content: '\201C'; }
    .pp-endorse-body::after  { content: '\201D'; }

    .pp-endorse-byline {
        font-size: 13px;
        font-weight: 700;
        color: rgba(255,255,255,0.45);
        letter-spacing: 0.3px;
    }

    .pp-endorse-byline::before {
        content: '— ';
        color: rgba(245,158,11,0.5);
    }

    /* ── Glass sections (details/summary) ── */
    .pp-section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 12px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .pp-section:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.14);
    }

    .pp-section[open] {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.16);
    }

    .pp-section-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        list-style: none;
    }

    .pp-section-title::-webkit-details-marker { display: none; }

    .pp-section-chevron {
        margin-left: auto;
        font-size: 18px;
        color: rgba(255,255,255,0.3);
        transition: transform 0.3s ease, color 0.3s;
        display: inline-block;
    }

    .pp-section[open] .pp-section-chevron {
        transform: rotate(90deg);
        color: rgba(255,255,255,0.6);
    }

    /* ── Form elements ── */
    .pp-field { margin-bottom: 12px; }

    .pp-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.6);
        margin-bottom: 6px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .pp-input, .pp-textarea {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        font-size: 15px;
        font-family: inherit;
        background: rgba(255,255,255,0.04);
        color: #ffffff;
        outline: none;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .pp-input:focus, .pp-textarea:focus {
        border-color: rgba(16,185,129,0.5);
        background: rgba(255,255,255,0.07);
        box-shadow: 0 0 20px rgba(16,185,129,0.1);
    }

    .pp-input::placeholder, .pp-textarea::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .pp-textarea {
        resize: vertical;
        min-height: 80px;
    }

    /* ── Buttons ── */
    .pp-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 800;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 8px;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
    }

    .pp-btn-green {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        box-shadow: 0 0 30px rgba(16,185,129,0.25), 0 4px 16px rgba(0,0,0,0.3);
    }

    .pp-btn-green:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 40px rgba(16,185,129,0.35), 0 8px 24px rgba(0,0,0,0.4);
    }

    .pp-btn-green:active {
        transform: translateY(0);
        box-shadow: 0 0 20px rgba(16,185,129,0.2), 0 2px 8px rgba(0,0,0,0.3);
    }

    /* ── Messages ── */
    .pp-success {
        background: rgba(16,185,129,0.08);
        border: 1px solid rgba(16,185,129,0.25);
        color: #34d399;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 14px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .pp-error {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.25);
        color: #fca5a5;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 14px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    /* ── QR ── */
    .pp-qr-wrap {
        text-align: center;
        margin-top: 32px;
    }

    .pp-qr-img {
        border-radius: 16px;
        background: #fff;
        padding: 10px;
        box-shadow: 0 0 40px rgba(88,28,135,0.15), 0 4px 20px rgba(0,0,0,0.4);
    }

    .pp-qr-label {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.3);
        margin-top: 12px;
        letter-spacing: 0.5px;
    }

    /* ── Footer branding ── */
    .pp-branding {
        text-align: center;
        margin-top: auto;
        padding-top: 32px;
    }

    .pp-branding-divider {
        width: 40px;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(139,92,246,0.3), transparent);
        margin: 0 auto 20px;
    }

    .pp-branding-text {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.35);
        margin-bottom: 14px;
        letter-spacing: 0.5px;
    }

    .pp-branding-link {
        display: inline-block;
        font-size: 13px;
        font-weight: 800;
        color: #a78bfa;
        text-decoration: none;
        padding: 10px 22px;
        border: 1px solid rgba(139,92,246,0.25);
        border-radius: 100px;
        transition: all 0.3s ease;
        letter-spacing: 0.2px;
    }

    .pp-branding-link:hover {
        background: rgba(139,92,246,0.1);
        border-color: rgba(139,92,246,0.5);
        transform: translateY(-1px);
        box-shadow: 0 0 30px rgba(139,92,246,0.15);
    }
</style>
{{end}}
