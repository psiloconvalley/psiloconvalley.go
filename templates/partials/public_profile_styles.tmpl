{{define "public-profile-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0a0f1a;
        color: #ffffff;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    .pp-wrap {
        max-width: 480px;
        margin: 0 auto;
        padding: 48px 20px 80px;
    }

    /* ── Business card ── */
    .pp-card {
        text-align: center;
        margin-bottom: 32px;
    }
    .pp-logo {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        object-fit: contain;
        margin-bottom: 16px;
        background: rgba(255,255,255,0.05);
        padding: 8px;
    }
    .pp-name {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -1px;
        margin-bottom: 8px;
    }
    .pp-location {
        font-size: 14px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 6px;
    }
    .pp-contact {
        font-size: 13px;
        color: rgba(255,255,255,0.4);
        margin-bottom: 4px;
    }
    .pp-contact a {
        color: rgba(255,255,255,0.5);
        text-decoration: none;
    }
    .pp-contact a:hover {
        color: #ffffff;
    }

    /* ── Sections ── */
    .pp-section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 16px;
    }
    .pp-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pp-section-icon {
        font-size: 16px;
    }

    /* ── Form elements ── */
    .pp-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        margin-bottom: 12px;
        outline: none;
        transition: border-color 0.2s;
    }
    .pp-input:focus {
        border-color: rgba(74,222,128,0.5);
    }
    .pp-input::placeholder {
        color: rgba(255,255,255,0.25);
    }
    .pp-textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        margin-bottom: 12px;
        outline: none;
        resize: vertical;
        min-height: 80px;
        transition: border-color 0.2s;
    }
    .pp-textarea:focus {
        border-color: rgba(74,222,128,0.5);
    }
    .pp-textarea::placeholder {
        color: rgba(255,255,255,0.25);
    }

    /* ── Buttons ── */
    .pp-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s;
    }
    .pp-btn-primary {
        background: #ffffff;
        color: #0a0f1a;
    }
    .pp-btn-primary:hover {
        background: #e2e8f0;
        transform: translateY(-1px);
    }
    .pp-btn-green {
        background: #15803d;
        color: #ffffff;
    }
    .pp-btn-green:hover {
        background: #166534;
        transform: translateY(-1px);
    }

    /* ── Messages ── */
    .pp-success {
        background: rgba(74,222,128,0.1);
        border: 1px solid rgba(74,222,128,0.3);
        color: #4ade80;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
    }
    .pp-error {
        background: rgba(220,38,38,0.1);
        border: 1px solid rgba(220,38,38,0.3);
        color: #fca5a5;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    /* ── Footer branding ── */
    .pp-branding {
        text-align: center;
        margin-top: 40px;
        padding-top: 24px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }
    .pp-branding-text {
        font-size: 12px;
        color: rgba(255,255,255,0.3);
        margin-bottom: 12px;
    }
    .pp-branding-link {
        display: inline-block;
        font-size: 13px;
        font-weight: 700;
        color: #4ade80;
        text-decoration: none;
        padding: 10px 20px;
        border: 1px solid rgba(74,222,128,0.3);
        border-radius: 8px;
        transition: all 0.2s;
    }
    .pp-branding-link:hover {
        background: rgba(74,222,128,0.1);
        border-color: #4ade80;
    }
</style>
{{end}}
