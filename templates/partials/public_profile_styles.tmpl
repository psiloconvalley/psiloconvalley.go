{{define "public-profile-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0a0f1a;
        color: #ffffff;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }
    .pp-wrap {
        max-width: 480px;
        margin: 0 auto;
        padding: 48px 20px 60px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    /* ── Business card ── */
    .pp-card {
        text-align: center;
        margin-bottom: 28px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .pp-logo {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        object-fit: contain;
        margin-bottom: 14px;
        background: rgba(255,255,255,0.05);
        padding: 8px;
    }
    .pp-name {
        font-size: clamp(26px, 6vw, 34px);
        font-weight: 900;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 8px;
    }
    .pp-location {
        font-size: 14px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 12px;
    }
    .pp-contact {
        font-size: 14px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 4px;
    }
    .pp-contact a {
        color: rgba(255,255,255,0.6);
        text-decoration: none;
    }
    .pp-contact a:hover { color: #ffffff; }

    /* ── Sections ── */
    .pp-section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 10px;
    }
    .pp-section-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.55);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── Form elements ── */
    .pp-field { margin-bottom: 10px; }
    .pp-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255,255,255,0.45);
        margin-bottom: 4px;
        letter-spacing: 0.3px;
    }
    .pp-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        outline: none;
        transition: border-color 0.2s;
    }
    .pp-input:focus { border-color: rgba(74,222,128,0.5); }
    .pp-input::placeholder { color: rgba(255,255,255,0.2); }
    .pp-textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        background: rgba(255,255,255,0.05);
        color: #ffffff;
        outline: none;
        resize: vertical;
        min-height: 70px;
        transition: border-color 0.2s;
    }
    .pp-textarea:focus { border-color: rgba(74,222,128,0.5); }
    .pp-textarea::placeholder { color: rgba(255,255,255,0.2); }

    /* ── Buttons ── */
    .pp-btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 4px;
    }
    .pp-btn-green { background: #15803d; color: #ffffff; }
    .pp-btn-green:hover { background: #166534; transform: translateY(-1px); }

    /* ── Messages ── */
    .pp-success {
        background: rgba(74,222,128,0.1);
        border: 1px solid rgba(74,222,128,0.3);
        color: #4ade80;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
        text-align: center;
    }
    .pp-error {
        background: rgba(220,38,38,0.1);
        border: 1px solid rgba(220,38,38,0.3);
        color: #fca5a5;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
        text-align: center;
    }

    /* ── Footer branding ── */
	.pp-branding {
        text-align: center;
        margin-top: auto;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }
        .pp-branding-text {
        font-size: 11px;
        color: rgba(255,255,255,0.25);
        margin-bottom: 10px;
    }
    .pp-branding-link {
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        color: #4ade80;
        text-decoration: none;
        padding: 8px 16px;
        border: 1px solid rgba(74,222,128,0.3);
        border-radius: 6px;
        transition: all 0.2s;
    }
    .pp-branding-link:hover {
        background: rgba(74,222,128,0.1);
        border-color: #4ade80;
    }
</style>
{{end}}
