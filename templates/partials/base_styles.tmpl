{{define "base-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #0a0f1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* ── Page wrapper ── */
    .page-wrapper {
        max-width: 960px;
        margin: 0 auto;
        padding: 80px 24px 120px;
    }

    /* ── Typography ── */
    .page-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        background: rgba(74,222,128,0.08);
        border: 1px solid rgba(74,222,128,0.2);
        padding: 8px 16px;
        border-radius: 20px;
        margin-bottom: 28px;
    }

    .page-title {
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1.1;
        margin-bottom: 20px;
    }

    .page-title span {
        background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-intro {
        font-size: 17px;
        color: rgba(255,255,255,0.55);
        line-height: 1.7;
        max-width: 640px;
        margin-bottom: 64px;
    }

    /* ── Section labels ── */
    .section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(74,222,128,0.7);
        margin-bottom: 12px;
    }

    .section-title {
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 24px;
    }

    /* ── Cards ── */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 24px 20px;
        transition: all 0.2s;
    }

    .card:hover {
        border-color: rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.04);
        transform: translateY(-2px);
    }

    .card-icon {
        font-size: 24px;
        margin-bottom: 12px;
    }

    .card h4 {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #ffffff;
    }

    .card p {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        line-height: 1.6;
    }

    /* ── Dividers ── */
    .page-section {
        margin-bottom: 64px;
        padding-bottom: 64px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .page-section:last-of-type {
        border-bottom: none;
    }

    /* ── Prose ── */
    .prose {
        font-size: 15px;
        color: rgba(255,255,255,0.55);
        line-height: 1.8;
    }
    .prose + .prose { margin-top: 16px; }

    /* ── Buttons ── */
    .btn-primary {
        background: #ffffff;
        color: #0a0f1a;
        padding: 14px 28px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
    }
    .btn-primary:hover {
        background: #e2e8f0;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: transparent;
        color: #ffffff;
        padding: 14px 28px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.2);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-secondary:hover {
        border-color: rgba(255,255,255,0.5);
        background: rgba(255,255,255,0.05);
    }

    /* ── CTA block ── */
    .cta-block {
        margin-top: 72px;
        text-align: center;
        padding: 48px 32px;
        background: rgba(74,222,128,0.04);
        border: 1px solid rgba(74,222,128,0.15);
        border-radius: 16px;
    }
    .cta-block h2 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .cta-block p {
        font-size: 15px;
        color: rgba(255,255,255,0.5);
        margin-bottom: 28px;
    }

    /* ── Accent link ── */
    .accent-link {
        color: #4ade80;
        text-decoration: none;
    }
    .accent-link:hover { text-decoration: underline; }

    /* ── Footer ── */
    footer {
        text-align: center;
        padding: 40px 24px;
        font-size: 12px;
        color: rgba(255,255,255,0.3);
        border-top: 1px solid rgba(255,255,255,0.06);
    }
    footer a { color: rgba(255,255,255,0.5); text-decoration: none; }
    footer a:hover { color: #fff; }

    /* ── Responsive ── */
    @media (max-width: 640px) {
        .page-wrapper { padding: 60px 20px 80px; }
        .card-grid { grid-template-columns: 1fr; }
        .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
    }
</style>
{{end}}
