{{define "home-styles"}}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #0a0f1a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        overflow-x: hidden;
        min-height: 100vh;
    }

    /* Mycelium canvas */
    #mycelium-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        pointer-events: none;
        opacity: 0.4;
    }

    .page-wrapper {
        position: relative;
        z-index: 2;
    }
</style>
{{template "home-styles-hero" .}}
{{template "home-styles-trust" .}}
{{template "home-styles-icp" .}}
{{template "home-styles-steps" .}}
{{template "home-styles-features" .}}
{{template "home-styles-cta" .}}
{{template "home-styles-dashboard" .}}
{{template "home-styles-animations" .}}
{{template "home-styles-flow" .}}
{{template "home-styles-security" .}}
{{end}}
