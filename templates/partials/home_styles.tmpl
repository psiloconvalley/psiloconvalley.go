{{define "home-styles"}}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #ffffff;
	    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Mycelium canvas */
        #mycelium-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
            opacity: 0.4;
        }

        .page-wrapper {
            position: relative;
            z-index: 2;
        }

          /* ═══════════════════════════════════════════════════════════════
           HERO SECTION — Inter, sharp, enterprise
           ═══════════════════════════════════════════════════════════════ */
        .hero {
            max-width: 1100px;
            margin: 0 auto;
            padding: 120px 24px 80px;
            text-align: center;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.8);
            margin-bottom: 36px;
        }

        .hero-eyebrow span:nth-child(even) {
            color: rgba(255,255,255,0.2);
        }

        .hero h1 {
            font-size: clamp(48px, 8vw, 88px);
            font-weight: 900;
            line-height: 1.0;
            letter-spacing: -4px;
            margin-bottom: 32px;
            color: #ffffff;
        }

        .hero h1 em {
            font-style: normal;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: clamp(16px, 2vw, 19px);
            line-height: 1.7;
            color: rgba(255,255,255,0.5);
            max-width: 560px;
            margin: 0 auto 48px;
            font-weight: 400;
        }

        /* CTA buttons */
        .hero-cta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: center;
            margin-bottom: 32px;
        }

        .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.3px;
        }
        .btn-primary:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: transparent;
            color: #ffffff;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.3px;
        }
        .btn-secondary:hover {
            border-color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.05);
        }

        .hero-note {
            font-size: 13px;
            color: rgba(255,255,255,0.35);
            max-width: 520px;
            margin: 0 auto;
            line-height: 1.6;
        }
        .hero-note strong {
            color: rgba(255,255,255,0.65);
        }

        /* ═══════════════════════════════════════════════════════════════
           TRUST BAR
           ═══════════════════════════════════════════════════════════════ */
        .trust-bar {
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 36px 24px;
            background: rgba(12,18,32,0.6);
            margin-top: 64px;
        }

        .trust-inner {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 48px;
            text-align: center;
        }

        .trust-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .trust-value {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .trust-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
        }

        /* ═══════════════════════════════════════════════════════════════
           ICP STRIP — who it's for
           ═══════════════════════════════════════════════════════════════ */
        .icp-strip {
            padding: 40px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .icp-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }

        .icp-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 40px;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.6);
            letter-spacing: -0.2px;
            transition: all 0.2s;
        }

        .icp-item:hover {
            border-color: rgba(74,222,128,0.3);
            color: rgba(255,255,255,0.9);
            background: rgba(74,222,128,0.05);
        }

        .icp-icon {
            font-size: 16px;
        } 
        /* ═══════════════════════════════════════════════════════════════
           HOW IT WORKS — 3 steps
           ═══════════════════════════════════════════════════════════════ */
        .steps-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 24px;
        }

        .section-title {
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .section-headline {
            text-align: center;
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 64px;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
        }

        .step-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 36px;
            transition: all 0.3s;
        }
        .step-card:hover {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.05);
            transform: translateY(-4px);
        }

        .step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .step-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .step-desc {
            font-size: 14px;
            line-height: 1.6;
            color: rgba(255,255,255,0.5);
        }

        /* ═══════════════════════════════════════════════════════════════
           FEATURES GRID
           ═══════════════════════════════════════════════════════════════ */
        .features-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px 100px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 24px;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .feature-icon {
            font-size: 24px;
            flex-shrink: 0;
        }

        .feature-text h4 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .feature-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.5;
        }

        /* ═══════════════════════════════════════════════════════════════
           FINAL CTA
           ═══════════════════════════════════════════════════════════════ */
        .final-cta {
            text-align: center;
            padding: 100px 24px;
            background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.02) 100%);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .final-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 16px;
        }

        .final-cta p {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 32px;
        }
	        /* ═══════════════════════════════════════════════════════════════
           PRICING CTA
           ═══════════════════════════════════════════════════════════════ */
        .pricing-cta {
            text-align: center;
            padding: 80px 24px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .pricing-cta .section-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 16px;
        }

        .pricing-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 12px;
        }

        .pricing-cta .pricing-sub {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 40px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
	.pricing-cta .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            max-width: 960px;
            margin: 0 auto 40px;
        }
	 .pricing-cta .plan-card.growth {
            border-color: rgba(74,222,128,0.3);
            background: rgba(74,222,128,0.04);
        }
        .pricing-cta .plan-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 32px 24px;
            text-align: center;
        }

        .pricing-cta .plan-card.pro {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
        }

        .pricing-cta .plan-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 12px;
        }

        .pricing-cta .plan-price {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .pricing-cta .plan-unit {
            font-size: 14px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .pricing-cta .plan-features {
            list-style: none;
            font-size: 14px;
            color: rgba(255,255,255,0.65);
            line-height: 2;
        }
		
        /* ═══════════════════════════════════════════════════════════════
           FOOTER
           ═══════════════════════════════════════════════════════════════ */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        footer a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        footer a:hover { color: #fff; }

        /* ═══════════════════════════════════════════════════════════════
           LOGGED-IN DASHBOARD VIEW
           ═══════════════════════════════════════════════════════════════ */
        .dashboard {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 24px 100px;
        }

        .dash-header {
            margin-bottom: 48px;
        }

        .dash-greeting {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 8px;
        }

        .dash-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 48px;
        }

        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .action-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
        }
        .action-card:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.06);
            transform: translateY(-2px);
        }

        .action-icon {
            font-size: 32px;
        }

        .action-text h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .action-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        @media (max-width: 640px) {
            .hero { padding: 60px 20px 60px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
            .trust-inner { gap: 24px; }
            .steps-section, .features-section { padding: 60px 20px; }
	    .pricing-cta .pricing-grid { grid-template-columns: 1fr; }
        }
            /* ═══════════════════════════════════════════════════════════════
           ANIMATIONS — scroll reveals, counters, interactive demo
           ═══════════════════════════════════════════════════════════════ */

        /* Scroll reveal */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Staggered children */
        .reveal-stagger > * {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .reveal-stagger.visible > *:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(2) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(3) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(4) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(5) { transition-delay: 0.5s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(6) { transition-delay: 0.6s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(7) { transition-delay: 0.7s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(8) { transition-delay: 0.8s; opacity: 1; transform: translateY(0); }

        /* Live invoice demo */
        .demo-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 80px 24px 100px;
        }
        .demo-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            overflow: hidden;
            max-width: 700px;
            margin: 0 auto;
        }
        .demo-accent { height: 4px; background: linear-gradient(90deg, #4ade80, #22d3ee, #818cf8); }
        .demo-header {
            padding: 28px 32px 0;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .demo-title {
            font-size: 20px;
            font-weight: 800;
            color: #0d1422;
            letter-spacing: -0.5px;
        }
        .demo-number { font-size: 14px; color: #64748b; font-weight: 600; }
        .demo-badge {
            background: #dcfce7;
            color: #15803d;
            font-size: 10px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .demo-addresses {
            padding: 20px 32px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }
        .demo-addr-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .demo-addr-name { font-size: 14px; font-weight: 700; color: #0d1422; }
        .demo-addr-line { font-size: 12px; color: #64748b; line-height: 1.5; }
        .demo-items {
            padding: 0 32px;
        }
        .demo-items table { width: 100%; border-collapse: collapse; }
        .demo-items th {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #94a3b8;
            text-align: left;
            padding: 8px 0;
            border-bottom: 2px solid #e2e8f0;
        }
        .demo-items th.right { text-align: right; }
        .demo-items td {
            padding: 10px 0;
            font-size: 13px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
        }
        .demo-items td.right { text-align: right; font-weight: 600; color: #0d1422; font-variant-numeric: tabular-nums; }
        .demo-item-desc { font-weight: 600; color: #0d1422; }
        .demo-total-row {
            padding: 16px 32px 24px;
            display: flex;
            justify-content: flex-end;
        }
        .demo-total-box {
            background: #f8fafc;
            border-radius: 8px;
            padding: 16px 24px;
            border: 1px solid #e2e8f0;
            min-width: 200px;
        }
        .demo-total-line {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #64748b;
            padding: 4px 0;
        }
        .demo-total-line.grand {
            border-top: 1px solid #e2e8f0;
            margin-top: 8px;
            padding-top: 10px;
            font-size: 16px;
            font-weight: 800;
            color: #0d1422;
        }
        .demo-total-line.grand span:last-child { color: #4ade80; }

        /* Typewriter effect */
        .typewriter {
            overflow: hidden;
            border-right: 2px solid #4ade80;
            white-space: nowrap;
            animation: typing 2s steps(20, end) forwards, blink 0.8s step-end infinite;
            width: 0;
            display: inline-block;
        }
        @keyframes typing {
            from { width: 0; }
            to { width: 100%; }
        }
        @keyframes blink {
            50% { border-color: transparent; }
        }

        /* Demo items animation */
        .demo-row-animate {
            opacity: 0;
            transform: translateX(-10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .demo-row-animate.show {
            opacity: 1;
            transform: translateX(0);
        }
	        /* ═══════════════════════════════════════════════════════════════
           ANIMATED FLOW SHOWCASE
           ═══════════════════════════════════════════════════════════════ */
        .flow-section {
            max-width: 860px;
            margin: 0 auto;
            padding: 80px 24px 60px;
            text-align: center;
        }

        /* Pills */
        .flow-pills {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-bottom: 36px;
        }
        .flow-pill {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.5);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }
        .flow-pill:hover {
            border-color: rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.8);
        }
        .flow-pill.active {
            background: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.3);
            color: #ffffff;
        }

        /* Stage */
        .flow-stage {
            position: relative;
            min-height: 380px;
            margin-bottom: 24px;
        }

        /* Cards */
        .flow-card {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            overflow: hidden;
            opacity: 0;
            transform: translateX(40px);
            transition: opacity 0.45s ease, transform 0.45s ease;
            pointer-events: none;
            text-align: left;
        }
        .flow-card.active {
            opacity: 1;
            transform: translateX(0);
            pointer-events: all;
            position: relative;
        }
        .flow-card.exit {
            opacity: 0;
            transform: translateX(-40px);
        }

        /* Chrome bar */
        .fc-chrome {
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .fc-chrome-dots {
            display: flex;
            gap: 5px;
            flex-shrink: 0;
        }
        .fc-chrome-dots span {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.12);
            display: block;
        }
        .fc-chrome-dots span:nth-child(1) { background: rgba(255,95,87,0.6); }
        .fc-chrome-dots span:nth-child(2) { background: rgba(255,189,68,0.6); }
        .fc-chrome-dots span:nth-child(3) { background: rgba(40,201,64,0.6); }
        .fc-chrome-url {
            font-size: 11px;
            color: rgba(255,255,255,0.3);
            font-family: monospace;
            letter-spacing: 0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Body */
        .fc-body {
            padding: 24px 28px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .fc-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .fc-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
