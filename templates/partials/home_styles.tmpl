{{define "home-styles"}}
<style>
    :root {
        /* Typography */
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'SF Mono', 'Fira Code', monospace;

        /* Font sizes */
        --text-xs:   11px;
        --text-sm:   13px;
        --text-base: 14px;
        --text-md:   16px;
        --text-lg:   18px;
        --text-xl:   24px;
        --text-2xl:  32px;

        /* Colors */
        --bg:             #0a0f1a;
        --bg-card:        rgba(255,255,255,0.03);
        --bg-card-hover:  rgba(255,255,255,0.06);
        --border:         rgba(255,255,255,0.08);
        --border-hover:   rgba(255,255,255,0.2);
        --text-primary:   #ffffff;
        --text-secondary: rgba(255,255,255,0.5);
        --text-tertiary:  rgba(255,255,255,0.3);
        --accent:         #4ade80;
        --accent-dim:     rgba(74,222,128,0.7);
        --error:          #dc2626;
        --error-light:    #fca5a5;

        /* Spacing */
        --space-1:  4px;
        --space-2:  8px;
        --space-3:  12px;
        --space-4:  16px;
        --space-5:  20px;
        --space-6:  24px;
        --space-8:  32px;
        --space-10: 40px;
        --space-12: 48px;
        --space-16: 64px;
        --space-20: 80px;

        /* Border radius */
        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text-primary);
        overflow-x: hidden;
        min-height: 100vh;
    }

    /* Mycelium canvas */
    #mycelium-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        pointer-events: none;
        opacity: 0.75;
    }

    .page-wrapper {
        position: relative;
        z-index: 2;
    }
</style>
{{template "home-styles-hero" .}}
{{template "home-styles-trust" .}}
{{template "home-styles-icp" .}}
{{template "home-styles-steps" .}}
{{template "home-styles-features" .}}
{{template "home-styles-cta" .}}
{{template "home-styles-dashboard" .}}
{{template "home-styles-animations" .}}
{{template "home-styles-flow" .}}
{{template "home-styles-security" .}}
{{end}}
