{{define "app-styles"}}
<style>
    :root {
        /* Typography */
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'SF Mono', 'Fira Code', monospace;

        /* Font sizes */
        --text-xs:   11px;
        --text-sm:   13px;
        --text-base: 14px;
        --text-md:   16px;
        --text-lg:   18px;
        --text-xl:   24px;
        --text-2xl:  32px;

        /* Colors */
        --bg:             #0a0f1a;
        --bg-card:        rgba(255,255,255,0.03);
        --bg-card-hover:  rgba(255,255,255,0.06);
        --border:         rgba(255,255,255,0.08);
        --border-hover:   rgba(255,255,255,0.2);
        --text-primary:   #ffffff;
        --text-secondary: rgba(255,255,255,0.5);
        --text-tertiary:  rgba(255,255,255,0.3);
        --accent:         #4ade80;
        --accent-dim:     rgba(74,222,128,0.7);
        --error:          #dc2626;
        --error-light:    #fca5a5;

        /* Spacing */
        --space-1:  4px;
        --space-2:  8px;
        --space-3:  12px;
        --space-4:  16px;
        --space-5:  20px;
        --space-6:  24px;
        --space-8:  32px;
        --space-10: 40px;
        --space-12: 48px;
        --space-16: 64px;
        --space-20: 80px;

        /* Border radius */
        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    /* ── Glowing Mycelium Keyframe Animations ──────────────────────── */
    @keyframes mycelium-pulse {
        0% { box-shadow: 0 0 12px rgba(34, 197, 94, 0.1); }
        50% { box-shadow: 0 0 22px rgba(34, 197, 94, 0.25); border-color: rgba(34, 197, 94, 0.4); }
        100% { box-shadow: 0 0 12px rgba(34, 197, 94, 0.1); }
    }

    @keyframes glass-focus {
        from { background: rgba(255, 255, 255, 0.05); }
        to { background: rgba(34, 197, 94, 0.02); }
    }

    /* ── Standardized Translucent Glass Cards ──────────────────────── */
    .form-card {
        background: rgba(255, 255, 255, 0.02) !important;
        border: 1px solid rgba(255, 255, 255, 0.06) !important;
        border-radius: 16px;
        padding: 40px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    /* ── Standardized Form Inputs & Focus Washes ─────────────────────── */
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        color: #fff;
        background: rgba(255, 255, 255, 0.04);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: rgba(34, 197, 94, 0.4) !important; /* Brand Emerald */
        background: rgba(34, 197, 94, 0.025); /* Faint organic green wash */
        box-shadow: 0 0 15px rgba(34, 197, 94, 0.15);
        animation: glass-focus 0.3s forwards;
    }

    /* ── Global Button Utilities (Strict 36px matches) ────────────── */
    .btn-primary, .btn-secondary, .btn-success, .btn-delete, .btn-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 20px;
        height: 36px;
        border-radius: var(--radius-md);
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        line-height: 1;
        white-space: nowrap;
    }

    /* Primary: Frosted Lens with White/Emerald Glow */
    .btn-primary {
        background: rgba(255, 255, 255, 0.95);
        color: #020617;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
    }
    .btn-primary:hover {
        background: #ffffff;
        box-shadow: 0 0 18px rgba(255, 255, 255, 0.15);
        transform: translateY(-1px);
    }
    .btn-primary:active {
        transform: translateY(0);
    }

    /* Secondary: Outline Lens */
    .btn-secondary {
        background: rgba(255, 255, 255, 0.02);
        color: var(--text-secondary);
        border: 1px solid var(--border);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--border-hover);
        color: var(--text-primary);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
    }

    /* Success / Action: Pulsing Neon Emerald */
    .btn-success {
        background: rgba(34, 197, 94, 0.08);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.35);
        animation: mycelium-pulse 3s infinite ease-in-out;
    }
    .btn-success:hover {
        background: rgba(34, 197, 94, 0.15);
        border-color: rgba(34, 197, 94, 0.6);
        box-shadow: 0 0 22px rgba(34, 197, 94, 0.35);
        color: #fff;
        transform: translateY(-1px);
        animation: none; /* Lock glow on hover */
    }
    .btn-success:active {
        transform: translateY(0);
    }

    /* Danger / Delete: Faint Neon Red Glow */
    .btn-delete, .btn-danger {
        background: rgba(239, 68, 68, 0.03);
        color: var(--error-light);
        border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .btn-delete:hover, .btn-danger:hover {
        background: rgba(239, 68, 68, 0.08);
        border-color: var(--error);
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.15);
        color: #fff;
    }
</style>
{{end}}
