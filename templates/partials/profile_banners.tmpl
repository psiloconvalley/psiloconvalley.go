{{define "profile-banners"}}
<style>
    .pr-welcome {
        background: linear-gradient(135deg, rgba(74,222,128,0.08) 0%, rgba(34,197,94,0.04) 100%);
        border: 1px solid var(--pr-green-border);
        border-radius: var(--pr-radius);
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    }

    .pr-welcome-icon {
        font-size: 32px;
        line-height: 1;
        flex-shrink: 0;
    }

    .pr-welcome-title {
        font-size: 18px;
        font-weight: 800;
        color: var(--pr-green);
        margin-bottom: 6px;
    }

    .pr-welcome-body {
        font-size: 13px;
        color: var(--pr-text-secondary);
        line-height: 1.6;
    }

    .pr-welcome-actions {
        margin-top: 14px;
        display: flex;
        gap: 16px;
        font-size: 12px;
        color: var(--pr-text-faint);
        align-items: center;
    }

    .pr-welcome-actions a {
        color: var(--pr-text-muted);
        text-decoration: none;
        transition: color var(--pr-dur-fast) ease;
    }

    .pr-welcome-actions a:hover { color: var(--pr-text); }

    .pr-magic-banner {
        background: linear-gradient(135deg, var(--pr-blue-surface) 0%, rgba(99,102,241,0.04) 100%);
        border: 1px solid var(--pr-blue-border);
        border-radius: var(--pr-radius);
        padding: 24px 28px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .pr-magic-icon {
        font-size: 28px;
        flex-shrink: 0;
        line-height: 1;
    }

    .pr-magic-title {
        font-size: 15px;
        font-weight: 800;
        color: var(--pr-blue);
        margin-bottom: 6px;
    }

    .pr-magic-body {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        line-height: 1.6;
    }
</style>
{{end}}
