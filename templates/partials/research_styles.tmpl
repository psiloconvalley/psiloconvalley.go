{{define "research-styles"}}
<style>
        .research-wrap {
            max-width: 960px;
            margin: 0 auto;
            padding: 80px 24px 120px;
        }

        /* ── Thesis Hero — top of page ── */
        .thesis-hero {
            margin-bottom: 80px;
            padding-bottom: 80px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .thesis-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 28px;
        }



        .thesis-hero h1 {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1.0;
            margin-bottom: 32px;
            color: #ffffff;
        }

        .thesis-hero h1 em {
            font-style: normal;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .thesis-body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            margin-top: 40px;
        }

        .thesis-block {
            padding: 28px;
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 14px;
            background: rgba(255,255,255,0.02);
            position: relative;
            overflow: hidden;
        }

        .thesis-block::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient(180deg, #4ade80, #22d3ee);
            border-radius: 3px 0 0 3px;
        }

        .thesis-block-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.6);
            margin-bottom: 10px;
        }

        .thesis-block p {
            font-size: 14px;
            color: rgba(255,255,255,0.6);
            line-height: 1.75;
        }

        .thesis-block p strong {
            color: #ffffff;
            font-weight: 700;
        }

        /* ── Roadmap Header ── */
        .roadmap-header {
            margin-bottom: 48px;
        }

        .roadmap-eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 12px;
        }

        .roadmap-header h2 {
            font-size: clamp(24px, 4vw, 36px);
            font-weight: 800;
            letter-spacing: -1.5px;
            color: #ffffff;
            margin-bottom: 12px;
        }

        .roadmap-header p {
            font-size: 15px;
            color: rgba(255,255,255,0.4);
            line-height: 1.6;
            max-width: 520px;
        }

        .roadmap-header p strong {
            color: rgba(255,255,255,0.7);
        }

        /* ── Section heads ── */
        .section-head {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin: 48px 0 20px;
        }

        .section-head::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,0.06);
        }

        /* ── Cards ── */
       .card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 24px 28px;
            margin-bottom: 12px;
            position: relative;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .card:hover {
            border-color: rgba(255,255,255,0.25);
            background: rgba(255,255,255,0.06);
        }
     
        /* Left accent bar per status */
        .card-shipped::before {
            content: '';
            position: absolute;
            left: 0; top: 0;
            width: 3px; height: 100%;
            background: #4ade80;
            border-radius: 3px 0 0 3px;
        }

        .card-building::before {
            content: '';
            position: absolute;
            left: 0; top: 0;
            width: 3px; height: 100%;
            background: #fbbf24;
            border-radius: 3px 0 0 3px;
        }

        .card-planned::before {
            content: '';
            position: absolute;
            left: 0; top: 0;
            width: 3px; height: 100%;
            background: #60a5fa;
            border-radius: 3px 0 0 3px;
        }

        .card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .card h2 {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: #ffffff;
            line-height: 1.3;
        }

        .card p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
        }

        .card p strong {
            color: rgba(255,255,255,0.8);
        }

        /* ── Tags ── */
        .tag {
            display: inline-block;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 20px;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .tag-shipped {
            background: rgba(74,222,128,0.1);
            color: #4ade80;
            border: 1px solid rgba(74,222,128,0.2);
        }

        .tag-building {
            background: rgba(251,191,36,0.1);
            color: #fbbf24;
            border: 1px solid rgba(251,191,36,0.2);
        }

        .tag-planned {
            background: rgba(96,165,250,0.1);
            color: #60a5fa;
            border: 1px solid rgba(96,165,250,0.2);
        }

        /* ── Meta ── */
        .meta {
            font-size: 11px;
            font-weight: 500;
            color: rgba(255,255,255,0.2);
            margin-top: 10px;
            font-family: 'SF Mono', 'Fira Code', monospace;
            letter-spacing: 0.3px;
        }

        @media (max-width: 640px) {
            .research-wrap { padding: 60px 20px 80px; }
            .thesis-body { grid-template-columns: 1fr; gap: 16px; }
            /* mobile h1 inherits from base */
            .card { padding: 20px; }
        }
</style>
{{end}}
