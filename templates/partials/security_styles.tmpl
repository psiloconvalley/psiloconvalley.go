{{define "security-styles"}}
<style>
        .page-wrapper {
            max-width: 860px;
        }

        /* ── Header ── */
        .sec-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.2);
            padding: 8px 16px;
            border-radius: 20px;
            margin-bottom: 28px;
        }

        .sec-title {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .sec-title span {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .sec-intro {
            font-size: 17px;
            color: rgba(255,255,255,0.55);
            line-height: 1.7;
            max-width: 640px;
            margin-bottom: 72px;
        }

        /* ── Sections ── */
        .sec-section {
            margin-bottom: 64px;
            padding-bottom: 64px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .sec-section:last-of-type {
            border-bottom: none;
        }

        .sec-section-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 12px;
        }

        .sec-section h2 {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 24px;
        }

        /* ── Cards ── */
        .sec-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .sec-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 22px 20px;
        }

        .sec-card-icon {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .sec-card h4 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .sec-card p {
            font-size: 13px;
            color: rgba(255,255,255,0.45);
            line-height: 1.6;
        }

        /* ── Prose ── */
        .sec-prose {
            font-size: 15px;
            color: rgba(255,255,255,0.55);
            line-height: 1.8;
        }

        .sec-prose + .sec-prose {
            margin-top: 16px;
        }

        /* ── Status table ── */
        .sec-status-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sec-status-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 20px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
        }

        .sec-status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .sec-status-dot.green { background: #4ade80; box-shadow: 0 0 8px rgba(74,222,128,0.5); }
        .sec-status-dot.yellow { background: #fbbf24; box-shadow: 0 0 8px rgba(251,191,36,0.5); }

        .sec-status-name {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
            min-width: 220px;
        }

        .sec-status-desc {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
        }

        /* ── CTA ── */
        .sec-cta {
            margin-top: 72px;
            text-align: center;
            padding: 48px 32px;
            background: rgba(74,222,128,0.04);
            border: 1px solid rgba(74,222,128,0.15);
            border-radius: 16px;
        }

        .sec-cta h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .sec-cta p {
            font-size: 15px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 28px;
        }

        @media (max-width: 640px) {
            .sec-status-row { flex-direction: column; align-items: flex-start; gap: 8px; }
            .sec-status-name { min-width: unset; }
        }
</style>
{{end}}
