{{define "pricing-styles"}}
<style>
        .page {
            max-width: 960px;
            margin: 0 auto;
            padding: 56px 20px 80px;
        }

        .hero {
            text-align: center;
            margin-bottom: 48px;
        }

        .hero .eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 14px;
        }

        .hero h1 {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 12px;
        }

        .hero p {
            max-width: 620px;
            margin: 0 auto;
            color: rgba(255,255,255,0.55);
            line-height: 1.7;
            font-size: 16px;
        }

        .notice {
            max-width: 720px;
            margin: 0 auto 24px;
            padding: 14px 16px;
            border-radius: 10px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #ffffff;
            font-size: 14px;
        }

        .notice.success {
            border-color: rgba(74,222,128,0.35);
            background: rgba(74,222,128,0.12);
            color: #dcfce7;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 24px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .pricing-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 36px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
            text-align: center;
            display: flex;
            flex-direction: column;
        }

        .pricing-card.growth {
            border-color: rgba(74,222,128,0.3);
            background: rgba(74,222,128,0.04);
            position: relative;
        }

        .pricing-card.pro {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
        }

        .pricing-card .features {
            flex: 1;
        }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: #4ade80;
            color: #0a0f1a;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 4px 16px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .plan-name {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.5);
            font-weight: 700;
            margin-bottom: 16px;
        }

        .growth .plan-name { color: #4ade80; }

        .price {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        .price .amount {
            font-size: 56px;
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1;
        }

        .price .unit {
            font-size: 16px;
            color: rgba(255,255,255,0.55);
            margin-bottom: 8px;
        }

        .subtext {
            color: rgba(255,255,255,0.55);
            margin-bottom: 28px;
            line-height: 1.7;
            font-size: 14px;
        }

        .features {
            list-style: none;
            margin-bottom: 30px;
            text-align: left;
        }

        .features li {
            padding: 10px 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.9);
            font-size: 14px;
        }

        .features li:first-child { border-top: none; }

        .cta-form, .cta-actions { margin-top: 8px; }

        .page .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 50px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.15s ease, opacity 0.15s ease;
        }

        .page .btn:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        .page .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
        }

        .page .btn-growth {
            background: #4ade80;
            color: #0a0f1a;
        }

        .page .btn-growth:hover {
            background: #22c55e;
        }

        .page .btn-secondary {
            background: transparent;
            color: #ffffff;
            border: 1px solid rgba(255,255,255,0.16);
            margin-top: 12px;
        }

        .plan-state {
            margin-top: 18px;
            font-size: 14px;
            color: #cbd5e1;
        }

        .ent-callout {
            max-width: 720px;
            margin: 48px auto 0;
            padding: 32px;
            background: rgba(74,222,128,0.04);
            border: 1px solid rgba(74,222,128,0.15);
            border-radius: 14px;
            text-align: center;
        }

        .ent-callout h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #ffffff;
        }

        .ent-callout p {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .ent-callout a {
            color: #4ade80;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .ent-callout a:hover {
            text-decoration: underline;
        }

        @media (max-width: 900px) {
            .pricing-grid { grid-template-columns: 1fr; max-width: 480px; }
        }

        @media (max-width: 640px) {
            .page { padding: 40px 16px 64px; }
            .hero h1 { font-size: 34px; }
            .pricing-card { padding: 24px; }
            .price .amount { font-size: 44px; }
        }
</style>
{{end}}
