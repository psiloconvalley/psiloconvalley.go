{{define "pricing-styles"}}
<style>
    .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 56px 20px 80px;
    }

    /* ── Hero ── */
    .hero {
        text-align: center;
        margin-bottom: 56px;
    }

    .hero .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(74,222,128,0.7);
        margin-bottom: 14px;
    }

    .hero .eyebrow::before {
        content: '';
        display: block;
        width: 24px;
        height: 2px;
        background: #4ade80;
        border-radius: 2px;
    }

    .hero h1 {
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1.1;
        margin-bottom: 12px;
    }

    .hero h1 em {
        font-style: normal;
        background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero p {
        max-width: 560px;
        margin: 0 auto;
        color: rgba(255,255,255,0.5);
        line-height: 1.7;
        font-size: 16px;
    }

    /* ── Notices ── */
    .notice {
        max-width: 720px;
        margin: 0 auto 24px;
        padding: 14px 18px;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.85);
        font-size: 14px;
        line-height: 1.6;
    }

    .notice.success {
        border-color: rgba(74,222,128,0.3);
        background: rgba(74,222,128,0.08);
        color: #dcfce7;
    }

    /* ── Pricing Grid ── */
    .pricing-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
        max-width: 1060px;
        margin: 0 auto 48px;
        align-items: center;
    }

    /* ── Base Card ── */
    .pricing-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 36px 32px;
        display: flex;
        flex-direction: column;
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        cursor: default;
    }

    .pricing-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 24px 60px rgba(0,0,0,0.3);
        border-color: rgba(255,255,255,0.14);
    }

    /* ── Popular Card (Pro) ── */
    .pricing-card.popular {
        border: 1.5px solid rgba(74,222,128,0.4);
        background: rgba(74,222,128,0.04);
        position: relative;
        transform: scale(1.04);
        box-shadow: 0 20px 50px rgba(0,0,0,0.28), 0 0 0 1px rgba(74,222,128,0.08);
        z-index: 2;
    }

    .pricing-card.popular:hover {
        transform: scale(1.04) translateY(-3px);
        box-shadow: 0 28px 64px rgba(0,0,0,0.35), 0 0 0 1px rgba(74,222,128,0.15);
        border-color: rgba(74,222,128,0.55);
    }

    /* ── Pro Card ── */
    .pricing-card.pro {
        border-color: rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
    }


    /* ── Pro Max Card ── */
    .pricing-card.promax {
        border: 1.5px solid rgba(251,191,36,0.4);
        background: rgba(251,191,36,0.04);
        position: relative;
    }

    .pricing-card.promax:hover {
        border-color: rgba(251,191,36,0.6);
        box-shadow: 0 24px 60px rgba(0,0,0,0.3), 0 0 0 1px rgba(251,191,36,0.1);
    }

    .promax .plan-name {
        color: #fbbf24;
    }

    .promax-badge {
        background: #fbbf24 !important;
        color: #0a0f1a !important;
    }

    /* ── Popular Badge ── */
    .popular-badge {
        position: absolute;
        top: -13px;
        left: 50%;
        transform: translateX(-50%);
        background: #4ade80;
        color: #0a0f1a;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 4px 16px;
        border-radius: 999px;
        white-space: nowrap;
    }

    /* ── Plan Name ── */
    .plan-name {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2.5px;
        color: rgba(255,255,255,0.4);
        font-weight: 700;
        margin-bottom: 20px;
    }

    .popular .plan-name {
        color: #4ade80;
    }

    /* ── Price ── */
    .price {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 6px;
        margin-bottom: 6px;
    }

    .price .amount {
        font-size: 52px;
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1;
        color: #ffffff;
    }

    .price .unit {
        font-size: 14px;
        color: rgba(255,255,255,0.45);
        margin-bottom: 10px;
        line-height: 1.3;
    }

    /* ── Founding Rate Tag ── */
    .founding-tag {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #4ade80;
        background: rgba(74,222,128,0.12);
        border: 1px solid rgba(74,222,128,0.25);
        border-radius: 6px;
        padding: 3px 10px;
        margin-bottom: 20px;
    }

    /* ── Subtext ── */
    .subtext {
        color: rgba(255,255,255,0.45);
        margin-bottom: 24px;
        line-height: 1.65;
        font-size: 13px;
    }

    /* ── Features List ── */
    .features {
        list-style: none;
        margin-bottom: 28px;
        text-align: left;
        flex: 1;
    }

    .features li {
        padding: 9px 0;
        border-top: 1px solid rgba(255,255,255,0.05);
        font-size: 13.5px;
        line-height: 1.4;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .features li:first-child {
        border-top: none;
    }

    /* Feature check/cross icons */
    .feat-yes {
        color: #4ade80;
        font-size: 13px;
        flex-shrink: 0;
        font-weight: 700;
    }

    .feat-no {
        color: rgba(255,255,255,0.2);
        font-size: 13px;
        flex-shrink: 0;
    }

    .feat-yes ~ span,
    .feat-no ~ span { }

    .feat-no ~ span {
        color: rgba(255,255,255,0.3);
    }

    /* ── Buttons ── */
    .cta-form,
    .cta-actions {
        margin-top: auto;
        padding-top: 8px;
    }

    .page .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 48px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        font-family: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        letter-spacing: 0.2px;
    }

    .page .btn:hover {
        transform: translateY(-1px);
    }

    .page .btn-primary {
        background: #ffffff;
        color: #0a0f1a;
        box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    }

    .page .btn-primary:hover {
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .page .btn-pro {
        background: #4ade80;
        color: #0a0f1a;
        box-shadow: 0 2px 16px rgba(74,222,128,0.2);
    }

    .page .btn-pro:hover {
        background: #22c55e;
        box-shadow: 0 4px 24px rgba(74,222,128,0.35);
    }

    .page .btn-secondary {
        background: transparent;
        color: rgba(255,255,255,0.7);
        border: 1px solid rgba(255,255,255,0.14);
        margin-top: 10px;
    }

    .page .btn-secondary:hover {
        border-color: rgba(255,255,255,0.28);
        color: #ffffff;
    }

    /* ── Plan State ── */
    .plan-state {
        margin-top: 14px;
        font-size: 13px;
        color: rgba(255,255,255,0.45);
    }

    /* ── Enterprise Callout ── */
    .ent-callout {
        max-width: 680px;
        margin: 0 auto;
        padding: 28px 32px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        text-align: center;
    }

    .ent-callout h3 {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #ffffff;
    }

    .ent-callout p {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        line-height: 1.7;
        margin-bottom: 16px;
    }

    .ent-callout a {
        color: #4ade80;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: opacity 0.15s;
    }

    .ent-callout a:hover {
        opacity: 0.8;
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .pricing-grid {
            grid-template-columns: 1fr;
            max-width: 440px;
        }

        .pricing-card.popular {
            transform: none;
            order: -1;
        }

        .pricing-card.popular:hover {
            transform: translateY(-3px);
        }
    }

    @media (max-width: 600px) {
        .page {
            padding: 36px 16px 64px;
        }

        .hero h1 {
            font-size: 32px;
            letter-spacing: -1.5px;
        }

        .pricing-card {
            padding: 28px 22px;
            border-radius: 16px;
        }

        .price .amount {
            font-size: 44px;
        }
    }
</style>
{{end}}
