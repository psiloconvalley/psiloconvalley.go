{{define "research-building"}}
    <!-- ── Building Now ── -->
    <div class="section-head">Building Now</div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Address Autocomplete</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            Start typing a client address and get suggestions from your own client history —
            no API key, no cost, no data leaving your account.
            Google Maps integration available for Pro users when ready.
            <strong>Faster client entry. Zero friction.</strong>
        </p>
        <div class="meta">Target: v4.3 · Local-first · Zero API cost</div>
    </div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Homepage in Spanish</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            The product is fully bilingual. The marketing page is next.
            Hero, features, pricing, and CTA — all in Spanish for the
            41 million Spanish speakers who deserve software built for them.
        </p>
        <div class="meta">Target: v4.3 · Extends existing i18n engine</div>
    </div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Additional Languages</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            Hindi, Punjabi, Mandarin, Cantonese, and Vietnamese translations
            are in development. The engine is built — we are expanding the vocabulary.
        </p>
        <div class="meta">Target: v4.4 · After Spanish validated</div>
    </div>
{{end}}
