{{define "research-building"}}
    <!-- ── Building Now ── -->
    <div class="section-head">Building Now</div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Dashboard Quote Request Feed</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            Quote requests from your public business page will appear directly
            on your dashboard. See new leads, respond faster, convert to estimates
            with one click.
        </p>
        <div class="meta">Target: v5.1 · Extends quote_requests table</div>
    </div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Public Profile in Spanish</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            Your /biz/ public business page will render in Spanish for
            Spanish-speaking visitors. Quote request form, invoice lookup,
            and Quick Pay — all translated.
        </p>
        <div class="meta">Target: v5.1 · Extends existing i18n engine</div>
    </div>

    <div class="card card-building">
        <div class="card-top">
            <h2>Additional Languages</h2>
            <span class="tag tag-building">In Progress</span>
        </div>
        <p>
            Hindi, Punjabi, Mandarin, Cantonese, and Vietnamese translations
            are in development. The engine is built — we are expanding the vocabulary.
        </p>
        <div class="meta">Target: v5.2 · After Spanish fully validated</div>
    </div>
{{end}}
