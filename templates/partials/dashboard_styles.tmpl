{{define "dashboard-styles"}}
<style>
    :root {
        --db-surface: rgba(255,255,255,0.03);
        --db-surface-hover: rgba(255,255,255,0.06);
        --db-border: rgba(255,255,255,0.08);
        --db-border-hover: rgba(255,255,255,0.15);
        --db-text: #ffffff;
        --db-text-secondary: rgba(255,255,255,0.6);
        --db-text-muted: rgba(255,255,255,0.4);
        --db-text-faint: rgba(255,255,255,0.3);
        --db-green: #4ade80;
        --db-yellow: #fbbf24;
        --db-red: #f87171;
        --db-radius: 14px;
        --db-radius-sm: 10px;
        --db-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --db-dur: 0.25s;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 48px 20px 80px;
    }

    /* ── Header ── */
    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        border-left: 2px solid rgba(255,255,255,0.15);
        padding-left: 24px;
    }

    .top h1 {
        font-size: 32px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -1px;
        color: var(--db-text);
    }

    .top-sub {
        color: var(--db-text-muted);
        font-size: 13px;
        margin-top: 6px;
        font-family: monospace;
    }

    /* ── Stats grid ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .stats-grid-two {
        grid-template-columns: repeat(2, 1fr);
        margin-top: 0;
    }

    .stat-card {
        background: var(--db-surface);
        border: 1px solid var(--db-border);
        border-radius: var(--db-radius);
        padding: 24px;
        transition:
            background var(--db-dur) ease,
            border-color var(--db-dur) ease;
    }

    .stat-card:hover {
        background: var(--db-surface-hover);
        border-color: var(--db-border-hover);
    }

    .stat-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--db-text-muted);
        margin-bottom: 12px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -1px;
        font-variant-numeric: tabular-nums;
        color: var(--db-text);
    }

    .stat-value.green  { color: var(--db-green); }
    .stat-value.yellow { color: var(--db-yellow); }
    .stat-value.red    { color: var(--db-red); }

    .stat-sub {
        font-size: 12px;
        color: var(--db-text-faint);
        margin-top: 6px;
    }

    .stat-sub a {
        color: var(--db-text-muted);
        text-decoration: none;
        transition: color var(--db-dur) ease;
    }

    .stat-sub a:hover { color: var(--db-text); }

    /* ── Quick actions ── */
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 32px;
    }

    .action-card {
        background: var(--db-surface);
        border: 1px solid var(--db-border);
        border-radius: var(--db-radius-sm);
        padding: 22px;
        text-decoration: none;
        color: var(--db-text);
        display: flex;
        align-items: center;
        gap: 14px;
        transition:
            background var(--db-dur) var(--db-ease),
            border-color var(--db-dur) var(--db-ease),
            transform var(--db-dur) var(--db-ease),
            box-shadow var(--db-dur) var(--db-ease);
    }

    .action-card:hover {
        background: var(--db-surface-hover);
        border-color: var(--db-border-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }

    .action-card:active {
        transform: translateY(0) scale(0.98);
    }

    .action-icon { font-size: 24px; }

    .action-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--db-text);
    }

    .action-sub {
        font-size: 12px;
        color: var(--db-text-muted);
        margin-top: 2px;
    }

    /* ── Pro upgrade banner ── */
    .upgrade-banner {
        background: linear-gradient(135deg, rgba(251,191,36,0.1) 0%, rgba(245,158,11,0.05) 100%);
        border: 1px solid rgba(251,191,36,0.2);
        border-radius: var(--db-radius);
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

    .upgrade-text {
        font-size: 14px;
        color: rgba(255,255,255,0.8);
    }

    .upgrade-text strong { color: var(--db-yellow); }

    .db-btn-upgrade {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none;
        white-space: nowrap;
        background: var(--db-yellow);
        color: #000;
        transition:
            background var(--db-dur) ease,
            transform var(--db-dur) ease;
    }

    .db-btn-upgrade:hover {
        background: #f59e0b;
        transform: translateY(-1px);
    }

    /* ── Passkey banner ── */
    .passkey-banner {
        background: linear-gradient(180deg, rgba(37,99,235,0.10), rgba(17,24,39,0.72));
        border: 1px solid rgba(96,165,250,0.28);
        border-radius: var(--db-radius);
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

    .passkey-banner strong { color: #93c5fd; }

    .db-btn-passkey {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none;
        white-space: nowrap;
        background: #2563eb;
        color: #ffffff;
        transition:
            background var(--db-dur) ease,
            transform var(--db-dur) ease;
    }

    .db-btn-passkey:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
    }

    /* ── Section ── */
    .section {
        margin-bottom: 40px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--db-text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .section-link {
        font-size: 12px;
        color: var(--db-text-muted);
        text-decoration: none;
        transition: color var(--db-dur) ease;
    }

    .section-link:hover { color: var(--db-text); }

    /* ── Table ── */
    .table-wrap {
        background: var(--db-surface);
        border: 1px solid var(--db-border);
        border-radius: var(--db-radius-sm);
        overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; }

    th {
        background: rgba(255,255,255,0.04);
        color: var(--db-text-muted);
        text-align: left;
        padding: 10px 16px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    td {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        font-size: 13px;
        vertical-align: middle;
        color: var(--db-text-secondary);
    }

    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    /* ── Empty state ── */
    .empty {
        text-align: center;
        padding: 40px 20px;
        color: var(--db-text-faint);
    }

    .empty-icon {
        font-size: 32px;
        margin-bottom: 12px;
    }

    .empty-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--db-text-muted);
        margin-bottom: 6px;
    }

    .empty-sub { font-size: 13px; }

    /* ── Mobile ── */
    @media (max-width: 639px) {
        .container { padding: 24px 16px 80px; }
        .top { padding-left: 16px; }
        .top h1 { font-size: 22px; }
        .stats-grid { grid-template-columns: 1fr 1fr; }
        .stats-grid-two { grid-template-columns: 1fr 1fr; }
        .stat-value { font-size: 22px; }
        .quick-actions { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 400px) {
        .stats-grid { grid-template-columns: 1fr; }
        .stats-grid-two { grid-template-columns: 1fr; }
        .quick-actions { grid-template-columns: 1fr; }
    }
</style>
{{end}}
