{{define "dashboard-styles"}}
<style>
  .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        /* ── Header ── */
	.top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-sub {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            margin-top: 6px;
            font-family: monospace;
        }
                .btn {
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 6px;
            font-family: inherit;
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .btn-white { background: #fff; color: #000; }
        .btn-white:hover { opacity: 0.85; }

        /* ── Stats grid ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }
	.stats-grid-two {
            grid-template-columns: repeat(2, 1fr);
            margin-top: 0;
        }
        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }
        .stat-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 12px;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
            font-variant-numeric: tabular-nums;
            color: #fff;
        }
        .stat-value.green { color: #4ade80; }
        .stat-value.yellow { color: #fbbf24; }
        .stat-value.red { color: #f87171; }
        .stat-sub {
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            margin-top: 6px;
        }

        /* ── Section ── */
        .section {
            margin-bottom: 40px;
        }
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .section-title {
            font-size: 14px;
            font-weight: 700;
            color: rgba(255,255,255,0.6);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .section-link {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            text-decoration: none;
        }
        .section-link:hover { color: white; }

        /* ── Table ── */
        .table-wrap {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            overflow: hidden;
        }
        table { width: 100%; border-collapse: collapse; }
        th {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.4);
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 13px;
            vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .inv-link {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        .inv-link:hover { text-decoration: underline; }

        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-draft   { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); }
        .badge-sent    { background: #1e3a5f; color: #93c5fd; }
        .badge-paid    { background: #14532d; color: #86efac; }
        .badge-void    { background: #450a0a; color: #fca5a5; }
        .badge-overdue { background: #431407; color: #fdba74; }
	.badge-pending  { background: #1e3a5f; color: #93c5fd; }
        .badge-accepted { background: #14532d; color: #86efac; }
        .badge-declined { background: #450a0a; color: #fca5a5; }

        .right { text-align: right; }
        .mono { font-variant-numeric: tabular-nums; }

        /* ── Quick actions ── */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 32px;
        }
        .action-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 20px;
            text-decoration: none;
            color: white;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .action-card:hover {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-1px);
        }
        .action-icon { font-size: 24px; }
        .action-title { font-size: 14px; font-weight: 700; }
        .action-sub { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 2px; }

        /* ── Pro upgrade banner ── */
        .upgrade-banner {
            background: linear-gradient(135deg, rgba(251,191,36,0.1) 0%, rgba(245,158,11,0.05) 100%);
            border: 1px solid rgba(251,191,36,0.2);
            border-radius: 12px;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }
        .upgrade-text { font-size: 14px; color: rgba(255,255,255,0.8); }
        .upgrade-text strong { color: #fbbf24; }
        .btn-upgrade {
            background: #fbbf24;
            color: #000;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .btn-upgrade:hover { background: #f59e0b; }

        /* ── Empty state ── */
        .empty {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-icon { font-size: 32px; margin-bottom: 12px; }
        .empty-title { font-size: 16px; font-weight: 700; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
        .empty-sub { font-size: 13px; }

        /* ── Mobile ── */
        @media (max-width: 639px) {
            .container { padding: 24px 16px 80px; }
	    .top { padding-left: 16px; }
            .top h1 { font-size: 22px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .stat-value { font-size: 22px; }
            .quick-actions { grid-template-columns: 1fr; }
        }
	.stats-grid-two { grid-template-columns: 1fr 1fr; }

        @media (max-width: 400px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
	.stats-grid-two { grid-template-columns: 1fr; }
</style>
{{end}}
