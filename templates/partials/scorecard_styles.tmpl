{{define "scorecard-styles"}}
<style>
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        /* ── Header ── */
        .top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-sub {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            margin-top: 6px;
            font-family: monospace;
        }
        .top-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .btn-secondary {
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            white-space: nowrap;
            min-height: 38px;
            display: inline-flex;
            align-items: center;
        }
        .btn-secondary:hover { background: rgba(255,255,255,0.1); }

        /* ── Explainer ── */
        .explainer {
            margin-left: 27px;
            margin-bottom: 36px;
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            line-height: 1.6;
            max-width: 600px;
        }

        /* ── Score legend ── */
        .legend {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }
        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        /* ── Cards grid ── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .scorecard {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 24px;
            position: relative;
            transition: border-color 0.2s;
        }
        .scorecard:hover { border-color: rgba(255,255,255,0.15); }

        /* Score color border on left */
        .scorecard.score-green  { border-left: 3px solid #4ade80; }
        .scorecard.score-yellow { border-left: 3px solid #fbbf24; }
        .scorecard.score-red    { border-left: 3px solid #f87171; }

        /* ── Card header ── */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .client-name {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.3px;
            line-height: 1.2;
            max-width: 200px;
            word-break: break-word;
        }
        .score-badge {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 52px;
        }
        .score-number {
            font-size: 28px;
            font-weight: 900;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }
        .score-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-top: 2px;
        }
        .score-green  .score-number { color: #4ade80; }
        .score-yellow .score-number { color: #fbbf24; }
        .score-red    .score-number { color: #f87171; }

        /* ── Score bar ── */
        .score-bar-wrap {
            margin-bottom: 20px;
        }
        .score-bar-track {
            height: 4px;
            background: rgba(255,255,255,0.08);
            border-radius: 2px;
            overflow: hidden;
        }
        .score-bar-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.6s ease;
        }
        .score-green  .score-bar-fill { background: #4ade80; }
        .score-yellow .score-bar-fill { background: #fbbf24; }
        .score-red    .score-bar-fill { background: #f87171; }

        /* ── Stats rows ── */
        .stat-rows {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 16px;
        }
        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .stat-row-label {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
        }
        .stat-row-value {
            font-size: 13px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }
        .val-green  { color: #4ade80; }
        .val-yellow { color: #fbbf24; }
        .val-red    { color: #f87171; }
        .val-blue   { color: #93c5fd; }

        /* ── Insight tag ── */
        .insight {
            margin-top: 16px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 12px;
            line-height: 1.5;
            font-weight: 500;
        }
        .insight-green  { background: rgba(74,222,128,0.08); color: #4ade80; }
        .insight-yellow { background: rgba(251,191,36,0.08); color: #fbbf24; }
        .insight-red    { background: rgba(248,113,113,0.08); color: #f87171; }

        /* ── Empty state ── */
        .empty {
            text-align: center;
            padding: 80px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-icon  { font-size: 48px; margin-bottom: 16px; }
        .empty-title { font-size: 20px; font-weight: 700; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
        .empty-sub   { font-size: 14px; line-height: 1.6; max-width: 380px; margin: 0 auto; }

        /* ── Mobile ── */
        @media (max-width: 640px) {
            .container { padding: 24px 16px 80px; }
            .top { padding-left: 16px; }
            .top h1 { font-size: 22px; }
            .cards-grid { grid-template-columns: 1fr; }
        }
</style>
{{end}}
