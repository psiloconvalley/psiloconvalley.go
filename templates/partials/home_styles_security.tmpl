{{define "home-styles-security"}}
<style>
     /* ═══════════════════════════════════════════════════════════════
           SECURITY SECTION — homepage
           ═══════════════════════════════════════════════════════════════ */
        .sec-home {
            padding: 100px 24px;
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background: rgba(8,13,24,0.5);
        }

        .sec-home-inner {
            max-width: 960px;
            margin: 0 auto;
        }

        .sec-home-header {
            text-align: center;
            margin-bottom: 48px;
        }

        .sec-home-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 14px;
        }

        .sec-home-eyebrow::before {
            content: '';
            display: block;
            width: 24px;
            height: 2px;
            background: #4ade80;
            border-radius: 2px;
        }

        .sec-home-title {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1.12;
            color: #ffffff;
            margin-bottom: 16px;
        }

        .sec-home-title em {
            font-style: normal;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .sec-home-sub {
            max-width: 560px;
            margin: 0 auto;
            font-size: 15px;
            line-height: 1.7;
            color: rgba(255,255,255,0.5);
        }

        .sec-home-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 28px;
        }

        .sec-home-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 22px 20px;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .sec-home-card:hover {
            border-color: rgba(255,255,255,0.14);
            background: rgba(255,255,255,0.03);
        }

        .sec-home-card-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .sec-home-icon {
            font-size: 20px;
            line-height: 1;
            flex-shrink: 0;
        }

        .sec-home-card h4 {
            font-size: 14px;
            font-weight: 700;
            line-height: 1.3;
            letter-spacing: -0.2px;
            color: #ffffff;
            margin: 0;
        }

        .sec-home-card p {
            font-size: 13px;
            line-height: 1.65;
            color: rgba(255,255,255,0.46);
            margin: 0;
        }

        .sec-home-proof {
            text-align: center;
            padding: 24px 28px;
            border-radius: 12px;
            border: 1px solid rgba(74,222,128,0.12);
            background: rgba(74,222,128,0.04);
            margin-bottom: 28px;
        }

        .sec-home-proof-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.65);
            margin-bottom: 10px;
        }

        .sec-home-proof p {
            max-width: 620px;
            margin: 0 auto;
            font-size: 14px;
            line-height: 1.7;
            color: rgba(255,255,255,0.52);
        }

        .sec-home-cta {
            text-align: center;
        }

        @media (max-width: 640px) {
            .sec-home {
                padding: 60px 20px;
            }

            .sec-home-grid {
                grid-template-columns: 1fr;
            }
        } 
</style>
{{end}}
