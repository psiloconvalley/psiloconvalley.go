{{define "profile-preview"}}
        <!-- ═══════════ RIGHT: BUSINESS CARD PREVIEW ═══════════ -->
        <div class="preview-rail">
            <div class="preview-label">{{.T.ProfilePreviewLabel}}</div>
            <div class="biz-preview">
                <div class="biz-preview-inner">
                    <div class="biz-preview-logo-area">
                        {{if .Profile}}{{if .Profile.LogoURL}}
                        <img id="preview-logo" class="biz-preview-logo" src="{{.Profile.LogoURL}}" alt="Logo">
                        {{else}}
                        <div id="preview-logo-placeholder" class="biz-preview-logo-placeholder">LOGO</div>
                        {{end}}{{else}}
                        <div id="preview-logo-placeholder" class="biz-preview-logo-placeholder">LOGO</div>
                        {{end}}
                    </div>
                    <div id="preview-name" class="biz-preview-name">
                        {{if .Profile}}{{if .Profile.Name}}{{.Profile.Name}}{{else}}{{.T.ProfilePreviewCompany}}{{end}}{{else}}{{.T.ProfilePreviewCompany}}{{end}}
                    </div>
                    <div id="preview-location" class="biz-preview-location">
                        {{if .Profile}}{{if .Profile.City}}📍 {{.Profile.City}}{{if .Profile.State}}, {{.Profile.State}}{{end}}{{end}}{{end}}
                    </div>
                    <div class="biz-preview-contacts">
                        <div id="preview-phone" class="biz-preview-contact"
                             {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.Phone}}style="display:none"{{end}}{{end}}>
                            📞 <span>{{if .Profile}}{{.Profile.Phone}}{{end}}</span>
                        </div>
                        <div id="preview-email" class="biz-preview-contact"
                             {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.Email}}style="display:none"{{end}}{{end}}>
                            📧 <span>{{if .Profile}}{{.Profile.Email}}{{end}}</span>
                        </div>
                        <div id="preview-zelle" class="biz-preview-contact"
                             {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.ZelleID}}style="display:none"{{end}}{{end}}>
                            💸 <span>{{.T.PubProfileZelle}} {{if .Profile}}{{.Profile.ZelleID}}{{end}}</span>
                        </div>
                        <div id="preview-venmo" class="biz-preview-contact"
                             {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.VenmoHandle}}style="display:none"{{end}}{{end}}>
                            💜 <span>{{.T.PubProfileVenmo}} {{if .Profile}}{{.Profile.VenmoHandle}}{{end}}</span>
                        </div>
                        <div id="preview-cashapp" class="biz-preview-contact"
                             {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.CashAppHandle}}style="display:none"{{end}}{{end}}>
                            💚 <span>{{.T.PubProfileCashApp}} {{if .Profile}}{{.Profile.CashAppHandle}}{{end}}</span>
                        </div>
                    </div>
                    <div id="preview-service-areas" class="biz-preview-service-areas"
                         {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.ServiceAreas}}style="display:none"{{end}}{{end}}>
                        🗺️ {{.T.PubProfileServing}} <span>{{if .Profile}}{{.Profile.ServiceAreas}}{{end}}</span>
                    </div>
                    {{if .Profile}}{{if .Profile.Slug}}
                    <div class="biz-preview-url">psiloconvalley.com/biz/{{.Profile.Slug}}</div>
                    {{end}}{{end}}
                </div>
            </div>
            <div class="preview-hint">{{.T.ProfilePreviewHint}}</div>
        </div>

<!-- ═══════════ MOBILE: FLOATING PREVIEW BUTTON + SHEET ═══════════ -->
<button class="mobile-preview-btn" onclick="openPreviewSheet()">
    {{.T.ProfilePreviewMobile}}
</button>

<div class="preview-overlay" id="previewOverlay" onclick="closePreviewSheet()"></div>
<div class="preview-sheet" id="previewSheet">
    <div class="preview-sheet-handle"></div>
    <button class="preview-sheet-close" onclick="closePreviewSheet()">✕</button>
    <div class="preview-label" style="margin-bottom:16px;">{{.T.ProfilePreviewLabel}}</div>
    <div class="biz-preview">
        <div class="biz-preview-inner">
            <div class="biz-preview-logo-area">
                {{if .Profile}}{{if .Profile.LogoURL}}
                <img id="preview-logo-mobile" class="biz-preview-logo" src="{{.Profile.LogoURL}}" alt="Logo">
                {{else}}
                <div id="preview-logo-placeholder-mobile" class="biz-preview-logo-placeholder">LOGO</div>
                {{end}}{{else}}
                <div id="preview-logo-placeholder-mobile" class="biz-preview-logo-placeholder">LOGO</div>
                {{end}}
            </div>
            <div id="preview-name-mobile" class="biz-preview-name">
                {{if .Profile}}{{if .Profile.Name}}{{.Profile.Name}}{{else}}{{.T.ProfilePreviewCompany}}{{end}}{{else}}{{.T.ProfilePreviewCompany}}{{end}}
            </div>
            <div id="preview-location-mobile" class="biz-preview-location">
                {{if .Profile}}{{if .Profile.City}}📍 {{.Profile.City}}{{if .Profile.State}}, {{.Profile.State}}{{end}}{{end}}{{end}}
            </div>
            <div class="biz-preview-contacts">
                <div id="preview-phone-mobile" class="biz-preview-contact"
                     {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.Phone}}style="display:none"{{end}}{{end}}>
                    📞 <span>{{if .Profile}}{{.Profile.Phone}}{{end}}</span>
                </div>
                <div id="preview-email-mobile" class="biz-preview-contact"
                     {{if not .Profile}}style="display:none"{{else}}{{if not .Profile.Email}}style="display:none"{{end}}{{end}}>
                    📧 <span>{{if .Profile}}{{.Profile.Email}}{{end}}</span>
                </div>
            </div>
            {{if .Profile}}{{if .Profile.Slug}}
            <div class="biz-preview-url">psiloconvalley.com/biz/{{.Profile.Slug}}</div>
            {{end}}{{end}}
        </div>
    </div>
</div>
{{end}}
