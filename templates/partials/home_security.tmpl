                    </div>
                    <p>{{.T.HomeSecCard1Desc}}</p>
                </div>
                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">💳</div>
                        <h4>{{.T.HomeSecCard2Title}}</h4>
                    </div>
                    <p>{{.T.HomeSecCard2Desc}}</p>
                </div>
                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🚫</div>
                        <h4>{{.T.HomeSecCard3Title}}</h4>
                    </div>
                    <p>{{.T.HomeSecCard3Desc}}</p>
                </div>
                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">⏱️</div>
