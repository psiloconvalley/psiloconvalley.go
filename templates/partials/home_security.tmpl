                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🔒</div>
                        <h4>{{.T.HomeSecCard6Title}}</h4>
                    </div>
                    <p>{{.T.HomeSecCard6Desc}}</p>
                </div>
            </div>

            <div class="sec-home-proof">
                <div class="sec-home-proof-label">{{.T.HomeSecProofLabel}}</div>
                <p>{{.T.HomeSecProofDesc}}</p>
            </div>

            <div class="sec-home-cta">
                <a href="/security" class="btn-secondary">{{.T.HomeSecCTA}}</a>
            </div>

        </div>
