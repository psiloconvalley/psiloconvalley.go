{{define "home-security"}}
    <!-- SECURITY SECTION -->
    <section class="sec-home">
        <div class="sec-home-inner">

            <div class="sec-home-header">
                <div class="sec-home-eyebrow">Security</div>
                <h2 class="sec-home-title">Your business data stays yours.<br><em>Full stop.</em></h2>
                <p class="sec-home-sub">
                    Your invoices contain real information — client names, amounts, job details.
                    We built this to protect it.
                </p>
            </div>

            <div class="sec-home-grid">
                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🔐</div>
                        <h4>Your password is uncrackable</h4>
                    </div>
                    <p>
                        We use the strongest password protection available.
                        Even we cannot see your password. Nobody can.
                    </p>
                </div>

                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">💳</div>
                        <h4>We never touch your card</h4>
                    </div>
                    <p>
                        Payments go through Stripe directly.
                        We never see or store card numbers. Ever.
                    </p>
                </div>

                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🚫</div>
                        <h4>No trackers. No exceptions.</h4>
                    </div>
                    <p>
                        No Google Analytics. No Facebook Pixel. No ad networks.
                        Your data belongs to you — not advertisers.
                    </p>
                </div>

                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">⏱️</div>
                        <h4>Locks out attackers automatically</h4>
                    </div>
                    <p>
                        Too many failed login attempts?
                        The account locks. Hackers get nowhere.
                    </p>
                </div>

                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🔑</div>
                        <h4>Login with your face</h4>
                    </div>
                    <p>
                        Face ID and Touch ID supported.
                        Faster than a password and impossible to steal.
                    </p>
                </div>

                <div class="sec-home-card">
                    <div class="sec-home-card-top">
                        <div class="sec-home-icon">🔒</div>
                        <h4>Client links are private</h4>
                    </div>
                    <p>
                        Every shared invoice or quote uses a unique private link.
                        Only the person you sent it to can open it.
                    </p>
                </div>
            </div>

            <div class="sec-home-proof">
                <div class="sec-home-proof-label">What protects every account</div>
                <p>
                    Uncrackable passwords, automatic lockout, private client links,
                    Stripe payments, Face ID login, and zero third-party trackers.
                </p>
            </div>

            <div class="sec-home-cta">
                <a href="/security" class="btn-secondary">Read our full security overview →</a>
            </div>

        </div>
    </section>
{{end}}
