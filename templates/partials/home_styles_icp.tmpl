{{define "home-styles-icp"}}
<style>
        /* ═══════════════════════════════════════════════════════════════
           ICP STRIP — who it's for
           ═══════════════════════════════════════════════════════════════ */
        .icp-strip {
            padding: 40px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .icp-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }

        .icp-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 40px;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.6);
            letter-spacing: -0.2px;
            transition: all 0.2s;
        }

        .icp-item:hover {
            border-color: rgba(74,222,128,0.3);
            color: rgba(255,255,255,0.9);
            background: rgba(74,222,128,0.05);
        }

        .icp-icon {
            font-size: 16px;
        } 
</style>
{{end}}
