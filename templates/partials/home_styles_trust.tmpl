{{define "home-styles-trust"}}
<style>
        /* ═══════════════════════════════════════════════════════════════
           TRUST BAR
           ═══════════════════════════════════════════════════════════════ */
        .trust-bar {
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 36px 24px;
            background: rgba(12,18,32,0.6);
            margin-top: 64px;
        }

        .trust-inner {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 48px;
            text-align: center;
        }

        .trust-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .trust-value {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .trust-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
        }

</style>
{{end}}
