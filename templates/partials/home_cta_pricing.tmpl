{{define "home-cta-pricing"}}
    <!-- FINAL CTA -->
    <section class="final-cta">
        <h2>{{.T.HomeCtaTitle}}</h2>
        <p>{{.T.HomeCtaSub}}</p>
        <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
            <a href="/register" class="btn-primary">{{.T.HomeCtaStart}}</a>
            <a href="/pricing" class="btn-secondary">{{.T.HomeCtaPricing}}</a>
        </div>
    </section>

    <!-- PRICING CTA -->
    <section class="pricing-cta">
        <div class="section-label">{{.T.HomePricingLabel}}</div>
        <h2>{{.T.HomePricingTitle}}</h2>
        <p class="pricing-sub">{{.T.HomePricingSub}}</p>

        <div class="pricing-grid">
            <div class="plan-card">
                <div class="plan-label">{{.T.HomePlanFreeLabel}}</div>
                <div class="plan-price">{{.T.HomePlanFreePrice}}</div>
                <div class="plan-unit">{{.T.HomePlanFreeUnit}}</div>
                <ul class="plan-features">
                    <li>{{.T.HomePlanFreeF1}}</li>
                    <li>{{.T.HomePlanFreeF2}}</li>
                    <li>{{.T.HomePlanFreeF3}}</li>
                    <li>{{.T.HomePlanFreeF4}}</li>
                    <li>{{.T.HomePlanFreeF5}}</li>
                </ul>
            </div>
            <div class="plan-card growth">
                <div class="plan-label">{{.T.HomePlanProLabel}}</div>
                <div class="plan-price">$18.88</div>
                <div class="plan-unit">{{.T.HomePlanProUnit}}</div>
                <ul class="plan-features">
                    <li>{{.T.HomePlanProF1}}</li>
                    <li>{{.T.HomePlanProF2}}</li>
                    <li>{{.T.HomePlanProF3}}</li>
                    <li>{{.T.HomePlanProF4}}</li>
                    <li>{{.T.HomePlanProF5}}</li>
                </ul>
            </div>
            <div class="plan-card pro">
                <div class="plan-label">Pro Max</div>
                <div class="plan-price">$28.88</div>
                <div class="plan-unit">{{.T.HomePlanProUnit}}</div>
                <ul class="plan-features">
                    <li>{{.T.HomePlanProF1}}</li>
                    <li>{{.T.PricingProMaxRecurring}}</li>
                    <li>{{.T.PricingProMaxReminders}}</li>
                    <li>{{.T.PricingProMaxTemplates}}</li>
                    <li>{{.T.PricingProMaxSupport}}</li>
                </ul>
            </div>
        </div>

        <a href="/pricing" class="btn-primary">{{.T.HomePricingViewAll}}</a>
    </section>
{{end}}
