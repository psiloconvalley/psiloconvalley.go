{{define "home-cta-pricing"}}
    <!-- FINAL CTA -->
    <section class="final-cta">
        <h2>Ready to get paid?</h2>
        <p>Send your first invoice or quote — free, in under a minute.</p>
        <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
            <a href="/register" class="btn-primary">
                Start Free →
            </a>
            <a href="/pricing" class="btn-secondary">
                See Pricing
            </a>
        </div>
    </section>

    <!-- PRICING CTA -->
    <section class="pricing-cta">
        <div class="section-label">Simple Pricing</div>
        <h2>Free to start. Upgrade when you're ready.</h2>
        <p class="pricing-sub">
            No trial. No credit card. Start free, then upgrade when you need more.
        </p>

        <div class="pricing-grid">
            <div class="plan-card">
                <div class="plan-label">Free</div>
                <div class="plan-price">$0</div>
                <div class="plan-unit">forever</div>
                <ul class="plan-features">
                    <li>5 invoices / month</li>
                    <li>3 estimates / month</li>
                    <li>5 saved clients</li>
                    <li>3 email sends / month</li>
                    <li>PDF download</li>
                </ul>
            </div>
            <div class="plan-card growth">
                <div class="plan-label">Growth</div>
                <div class="plan-price">$8.88</div>
                <div class="plan-unit">/ month — founding rate</div>
                <ul class="plan-features">
                    <li>15 invoices / month</li>
                    <li>15 estimates / month</li>
                    <li>15 clients</li>
                    <li>Stripe card payments</li>
                    <li>Expense tracking</li>
                </ul>
            </div>
            <div class="plan-card pro">
                <div class="plan-label">Pro</div>
                <div class="plan-price">$18.88</div>
                <div class="plan-unit">/ month</div>
                <ul class="plan-features">
                    <li>Unlimited everything</li>
                    <li>Recurring automation</li>
                    <li>Auto payment reminders</li>
                    <li>Advanced templates</li>
                    <li>Priority support</li>
                </ul>
            </div>
        </div>

        <a href="/pricing" class="btn-primary">
            View Full Pricing →
        </a>
    </section>
{{end}}
