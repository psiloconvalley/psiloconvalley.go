{{define "home-cta-pricing"}}
       <!-- FINAL CTA -->
    <section class="final-cta">
        <h2>Ready to get paid?</h2>
        <p>From estimate to invoice to payment — start free, upgrade when you're ready.</p>
        <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
            <a href="/estimates/new" class="btn-primary">
                Create Estimate →
            </a>
            <a href="/invoices/new" class="btn-secondary">
                Create Invoice →
            </a>
        </div>
    </section>
        <!-- PRICING CTA -->
      <section class="pricing-cta">
        <div class="section-label">Simple Pricing</div>
        <h2>Free to start. Upgrade when you're ready.</h2>
        <p class="pricing-sub">
            No trial. No credit card. Use the free tier as long as you want.
        </p>

        <div class="pricing-grid">
            <div class="plan-card">
                <div class="plan-label">Free</div>
                <div class="plan-price">$0</div>
                <div class="plan-unit">forever</div>
                <ul class="plan-features">
                    <li>10 invoices / month</li>
                    <li>5 estimates / month</li>
                    <li>5 saved clients</li>
                    <li>PDF export</li>
                    <li>3 invoice templates</li>
                </ul>
            </div>
            <div class="plan-card growth">
                <div class="plan-label">Growth</div>
                <div class="plan-price">$8.88</div>
                <div class="plan-unit">/ month</div>
                <ul class="plan-features">
                    <li>Unlimited invoices &amp; estimates</li>
                    <li>Unlimited clients</li>
                    <li>Client scorecard</li>
                    <li>Reports &amp; CSV export</li>
                    <li>Remove PsiloConValley branding</li>
                </ul>
            </div>
            <div class="plan-card pro">
                <div class="plan-label">Pro</div>
                <div class="plan-price">$18.88</div>
                <div class="plan-unit">/ month</div>
                <ul class="plan-features">
                    <li>Everything in Growth</li>
                    <li>Recurring invoice automation</li>
                    <li>Auto payment reminders</li>
                    <li>Client payment portal</li>
                    <li>Professional email delivery</li>
                </ul>
            </div>
        </div>

        <a href="/pricing" class="btn-primary">
            View Full Pricing →
        </a>
    </section> 
{{end}}
