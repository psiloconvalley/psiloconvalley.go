{{define "expenses-list-styles"}}
<style>
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            font-family: monospace;
            margin-top: 4px;
        }

        .btn-new {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            color: #0a0f1a;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }
        .btn-new:hover { opacity: 0.85; }

        .success-banner {
            background: rgba(16,185,129,0.1);
            border: 1px solid rgba(16,185,129,0.3);
            color: #6ee7b7;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 24px;
        }

        /* ── Stats ── */
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 20px 24px;
        }
        .stat-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 6px;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        /* ── Table ── */
        .expense-table {
            width: 100%;
            border-collapse: collapse;
        }
        .expense-table th {
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .expense-table td {
            padding: 14px 16px;
            font-size: 14px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            vertical-align: middle;
        }
        .expense-table tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        .expense-amount {
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: #fca5a5;
        }

        .expense-category {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            background: rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.7);
        }

        .expense-vendor {
            color: rgba(255,255,255,0.6);
        }

        .expense-date {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            font-variant-numeric: tabular-nums;
        }

        .expense-receipt {
            font-size: 12px;
        }
        .expense-receipt a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        .expense-receipt a:hover {
            color: #fff;
        }

        .expense-actions a {
            color: rgba(255,255,255,0.4);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }
        .expense-actions a:hover { color: #fff; }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-state h3 {
            font-size: 20px;
            font-weight: 700;
            color: rgba(255,255,255,0.5);
            margin-bottom: 8px;
        }
        .empty-state p {
            font-size: 14px;
            margin-bottom: 24px;
        }

        /* ── Mobile ── */
        .mobile-cards { display: none; }

        @media (max-width: 768px) {
            .stats-row { grid-template-columns: 1fr; }
            .expense-table { display: none; }
            .mobile-cards { display: block; }
            .mobile-card {
                background: rgba(255,255,255,0.03);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 12px;
                padding: 16px 20px;
                margin-bottom: 12px;
            }
            .mobile-card-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
            }
            .mobile-card-vendor {
                font-weight: 700;
                font-size: 15px;
            }
            .mobile-card-amount {
                font-weight: 800;
                color: #fca5a5;
                font-variant-numeric: tabular-nums;
            }
            .mobile-card-meta {
                font-size: 12px;
                color: rgba(255,255,255,0.4);
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
            }
            .mobile-card-actions {
                margin-top: 10px;
                display: flex;
                gap: 16px;
            }
            .mobile-card-actions a {
                font-size: 12px;
                color: rgba(255,255,255,0.5);
                text-decoration: none;
                font-weight: 600;
            }
        }
</style>
{{end}}
