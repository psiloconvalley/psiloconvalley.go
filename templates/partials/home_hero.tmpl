{{define "home-hero"}}
    <!-- HERO -->
    <section class="hero">

        <div class="hero-eyebrow">
            <span>Invoices</span>
            <span>·</span>
            <span>Estimates</span>
            <span>·</span>
            <span>Payments</span>
            <span>·</span>
            <span>Peace of Mind</span>
        </div>

        <h1>
            Get paid faster.<br>
            <em>Look professional<br>doing it.</em>
        </h1>

        <p class="hero-sub">
            Built for contractors, medical offices, attorneys,
            landscapers, IT consultants — and every professional
            who does great work and deserves to get paid for it.
        </p>

        <div class="hero-cta">
            <a href="/register" class="btn-primary">
                Start Free Today →
            </a>
            <a href="/invoices/new" class="btn-secondary">
                Create Invoice
            </a>
        </div>

        <p class="hero-note">
            <strong>Free to start</strong> — 10 invoices/month, 5 estimates, PDF downloads.
            Growth &amp; Pro unlock unlimited invoices, branding removal, and recurring billing.
        </p>
    </section>

    <!-- TRUST BAR -->
    <div class="trust-bar">
        <div class="trust-inner">
            <div class="trust-item">
                <div class="trust-value">30s</div>
                <div class="trust-label">To create</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">$0</div>
                <div class="trust-label">To start</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">PDF</div>
                <div class="trust-label">Instant download</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">Zero</div>
                <div class="trust-label">Trackers</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">Stripe</div>
                <div class="trust-label">Payments</div>
            </div>
        </div>
    </div>

    <!-- ICP STRIP -->
    <div class="icp-strip">
        <div class="icp-inner">
            <div class="icp-item">
                <span class="icp-icon">🔨</span>
                <span>Contractors</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🏥</span>
                <span>Medical Offices</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">⚖️</span>
                <span>Attorneys</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🌿</span>
                <span>Landscapers</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">💻</span>
                <span>IT Consultants</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">📸</span>
                <span>Photographers</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🧠</span>
                <span>Therapists</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🏗️</span>
                <span>Architects</span>
            </div>
        </div>
    </div>
{{end}}
