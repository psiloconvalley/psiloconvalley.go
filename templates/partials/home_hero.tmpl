{{define "home-hero"}}
    <!-- HERO -->
    <section class="hero">
        <div class="hero-badge">✦ Invoices · Estimates · Payments · Peace of Mind</div>

        <h1><span>Get paid faster.</span><br>Look professional doing it.</h1>

        <p class="hero-sub">
            Send invoices and estimates in minutes.
            Built for contractors, medical offices, attorneys, landscapers,
            IT consultants, and every professional who does great work
            and deserves to get paid for it.
        </p>

        <div class="hero-cta">
            <a href="/register" class="btn-primary">
                Start Free Today →
            </a>
            <a href="/invoices/new" class="btn-secondary">
                Create Invoice
            </a>
        </div>

        <p class="hero-note">
            <strong>Free to start:</strong> 10 invoices/month, 5 estimates, PDF downloads.
            <span>Growth &amp; Pro unlock unlimited invoices, branding removal, recurring billing, and more.</span>
        </p>
    </section>

    <!-- TRUST BAR -->
    <div class="trust-bar reveal">
        <div class="trust-inner reveal-stagger">
            <div class="trust-item">
                <div class="trust-value">30s</div>
                <div class="trust-label">To create</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">$0</div>
                <div class="trust-label">To start</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">PDF</div>
                <div class="trust-label">Download</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">Zero</div>
                <div class="trust-label">Tracking</div>
            </div>
        </div>
    </div>
{{end}}
