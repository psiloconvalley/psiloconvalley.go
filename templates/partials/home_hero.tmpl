{{define "home-hero"}}
    <!-- HERO -->
    <section class="hero">

        <div class="hero-eyebrow">
            <span>Quotes</span>
            <span>·</span>
            <span>Invoices</span>
            <span>·</span>
            <span>Payments</span>
            <span>·</span>
            <span>Get Paid</span>
        </div>

        <h1>
            You did the work.<br>
            <em>Now get paid for it.</em>
        </h1>

        <p class="hero-sub">
            Send a professional invoice or quote in minutes.
            Your client pays by card — money goes straight to you.
            Built for independent businesses that run on reputation.
        </p>

        <div class="hero-cta">
            <a href="/register" class="btn-primary">
                Start Free →
            </a>
            <a href="#how-it-works" class="btn-secondary">
                See how it works ↓
            </a>
        </div>

        <p class="hero-note">
            <strong>Free to start.</strong> No credit card required.
        </p>

    </section>

    <!-- TRUST BAR -->
    <div class="trust-bar">
        <div class="trust-inner">
            <div class="trust-item">
                <div class="trust-value">60s</div>
                <div class="trust-label">To send</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">$0</div>
                <div class="trust-label">To start</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">PDF</div>
                <div class="trust-label">Instant download</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">No</div>
                <div class="trust-label">Trackers</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">Stripe</div>
                <div class="trust-label">Card payments</div>
            </div>
        </div>
    </div>

    <!-- ICP STRIP -->
    <div class="icp-strip">
        <div class="icp-inner">
            <div class="icp-item">
                <span class="icp-icon">🔨</span>
                <span>Contractors</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🏊</span>
                <span>Pool Services</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🌿</span>
                <span>Landscapers</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🖌️</span>
                <span>Painters</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">⚡</span>
                <span>Electricians</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🔧</span>
                <span>Handymen</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">📸</span>
                <span>Photographers</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">💻</span>
                <span>Freelancers</span>
            </div>
        </div>
    </div>
{{end}}
