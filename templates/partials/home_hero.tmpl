{{define "home-hero"}}
    <!-- HERO -->
    <section class="hero">

        <div class="hero-eyebrow">
            <span>{{.T.HomeEyebrowQuotes}}</span>
            <span>·</span>
            <span>{{.T.HomeEyebrowInvoices}}</span>
            <span>·</span>
            <span>{{.T.HomeEyebrowPayments}}</span>
            <span>·</span>
            <span>{{.T.HomeEyebrowGetPaid}}</span>
        </div>

        <h1>
            {{.T.HomeHeroLine1}}<br>
            <em>{{.T.HomeHeroLine2}}</em>
        </h1>

        <p class="hero-sub">
            {{.T.HomeHeroSub}}
        </p>

        <div class="hero-cta">
            <a href="/register" class="btn-primary">
                {{.T.HomeHeroCTA}}
            </a>
            <a href="#how-it-works" class="btn-secondary">
                {{.T.HomeHeroSecondaryCTA}}
            </a>
        </div>

        <p class="hero-note">
            <strong>{{.T.HomeHeroNoteBold}}</strong> {{.T.HomeHeroNote}}
        </p>

    </section>

    <!-- TRUST BAR -->
    <div class="trust-bar">
        <div class="trust-inner" id="trust-bar">
            <div class="trust-item">
                <div class="trust-value">{{.T.HomeTrustSend}}</div>
                <div class="trust-label">{{.T.HomeTrustSendLabel}}</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">{{.T.HomeTrustStart}}</div>
                <div class="trust-label">{{.T.HomeTrustStartLabel}}</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">{{.T.HomeTrustPDF}}</div>
                <div class="trust-label">{{.T.HomeTrustPDFLabel}}</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">{{.T.HomeTrustTrackers}}</div>
                <div class="trust-label">{{.T.HomeTrustTrackLabel}}</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">{{.T.HomeTrustStripe}}</div>
                <div class="trust-label">{{.T.HomeTrustStripeLabel}}</div>
            </div>
        </div>
    </div>

    <!-- SOCIAL PROOF -->
    <div class="social-proof">
        <div class="social-proof-inner">
            <div class="social-proof-quote">
                "I used to carry a box of paper invoices in my truck. Now I just show my phone."
            </div>
            <div class="social-proof-author">
                — Salvador S., Pool Services, San Jose
            </div>
        </div>
    </div>

    <!-- ICP STRIP -->
    <div class="icp-strip">
        <div class="icp-inner">
            <div class="icp-item">
                <span class="icp-icon">🔨</span>
                <span>{{.T.HomeICPContractors}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🏊</span>
                <span>{{.T.HomeICPPool}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🌿</span>
                <span>{{.T.HomeICPLandscapers}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🖌️</span>
                <span>{{.T.HomeICPPainters}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">⚡</span>
                <span>{{.T.HomeICPElectricians}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">🔧</span>
                <span>{{.T.HomeICPHandymen}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">📸</span>
                <span>{{.T.HomeICPPhotographers}}</span>
            </div>
            <div class="icp-item">
                <span class="icp-icon">💻</span>
                <span>{{.T.HomeICPFreelancers}}</span>
            </div>
        </div>
    </div>
{{end}}
