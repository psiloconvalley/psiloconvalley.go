{{define "clients-list-styles"}}
<style>
    :root {
        --cl-surface: rgba(255,255,255,0.02);
        --cl-surface-hover: rgba(255,255,255,0.04);
        --cl-border: rgba(255,255,255,0.08);
        --cl-border-hover: rgba(255,255,255,0.14);
        --cl-text: #ffffff;
        --cl-text-secondary: rgba(255,255,255,0.6);
        --cl-text-muted: rgba(255,255,255,0.4);
        --cl-text-faint: rgba(255,255,255,0.3);
        --cl-green: #4ade80;
        --cl-green-strong: #16a34a;
        --cl-green-text: #052e16;
        --cl-green-surface: rgba(16,185,129,0.1);
        --cl-green-border: rgba(16,185,129,0.2);
        --cl-green-text-color: #6ee7b7;
        --cl-amber-surface: rgba(234,179,8,0.1);
        --cl-amber-border: rgba(234,179,8,0.2);
        --cl-amber-text: #fde68a;
        --cl-amber-strong: #fbbf24;
        --cl-red: #ef4444;
        --cl-radius: 12px;
        --cl-radius-sm: 8px;
        --cl-radius-xs: 6px;
        --cl-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --cl-dur: 0.2s;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 60px 20px 80px;
    }

    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        border-left: 2px solid rgba(255,255,255,0.15);
        padding-left: 24px;
    }

    .top h1 {
        font-size: 32px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -1px;
        color: var(--cl-text);
    }

    .top-subtitle {
        color: var(--cl-text-muted);
        font-size: 13px;
        margin-top: 6px;
        font-family: monospace;
    }

    .top-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ── Primary action button ── */
    .cl-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 11px 22px;
        border: none;
        border-radius: var(--cl-radius-sm);
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        background: linear-gradient(135deg, var(--cl-green) 0%, var(--cl-green-strong) 100%);
        color: var(--cl-green-text);
        box-shadow: 0 0 20px rgba(74,222,128,0.15), 0 4px 12px rgba(0,0,0,0.3);
        transition:
            transform var(--cl-dur) var(--cl-ease),
            box-shadow var(--cl-dur) var(--cl-ease);
    }

    .cl-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 28px rgba(74,222,128,0.25), 0 6px 16px rgba(0,0,0,0.4);
    }

    .cl-btn:active {
        transform: translateY(0) scale(0.98);
    }

    .cl-btn:focus-visible {
        outline: 2px solid rgba(74,222,128,0.55);
        outline-offset: 3px;
    }

    /* ── Secondary action button ── */
    .cl-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 11px 18px;
        border: 1px solid var(--cl-border);
        border-radius: var(--cl-radius-sm);
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        background: var(--cl-surface);
        color: var(--cl-text-secondary);
        transition:
            background var(--cl-dur) ease,
            border-color var(--cl-dur) ease,
            color var(--cl-dur) ease;
    }

    .cl-btn-secondary:hover {
        background: var(--cl-surface-hover);
        border-color: var(--cl-border-hover);
        color: var(--cl-text);
    }

    .cl-btn-secondary:focus-visible {
        outline: 2px solid rgba(255,255,255,0.3);
        outline-offset: 3px;
    }

    /* ── Disabled button ── */
    .cl-btn-disabled {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 11px 22px;
        border: 1px solid var(--cl-border);
        border-radius: var(--cl-radius-sm);
        font-size: 14px;
        font-weight: 700;
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
        cursor: not-allowed;
        white-space: nowrap;
    }

    /* ── Banners ── */
    .success-banner {
        background: var(--cl-green-surface);
        border: 1px solid var(--cl-green-border);
        color: var(--cl-green-text-color);
        padding: 14px 20px;
        border-radius: var(--cl-radius-sm);
        font-size: 14px;
        margin-bottom: 32px;
        line-height: 1.5;
    }

    .limit-banner {
        background: var(--cl-amber-surface);
        border: 1px solid var(--cl-amber-border);
        color: var(--cl-amber-text);
        padding: 14px 20px;
        border-radius: var(--cl-radius-sm);
        font-size: 14px;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .limit-banner strong { color: var(--cl-amber-strong); }

    .limit-banner a {
        color: var(--cl-amber-strong);
        font-weight: 700;
        text-decoration: none;
    }

    .limit-banner a:hover { text-decoration: underline; }

    /* ── Table ── */
    .table-wrapper {
        background: var(--cl-surface);
        border: 1px solid var(--cl-border);
        border-radius: var(--cl-radius);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table-wrapper::-webkit-scrollbar { height: 6px; }
    .table-wrapper::-webkit-scrollbar-track { background: rgba(255,255,255,0.03); }
    .table-wrapper::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
    .table-wrapper::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.25); }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 680px;
    }

    th {
        background: rgba(255,255,255,0.03);
        color: var(--cl-text-muted);
        text-align: left;
        padding: 14px 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        white-space: nowrap;
    }

    td {
        padding: 18px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        vertical-align: middle;
        font-size: 15px;
        color: var(--cl-text-secondary);
    }

    tr:last-child td { border-bottom: none; }

    tr:hover td { background: rgba(255,255,255,0.02); }

    .client-name {
        font-weight: 600;
        color: var(--cl-text);
        margin-bottom: 3px;
    }

    .client-email {
        font-size: 13px;
        color: var(--cl-text-muted);
        font-family: monospace;
    }

    .client-location {
        color: var(--cl-text-secondary);
        font-size: 14px;
    }

    .client-country {
        color: var(--cl-text-faint);
        font-size: 12px;
        margin-top: 2px;
    }

    .client-phone {
        color: var(--cl-text-secondary);
        font-size: 14px;
        font-family: monospace;
    }

    .actions-cell {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        flex-wrap: nowrap;
    }

    .small-btn {
        display: inline-flex;
        align-items: center;
        background: none;
        color: var(--cl-text-secondary);
        border: 1px solid var(--cl-border);
        padding: 7px 13px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        border-radius: var(--cl-radius-xs);
        cursor: pointer;
        font-family: inherit;
        white-space: nowrap;
        transition:
            border-color var(--cl-dur) ease,
            color var(--cl-dur) ease,
            background var(--cl-dur) ease;
    }

    .small-btn:hover {
        border-color: var(--cl-border-hover);
        color: var(--cl-text);
        background: rgba(255,255,255,0.03);
    }

    .small-btn:focus-visible {
        outline: 2px solid rgba(255,255,255,0.3);
        outline-offset: 2px;
    }

    .small-btn.danger:hover {
        border-color: var(--cl-red);
        color: var(--cl-red);
        background: rgba(239,68,68,0.06);
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 100px 20px;
        background: var(--cl-surface);
        border: 1px dashed var(--cl-border);
        border-radius: var(--cl-radius);
    }

    .empty-icon {
        font-size: 32px;
        margin-bottom: 20px;
        opacity: 0.35;
    }

    .empty-state h2 {
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--cl-text-muted);
        margin-bottom: 12px;
    }

    .empty-state p {
        color: var(--cl-text-muted);
        margin-bottom: 32px;
        font-size: 14px;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    /* ── Plan badge ── */
    .plan-badge {
        display: inline-block;
        font-size: 10px;
        font-family: monospace;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(255,255,255,0.06);
        color: var(--cl-text-muted);
    }

    .plan-badge.pro {
        background: var(--cl-green-surface);
        color: var(--cl-green-text-color);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .container { padding: 40px 16px 60px; }

        .top {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
            padding-left: 16px;
        }

        .top h1 { font-size: 24px; }

        .top-right {
            width: 100%;
            flex-wrap: wrap;
        }

        .cl-btn,
        .cl-btn-secondary,
        .cl-btn-disabled {
            flex: 1;
            justify-content: center;
        }

        .table-wrapper::after {
            content: '← Swipe →';
            display: block;
            text-align: center;
            font-size: 11px;
            color: var(--cl-text-faint);
            padding: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
    }
</style>
{{end}}
