{{define "public-profile-actions"}}
<style>
    .pp-section {
        background: var(--pp-surface-section);
        border: 1px solid var(--pp-border-default);
        border-radius: var(--pp-radius-lg);
        padding: 20px;
        margin-bottom: 12px;
        backdrop-filter: blur(var(--pp-blur-lg));
        -webkit-backdrop-filter: blur(var(--pp-blur-lg));
        transition: all var(--pp-dur) ease;
        cursor: pointer;
    }

    .pp-section:hover {
        background: var(--pp-surface-section-hover);
        border-color: var(--pp-border-green-soft);
        box-shadow: var(--pp-shadow-section-hover);
    }

    .pp-section[open] {
        background: var(--pp-surface-section-open);
        border-color: var(--pp-border-green);
        box-shadow: var(--pp-shadow-section-open);
    }

    .pp-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--pp-text);
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        list-style: none;
    }

    .pp-section-title::-webkit-details-marker {
        display: none;
    }

    .pp-section-chevron {
        margin-left: auto;
        font-size: 18px;
        color: var(--pp-text-faint);
        transition:
            transform var(--pp-dur) var(--pp-ease),
            color var(--pp-dur);
        display: inline-block;
    }

    .pp-section[open] .pp-section-chevron {
        transform: rotate(90deg);
        color: var(--pp-green);
    }

    .pp-section-content {
        overflow: hidden;
        animation: pp-expand 0.35s var(--pp-ease);
    }

    .pp-field {
        margin-bottom: 12px;
    }

    .pp-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: var(--pp-text-label);
        margin-bottom: 6px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .pp-input,
    .pp-textarea {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid var(--pp-border-input);
        border-radius: var(--pp-radius-md);
        font-size: 15px;
        font-family: inherit;
        background: var(--pp-surface-input);
        color: var(--pp-text);
        outline: none;
        transition: all var(--pp-dur) ease;
    }

    .pp-input:focus,
    .pp-textarea:focus {
        border-color: var(--pp-green-glow-byline);
        background: var(--pp-surface-input-focus);
        box-shadow: 0 0 20px var(--pp-green-glow-focus);
    }

    .pp-input::placeholder,
    .pp-textarea::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .pp-textarea {
        resize: vertical;
        min-height: 80px;
    }

    .pp-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: var(--pp-radius-md);
        font-size: 15px;
        font-weight: 800;
        font-family: inherit;
        cursor: pointer;
        transition: all var(--pp-dur) ease;
        margin-top: 8px;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
    }

    .pp-btn-green {
        background: linear-gradient(135deg, var(--pp-green) 0%, var(--pp-green-strong) 100%);
        color: var(--pp-green-text);
        box-shadow: var(--pp-shadow-button);
    }

    .pp-btn-green:hover {
        transform: translateY(-2px);
        box-shadow: var(--pp-shadow-button-hover);
    }

    .pp-btn-green:active {
        transform: translateY(0) scale(0.98);
        box-shadow: var(--pp-shadow-button-active);
    }

    .pp-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle at var(--x, 50%) var(--y, 50%),
            var(--pp-surface-ripple),
            transparent 60%
        );
        opacity: 0;
        transition: opacity 0.4s;
    }

    .pp-btn:active::after {
        opacity: 1;
    }

    .pp-success {
        background: var(--pp-surface-success);
        border: 1px solid var(--pp-border-green);
        color: var(--pp-green);
        padding: 14px 18px;
        border-radius: var(--pp-radius-md);
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 14px;
        text-align: center;
    }

    .pp-error {
        background: var(--pp-surface-danger);
        border: 1px solid var(--pp-border-danger);
        color: var(--pp-red-text);
        padding: 14px 18px;
        border-radius: var(--pp-radius-md);
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 14px;
        text-align: center;
    }

    @keyframes pp-expand {
        from {
            opacity: 0;
            max-height: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            max-height: 500px;
            transform: translateY(0);
        }
    }
</style>
{{end}}
