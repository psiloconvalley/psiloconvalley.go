{{define "public-profile-actions"}}
<style>
    .pp-section {
        position: relative;
        margin-bottom: 12px;
        background: var(--pp-surface-section);
        border: 1px solid var(--pp-border-default);
        border-radius: var(--pp-radius-lg);
        backdrop-filter: blur(var(--pp-blur-lg));
        -webkit-backdrop-filter: blur(var(--pp-blur-lg));
        transition:
            background var(--pp-dur) ease,
            border-color var(--pp-dur) ease,
            box-shadow var(--pp-dur) ease,
            transform var(--pp-dur-fast) ease;
    }

    .pp-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 20px;
        right: 20px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--pp-border-default), transparent);
        opacity: 0.7;
        transition:
            opacity var(--pp-dur) ease,
            background var(--pp-dur) ease;
    }

    .pp-section:hover {
        background: var(--pp-surface-section-hover);
        border-color: var(--pp-border-green-soft);
        box-shadow: var(--pp-shadow-section-hover);
        transform: translateY(-1px);
    }

    .pp-section[open] {
        background: var(--pp-surface-section-open);
        border-color: var(--pp-border-green);
        box-shadow: var(--pp-shadow-section-open);
    }

    .pp-section[open]::before {
        opacity: 1;
        background: linear-gradient(90deg, transparent, var(--pp-border-green-mid), transparent);
    }

    .pp-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 18px 20px;
        font-size: 16px;
        font-weight: 700;
        color: var(--pp-text);
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        list-style: none;
    }

    .pp-section-title::-webkit-details-marker {
        display: none;
    }

    .pp-section-title:focus-visible {
        outline: 2px solid var(--pp-border-green-mid);
        outline-offset: 4px;
        border-radius: var(--pp-radius-md);
    }

    .pp-section-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--pp-radius-md);
        background: var(--pp-surface-rating);
        border: 1px solid var(--pp-border-rating);
        transition:
            background var(--pp-dur) ease,
            border-color var(--pp-dur) ease,
            box-shadow var(--pp-dur) ease,
            transform var(--pp-dur-fast) ease;
    }

    .pp-section:hover .pp-section-icon,
    .pp-section[open] .pp-section-icon {
        border-color: var(--pp-border-green-mid);
        background: var(--pp-surface-branding-hover);
        box-shadow: 0 0 20px var(--pp-green-glow-soft);
        transform: scale(1.02);
    }

    .pp-section-heading {
        flex: 1 1 auto;
        min-width: 0;
        line-height: 1.2;
    }

    .pp-section-chevron {
        margin-left: auto;
        flex: 0 0 auto;
        font-size: 18px;
        color: var(--pp-text-faint);
        display: inline-block;
        transition:
            transform var(--pp-dur) var(--pp-ease),
            color var(--pp-dur) ease;
    }

    .pp-section[open] .pp-section-chevron {
        transform: rotate(90deg);
        color: var(--pp-green);
    }

    .pp-section-content {
        padding: 0 20px 20px;
    }

    .pp-section[open] .pp-section-content {
        padding-top: 16px;
        border-top: 1px solid var(--pp-border-default);
        animation: pp-expand 0.35s var(--pp-ease);
    }
</style>
{{end}}
