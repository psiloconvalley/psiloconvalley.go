{{define "profile-tokens"}}
<style>
    :root {
        --pr-surface: rgba(255,255,255,0.03);
        --pr-surface-hover: rgba(255,255,255,0.05);
        --pr-border: rgba(255,255,255,0.08);
        --pr-border-hover: rgba(255,255,255,0.15);
        --pr-border-input: rgba(255,255,255,0.15);
        --pr-border-focus: rgba(74,222,128,0.5);
        --pr-text: #ffffff;
        --pr-text-secondary: rgba(255,255,255,0.7);
        --pr-text-label: rgba(255,255,255,0.6);
        --pr-text-muted: rgba(255,255,255,0.4);
        --pr-text-faint: rgba(255,255,255,0.3);
        --pr-text-hint: rgba(255,255,255,0.3);
        --pr-green: #4ade80;
        --pr-green-strong: #16a34a;
        --pr-green-text: #052e16;
        --pr-green-surface: rgba(74,222,128,0.08);
        --pr-green-border: rgba(74,222,128,0.2);
        --pr-green-glow: rgba(74,222,128,0.1);
        --pr-amber: #fbbf24;
        --pr-amber-surface: rgba(245,158,11,0.08);
        --pr-amber-border: rgba(245,158,11,0.2);
        --pr-blue: #a5b4fc;
        --pr-blue-surface: rgba(129,140,248,0.08);
        --pr-blue-border: rgba(129,140,248,0.2);
        --pr-red-surface: rgba(239,68,68,0.08);
        --pr-red-border: rgba(239,68,68,0.2);
        --pr-red-text: #fca5a5;
        --pr-stripe: #635bff;
        --pr-radius: 14px;
        --pr-radius-md: 10px;
        --pr-radius-sm: 8px;
        --pr-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --pr-dur: 0.25s;
        --pr-dur-fast: 0.15s;
    }
</style>
{{end}}
