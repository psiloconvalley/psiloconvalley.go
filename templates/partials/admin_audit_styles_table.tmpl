{{define "admin-audit-styles-table"}}
<style>
    .audit-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .audit-table th {
        text-align: left;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        padding: 10px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .audit-table td {
        padding: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.75);
        vertical-align: top;
    }

    .audit-table tr:hover td {
        background: rgba(255,255,255,0.02);
    }

    .audit-action {
        font-family: 'SF Mono', 'Fira Code', monospace;
        font-size: 12px;
        color: #4ade80;
        white-space: nowrap;
    }

    .audit-action.auth    { color: #60a5fa; }
    .audit-action.payment { color: #fbbf24; }
    .audit-action.failed  { color: #f87171; }

    .audit-entity {
        font-size: 12px;
        color: rgba(255,255,255,0.4);
        font-family: 'SF Mono', 'Fira Code', monospace;
    }

    .audit-ip {
        font-size: 11px;
        color: rgba(255,255,255,0.25);
        font-family: 'SF Mono', 'Fira Code', monospace;
    }

    .audit-time {
        font-size: 11px;
        color: rgba(255,255,255,0.35);
        white-space: nowrap;
    }

    .audit-user {
        font-size: 12px;
        color: rgba(255,255,255,0.5);
    }

    @media (max-width: 768px) {
        .audit-table th:nth-child(4),
        .audit-table td:nth-child(4) { display: none; }
        .audit-table th:nth-child(5),
        .audit-table td:nth-child(5) { display: none; }
    }
</style>
{{end}}
