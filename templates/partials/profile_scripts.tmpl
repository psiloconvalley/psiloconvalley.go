{{define "profile-scripts"}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab switching
    document.querySelectorAll('.preview-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            var target = this.getAttribute('data-tab');
            var parent = this.closest('.preview-rail') || this.closest('.preview-sheet');
            if (!parent) return;
            parent.querySelectorAll('.preview-tab').forEach(function(t) { t.classList.remove('active'); });
            parent.querySelectorAll('.preview-pane').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            var pane = document.getElementById('preview-pane-' + target);
            if (pane) pane.classList.add('active');
        });
    });

    function wire(inputSelector, desktopId, mobileId, opts) {
        var input = document.querySelector(inputSelector);
        if (!input) return;
        input.addEventListener('input', function() {
            var val = this.value.trim();
            var els = [document.getElementById(desktopId)];
            if (mobileId) els.push(document.getElementById(mobileId));
            els.forEach(function(el) {
                if (!el) return;
                if (opts && opts.prefix) {
                    var span = el.querySelector('span');
                    if (span) span.textContent = val;
                    el.style.display = val ? '' : 'none';
                } else if (opts && opts.location) {
                    // handled separately
                } else {
                    el.textContent = val || (opts && opts.fallback ? opts.fallback : '');
                    if (opts && opts.hideEmpty) el.style.display = val ? '' : 'none';
                }
            });
        });
    }

    // Name
    wire('input[name="name"]', 'preview-name', 'preview-name-mobile', { fallback: '{{.T.ProfilePreviewCompany}}' });

    // Email
    wire('input[name="email"]', 'preview-email', 'preview-email-mobile', { prefix: true });

    // Phone
    wire('input[name="phone"]', 'preview-phone', 'preview-phone-mobile', { prefix: true });

    // Zelle
    wire('input[name="zelle_id"]', 'preview-zelle', null, { prefix: true });

    // Venmo
    wire('input[name="venmo_handle"]', 'preview-venmo', null, { prefix: true });

    // CashApp
    wire('input[name="cashapp_handle"]', 'preview-cashapp', null, { prefix: true });

    // Service areas
    wire('input[name="service_areas"]', 'preview-service-areas', null, { prefix: true });

    // Location — combines city + state
    var cityInput = document.querySelector('input[name="city"]');
    var stateInput = document.querySelector('input[name="state"]');
    function updateLocation() {
        var city = cityInput ? cityInput.value.trim() : '';
        var state = stateInput ? stateInput.value.trim() : '';
        var loc = '';
        if (city && state) loc = '📍 ' + city + ', ' + state;
        else if (city) loc = '📍 ' + city;
        else if (state) loc = '📍 ' + state;
        ['preview-location', 'preview-location-mobile'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.textContent = loc;
        });
    }
    if (cityInput) cityInput.addEventListener('input', updateLocation);
    if (stateInput) stateInput.addEventListener('input', updateLocation);

    // Logo
    var logoInput = document.querySelector('input[name="logo"]');
    if (logoInput) {
        logoInput.addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function(ev) {
                var src = ev.target.result;
                updatePreviewLogo('preview-logo', 'preview-logo-placeholder', src);
                updatePreviewLogo('preview-logo-mobile', 'preview-logo-placeholder-mobile', src);
                updatePreviewLogo('inv-preview-logo', 'inv-preview-logo-placeholder', src);
            };
            reader.readAsDataURL(file);
        });
    }

    // Invoice preview live updates
    wire('input[name="name"]', 'inv-preview-company', null, { fallback: '{{.T.ProfilePreviewCompany}}' });

    function updateInvAddress() {
        var city = document.querySelector('input[name="city"]');
        var state = document.querySelector('input[name="state"]');
        var zip = document.querySelector('input[name="zip"]');
        var c = city ? city.value.trim() : '';
        var st = state ? state.value.trim() : '';
        var z = zip ? zip.value.trim() : '';
        var parts = [];
        if (c) parts.push(c);
        if (st) parts.push(st);
        var line = parts.join(', ');
        if (z) line += (line ? ' ' : '') + z;
        var el = document.getElementById('inv-preview-address');
        if (el) el.textContent = line;
    }

    function updateInvContact() {
        var phone = document.querySelector('input[name="phone"]');
        var email = document.querySelector('input[name="email"]');
        var ph = phone ? phone.value.trim() : '';
        var em = email ? email.value.trim() : '';
        var parts = [];
        if (ph) parts.push(ph);
        if (em) parts.push(em);
        var el = document.getElementById('inv-preview-contact');
        if (el) el.textContent = parts.join(' · ');
    }

    ['city', 'state', 'zip'].forEach(function(n) {
        var inp = document.querySelector('input[name="' + n + '"]');
        if (inp) inp.addEventListener('input', updateInvAddress);
    });

    ['phone', 'email'].forEach(function(n) {
        var inp = document.querySelector('input[name="' + n + '"]');
        if (inp) inp.addEventListener('input', updateInvContact);
    });

        function updatePreviewLogo(imgId, placeholderId, src) {
        var img = document.getElementById(imgId);
        var placeholder = document.getElementById(placeholderId);
        if (img) {
            img.src = src;
        } else if (placeholder) {
            var newImg = document.createElement('img');
            newImg.id = imgId;
            newImg.className = 'biz-preview-logo';
            newImg.src = src;
            newImg.alt = 'Logo';
            placeholder.replaceWith(newImg);
        }
    }
});

function openPreviewSheet() {
    document.getElementById('previewOverlay').style.display = 'block';
    var sheet = document.getElementById('previewSheet');
    sheet.style.display = 'block';
    requestAnimationFrame(function() { sheet.classList.add('open'); });
}

function closePreviewSheet() {
    document.getElementById('previewOverlay').style.display = 'none';
    var sheet = document.getElementById('previewSheet');
    sheet.classList.remove('open');
    setTimeout(function() { sheet.style.display = 'none'; }, 300);
}

// Password match indicator
(function() {
    var np = document.getElementById('new-password');
    var cp = document.getElementById('confirm-password');
    var hint = document.getElementById('pw-match-hint');
    var btn = document.getElementById('pw-submit-btn');
    if (!np || !cp || !hint) return;

    function check() {
        if (cp.value === '') {
            hint.textContent = '';
            hint.style.color = 'rgba(255,255,255,0.3)';
            if (btn) btn.disabled = false;
            return;
        }
        if (np.value === cp.value) {
            hint.textContent = '✓ {{.T.ProfilePwMatch}}';
            hint.style.color = '#6ee7b7';
            if (btn) btn.disabled = false;
        } else {
            hint.textContent = '✗ {{.T.ProfilePwNoMatch}}';
            hint.style.color = '#fca5a5';
            if (btn) btn.disabled = true;
        }
    }

    np.addEventListener('input', check);
    cp.addEventListener('input', check);
})();
</script>
{{end}}
