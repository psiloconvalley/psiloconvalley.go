<!DOCTYPE html>
<html lang="en">
<head>
    <title>404 — Not Found | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #060a12;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .error-page {
            max-width: 640px;
            margin: 0 auto;
            padding: 120px 24px 80px;
            text-align: center;
        }

        .error-code {
            font-size: 120px;
            font-weight: 800;
            letter-spacing: -4px;
            line-height: 1;
            color: #39ff8a;
            text-shadow: 0 0 40px rgba(57, 255, 138, 0.3), 0 0 80px rgba(57, 255, 138, 0.15);
            margin-bottom: 16px;
        }

        .error-title {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 16px;
            color: #fff;
        }

        .error-desc {
            font-size: 15px;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
            max-width: 440px;
            margin: 0 auto 40px;
            font-weight: 300;
        }

        .error-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .error-btn {
            display: inline-flex;
            align-items: center;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

        .error-btn-primary {
            background: #39ff8a;
            color: #060a12;
            box-shadow: 0 0 20px rgba(57, 255, 138, 0.25);
        }

        .error-btn-primary:hover {
            background: #5cffaa;
            box-shadow: 0 0 32px rgba(57, 255, 138, 0.4);
            transform: translateY(-1px);
        }

        .error-btn-secondary {
            background: transparent;
            color: rgba(255,255,255,0.6);
            border: 1px solid rgba(255,255,255,0.12);
        }

        .error-btn-secondary:hover {
            border-color: rgba(57, 255, 138, 0.3);
            color: #39ff8a;
        }

        .error-network {
            margin-top: 56px;
            font-family: monospace;
            font-size: 11px;
            color: rgba(255,255,255,0.15);
            letter-spacing: 1px;
        }

        @media (max-width: 640px) {
            .error-page { padding: 80px 20px 60px; }
            .error-code { font-size: 80px; }
            .error-title { font-size: 20px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="error-page">
    <div class="error-code">404</div>
    <div class="error-title">This path does not exist in the network.</div>
    <p class="error-desc">
        The mycelium searched every thread and found no connection at this address. The page you are looking for may have moved, been removed, or never existed.
    </p>

    <div class="error-actions">
        <a href="/dashboard" class="error-btn error-btn-primary">Return to Command Center</a>
        <a href="/" class="error-btn error-btn-secondary">Go Home</a>
    </div>

    <div class="error-network">PSILOCONVALLEY · NODE NOT FOUND · THE NETWORK IS ALIVE</div>
</div>

{{template "public-footer" .}}

</body>
</html>
