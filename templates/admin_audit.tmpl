<!DOCTYPE html>
<html lang="en">
<head>
    <title>Audit Log | Psilocon Valley Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    <style>
        .audit-wrap {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 24px 120px;
        }

        .audit-header {
            margin-bottom: 40px;
            padding-bottom: 32px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .audit-eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 12px;
        }

        .audit-header h1 {
            font-size: clamp(24px, 3vw, 36px);
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 8px;
        }

        .audit-header p {
            font-size: 14px;
            color: rgba(255,255,255,0.4);
        }

        /* ── Filters ── */
        .audit-filters {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .audit-filters select {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            color: #ffffff;
            font-size: 13px;
            padding: 8px 14px;
            font-family: inherit;
            cursor: pointer;
            outline: none;
        }

        .audit-filters select:focus {
            border-color: rgba(74,222,128,0.4);
        }

        .audit-filters .btn-filter {
            background: rgba(74,222,128,0.1);
            border: 1px solid rgba(74,222,128,0.25);
            color: #4ade80;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 8px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.2s;
        }

        .audit-filters .btn-filter:hover {
            background: rgba(74,222,128,0.2);
        }

        .audit-count {
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            margin-left: auto;
        }

        /* ── Table ── */
        .audit-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .audit-table th {
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            padding: 10px 14px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .audit-table td {
            padding: 14px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.75);
            vertical-align: top;
        }

        .audit-table tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        .audit-action {
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 12px;
            color: #4ade80;
            white-space: nowrap;
        }

        .audit-action.auth    { color: #60a5fa; }
        .audit-action.payment { color: #fbbf24; }
        .audit-action.failed  { color: #f87171; }

        .audit-entity {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            font-family: 'SF Mono', 'Fira Code', monospace;
        }

        .audit-ip {
            font-size: 11px;
            color: rgba(255,255,255,0.25);
            font-family: 'SF Mono', 'Fira Code', monospace;
        }

        .audit-time {
            font-size: 11px;
            color: rgba(255,255,255,0.35);
            white-space: nowrap;
        }

        .audit-user {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }

        .audit-empty {
            text-align: center;
            padding: 60px 24px;
            color: rgba(255,255,255,0.25);
            font-size: 14px;
        }

        /* ── Pagination ── */
        .audit-pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 40px;
            font-size: 13px;
        }

        .audit-pagination a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            padding: 8px 16px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            transition: all 0.2s;
        }

        .audit-pagination a:hover {
            border-color: rgba(255,255,255,0.3);
            color: #ffffff;
        }

        .audit-pagination .current {
            color: #4ade80;
            border-color: rgba(74,222,128,0.3);
            padding: 8px 16px;
            border: 1px solid rgba(74,222,128,0.3);
            border-radius: 8px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: rgba(255,255,255,0.35);
            text-decoration: none;
            margin-bottom: 32px;
            transition: color 0.2s;
        }

        .back-link:hover { color: rgba(255,255,255,0.7); }

        @media (max-width: 768px) {
            .audit-wrap { padding: 40px 16px 80px; }
            .audit-table th:nth-child(4),
            .audit-table td:nth-child(4) { display: none; }
            .audit-table th:nth-child(5),
            .audit-table td:nth-child(5) { display: none; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="audit-wrap">

    <a href="/admin/analytics" class="back-link">← Admin Analytics</a>

    <div class="audit-header">
        <div class="audit-eyebrow">Admin</div>
        <h1>Audit Log</h1>
        <p>Every financial and authentication event — append-only, tamper-evident.</p>
    </div>

    <!-- ── Filters ── -->
    <form method="GET" action="/admin/audit" class="audit-filters">
        <select name="action" onchange="this.form.submit()">
            <option value="" {{if eq .Action ""}}selected{{end}}>All Actions</option>
            <optgroup label="Invoice">
                <option value="invoice.created"       {{if eq .Action "invoice.created"}}selected{{end}}>invoice.created</option>
                <option value="invoice.updated"       {{if eq .Action "invoice.updated"}}selected{{end}}>invoice.updated</option>
                <option value="invoice.deleted"       {{if eq .Action "invoice.deleted"}}selected{{end}}>invoice.deleted</option>
                <option value="invoice.status_changed"{{if eq .Action "invoice.status_changed"}}selected{{end}}>invoice.status_changed</option>
                <option value="invoice.sent"          {{if eq .Action "invoice.sent"}}selected{{end}}>invoice.sent</option>
                <option value="invoice.duplicated"    {{if eq .Action "invoice.duplicated"}}selected{{end}}>invoice.duplicated</option>
            </optgroup>
            <optgroup label="Estimate">
                <option value="estimate.created"      {{if eq .Action "estimate.created"}}selected{{end}}>estimate.created</option>
                <option value="estimate.updated"      {{if eq .Action "estimate.updated"}}selected{{end}}>estimate.updated</option>
                <option value="estimate.deleted"      {{if eq .Action "estimate.deleted"}}selected{{end}}>estimate.deleted</option>
                <option value="estimate.sent"         {{if eq .Action "estimate.sent"}}selected{{end}}>estimate.sent</option>
                <option value="estimate.converted"    {{if eq .Action "estimate.converted"}}selected{{end}}>estimate.converted</option>
                <option value="estimate.responded"    {{if eq .Action "estimate.responded"}}selected{{end}}>estimate.responded</option>
            </optgroup>
            <optgroup label="Auth">
                <option value="auth.login"            {{if eq .Action "auth.login"}}selected{{end}}>auth.login</option>
                <option value="auth.login_failed"     {{if eq .Action "auth.login_failed"}}selected{{end}}>auth.login_failed</option>
                <option value="auth.logout"           {{if eq .Action "auth.logout"}}selected{{end}}>auth.logout</option>
                <option value="auth.register"         {{if eq .Action "auth.register"}}selected{{end}}>auth.register</option>
            </optgroup>
            <optgroup label="Payment">
                <option value="payment.received"      {{if eq .Action "payment.received"}}selected{{end}}>payment.received</option>
                <option value="payment.failed"        {{if eq .Action "payment.failed"}}selected{{end}}>payment.failed</option>
            </optgroup>
        </select>
        <span class="audit-count">{{.Total}} entries</span>
    </form>

    <!-- ── Table ── -->
    {{if .Logs}}
    <table class="audit-table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Action</th>
                <th>Entity</th>
                <th>User ID</th>
                <th>IP Address</th>
            </tr>
        </thead>
        <tbody>
            {{range .Logs}}
            <tr>
                <td class="audit-time">{{.CreatedAt.Format "Jan 02 15:04:05"}}</td>
                <td>
                    <span class="audit-action{{if hasPrefix .Action "auth"}} auth{{end}}{{if hasPrefix .Action "payment"}} payment{{end}}{{if hasSuffix .Action "failed"}} failed{{end}}">
                        {{.Action}}
                    </span>
                </td>
                <td class="audit-entity">
                    {{if .EntityID}}
                        {{.EntityType}} #{{.EntityID}}
                    {{else}}
                        {{.EntityType}}
                    {{end}}
                </td>
                <td class="audit-user">
                    {{if .UserID}}#{{.UserID}}{{else}}—{{end}}
                </td>
                <td class="audit-ip">{{if .IPAddress}}{{.IPAddress}}{{else}}—{{end}}</td>
            </tr>
            {{end}}
        </tbody>
    </table>

    <!-- ── Pagination ── -->
    {{if gt .TotalPages 1}}
    <div class="audit-pagination">
        {{if .HasPrev}}
            <a href="/admin/audit?page={{.PrevPage}}&action={{.Action}}">← Prev</a>
        {{end}}
        <span class="current">Page {{.Page}} of {{.TotalPages}}</span>
        {{if .HasNext}}
            <a href="/admin/audit?page={{.NextPage}}&action={{.Action}}">Next →</a>
        {{end}}
    </div>
    {{end}}

    {{else}}
    <div class="audit-empty">
        No audit entries found{{if .Action}} for action <strong>{{.Action}}</strong>{{end}}.
    </div>
    {{end}}

</div>

<footer>
    <p>
        Built with Go + PostgreSQL —
        <a href="/research">Research</a> ·
        <a href="/tools">Tools</a> ·
        <a href="/security">Security</a>
    </p>
</footer>

</body>
</html>
