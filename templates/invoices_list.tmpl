<!DOCTYPE html>
<html lang="en">
<head>
    <title>Invoices | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #fff;
	    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        /* ── Header ── */
	.top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-subtitle {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            margin-top: 6px;
            font-family: monospace;
        }
        .btn-new {
            background: #fff;
            color: #000;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 6px;
            font-family: inherit;
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
            transition: opacity 0.2s;
            /* Mobile: minimum touch target */
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .btn-new:hover { opacity: 0.85; }

        /* ── Status badges ── */
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-draft    { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); }
        .badge-sent     { background: #1e3a5f; color: #93c5fd; }
        .badge-paid     { background: #14532d; color: #86efac; }
        .badge-void     { background: #450a0a; color: #fca5a5; }
        .badge-overdue  { background: #431407; color: #fdba74; }

        /* ── Empty state ── */
        .empty {
            text-align: center;
            padding: 80px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-icon { font-size: 40px; margin-bottom: 16px; }
        .empty-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: rgba(255,255,255,0.5); }
        .empty-sub { font-size: 14px; margin-bottom: 24px; }

        /* ============================================================
           DESKTOP TABLE (≥ 640px)
           ============================================================ */
	.table-wrap {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table-wrap::-webkit-scrollbar { height: 8px; }
        .table-wrap::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        .table-wrap::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
        .table-wrap::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }
                table {
            width: 100%;
            border-collapse: collapse;
	    min-width: 800px;

        }
        th {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.4);
            text-align: left;
            padding: 12px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 14px;
            vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .inv-link {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        .inv-link:hover { text-decoration: underline; }

	.right { text-align: right; }
        .mono { font-variant-numeric: tabular-nums; }

	          /* ── Row actions (matches clients page) ── */
        .row-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            flex-wrap: nowrap;
        }
        .small-btn {
            background: none;
            color: rgba(255,255,255,0.6);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 14px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            transition: all 0.2s;
            cursor: pointer;
            font-family: inherit;
            white-space: nowrap;
        }
        .small-btn:hover {
            border-color: #fff;
            color: #fff;
        }
        .small-btn.danger:hover {
            border-color: #ef4444;
            color: #ef4444;
        }

        /* ── Mobile card actions ── */
        .inv-card-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .inv-card-actions .small-btn {
            flex: 1;
            text-align: center;
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }               
        /* Hide table on mobile — show cards instead */
        .table-wrap { display: block; }
        .card-list  { display: none; }

        /* ============================================================
           MOBILE CARDS (< 640px)
           Mobile-first rule: on small screens the table is replaced
           by a card list. Each card shows the same data in a touch-
           friendly vertical layout with a 44px minimum tap target.
           We use display:none / display:flex toggled by the breakpoint
           rather than hiding columns, because hiding columns still
           forces the browser to render and reflow the table — cards
           are semantically and performatively cleaner.
           ============================================================ */
        @media (max-width: 639px) {
            .container { padding: 24px 16px 80px; }

	    .top { padding-left: 16px; }
            .top h1 { font-size: 22px; }

            .table-wrap { display: none; }
            .card-list  { display: flex; flex-direction: column; gap: 10px; }

            .inv-card {
                display: block;
                background: rgba(255,255,255,0.03);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 10px;
                padding: 16px;
                text-decoration: none;
                color: #fff;
                /* Smooth press feedback on iOS */
                -webkit-tap-highlight-color: transparent;
                transition: background 0.15s;
            }
            .inv-card:active { background: rgba(255,255,255,0.07); }

            .inv-card-top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 8px;
            }
            .inv-card-number {
                font-size: 15px;
                font-weight: 700;
                color: #fff;
            }
            .inv-card-client {
                font-size: 13px;
                color: rgba(255,255,255,0.55);
                margin-bottom: 10px;
            }
            .inv-card-bottom {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .inv-card-dates {
                font-size: 11px;
                color: rgba(255,255,255,0.35);
            }
            .inv-card-total {
                font-size: 16px;
                font-weight: 800;
                font-variant-numeric: tabular-nums;
                color: #fff;
            }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="container">

       <div class="top">
	<div>
            <h1>Invoices</h1>
            <div class="top-subtitle">
                {{len .Invoices}} total
                {{if .User}}
                    {{if .IsPro}}
                    · <span style="color:#4ade80;">Pro — Unlimited</span>
                    {{else}}
                    · {{.MonthlyCount}}/{{.MonthlyLimit}} this month
                    {{end}}
                {{end}}
            </div>
        </div>
	                <a href="/invoices/new" class="btn-new">+ New Invoice</a>
    </div>

    {{if .Deleted}}
    <div style="
        background: rgba(16,185,129,0.1);
        border: 1px solid rgba(16,185,129,0.3);
        color: #6ee7b7;
        padding: 14px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
        font-family: monospace;
    ">✓ Invoice deleted successfully</div>
    {{end}}

    {{if not .IsPro}}
        <div style="
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    ">
        <div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 4px;">
                Monthly Usage
            </div>
            <div style="font-size: 20px; font-weight: 700;">
                {{.MonthlyCount}} / {{.MonthlyLimit}} invoices
            </div>
        </div>
        <div style="flex: 1; max-width: 300px; min-width: 150px;">
            <div style="
                background: rgba(255,255,255,0.08);
                border-radius: 6px;
                height: 8px;
                overflow: hidden;
            ">
                <div style="
                    background: {{if ge .MonthlyCount .MonthlyLimit}}#ef4444{{else if ge .MonthlyCount 8}}#f59e0b{{else}}#4ade80{{end}};
                    height: 100%;
                    width: {{if ge .MonthlyCount .MonthlyLimit}}100{{else}}{{mul .MonthlyCount 10}}{{end}}%;
                    border-radius: 6px;
                    transition: width 0.3s;
                "></div>
            </div>
        </div>
        {{if ge .MonthlyCount 8}}
        <a href="/pricing" style="
            font-size: 12px;
            font-weight: 700;
            color: #f59e0b;
            text-decoration: none;
        ">Upgrade →</a>
        {{end}}
    </div>
    {{end}}
      {{if not .Invoices}}
    <div class="empty">
        <div class="empty-icon">📭</div>
        <div class="empty-title">No invoices yet</div>
        <div class="empty-sub">Create your first invoice to get started.</div>
        <a href="/invoices/new" class="btn-new">Create Invoice</a>
    </div>
    {{else}}

    {{/* ── DESKTOP TABLE ── */}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Client</th>
                    <th>Issued</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th class="right">Total</th>
		    <th class="right">Actions</th>
                </tr>
            </thead>
            <tbody>
		{{range .Invoices}}
                <tr>
                    <td>
                        <a href="/invoices/{{.ID}}" class="inv-link">
                            {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                        </a>
                    </td>
                    <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
		    <td>{{if .IssueDate}}{{.IssueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
		    <td>{{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td>
                        <span class="badge badge-{{.Status}}">{{.Status}}</span>
                    </td>
                    <td class="right mono">{{money .TotalCents}}</td>
                    <td>
			<div class="row-actions">
                            {{if eq .Status "draft"}}
                            <a href="/invoices/{{.ID}}/send" class="small-btn">Send</a>
                            <a href="/invoices/{{.ID}}/edit" class="small-btn">Edit</a>
                            {{end}}
                            {{if or (eq .Status "sent") (eq .Status "overdue")}}
                            <a href="/invoices/{{.ID}}/send" class="small-btn">Resend</a>
                            {{end}}
                            <a href="/invoices/{{.ID}}/duplicate" class="small-btn">Duplicate</a>
                            {{if eq .Status "draft"}}
			    <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">Delete</button>
                            {{end}}
                        </div>
                                            </td>
                </tr>
                {{end}}
                            </tbody>
        </table>
    </div>

    {{/* ── MOBILE CARD LIST ── */}}
    <div class="card-list">
	{{range .Invoices}}
        <div class="inv-card">
            <a href="/invoices/{{.ID}}" style="text-decoration:none; color:inherit; display:block;">
                <div class="inv-card-top">
                    <span class="inv-card-number">
                        {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}Untitled{{end}}
                    </span>
                    <span class="badge badge-{{.Status}}">{{.Status}}</span>
                </div>
                <div class="inv-card-client">
                    {{if .ClientName}}{{.ClientName}}{{else}}No client{{end}}
                </div>
                <div class="inv-card-bottom">
                    <div class="inv-card-dates">
		     {{if .IssueDate}}Issued {{.IssueDate.Format "Jan 2, 2006"}}{{end}}
          	     {{if .DueDate}} · Due {{.DueDate.Format "Jan 2, 2006"}}{{end}}
		</div>
                    <div class="inv-card-total">{{money .TotalCents}}</div>
                </div>
            </a>
	   <div class="inv-card-actions">
                {{if eq .Status "draft"}}
                <a href="/invoices/{{.ID}}/send" class="small-btn">Send</a>
                <a href="/invoices/{{.ID}}/edit" class="small-btn">Edit</a>
                {{end}}
                {{if or (eq .Status "sent") (eq .Status "overdue")}}
                <a href="/invoices/{{.ID}}/send" class="small-btn">Resend</a>
                {{end}}
                <a href="/invoices/{{.ID}}/duplicate" class="small-btn">Duplicate</a>
                {{if eq .Status "draft"}}
		 <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">Delete</button>
                {{end}}
            </div>
                    </div>
        {{end}}
            </div>

    {{end}}
</div>

<!-- ═══════════ DELETE CONFIRMATION MODAL ═══════════ -->
<div id="delete-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:500;">
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:32px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="font-size:20px; font-weight:800; color:#fff; margin-bottom:8px;">Delete Draft Invoice</div>
        <div style="font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:20px; line-height:1.5;">This action <strong style="color:#fca5a5;">cannot be undone</strong>. The invoice and all its line items will be permanently deleted.</div>
        <div style="font-size:13px; font-weight:600; color:rgba(255,255,255,0.6); margin-bottom:8px;">Type the invoice number to confirm:</div>
        <div style="font-size:13px; font-weight:700; color:#fca5a5; background:rgba(220,38,38,0.15); border:1px solid rgba(220,38,38,0.3); border-radius:6px; padding:8px 12px; margin-bottom:12px; font-family:monospace;" id="delete-modal-number"></div>
        <input
            type="text"
            id="delete-confirm-input"
            placeholder="Type invoice number here"
            oninput="checkDeleteConfirm()"
            style="width:100%; padding:10px 12px; border:1px solid rgba(255,255,255,0.15); border-radius:8px; font-size:14px; font-family:inherit; margin-bottom:16px; background:rgba(255,255,255,0.05); color:#fff;"
        >
        <div style="display:flex; gap:12px;">
            <button type="button" onclick="closeDeleteModal()" style="flex:1; padding:11px; border:1px solid rgba(255,255,255,0.15); background:transparent; color:rgba(255,255,255,0.6); border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;">Cancel</button>
            <form id="delete-form" method="POST" action="" style="flex:1;">
                {{.csrfField}}
                <input type="hidden" name="confirm_number" id="delete-confirm-hidden">
                <button type="submit" id="delete-submit-btn" disabled
                    style="width:100%; padding:11px; background:#dc2626; color:white; border:none; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer; opacity:0.4;">
                    Delete Permanently
                </button>
            </form>
        </div>
    </div>
</div>

<script>
var _deleteInvoiceNumber = '';

function openDeleteModal(invoiceNumber, invoiceID) {
    _deleteInvoiceNumber = invoiceNumber;
    document.getElementById('delete-modal-number').textContent = invoiceNumber;
    document.getElementById('delete-confirm-input').value = '';
    document.getElementById('delete-confirm-hidden').value = '';
    document.getElementById('delete-submit-btn').disabled = true;
    document.getElementById('delete-submit-btn').style.opacity = '0.4';
    document.getElementById('delete-form').action = '/invoices/' + invoiceID + '/delete';
    document.getElementById('delete-overlay').style.display = 'block';
    setTimeout(function(){ document.getElementById('delete-confirm-input').focus(); }, 50);
}

function closeDeleteModal() {
    document.getElementById('delete-overlay').style.display = 'none';
}

function checkDeleteConfirm() {
    var val = document.getElementById('delete-confirm-input').value.trim();
    var btn = document.getElementById('delete-submit-btn');
    var hidden = document.getElementById('delete-confirm-hidden');
    if (val === _deleteInvoiceNumber) {
        btn.disabled = false;
        btn.style.opacity = '1';
        hidden.value = val;
    } else {
        btn.disabled = true;
        btn.style.opacity = '0.4';
        hidden.value = '';
    }
}

document.getElementById('delete-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});
</script>

</body>
</html>
