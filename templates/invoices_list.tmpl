<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "invoices-list-styles" .}}
    {{template "app-components" .}}
</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>{{.T.InvoicesTitle}}</h1>
            <div class="top-subtitle">
                {{len .Invoices}} {{.T.InvoicesListTotal}}
                {{if .User}}
                    {{if .IsPro}}
                    · <span style="color:#4ade80;">{{.T.InvoicesProUnlimited}}</span>
                    {{else}}
                    · {{.MonthlyCount}}/{{.MonthlyLimit}} {{.T.InvoicesThisMonth}}
                    {{end}}
                {{end}}
            </div>
        </div>
        <a href="/invoices/new" class="btn-new">{{.T.InvoicesNewInvoice}}</a>
    </div>

    {{if .Deleted}}
    <div id="success-banner" style="
        background: rgba(16,185,129,0.1);
        border: 1px solid rgba(16,185,129,0.3);
        color: #6ee7b7;
        padding: 14px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
        font-family: monospace;
        display: flex;
        justify-content: space-between;
        align-items: center;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.4s ease, transform 0.4s ease;
        cursor: pointer;
    " onclick="dismissBanner()">
        <span>{{.T.InvoicesDeleted}}</span>
        <span style="font-size: 18px; opacity: 0.5;">✕</span>
    </div>
    <script>
    (function() {
        var banner = document.getElementById('success-banner');
        requestAnimationFrame(function() {
            banner.style.opacity = '1';
            banner.style.transform = 'translateY(0)';
        });
        setTimeout(function() { dismissBanner(); }, 4000);
    })();
    function dismissBanner() {
        var banner = document.getElementById('success-banner');
        if (!banner) return;
        banner.style.opacity = '0';
        banner.style.transform = 'translateY(-8px)';
        setTimeout(function() { banner.remove(); }, 400);
    }
    </script>
    {{end}}

    {{if not .IsPro}}
    <div style="
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    ">
        <div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 4px;">
                {{.T.InvoicesMonthlyUsage}}
            </div>
            <div style="font-size: 20px; font-weight: 700;">
                {{.MonthlyCount}} / {{.MonthlyLimit}} {{.T.InvoicesUsageLabel}}
            </div>
        </div>
        <div style="flex: 1; max-width: 300px; min-width: 150px;">
            <div style="
                background: rgba(255,255,255,0.08);
                border-radius: 6px;
                height: 8px;
                overflow: hidden;
            ">
                <div style="
                    background: {{if ge .MonthlyCount .MonthlyLimit}}#ef4444{{else if ge .MonthlyCount 8}}#f59e0b{{else}}#4ade80{{end}};
                    height: 100%;
                    width: {{if ge .MonthlyCount .MonthlyLimit}}100{{else}}{{mul .MonthlyCount 10}}{{end}}%;
                    border-radius: 6px;
                    transition: width 0.3s;
                "></div>
            </div>
        </div>
        {{if ge .MonthlyCount 8}}
        <a href="/pricing" style="
            font-size: 12px;
            font-weight: 700;
            color: #f59e0b;
            text-decoration: none;
        ">{{.T.InvoicesUpgrade}}</a>
        {{end}}
    </div>
    {{end}}

    {{if not .Invoices}}
    <div class="empty">
        <div class="empty-icon">📭</div>
        <div class="empty-title">{{.T.InvoicesEmptyTitle}}</div>
        <div class="empty-sub">{{.T.InvoicesEmptyBody}}</div>
        <a href="/invoices/new" class="btn-new">{{.T.InvoicesCreateInvoice}}</a>
    </div>
    {{else}}

    {{/* ── DESKTOP TABLE ── */}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>{{.T.InvoicesThInvoice}}</th>
                    <th>{{.T.InvoicesThClient}}</th>
                    <th>{{.T.InvoicesThIssued}}</th>
                    <th>{{.T.InvoicesThDue}}</th>
                    <th>{{.T.InvoicesThStatus}}</th>
                    <th class="right">{{.T.InvoicesThTotal}}</th>
                    <th class="right">{{.T.InvoicesThActions}}</th>
                </tr>
            </thead>
            <tbody>
                {{range .Invoices}}
                <tr>
                    <td>
                        <a href="/invoices/{{.ID}}" class="inv-link">
                            {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                        </a>
                    </td>
                    <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                    <td>{{if .IssueDate}}{{.IssueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td>{{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td>
                        <span class="badge badge-{{.Status}}">{{.Status}}</span>
                        {{if and (eq .Status "paid") .PaymentMethod}}
                        <span class="badge-method">{{.PaymentMethod}}</span>
                        {{end}}
                    </td>
                    <td class="right mono">{{money .TotalCents}}</td>
                    <td>
                        <div class="row-actions">
                            {{if eq .Status "draft"}}
                            <a href="/invoices/{{.ID}}/send" class="small-btn">{{$.T.InvoicesSend}}</a>
                            <a href="/invoices/{{.ID}}/edit" class="small-btn">{{$.T.InvoicesEdit}}</a>
                            {{end}}
                            {{if or (eq .Status "sent") (eq .Status "overdue")}}
                            <a href="/invoices/{{.ID}}/send" class="small-btn">{{$.T.InvoicesResend}}</a>
                            <button type="button" class="small-btn paid-btn" onclick="openPaidModal({{.ID}})">{{$.T.InvoicesMarkPaid}}</button>
                            {{end}}
                            <a href="/invoices/{{.ID}}/duplicate" class="small-btn">{{$.T.InvoicesDuplicate}}</a>
                            {{if eq .Status "draft"}}
                            <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">{{$.T.InvoicesDeleteBtn}}</button>
                            {{end}}
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    {{/* ── MOBILE CARD LIST ── */}}
    <div class="card-list">
        {{range .Invoices}}
        <div class="inv-card">
            <a href="/invoices/{{.ID}}" style="text-decoration:none; color:inherit; display:block;">
                <div class="inv-card-top">
                    <span class="inv-card-number">
                        {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}{{$.T.InvoicesUntitled}}{{end}}
                    </span>
                    <span class="badge badge-{{.Status}}">{{.Status}}</span>
                </div>
                <div class="inv-card-client">
                    {{if .ClientName}}{{.ClientName}}{{else}}{{$.T.InvoicesNoClient}}{{end}}
                </div>
                <div class="inv-card-bottom">
                    <div class="inv-card-dates">
                        {{if .IssueDate}}{{$.T.InvoicesIssuedLabel}} {{.IssueDate.Format "Jan 2, 2006"}}{{end}}
                        {{if .DueDate}} · {{$.T.InvoicesDueLabel}} {{.DueDate.Format "Jan 2, 2006"}}{{end}}
                    </div>
                    <div class="inv-card-total">{{money .TotalCents}}</div>
                </div>
            </a>
            <div class="inv-card-actions">
                {{if eq .Status "draft"}}
                <a href="/invoices/{{.ID}}/send" class="small-btn">{{$.T.InvoicesSend}}</a>
                <a href="/invoices/{{.ID}}/edit" class="small-btn">{{$.T.InvoicesEdit}}</a>
                {{end}}
                {{if or (eq .Status "sent") (eq .Status "overdue")}}
                <a href="/invoices/{{.ID}}/send" class="small-btn">{{$.T.InvoicesResend}}</a>
                <button type="button" class="small-btn paid-btn" onclick="openPaidModal({{.ID}})">{{$.T.InvoicesMarkPaid}}</button>
                {{end}}
                <a href="/invoices/{{.ID}}/duplicate" class="small-btn">{{$.T.InvoicesDuplicate}}</a>
                {{if eq .Status "draft"}}
                <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">{{$.T.InvoicesDeleteBtn}}</button>
                {{end}}
            </div>
        </div>
        {{end}}
    </div>

    {{end}}
</div>

<!-- ═══════════ DELETE CONFIRMATION MODAL ═══════════ -->
<div id="delete-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:500;">
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:32px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="font-size:20px; font-weight:800; color:#fff; margin-bottom:8px;">{{.T.InvoicesDeleteTitle}}</div>
        <div style="font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:20px; line-height:1.5;">{{.T.InvoicesDeleteBody}}</div>
        <div style="font-size:13px; font-weight:600; color:rgba(255,255,255,0.6); margin-bottom:8px;">{{.T.InvoicesDeleteConfirm}}</div>
        <div style="font-size:13px; font-weight:700; color:#fca5a5; background:rgba(220,38,38,0.15); border:1px solid rgba(220,38,38,0.3); border-radius:6px; padding:8px 12px; margin-bottom:12px; font-family:monospace;" id="delete-modal-number"></div>
        <input
            type="text"
            id="delete-confirm-input"
            placeholder="{{.T.InvoicesDeletePlaceholder}}"
            oninput="checkDeleteConfirm()"
            style="width:100%; padding:10px 12px; border:1px solid rgba(255,255,255,0.15); border-radius:8px; font-size:14px; font-family:inherit; margin-bottom:16px; background:rgba(255,255,255,0.05); color:#fff;"
        >
        <div style="display:flex; gap:12px;">
            <button type="button" onclick="closeDeleteModal()" style="flex:1; padding:11px; border:1px solid rgba(255,255,255,0.15); background:transparent; color:rgba(255,255,255,0.6); border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;">{{.T.InvoicesDeleteCancel}}</button>
            <form id="delete-form" method="POST" action="" style="flex:1;">
                {{.csrfField}}
                <input type="hidden" name="confirm_number" id="delete-confirm-hidden">
                <button type="submit" id="delete-submit-btn" disabled
                    style="width:100%; padding:11px; background:#dc2626; color:white; border:none; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer; opacity:0.4;">
                    {{.T.InvoicesDeletePermanent}}
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════ MARK AS PAID MODAL ═══════════ -->
<div id="paid-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:500;">
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:32px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="font-size:20px; font-weight:800; color:#fff; margin-bottom:8px;">{{.T.InvoicesMarkPaid}}</div>
        <div style="font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:20px; line-height:1.5;">{{.T.InvoicesPaidWith}}</div>
        <form id="paid-form" method="POST" action="">
            {{.csrfField}}
            <input type="hidden" name="status" value="paid">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:20px;">
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="cash" checked>
                    <span>💵 {{.T.InvoicesPayCash}}</span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="zelle">
                    <span>⚡ {{.T.InvoicesPayZelle}}</span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="venmo">
                    <span>📱 {{.T.InvoicesPayVenmo}}</span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="check">
                    <span>📝 {{.T.InvoicesPayCheck}}</span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="card">
                    <span>💳 {{.T.InvoicesPayCard}}</span>
                </label>
                <label class="pay-option">
                    <input type="radio" name="payment_method" value="other">
                    <span>📦 {{.T.InvoicesPayOther}}</span>
                </label>
            </div>
            <div style="display:flex; gap:12px;">
                <button type="button" onclick="closePaidModal()" style="flex:1; padding:11px; border:1px solid rgba(255,255,255,0.15); background:transparent; color:rgba(255,255,255,0.6); border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;">{{.T.InvoicesPayCancel}}</button>
                <button type="submit" style="flex:1; padding:11px; background:#15803d; color:white; border:none; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer;">{{.T.InvoicesPayConfirm}}</button>
            </div>
        </form>
    </div>
</div>

<script>
var _deleteInvoiceNumber = '';

function openDeleteModal(invoiceNumber, invoiceID) {
    _deleteInvoiceNumber = invoiceNumber;
    document.getElementById('delete-modal-number').textContent = invoiceNumber;
    document.getElementById('delete-confirm-input').value = '';
    document.getElementById('delete-confirm-hidden').value = '';
    document.getElementById('delete-submit-btn').disabled = true;
    document.getElementById('delete-submit-btn').style.opacity = '0.4';
    document.getElementById('delete-form').action = '/invoices/' + invoiceID + '/delete';
    document.getElementById('delete-overlay').style.display = 'block';
    setTimeout(function(){ document.getElementById('delete-confirm-input').focus(); }, 50);
}

function closeDeleteModal() {
    document.getElementById('delete-overlay').style.display = 'none';
}

function checkDeleteConfirm() {
    var val = document.getElementById('delete-confirm-input').value.trim();
    var btn = document.getElementById('delete-submit-btn');
    var hidden = document.getElementById('delete-confirm-hidden');
    if (val === _deleteInvoiceNumber) {
        btn.disabled = false;
        btn.style.opacity = '1';
        hidden.value = val;
    } else {
        btn.disabled = true;
        btn.style.opacity = '0.4';
        hidden.value = '';
    }
}

document.getElementById('delete-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});

function openPaidModal(invoiceID) {
    document.getElementById('paid-form').action = '/invoices/' + invoiceID + '/status';
    document.getElementById('paid-overlay').style.display = 'block';
}

function closePaidModal() {
    document.getElementById('paid-overlay').style.display = 'none';
}

document.getElementById('paid-overlay').addEventListener('click', function(e) {
    if (e.target === this) closePaidModal();
});
</script>

</body>
</html>
