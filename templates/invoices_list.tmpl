<!DOCTYPE html>
<html>
<head>
    <title>Invoices</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            padding: 40px;
            color: #111;
        }

        .container {
            max-width: 1000px;
            margin: auto;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0;
        }

        .btn {
            background: #111;
            color: white;
            padding: 12px 18px;
            text-decoration: none;
            border-radius: 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

        th {
            background: #111;
            color: white;
            text-align: left;
            padding: 14px;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #ddd;
        }

        tr:last-child td {
            border-bottom: none;
        }

        a {
            color: inherit;
            text-decoration: none;
            font-weight: bold;
        }

        a:hover {
            text-decoration: underline;
        }

        .empty {
            background: white;
            padding: 40px;
            border-radius: 10px;
            text-align: center;
            color: #666;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="top">
        <h1>Invoices</h1>

        <a class="btn" href="/invoices/new">
            Create Invoice
        </a>
    </div>

    {{if .Invoices}}

    <table>

        <thead>
            <tr>
                <th>Invoice #</th>
                <th>Client</th>
                <th>Status</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            {{range .Invoices}}
            <tr>

                <td>
                    <a href="/invoices/{{.ID}}">
                        {{.InvoiceNumber}}
                    </a>
                </td>

                <td>{{.ClientName}}</td>

                <td>{{.Status}}</td>

                <td>{{money .Total}}</td>

            </tr>
            {{end}}

        </tbody>

    </table>

    {{else}}

    <div class="empty">
        No invoices yet.
    </div>

    {{end}}

</div>

</body>
</html>
