<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.T.ClientsTitle}} | PsiloConValley</title>

    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "clients-list-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>{{.T.ClientsTitle}}</h1>
            <div class="top-subtitle">
                {{.ClientCount}} {{.T.ClientsSaved}}
                {{if .User}}
                    {{if eq .User.Plan "pro"}}
                    · <span class="plan-badge pro">{{.T.ClientsProUnlimited}}</span>
                    {{else}}
                    · {{.ClientCount}}/5 {{.T.ClientsFreeSlotsUsed}}
                    {{end}}
                {{end}}
            </div>
        </div>
        <div class="top-right">
            <a class="btn btn-secondary" href="/clients/import" style="margin-right:8px;">📤 {{.T.ClientsImport}}</a>
            <a class="btn btn-secondary" href="/clients/export.csv" style="margin-right:8px;">📥 {{.T.ClientsExport}}</a>
            {{if .CanAddClient}}
            <a class="btn" href="/clients/new">{{.T.ClientsNewClient}}</a>
            {{else}}
            <span class="btn-disabled">{{.T.ClientsNewClient}}</span>
            {{end}}
        </div>
    </div>

    {{if .AtLimit}}
    <div class="limit-banner">
        ⚡ {{.T.ClientsLimitBanner}}
        <br><br>
        <a href="/pricing">{{.T.ClientsLimitUpgrade}}</a>
    </div>
    {{end}}

    {{if eq (index . "saved") true}}
    <div class="success-banner">{{.T.ClientsSavedSuccess}}</div>
    {{end}}

    {{if .Clients}}
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>{{.T.ClientsThClient}}</th>
                    <th>{{.T.ClientsThLocation}}</th>
                    <th>{{.T.ClientsThPhone}}</th>
                    <th style="text-align:right;">{{.T.ClientsThOperations}}</th>
                </tr>
            </thead>
            <tbody>
                {{range .Clients}}
                <tr>
                    <td>
                        <div class="client-name">{{.Name}}</div>
                        {{if .Email}}
                        <div class="client-email">{{.Email}}</div>
                        {{end}}
                    </td>
                    <td style="color:rgba(255,255,255,0.6); font-size:14px;">
                        {{if .City}}{{.City}}{{end}}
                        {{if and .City .State}}, {{end}}
                        {{if .State}}{{.State}}{{end}}
                        {{if .Country}}<br><span style="color:rgba(255,255,255,0.3); font-size:12px;">{{.Country}}</span>{{end}}
                    </td>
                    <td style="color:rgba(255,255,255,0.5); font-size:14px; font-family:monospace;">
                        {{if .Phone}}{{.Phone}}{{else}}—{{end}}
                    </td>
                    <td>
                        <div class="actions-cell">
                            <a class="small-btn" href="/clients/{{.ID}}/edit">{{$.T.ClientsEdit}}</a>
                            <a class="small-btn" href="/invoices/new?client_id={{.ID}}">{{$.T.ClientsInvoice}}</a>
                            <form method="POST" action="/clients/{{.ID}}/delete"
                                  style="display:inline;"
                                  onsubmit="return confirm('{{$.T.ClientsDeleteConfirm}}');">
                                {{$.csrfField}}
                                <button type="submit" class="small-btn danger">{{$.T.ClientsDelete}}</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    {{else}}
    <div class="empty-state">
        <div class="empty-icon">👤</div>
        <h2>{{.T.ClientsEmptyTitle}}</h2>
        <p>{{.T.ClientsEmptyBody}}</p>
        {{if .CanAddClient}}
        <a href="/clients/new" class="btn">{{.T.ClientsAddFirst}}</a>
        {{end}}
    </div>
    {{end}}

</div>

</body>
</html>
