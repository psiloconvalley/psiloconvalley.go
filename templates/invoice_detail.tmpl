<!DOCTYPE html>
<html>
<head>
    <title>{{.Invoice.InvoiceNumber}} — {{.Invoice.ClientName}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #f5f5f5;
            color: #1a1a1a;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            max-width: 880px;
            margin: 48px auto;
            padding: 0 24px;
        }

        .invoice-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        /* ── Header ── */
        .header {
            background: #0a0a0a;
            color: white;
            padding: 48px 56px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .header-left {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .title {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin: 0;
        }

        .invoice-number-display {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -1px;
            margin: 0;
        }

        .header-right {
            text-align: right;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .company-name-header {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo-placeholder {
            width: 120px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            overflow: hidden;
        }

        .logo-placeholder img {
            max-width: 120px;
            max-height: 48px;
            object-fit: contain;
        }

        .currency-badge {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.08);
            padding: 4px 12px;
            border-radius: 4px;
        }

        /* ── Body ── */
        .body {
            padding: 56px;
        }

        /* ── Addresses ── */
        .addresses {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 56px;
            margin-bottom: 48px;
        }

        .address-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #999;
            margin-bottom: 12px;
        }

        .address-name {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #111;
        }

        .address-line {
            font-size: 14px;
            color: #555;
            line-height: 1.7;
        }

        /* ── Invoice Meta ── */
        .invoice-meta {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 48px;
            padding: 28px 32px;
            background: #fafafa;
            border-radius: 10px;
            border: 1px solid #f0f0f0;
        }

        .meta-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .meta-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #999;
        }

        .meta-value {
            font-size: 15px;
            font-weight: 600;
            color: #111;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-draft    { background: #f3f4f6; color: #374151; }
        .status-sent     { background: #dbeafe; color: #1d4ed8; }
        .status-paid     { background: #dcfce7; color: #15803d; }
        .status-void     { background: #fee2e2; color: #dc2626; }
        .status-overdue  { background: #fef9c3; color: #854d0e; }

        /* ── Line Items Table ── */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #999;
            padding: 14px 16px;
            border-bottom: 2px solid #111;
            text-align: left;
        }

        thead th.right {
            text-align: right;
        }

        tbody td {
            padding: 18px 16px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            color: #333;
        }

        tbody td.right {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* ── Totals ── */
        .totals-section {
            margin-top: 8px;
            border-top: 2px solid #111;
        }

        .totals-row {
            display: flex;
            justify-content: flex-end;
            padding: 12px 16px;
            font-size: 14px;
        }

        .totals-row .totals-label {
            width: 200px;
            text-align: right;
            padding-right: 32px;
            color: #666;
        }

        .totals-row .totals-value {
            width: 150px;
            text-align: right;
            font-variant-numeric: tabular-nums;
            color: #111;
        }

        .totals-row.grand-total {
            padding: 20px 16px;
            margin-top: 4px;
            border-top: 1px solid #eee;
        }

        .totals-row.grand-total .totals-label {
            font-size: 18px;
            font-weight: 700;
            color: #111;
        }

        .totals-row.grand-total .totals-value {
            font-size: 18px;
            font-weight: 700;
            color: #111;
        }

        /* ── Footer Sections ── */
        .info-section {
            margin-top: 48px;
            padding-top: 32px;
            border-top: 1px solid #f0f0f0;
        }

        .info-section-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #999;
            margin-bottom: 10px;
        }

        .info-section-content {
            font-size: 14px;
            color: #555;
            line-height: 1.7;
        }

        /* ── Actions ── */
        .actions {
            margin-top: 40px;
            padding-top: 32px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .btn-primary {
            background: #111;
            color: white;
        }

        .btn-primary:hover {
            background: #333;
        }

        .btn-secondary {
            background: white;
            color: #111;
            border: 1px solid #ddd;
        }

        .btn-secondary:hover {
            background: #f5f5f5;
            border-color: #bbb;
        }

        /* ── Responsive ── */
        @media (max-width: 700px) {
            .header {
                flex-direction: column;
                gap: 24px;
                padding: 32px 28px;
            }

            .header-right {
                text-align: left;
                align-items: flex-start;
            }

            .body {
                padding: 32px 28px;
            }

            .addresses {
                grid-template-columns: 1fr;
                gap: 32px;
            }

            .invoice-meta {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* ── Print Styles ── */
        @media print {
            @page {
                margin: 0.5in;
                size: letter;
            }

            html, body {
                background: white !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            body {
                font-size: 12px;
            }

            .page {
                margin: 0;
                padding: 0;
                max-width: 100%;
            }

            .invoice-card {
                box-shadow: none;
                border-radius: 0;
                border: none;
            }

            .header {
                background: #0a0a0a !important;
                color: white !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                padding: 32px 40px;
            }

            .body {
                padding: 32px 40px;
            }

            .invoice-meta {
                background: #fafafa !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .status-badge {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            thead th {
                border-bottom: 2px solid #111 !important;
            }

            .actions {
                display: none !important;
            }

            .site-nav {
                display: none !important;
            }

            a {
                text-decoration: none !important;
                color: inherit !important;
            }
        }
    </style>
</head>
<body>

<div class="page">
    <div class="invoice-card">

        <!-- Header -->
        <div class="header">
            <div class="header-left">
                <h1 class="title">Invoice</h1>
                <p class="invoice-number-display">{{.Invoice.InvoiceNumber}}</p>
            </div>
            <div class="header-right">
                <div class="logo-placeholder">
                    <!-- Logo will go here for paid users -->
                </div>
                <span class="company-name-header">{{.Invoice.CompanyName}}</span>
                <span class="currency-badge">{{.Invoice.Currency}}</span>
            </div>
        </div>

        <div class="body">

            <!-- Addresses -->
            <div class="addresses">
                <div class="address">
                    <div class="address-label">From</div>
                    <div class="address-name">{{.Invoice.CompanyName}}</div>
                    <div class="address-line">
                        {{if .Invoice.CompanyAddress}}{{.Invoice.CompanyAddress}}<br>{{end}}
                        {{if .Invoice.CompanyCity}}{{.Invoice.CompanyCity}}{{if .Invoice.CompanyState}}, {{.Invoice.CompanyState}}{{end}} {{.Invoice.CompanyZip}}<br>{{end}}
                        {{if .Invoice.CompanyCountry}}{{.Invoice.CompanyCountry}}<br>{{end}}
                        {{if .Invoice.CompanyEmail}}{{.Invoice.CompanyEmail}}{{end}}
                    </div>
                </div>
                <div class="address">
                    <div class="address-label">Bill To</div>
                    <div class="address-name">{{.Invoice.ClientName}}</div>
                    <div class="address-line">
                        {{if .Invoice.ClientAddress}}{{.Invoice.ClientAddress}}<br>{{end}}
                        {{if .Invoice.ClientCity}}{{.Invoice.ClientCity}}{{if .Invoice.ClientState}}, {{.Invoice.ClientState}}{{end}} {{.Invoice.ClientZip}}<br>{{end}}
                        {{if .Invoice.ClientCountry}}{{.Invoice.ClientCountry}}<br>{{end}}
                        {{if .Invoice.ClientEmail}}{{.Invoice.ClientEmail}}{{end}}
                    </div>
                </div>
            </div>

            <!-- Invoice Meta -->
            <div class="invoice-meta">
                <div class="meta-item">
                    <span class="meta-label">Invoice Number</span>
                    <span class="meta-value">{{.Invoice.InvoiceNumber}}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Status</span>
                    <span class="meta-value">
                        <span class="status-badge status-{{.Invoice.Status}}">{{.Invoice.Status}}</span>
                    </span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Issue Date</span>
                    <span class="meta-value">{{.Invoice.IssueDate}}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Due Date</span>
                    <span class="meta-value">{{if .Invoice.DueDate}}{{.Invoice.DueDate}}{{else}}—{{end}}</span>
                </div>
            </div>

            <!-- Line Items -->
            <table>
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="right">Qty</th>
                        <th class="right">Price</th>
                        <th class="right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Invoice.Items}}
                    <tr>
                        <td>{{.Description}}</td>
                        <td class="right">{{.Quantity}}</td>
                        <td class="right">{{.UnitPrice}}</td>
                        <td class="right">{{.LineTotal}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>

            <!-- Totals -->
            <div class="totals-section">
                <div class="totals-row">
                    <span class="totals-label">Subtotal</span>
                    <span class="totals-value">{{.Invoice.Subtotal}}</span>
                </div>

                {{if .Invoice.TaxRate}}
                <div class="totals-row">
                    <span class="totals-label">Tax ({{.Invoice.TaxRate}}%)</span>
                    <span class="totals-value">{{.Invoice.TaxAmount}}</span>
                </div>
                {{end}}

                {{if .Invoice.Discount}}
                <div class="totals-row">
                    <span class="totals-label">Discount</span>
                    <span class="totals-value">-{{.Invoice.Discount}}</span>
                </div>
                {{end}}

                <div class="totals-row grand-total">
                    <span class="totals-label">Total</span>
                    <span class="totals-value">{{.Invoice.Total}}</span>
                </div>
            </div>

            <!-- Payment Details -->
            {{if .Invoice.PaymentDetails}}
            <div class="info-section">
                <div class="info-section-label">Payment Details</div>
                <div class="info-section-content">{{.Invoice.PaymentDetails}}</div>
            </div>
            {{end}}

            <!-- Notes -->
            {{if .Invoice.Notes}}
            <div class="info-section">
                <div class="info-section-label">Notes</div>
                <div class="info-section-content">{{.Invoice.Notes}}</div>
            </div>
            {{end}}

            <!-- Actions -->
		<div class="actions">
    			{{if eq .Invoice.Status "draft"}}
    			<a href="/invoices/{{.Invoice.ID}}/edit" class="btn btn-secondary">Edit Invoice</a>
    {{end}}
   			 <a href="/invoices/{{.Invoice.ID}}/duplicate" class="btn btn-secondary">Duplicate</a>
    			<a href="/invoices/{{.Invoice.ID}}/pdf" class="btn btn-primary">Download PDF</a>
    			<button class="btn btn-secondary" onclick="window.print()">Print</button>
</div>	
        </div>
    </div>
</div>

</body>
</html>
