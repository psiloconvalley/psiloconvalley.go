<!DOCTYPE html>
<html lang="en">
<head>
    <title>Dashboard | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "dashboard-styles" .}}
    {{template "dashboard-onboarding-styles" .}}
    {{template "app-components" .}}

</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>{{.T.DashboardTitle}}</h1>
            <div class="top-sub">{{.T.DashboardWelcome}}{{if .User.Name}}, {{.User.Name}}{{end}}</div>
        </div>
    </div>

    {{/* ── Upgrade banner for free users ── */}}
    {{if not .IsPro}}
    <div class="upgrade-banner">
        <div class="upgrade-text">
	   <strong>{{.T.DashboardUpgradeTitle}}</strong> — {{.T.DashboardUpgradeBody}}
        </div>
     <a href="/pricing" class="btn-upgrade">{{.T.DashboardUpgradeCta}}</a>
    </div>
    {{end}}
       {{if .ShowPasskeyNudge}}
    <div class="upgrade-banner" style="border-color: rgba(96,165,250,0.28); background: linear-gradient(180deg, rgba(37,99,235,0.10), rgba(17,24,39,0.72));">
        <div class="upgrade-text">
	   <strong style="color:#93c5fd;">{{.T.DashboardPasskeyTitle}}</strong> — {{.T.DashboardPasskeyBody}}
        </div>
    <a href="/profile#passkey" class="btn-upgrade" style="background:#2563eb;">{{.T.DashboardPasskeyCta}}</a>
    </div>
    {{end}}

    {{/* ── Stats ── */}}
    {{if .TotalCount}}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">💰 {{.T.DashboardRevenue}}</div>
            <div class="stat-value green">{{.Revenue}}</div>
            <div class="stat-sub">{{.T.FromPaidInvoices}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📤 {{.T.DashboardOutstanding}}</div>
            <div class="stat-value yellow">{{.Outstanding}}</div>
            <div class="stat-sub">{{.T.AwaitingPayment}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">⚠️ {{.T.DashboardOverdue}}</div>
            <div class="stat-value red">{{.Overdue}}</div>
            <div class="stat-sub">{{.T.PastDueDate}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📋 {{.T.DashboardThisMonth}}</div>
            <div class="stat-value">{{.MonthlyCount}}</div>
            <div class="stat-sub">{{.TotalCount}} {{.T.InvoicesTotal}}</div>
        </div>
    </div>
    {{if .HasExpenses}}
    <div class="stats-grid stats-grid-two">
        <div class="stat-card">
	    <div class="stat-label">💸 {{.T.DashboardExpensesMonth}}</div>
            <div class="stat-value red">{{.MonthlyExpenses}}</div>
            <div class="stat-sub">
                <a href="/expenses" style="color:rgba(255,255,255,0.4);text-decoration:none;">
                    {{.T.ViewExpenses}}
                </a>
            </div>
        </div>
        <div class="stat-card">
	    <div class="stat-label">📊 {{.T.DashboardNetProfitMonth}}</div>
            <div class="stat-value {{if gt .NetProfitCents 0}}green{{else}}red{{end}}">
                {{.NetProfit}}
            </div>
            <div class="stat-sub">{{.T.RevenueMinusExpenses}}</div>
        </div>
    </div>
    {{end}}

    {{/* ── Onboarding ── */}}
    {{else if not .OnboardingDone}}
    {{template "dashboard-onboarding" .}}
    {{end}}

    {{/* ── Needs Attention ── */}}
    {{template "dashboard-needs-attention" .}}

    {{/* ── Recent Invoices ── */}}
    <div class="section">
        <div class="section-header">
            <div class="section-title">{{.T.DashboardRecentInvoices}}</div>
            <a href="/invoices" class="section-link">{{.T.DashboardViewAll}}</a>
        </div>

	          {{if .RecentInvoices}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
			<th>{{.T.DashboardThInvoice}}</th>
                        <th>{{.T.DashboardThClient}}</th>
                        <th>{{.T.DashboardThStatus}}</th>
                        <th>{{.T.DashboardThDue}}</th>
                        <th class="right">{{.T.DashboardThTotal}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .RecentInvoices}}
                    <tr>
                        <td>
                            <a href="/invoices/{{.ID}}" class="inv-link">
                                {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                            </a>
                        </td>
                        <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                        <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                        <td style="color: rgba(255,255,255,0.5);">
                            {{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}
                        </td>
                        <td class="right mono">{{money .TotalCents}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="table-wrap">
            <div class="empty">
                <div class="empty-icon">📭</div>
                <div class="empty-title">{{.T.NoInvoicesYet}}</div>
                <div class="empty-sub">{{.T.CreateFirstInvoice}}</div>
            </div>
        </div>
        {{end}}
    </div>

    {{/* ── Recent Estimates ── */}}
    <div class="section">
        <div class="section-header">
            <div class="section-title">{{.T.DashboardRecentEstimates}}</div>
            <a href="/estimates" class="section-link">{{.T.DashboardViewAll}}</a>
        </div>
        {{if .RecentEstimates}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
		     	<th>{{.T.DashboardThEstimate}}</th>
        		<th>{{.T.DashboardThClient}}</th>
                        <th>{{.T.DashboardThStatus}}</th>
                        <th class="right">{{.T.DashboardThTotal}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .RecentEstimates}}
                    <tr>
                        <td>
                            <a href="/estimates/{{.ID}}" class="inv-link">
                                {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                            </a>
                        </td>
                        <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                        <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                        <td style="color: rgba(255,255,255,0.5);">
                            {{.IssueDate.Format "Jan 2, 2006"}}
                        </td>
                        <td class="right mono">{{money .TotalCents}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="table-wrap">
            <div class="empty">
                <div class="empty-icon">📋</div>
                <div class="empty-title">{{.T.NoEstimatesYet}}</div>
                <div class="empty-sub">{{.T.CreateFirstEstimate}}</div>
            </div>
        </div>
        {{end}}
    </div>

</div>

</body>
</html>
