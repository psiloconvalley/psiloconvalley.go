<!DOCTYPE html>
<html lang="en">
<head>
    <title>Dashboard | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
	
    {{template "nav-styles" .}}

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        /* ── Header ── */
	.top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-sub {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            margin-top: 6px;
            font-family: monospace;
        }
                .btn {
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 6px;
            font-family: inherit;
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .btn-white { background: #fff; color: #000; }
        .btn-white:hover { opacity: 0.85; }

        /* ── Stats grid ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }
        .stat-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 12px;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
            font-variant-numeric: tabular-nums;
            color: #fff;
        }
        .stat-value.green { color: #4ade80; }
        .stat-value.yellow { color: #fbbf24; }
        .stat-value.red { color: #f87171; }
        .stat-sub {
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            margin-top: 6px;
        }

        /* ── Section ── */
        .section {
            margin-bottom: 32px;
        }
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .section-title {
            font-size: 14px;
            font-weight: 700;
            color: rgba(255,255,255,0.6);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .section-link {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            text-decoration: none;
        }
        .section-link:hover { color: white; }

        /* ── Table ── */
        .table-wrap {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            overflow: hidden;
        }
        table { width: 100%; border-collapse: collapse; }
        th {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.4);
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 13px;
            vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        .inv-link {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        .inv-link:hover { text-decoration: underline; }

        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-draft   { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); }
        .badge-sent    { background: #1e3a5f; color: #93c5fd; }
        .badge-paid    { background: #14532d; color: #86efac; }
        .badge-void    { background: #450a0a; color: #fca5a5; }
        .badge-overdue { background: #431407; color: #fdba74; }
	.badge-pending  { background: #1e3a5f; color: #93c5fd; }
        .badge-accepted { background: #14532d; color: #86efac; }
        .badge-declined { background: #450a0a; color: #fca5a5; }

        .right { text-align: right; }
        .mono { font-variant-numeric: tabular-nums; }

        /* ── Quick actions ── */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 32px;
        }
        .action-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 20px;
            text-decoration: none;
            color: white;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .action-card:hover {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-1px);
        }
        .action-icon { font-size: 24px; }
        .action-title { font-size: 14px; font-weight: 700; }
        .action-sub { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 2px; }

        /* ── Pro upgrade banner ── */
        .upgrade-banner {
            background: linear-gradient(135deg, rgba(251,191,36,0.1) 0%, rgba(245,158,11,0.05) 100%);
            border: 1px solid rgba(251,191,36,0.2);
            border-radius: 12px;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }
        .upgrade-text { font-size: 14px; color: rgba(255,255,255,0.8); }
        .upgrade-text strong { color: #fbbf24; }
        .btn-upgrade {
            background: #fbbf24;
            color: #000;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }
        .btn-upgrade:hover { background: #f59e0b; }

        /* ── Empty state ── */
        .empty {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-icon { font-size: 32px; margin-bottom: 12px; }
        .empty-title { font-size: 16px; font-weight: 700; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
        .empty-sub { font-size: 13px; }

        /* ── Mobile ── */
        @media (max-width: 639px) {
            .container { padding: 24px 16px 80px; }
	    .top { padding-left: 16px; }
            .top h1 { font-size: 22px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .stat-value { font-size: 22px; }
            .quick-actions { grid-template-columns: 1fr; }
        }

        @media (max-width: 400px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
	<h1>{{.T.DashboardTitle}}</h1>
	<div class="top-sub">{{.T.DashboardWelcome}}{{if .User.Name}}, {{.User.Name}}{{end}}</div>
        </div>
    </div>

    {{/* ── Upgrade banner for free users ── */}}
    {{if not .IsPro}}
    <div class="upgrade-banner">
        <div class="upgrade-text">
            <strong>Upgrade to Pro</strong> — Unlock recurring invoices, automatic payment reminders, and unlimited clients.
        </div>
        <a href="/pricing" class="btn-upgrade">Upgrade for $18.88/mo →</a>
    </div>
    {{end}}

       {{if .TotalCount}}
    {{/* ── Stats ── */}}
    <div class="stats-grid">
        <div class="stat-card">
	 <div class="stat-label">💰 {{.T.DashboardRevenue}}</div>
            <div class="stat-value green">{{.Revenue}}</div>
		<div class="stat-sub">{{.T.FromPaidInvoices}}</div>
        </div>
        <div class="stat-card">
	    <div class="stat-label">📤 {{.T.DashboardOutstanding}}</div>
            <div class="stat-value yellow">{{.Outstanding}}</div>
	    <div class="stat-sub">{{.T.AwaitingPayment}}</div>
        </div>
        <div class="stat-card">
	    <div class="stat-label">⚠️ {{.T.DashboardOverdue}}</div>
            <div class="stat-value red">{{.Overdue}}</div>
	    <div class="stat-sub">{{.T.PastDueDate}}</div>
        </div>
        <div class="stat-card">
	     <div class="stat-label">📋 {{.T.DashboardThisMonth}}</div>
            <div class="stat-value">{{.MonthlyCount}}</div>
            <div class="stat-sub">{{.TotalCount}} invoices total</div>
        </div>
    </div>
    {{else}}
    {{/* ── Onboarding: first-time user ── */}}
    <div style="
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 48px 40px;
        text-align: center;
        margin-bottom: 32px;
    ">
        <div style="font-size: 48px; margin-bottom: 16px;">🚀</div>
        <div style="font-size: 24px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 8px;">Welcome to PsiloConValley</div>
        <div style="font-size: 14px; color: rgba(255,255,255,0.5); max-width: 420px; margin: 0 auto 28px; line-height: 1.6;">
            Create your first invoice in under 60 seconds. Set up your business profile, add a client, and start getting paid.
        </div>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/profile" style="
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff;
                padding: 12px 24px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                transition: all 0.2s;
            ">1. Set Up Profile</a>
            <a href="/clients/new" style="
                background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff;
                padding: 12px 24px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                transition: all 0.2s;
            ">2. Add a Client</a>
            <a href="/invoices/new" style="
                background: #fff;
                color: #0a0f1a;
                padding: 12px 24px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                border: none;
                transition: all 0.2s;
            ">3. Create Invoice →</a>
        </div>
    </div>
    {{end}}
  
      {{/* ── Needs attention ── */}}
    <div class="section">
        <div class="section-header">
	 <div class="section-title">{{.T.DashboardNeedsAttention}}</div>
        </div>

	{{if .NeedsAttention}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th class="right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .NeedsAttention}}
                    <tr>
                        <td>
                            <a href="/{{if eq .DocumentType "estimate"}}estimates{{else}}invoices{{end}}/{{.ID}}" class="inv-link">
                                {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                            </a>
                        </td>
                        <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                        <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                        <td class="right mono">{{money .TotalCents}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="table-wrap">
            <div class="empty">
                <div class="empty-icon">✓</div>
		 <div class="empty-title">{{.T.DashboardAllCaughtUp}}</div>
	    <div class="empty-sub">{{.T.DashboardNoCaughtUpSub}}</div>
            </div>
        </div>
        {{end}}
    </div>
      {{/* ── Recent invoices ── */}}
    <div class="section">
        <div class="section-header">
            <div class="section-title">{{.T.DashboardRecentInvoices}}</div>
            <a href="/invoices" class="section-link">{{.T.DashboardViewAll}}</a>
        </div>

        {{if .RecentInvoices}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Due</th>
                        <th class="right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .RecentInvoices}}
                    <tr>
                        <td>
                            <a href="/invoices/{{.ID}}" class="inv-link">
                                {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                            </a>
                        </td>
                        <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                        <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                        <td style="color: rgba(255,255,255,0.5);">
                            {{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}
                        </td>
                        <td class="right mono">{{money .TotalCents}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="table-wrap">
            <div class="empty">
                <div class="empty-icon">📭</div>
                <div class="empty-title">{{.T.NoInvoicesYet}}</div>
                <div class="empty-sub">Create your first invoice to get started.</div>
            </div>
        </div>
        {{end}}
    </div>

    {{/* ── Recent estimates ── */}}
    <div class="section">
        <div class="section-header">
            <div class="section-title">{{.T.DashboardRecentEstimates}}</div>
            <a href="/estimates" class="section-link">{{.T.DashboardViewAll}}</a>
        </div>

        {{if .RecentEstimates}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Estimate</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .RecentEstimates}}
                    <tr>
                        <td>
                            <a href="/estimates/{{.ID}}" class="inv-link">
                                {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                            </a>
                        </td>
                        <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                        <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                        <td style="color: rgba(255,255,255,0.5);">
                            {{.IssueDate.Format "Jan 2, 2006"}}
                        </td>
                        <td class="right mono">{{money .TotalCents}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="table-wrap">
            <div class="empty">
                <div class="empty-icon">📋</div>
                <div class="empty-title">{{.T.NoEstimatesYet}}</div>
                <div class="empty-sub">Create your first estimate to start winning jobs.</div>
            </div>
        </div>
        {{end}}
    </div>

</div>

</body>
</html> 
</body>
</html>
