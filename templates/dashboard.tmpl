<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "dashboard-styles" .}}
    {{template "dashboard-onboarding-styles" .}}
    {{template "app-components" .}}
</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>{{.T.DashboardTitle}}</h1>
            <div class="top-sub">{{.T.DashboardWelcome}}{{if .User.Name}}, {{.User.Name}}{{end}}</div>
        </div>
    </div>

    {{/* ── Upgrade banner for free users ── */}}
    {{if not .IsPro}}
    <div class="upgrade-banner">
        <div class="upgrade-text">
            <strong>{{.T.DashboardUpgradeTitle}}</strong> — {{.T.DashboardUpgradeBody}}
        </div>
        <a href="/pricing" class="db-btn-upgrade">{{.T.DashboardUpgradeCta}}</a>
    </div>
    {{end}}

    {{if .ShowPasskeyNudge}}
    <div class="passkey-banner">
        <div class="upgrade-text">
            <strong>{{.T.DashboardPasskeyTitle}}</strong> — {{.T.DashboardPasskeyBody}}
        </div>
        <a href="/profile#passkey" class="db-btn-passkey">{{.T.DashboardPasskeyCta}}</a>
    </div>
    {{end}}

    {{/* ── Stats ── */}}
    {{if .TotalCount}}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">💰 {{.T.DashboardRevenue}}</div>
            <div class="stat-value green">{{.Revenue}}</div>
            <div class="stat-sub">{{.T.FromPaidInvoices}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📤 {{.T.DashboardOutstanding}}</div>
            <div class="stat-value yellow">{{.Outstanding}}</div>
            <div class="stat-sub">{{.T.AwaitingPayment}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">⚠️ {{.T.DashboardOverdue}}</div>
            <div class="stat-value red">{{.Overdue}}</div>
            <div class="stat-sub">{{.T.PastDueDate}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📋 {{.T.DashboardThisMonth}}</div>
            <div class="stat-value">{{.MonthlyCount}}</div>
            <div class="stat-sub">{{.TotalCount}} {{.T.InvoicesTotal}}</div>
        </div>
    </div>

    {{if .HasExpenses}}
    <div class="stats-grid stats-grid-two">
        <div class="stat-card">
            <div class="stat-label">💸 {{.T.DashboardExpensesMonth}}</div>
            <div class="stat-value red">{{.MonthlyExpenses}}</div>
            <div class="stat-sub">
                <a href="/expenses">{{.T.ViewExpenses}}</a>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📊 {{.T.DashboardNetProfitMonth}}</div>
            <div class="stat-value {{if gt .NetProfitCents 0}}green{{else}}red{{end}}">
                {{.NetProfit}}
            </div>
            <div class="stat-sub">{{.T.RevenueMinusExpenses}}</div>
        </div>
    </div>
    {{end}}

    {{/* ── Quick Actions ── */}}
    <div class="quick-actions">
        <a href="/invoices/new" class="action-card">
            <div class="action-icon">📄</div>
            <div>
                <div class="action-title">{{.T.DashboardNewInvoice}}</div>
                <div class="action-sub">{{.T.DashboardNewInvoiceSub}}</div>
            </div>
        </a>
        <a href="/invoices" class="action-card">
            <div class="action-icon">📊</div>
            <div>
                <div class="action-title">{{.T.DashboardViewInvoices}}</div>
                <div class="action-sub">{{.T.DashboardViewInvoicesSub}}</div>
            </div>
        </a>
        <a href="/clients" class="action-card">
            <div class="action-icon">👥</div>
            <div>
                <div class="action-title">{{.T.DashboardClients}}</div>
                <div class="action-sub">{{.T.DashboardClientsSub}}</div>
            </div>
        </a>
        <a href="/profile" class="action-card">
            <div class="action-icon">⚙️</div>
            <div>
                <div class="action-title">{{.T.DashboardSettings}}</div>
                <div class="action-sub">{{.T.DashboardSettingsSub}}</div>
            </div>
        </a>
    </div>

    {{/* ── Onboarding (new users only) ── */}}
    {{else if not .OnboardingDone}}
    {{template "dashboard-onboarding" .}}
    {{end}}

    {{/* ── Needs Attention ── */}}
    {{template "dashboard-needs-attention" .}}

    {{/* ── Quote Requests ── */}}
    {{template "dashboard-quote-requests" .}}

</div>

</body>
</html>
