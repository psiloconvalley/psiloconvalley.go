<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "auth-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="auth-container">
    <div class="auth-card">

        {{if .Success}}

        <div class="auth-success">
            <span class="auth-success-icon">{{.T.ForgotSuccessIcon}}</span>
            <div class="auth-success-title">{{.T.ForgotSuccessTitle}}</div>
            <p class="auth-success-body">{{.T.ForgotSuccessBody}}</p>
            <a href="/login" class="submit-link">{{.T.ForgotSuccessBack}}</a>
        </div>

        {{else}}

        <h1 class="auth-title">{{.T.ForgotTitle}}</h1>
        <p class="auth-subtitle">{{.T.ForgotSub}}</p>

        {{if .Error}}
        <div class="error-banner">{{.Error}}</div>
        {{end}}

        <form method="POST" action="/forgot-password" id="forgot-form">
            {{.csrfField}}
            <div class="form-group">
                <label>{{.T.ForgotLabel}}</label>
                <input type="email" name="email"
                       placeholder="you@company.com"
                       autocomplete="email" autofocus required>
            </div>

            <button type="submit" class="submit-btn" id="submit-btn">{{.T.ForgotSubmit}}</button>
        </form>

        <div class="auth-note">
            <span class="auth-note-icon">🔒</span>
            <span class="auth-note-text">{{.T.ForgotSecNote}}</span>
        </div>

        {{end}}

        <div class="auth-footer">
            <a href="/login">{{.T.ForgotBack}}</a>
        </div>

    </div>
</div>

<script>
var f = document.getElementById('forgot-form');
if (f) f.addEventListener('submit', function() {
    var btn = document.getElementById('submit-btn');
    if (btn) { btn.disabled = true; btn.textContent = '{{.T.ForgotSending}}'; }
});
</script>

</body>
</html>
