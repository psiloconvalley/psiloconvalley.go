<!DOCTYPE html>
<html lang="en">
<head>
    <title>Estimates | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}
     {{template "app-styles" .}}

    {{template "estimates-list-styles" .}}
    {{template "app-components" .}}


</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>Estimates</h1>
            <div class="top-subtitle">
                {{len .Estimates}} total
            </div>
        </div>
        <a href="/estimates/new" class="btn-new">+ New Estimate</a>
    </div>

    {{if .Deleted}}
    <div id="success-banner" style="
        background: rgba(16,185,129,0.1);
        border: 1px solid rgba(16,185,129,0.3);
        color: #6ee7b7;
        padding: 14px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
        font-family: monospace;
        display: flex;
        justify-content: space-between;
        align-items: center;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.4s ease, transform 0.4s ease;
        cursor: pointer;
    " onclick="dismissBanner()">
        <span>✓ Estimate deleted successfully</span>
        <span style="font-size: 18px; opacity: 0.5;">✕</span>
    </div>
    <script>
    (function() {
        var banner = document.getElementById('success-banner');
        requestAnimationFrame(function() {
            banner.style.opacity = '1';
            banner.style.transform = 'translateY(0)';
        });
        setTimeout(function() { dismissBanner(); }, 4000);
    })();
    function dismissBanner() {
        var banner = document.getElementById('success-banner');
        if (!banner) return;
        banner.style.opacity = '0';
        banner.style.transform = 'translateY(-8px)';
        setTimeout(function() { banner.remove(); }, 400);
    }
    </script>
    {{end}}

    {{if .Converted}}
    <div id="converted-banner" style="
        background: rgba(59,130,246,0.1);
        border: 1px solid rgba(59,130,246,0.3);
        color: #93c5fd;
        padding: 14px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
        font-family: monospace;
        display: flex;
        justify-content: space-between;
        align-items: center;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.4s ease, transform 0.4s ease;
        cursor: pointer;
    " onclick="this.style.opacity='0'; this.style.transform='translateY(-8px)'; setTimeout(()=>this.remove(),400);">
        <span>✓ Estimate converted to invoice</span>
        <span style="font-size: 18px; opacity: 0.5;">✕</span>
    </div>
    <script>
    (function() {
        var b = document.getElementById('converted-banner');
        requestAnimationFrame(function() {
            b.style.opacity = '1';
            b.style.transform = 'translateY(0)';
        });
    })();
    </script>
    {{end}}

    {{if not .Estimates}}
    <div class="empty">
        <div class="empty-icon">📝</div>
        <div class="empty-title">No estimates yet</div>
        <div class="empty-sub">Create your first estimate to send to a client for approval.</div>
        <a href="/estimates/new" class="btn-new">Create Estimate</a>
    </div>
    {{else}}

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Estimate</th>
                    <th>Client</th>
                    <th>Issued</th>
                    <th>Valid Until</th>
                    <th>Status</th>
                    <th class="right">Total</th>
                    <th class="right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Estimates}}
                <tr>
                    <td>
                        <a href="/estimates/{{.ID}}" class="inv-link">
                            {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}
                        </a>
                    </td>
                    <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                    <td>{{if .IssueDate}}{{.IssueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td>{{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td>
                        <span class="badge badge-{{.Status}}">{{.Status}}</span>
                    </td>
                    <td class="right mono">{{money .TotalCents}}</td>
		    <td>
                        <div class="row-actions">
                            {{if eq .Status "draft"}}
                            <a href="/estimates/{{.ID}}/send" class="small-btn">Send</a>
                            <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                            <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">Delete</button>
                            {{else if eq .Status "sent"}}
                            <a href="/estimates/{{.ID}}/send" class="small-btn">Resend</a>
                            <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                            <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                            {{else if eq .Status "accepted"}}
                            <form method="POST" action="/estimates/{{.ID}}/convert" style="display:inline;">
                                {{$.csrfField}}
                                <button type="submit" class="small-btn success">Convert</button>
                            </form>
                            <button type="button" class="small-btn" onclick="openEditAcceptedModal({{.ID}})">Edit</button>
                            <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                            {{else if or (eq .Status "rejected") (eq .Status "expired")}}
                            <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                            <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                            {{else if eq .Status "converted"}}
                            <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                            {{end}}
                        </div>
                    </td>
				                                            </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    {{/* ── MOBILE CARD LIST ── */}}
    <div class="card-list">
        {{range .Estimates}}
        <div class="inv-card">
            <a href="/estimates/{{.ID}}" style="text-decoration:none; color:inherit; display:block;">
                <div class="inv-card-top">
                    <span class="inv-card-number">
                        {{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}Untitled{{end}}
                    </span>
                    <span class="badge badge-{{.Status}}">{{.Status}}</span>
                </div>
                <div class="inv-card-client">
                    {{if .ClientName}}{{.ClientName}}{{else}}No client{{end}}
                </div>
                <div class="inv-card-bottom">
                    <div class="inv-card-dates">
                        {{if .IssueDate}}Created {{.IssueDate.Format "Jan 2, 2006"}}{{end}}
                    </div>
                    <div class="inv-card-total">{{money .TotalCents}}</div>
                </div>
            </a>
		            <div class="inv-card-actions">
                {{if eq .Status "draft"}}
                <a href="/estimates/{{.ID}}/send" class="small-btn">Send</a>
                <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                <button type="button" class="small-btn danger" onclick="openDeleteModal('{{.InvoiceNumber}}', {{.ID}})">Delete</button>
                {{else if eq .Status "sent"}}
                <a href="/estimates/{{.ID}}/send" class="small-btn">Resend</a>
                <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                {{else if eq .Status "accepted"}}
                <form method="POST" action="/estimates/{{.ID}}/convert" style="display:inline; flex:1;">
                    {{$.csrfField}}
                    <button type="submit" class="small-btn success" style="width:100%;">Convert</button>
                </form>
                <button type="button" class="small-btn" onclick="openEditAcceptedModal({{.ID}})">Edit</button>
                <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                {{else if or (eq .Status "rejected") (eq .Status "expired")}}
                <a href="/estimates/{{.ID}}/edit" class="small-btn">Edit</a>
                <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                {{else}}
                <a href="/estimates/{{.ID}}" class="small-btn">View</a>
                {{end}}
            </div>
                </div>
        {{end}}
    </div>

    {{end}}
</div>

<!-- ═══════════ DELETE CONFIRMATION MODAL ═══════════ -->
<div id="delete-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:500;">
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:32px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="font-size:20px; font-weight:800; color:#fff; margin-bottom:8px;">Delete Draft Estimate</div>
        <div style="font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:20px; line-height:1.5;">This action <strong style="color:#fca5a5;">cannot be undone</strong>. The estimate and all its line items will be permanently deleted.</div>
        <div style="font-size:13px; font-weight:600; color:rgba(255,255,255,0.6); margin-bottom:8px;">Type the estimate number to confirm:</div>
        <div style="font-size:13px; font-weight:700; color:#fca5a5; background:rgba(220,38,38,0.15); border:1px solid rgba(220,38,38,0.3); border-radius:6px; padding:8px 12px; margin-bottom:12px; font-family:monospace;" id="delete-modal-number"></div>
        <input type="text" id="delete-confirm-input" placeholder="Type estimate number here" oninput="checkDeleteConfirm()"
            style="width:100%; padding:10px 12px; border:1px solid rgba(255,255,255,0.15); border-radius:8px; font-size:14px; :wq
	    font-family:inherit; margin-bottom:16px; background:rgba(255,255,255,0.05); color:#fff;">
        <div style="display:flex; gap:12px;">
            <button type="button" onclick="closeDeleteModal()" style="flex:1; padding:11px; border:1px solid rgba(255,255,255,0.15); background:transparent; color:rgba(255,255,255,0.6); border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;">Cancel</button>
            <form id="delete-form" method="POST" action="" style="flex:1;">
                {{.csrfField}}
                <input type="hidden" name="confirm_number" id="delete-confirm-hidden">
                <button type="submit" id="delete-submit-btn" disabled
                    style="width:100%; padding:11px; background:#dc2626; color:white; border:none; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer; opacity:0.4;">
                    Delete Permanently
       </button>
            </form>
        </div>
    </div>
</div>

<script>
var _deleteInvoiceNumber = '';

function openDeleteModal(invoiceNumber, invoiceID) {
    _deleteInvoiceNumber = invoiceNumber;
    document.getElementById('delete-modal-number').textContent = invoiceNumber;
    document.getElementById('delete-confirm-input').value = '';
    document.getElementById('delete-confirm-hidden').value = '';
    document.getElementById('delete-submit-btn').disabled = true;
    document.getElementById('delete-submit-btn').style.opacity = '0.4';
    document.getElementById('delete-form').action = '/estimates/' + invoiceID + '/delete';
    document.getElementById('delete-overlay').style.display = 'block';
    setTimeout(function(){ document.getElementById('delete-confirm-input').focus(); }, 50);
}

function closeDeleteModal() {
    document.getElementById('delete-overlay').style.display = 'none';
}

function checkDeleteConfirm() {
    var val = document.getElementById('delete-confirm-input').value.trim();
    var btn = document.getElementById('delete-submit-btn');
    var hidden = document.getElementById('delete-confirm-hidden');
    if (val === _deleteInvoiceNumber) {
        btn.disabled = false;
        btn.style.opacity = '1';
        hidden.value = val;
    } else {
        btn.disabled = true;
        btn.style.opacity = '0.4';
        hidden.value = '';
    }
}

document.getElementById('delete-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});
</script>

<!-- ═══════════ EDIT ACCEPTED ESTIMATE MODAL ═══════════ -->
<div id="edit-accepted-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:600;">
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:#1e293b; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:32px; max-width:460px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="font-size:32px; margin-bottom:12px;">⚠️</div>
        <div style="font-size:20px; font-weight:800; color:#fff; margin-bottom:8px;">This estimate has been accepted</div>
        <div style="font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:24px; line-height:1.6;">
            The client has already approved this estimate. What would you like to do?
        </div>

        <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
            <form id="convert-form" method="POST" action="">
                {{.csrfField}}
                <button type="submit" style="width:100%; padding:14px; background:#14532d; color:#86efac; border:1px solid rgba(134,239,172,0.3); border-radius:10px; font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; text-align:left;">
                    <span style="font-size:16px;">🔄</span>&nbsp;&nbsp;Convert to Invoice
                    <div style="font-size:11px; font-weight:400; color:rgba(134,239,172,0.7); margin-top:4px;">Recommended — create an invoice from this accepted estimate</div>
                </button>
            </form>

            <a id="edit-accepted-link" href="" style="display:block; padding:14px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); border-radius:10px; font-size:14px; font-weight:700; color:#fff; text-decoration:none; font-family:inherit;">
                <span style="font-size:16px;">✏️</span>&nbsp;&nbsp;Edit Anyway
                <div style="font-size:11px; font-weight:400; color:rgba(255,255,255,0.4); margin-top:4px;">Status will revert to draft — client will need to re-accept</div>
            </a>

            <button type="button" onclick="closeEditAcceptedModal()" style="padding:14px; background:none; border:1px solid rgba(255,255,255,0.1); border-radius:10px; font-size:14px; font-weight:600; color:rgba(255,255,255,0.4); cursor:pointer; font-family:inherit;">
                Cancel
            </button>
        </div>
    </div>
</div>

<script>
function openEditAcceptedModal(estimateID) {
    document.getElementById('convert-form').action = '/estimates/' + estimateID + '/convert';
    document.getElementById('edit-accepted-link').href = '/estimates/' + estimateID + '/edit?revert=true';
    document.getElementById('edit-accepted-overlay').style.display = 'block';
}
function closeEditAcceptedModal() {
    document.getElementById('edit-accepted-overlay').style.display = 'none';
}
document.getElementById('edit-accepted-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeEditAcceptedModal();
});
</script>

</body>
</html>
