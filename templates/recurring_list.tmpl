<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "recurring-list-styles" .}}
    {{template "app-components" .}}

</head>
<body>

{{template "nav" .}}

<div class="container">

        <div class="top">
        <div>
            <h1>Recurring Invoices</h1>
            <div class="top-subtitle">
                {{len .Schedules}} schedule{{if ne (len .Schedules) 1}}s{{end}}
            </div>
        </div>
        <a href="/invoices/new" class="btn btn-white">+ New Invoice</a>
    </div>
    <div class="info-banner">
        Recurring invoices are automatically generated and optionally sent to your client on your chosen schedule.
        To create one, open any invoice and turn on <strong>Make Recurring</strong> in the sidebar.
    </div>

    {{if not .Schedules}}
    <div class="empty">
        <div class="empty-icon">🔁</div>
        <div class="empty-title">No recurring invoices yet</div>
        <div class="empty-sub">
            Create an invoice and turn on "Make Recurring" in the sidebar to get started.
        </div>
        <a href="/invoices/new" class="btn btn-white">Create Invoice</a>
    </div>
    {{else}}

    {{/* ── DESKTOP TABLE ── */}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Template Invoice</th>
                    <th>Client</th>
                    <th>Frequency</th>
                    <th>Auto-Send</th>
                    <th>Next Run</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{range .Schedules}}
                <tr>
                    <td>
                        <a href="/invoices/{{.TemplateInvoiceID}}" class="inv-link">
                            {{.InvoiceNumber}}
                        </a>
                    </td>
                    <td>{{if .ClientName}}{{.ClientName}}{{else}}—{{end}}</td>
                    <td><span class="freq-badge">{{.Frequency}}</span></td>
                    <td>{{if .SendAutomatically}}✅{{else}}📝 Draft only{{end}}</td>
                    <td style="font-variant-numeric: tabular-nums; color: rgba(255,255,255,0.6);">
                        {{.NextRunAt.Format "Jan 2, 2006"}}
                    </td>
                    <td>
                        {{if .Active}}
                        <span class="badge badge-active">Active</span>
                        {{else}}
                        <span class="badge badge-paused">Paused</span>
                        {{end}}
                    </td>
                    <td>
                        <div class="actions">
                            {{if .Active}}
                            <form method="POST" action="/recurring/{{.ID}}/pause">
                                {{$.csrfField}}
                                <button type="submit" class="btn btn-muted">⏸ Pause</button>
                            </form>
                            {{else}}
                            <form method="POST" action="/recurring/{{.ID}}/resume">
                                {{$.csrfField}}
                                <button type="submit" class="btn btn-success">▶ Resume</button>
                            </form>
                            {{end}}
                            <form method="POST" action="/recurring/{{.ID}}/delete"
                                  onsubmit="return confirm('Delete this recurring schedule? This cannot be undone.')">
                                {{$.csrfField}}
                                <button type="submit" class="btn btn-danger">🗑 Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    {{/* ── MOBILE CARDS ── */}}
    <div class="card-list">
        {{range .Schedules}}
        <div class="rec-card">
            <div class="rec-card-top">
                <a href="/invoices/{{.TemplateInvoiceID}}" class="inv-link rec-card-number">
                    {{.InvoiceNumber}}
                </a>
                {{if .Active}}
                <span class="badge badge-active">Active</span>
                {{else}}
                <span class="badge badge-paused">Paused</span>
                {{end}}
            </div>
            <div class="rec-card-client">
                {{if .ClientName}}{{.ClientName}}{{else}}No client{{end}}
            </div>
            <div class="rec-card-meta">
                <span class="freq-badge">{{.Frequency}}</span>
                {{if .SendAutomatically}}
                <span class="freq-badge">Auto-send ✅</span>
                {{else}}
                <span class="freq-badge">Draft only 📝</span>
                {{end}}
                <span class="freq-badge" style="color: rgba(255,255,255,0.4);">
                    Next: {{.NextRunAt.Format "Jan 2, 2006"}}
                </span>
            </div>
            <div class="rec-card-actions">
                {{if .Active}}
                <form method="POST" action="/recurring/{{.ID}}/pause">
                    {{$.csrfField}}
                    <button type="submit" class="btn btn-muted">⏸ Pause</button>
                </form>
                {{else}}
                <form method="POST" action="/recurring/{{.ID}}/resume">
                    {{$.csrfField}}
                    <button type="submit" class="btn btn-success">▶ Resume</button>
                </form>
                {{end}}
                <form method="POST" action="/recurring/{{.ID}}/delete"
                      onsubmit="return confirm('Delete this recurring schedule?')">
                    {{$.csrfField}}
                    <button type="submit" class="btn btn-danger">🗑 Delete</button>
                </form>
            </div>
        </div>
        {{end}}
    </div>

    {{end}}
</div>

</body>
</html>
