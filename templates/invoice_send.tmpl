<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head-no-title" .}}
    <title>{{if .IsEstimate}}{{.T.InvoiceSendBtnEst}}{{else}}{{.T.InvoiceSendTitle}}{{end}} {{.Invoice.InvoiceNumber}} | PSILOCONVALLEY</title>

    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "invoice-send-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="page">

    <div class="page-header">
        <p class="page-label">{{.T.InvoiceSendLabel}}</p>
        <h1 class="page-title">{{if .IsEstimate}}{{.T.InvoiceSendBtnEst}}{{else}}{{.T.InvoiceSendTitle}}{{end}}</h1>
        <p class="page-sub">{{.T.InvoiceSendSubtitle}}</p>
    </div>

    <!-- Invoice Summary Card -->
    <div class="card">
        <div class="card-accent"></div>
        <div class="card-body">
            <div class="summary-row">
                <div>
                    <div class="summary-label">{{.T.InvoiceSendInvoiceLabel}}</div>
                    <div class="summary-number">{{.Invoice.InvoiceNumber}}</div>
                    <div class="summary-client">{{.Invoice.ClientName}}</div>
                </div>
                <div class="summary-amount">
                    <div class="summary-label">{{.T.InvoiceSendAmountDue}}</div>
                    <div class="summary-total">{{.Invoice.Currency}} {{.Invoice.Total}}</div>
                    {{if .Invoice.DueDate}}
                    <div class="summary-due">{{.T.InvoiceSendDue}} {{.Invoice.DueDate}}</div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Send Form Card -->
    <div class="card">
        <div class="card-body">
            <form class="send-form" method="POST"
                  action="{{if .IsEstimate}}/estimates/{{.InvoiceID}}/send{{else}}/invoices/{{.InvoiceID}}/send{{end}}"
                  id="send-form">
                {{.csrfField}}

                <div class="field-group">
                    <label for="to_email">{{.T.InvoiceSendTo}}</label>
                    <input
                        type="email"
                        id="to_email"
                        name="to_email"
                        value="{{.ClientEmail}}"
                        placeholder="{{.T.InvoiceSendToPlaceholder}}"
                        required
                        autocomplete="email"
                    >
                    <span class="field-hint">{{.T.InvoiceSendToHint}}</span>
                </div>

                <div class="field-group">
                    <label for="personal_note">{{.T.InvoiceSendNote}} <span style="font-weight:400;text-transform:none;letter-spacing:0;">{{.T.InvoiceSendNoteOptional}}</span></label>
                    <textarea
                        id="personal_note"
                        name="personal_note"
                        placeholder="{{.T.InvoiceSendNotePlaceholder}}"
                    ></textarea>
                    <span class="field-hint">{{.T.InvoiceSendNoteHint}}</span>
                </div>

                <div class="email-preview">
                    <div class="preview-label">{{.T.InvoiceSendPreview}}</div>
                    <div class="preview-line">{{.T.InvoiceSendFrom}} <span>noreply@psiloconvalley.com</span></div>
                    <div class="preview-line">Subject: <span>{{if .IsEstimate}}{{.T.InvoiceSendSubjectEst}}{{else}}{{.T.InvoiceSendSubjectInv}}{{end}} {{.Invoice.InvoiceNumber}} from {{.Invoice.CompanyName}} - {{.Invoice.Currency}} {{.Invoice.Total}}</span></div>
                    {{if not .IsEstimate}}<div class="preview-line">{{.T.InvoiceSendAttachment}} <span>invoice-{{.Invoice.InvoiceNumber}}.pdf</span></div>{{end}}
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-send" id="btn-send">
                        {{if .IsEstimate}}{{.T.InvoiceSendBtnEst}}{{else}}{{.T.InvoiceSendBtnInv}}{{end}}
                    </button>
                    <a href="{{if .IsEstimate}}/estimates/{{.InvoiceID}}{{else}}/invoices/{{.InvoiceID}}{{end}}" class="btn-cancel">
                        {{.T.InvoiceSendCancel}}
                    </a>
                </div>

                <p class="send-note">
                    {{if eq .Invoice.Status "draft"}}
                    {{.T.InvoiceSendStatusNote}}
                    {{end}}
                    {{.T.InvoiceSendPDFNote}}
                </p>

            </form>
        </div>
    </div>

</div>

<script>
document.getElementById('send-form').addEventListener('submit', function() {
    const btn = document.getElementById('btn-send');
    btn.disabled = true;
    btn.textContent = '{{.T.InvoiceSendSending}}';
});
</script>

</body>
</html>
