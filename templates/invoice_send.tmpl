<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{if .IsEstimate}}Send Estimate{{else}}Send Invoice{{end}} {{.Invoice.InvoiceNumber}} | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    {{template "nav-styles" .}}
    {{template "app-styles" .}}


    <style>
        .page {
            max-width: 620px;
            margin: 40px auto;
            padding: 0 20px 60px;
        }

        /* Page header */
        .page-header {
            margin-bottom: 28px;
        }
        .page-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 6px;
        }
	.page-title {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            text-transform: uppercase;
            color: #0d1422;
            margin-bottom: 6px;
            border-left: 2px solid #0d1422;
            padding-left: 16px;
        }
        .page-sub {
            font-size: 13px;
            color: #64748b;
        }

        /* Card */
        .card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 4px 16px rgba(15,23,42,0.06);
            overflow: hidden;
            margin-bottom: 20px;
        }
        .card-accent {
            height: 4px;
            background: linear-gradient(90deg, #4ade80, #22d3ee, #818cf8);
        }
        .card-body {
            padding: 28px 32px;
        }

        /* Invoice summary */
        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }
        .summary-label {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .summary-number {
            font-size: 18px;
            font-weight: 800;
            color: #0d1422;
        }
        .summary-client {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
        }
        .summary-amount {
            text-align: right;
        }
        .summary-total {
            font-size: 24px;
            font-weight: 800;
            color: #0d1422;
            font-variant-numeric: tabular-nums;
        }
        .summary-due {
            font-size: 11px;
            color: #64748b;
            margin-top: 2px;
        }

        /* Form fields */
        .send-form {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
        .field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #64748b;
        }
        input[type="email"],
        textarea {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 14px;
            color: #0d1422;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s;
            width: 100%;
        }
        input[type="email"]:focus,
        textarea:focus {
            border-color: #94a3b8;
            background: #ffffff;
        }
        textarea {
            min-height: 90px;
            resize: vertical;
        }
        .field-hint {
            font-size: 11px;
            color: #94a3b8;
        }

        /* Email preview box */
        .email-preview {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px 20px;
        }
        .preview-label {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 10px;
        }
        .preview-line {
            font-size: 12px;
            color: #64748b;
            margin-bottom: 5px;
        }
        .preview-line span {
            color: #0d1422;
            font-weight: 600;
        }

        /* Actions */
        .form-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            padding-top: 4px;
        }
        .btn-send {
            background: #0d1422;
            color: #ffffff;
            border: none;
            padding: 12px 28px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            border-radius: 8px;
            transition: background 0.15s, opacity 0.15s;
            min-height: 44px;
        }
        .btn-send:hover { background: #1e293b; }
        .btn-send:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .btn-cancel {
            color: #64748b;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color 0.15s;
        }
        .btn-cancel:hover { color: #0d1422; }

        .send-note {
            font-size: 11.5px;
            color: #94a3b8;
            line-height: 1.6;
        }

        @media (max-width: 640px) {
            .page { margin: 0; padding: 0 0 40px; }
            .card { border-radius: 0; border-left: none; border-right: none; }
            .card-body { padding: 20px 16px; }
            .page-header { padding: 24px 16px 0; }
            .summary-total { font-size: 20px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="page">

    <div class="page-header">
        <p class="page-label">Invoice Delivery</p>
	<h1 class="page-title">{{if .IsEstimate}}Send Estimate{{else}}Send Invoice{{end}}</h1>
	<p class="page-sub">A PDF will be generated and delivered to your client via email.</p>
    </div>

    <!-- Invoice Summary Card -->
    <div class="card">
        <div class="card-accent"></div>
        <div class="card-body">
            <div class="summary-row">
                <div>
                    <div class="summary-label">Invoice</div>
                    <div class="summary-number">{{.Invoice.InvoiceNumber}}</div>
                    <div class="summary-client">{{.Invoice.ClientName}}</div>
                </div>
                <div class="summary-amount">
                    <div class="summary-label">Amount Due</div>
                    <div class="summary-total">{{.Invoice.Currency}} {{.Invoice.Total}}</div>
                    {{if .Invoice.DueDate}}
			<div class="summary-due">Due {{.Invoice.DueDate}}</div>
		    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Send Form Card -->
    <div class="card">
        <div class="card-body">
            <form class="send-form" method="POST"
		  action="{{if .IsEstimate}}/estimates/{{.InvoiceID}}/send{{else}}/invoices/{{.InvoiceID}}/send{{end}}"
                  id="send-form">
                {{.csrfField}}

                <!-- Recipient -->
                <div class="field-group">
                    <label for="to_email">Send To</label>
                    <input
                        type="email"
                        id="to_email"
                        name="to_email"
                        value="{{.ClientEmail}}"
                        placeholder="client@company.com"
                        required
                        autocomplete="email"
                    >
                    <span class="field-hint">Client will receive the invoice PDF as an attachment</span>
                </div>

                <!-- Personal Note -->
                <div class="field-group">
                    <label for="personal_note">Personal Note <span style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></label>
                    <textarea
                        id="personal_note"
                        name="personal_note"
                        placeholder="Add a message to your client..."
                    ></textarea>
                    <span class="field-hint">Appears in the email body above the invoice details</span>
                </div>

                <!-- Email Preview -->
                <div class="email-preview">
                    <div class="preview-label">Email Preview</div>
                    <div class="preview-line">From: <span>noreply@psiloconvalley.com</span></div>
		<div class="preview-line">Subject: <span>{{if .IsEstimate}}Estimate{{else}}Invoice{{end}} {{.Invoice.InvoiceNumber}} from {{.Invoice.CompanyName}} - {{.Invoice.Currency}} {{.Invoice.Total}}</span></div>{{if not .IsEstimate}}<div class="preview-line">Attachment: <span>invoice-{{.Invoice.InvoiceNumber}}.pdf</span></div>{{end}}
                                    </div>

                <!-- Actions -->
                <div class="form-actions">
                    <button type="submit" class="btn-send" id="btn-send">
		    {{if .IsEstimate}}Send Estimate →{{else}}Send Invoice →{{end}}
                    </button>
			<a href="{{if .IsEstimate}}/estimates/{{.InvoiceID}}{{else}}/invoices/{{.InvoiceID}}{{end}}" class="btn-cancel">
                        Cancel
                    </a>
                </div>

                <p class="send-note">
                    {{if eq .Invoice.Status "draft"}}
                    Invoice status will automatically update from Draft to Sent after delivery.
                    {{end}}
                    A PDF copy will be attached to the email.
                </p>

            </form>
        </div>
    </div>

</div>

<script>
document.getElementById('send-form').addEventListener('submit', function() {
    const btn = document.getElementById('btn-send');
    btn.disabled = true;
    btn.textContent = 'Sending...';
});
</script>

</body>
</html>
