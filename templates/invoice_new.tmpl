<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
{{template "page-head-no-title" .}}
<title>
        {{if eq .DocumentType "estimate"}}
            {{if eq .Mode "edit"}}{{.T.InvoiceNewEditEstimate}}{{else}}{{.T.InvoiceNewCreateEstimate}}{{end}}
        {{else}}
            {{if eq .Mode "edit"}}{{.T.InvoiceNewEditInvoice}}
            {{else if eq .Mode "duplicate"}}{{.T.InvoiceNewDuplicateInvoice}}
            {{else}}{{.T.InvoiceNewCreateInvoice}}{{end}}
        {{end}} — PSILOCONVALLEY
</title>

    {{template "invoice-new-layout-styles" .}}
    {{template "invoice-new-form-styles" .}}
    {{template "invoice-new-items-styles" .}}
    {{template "invoice-new-sidebar-styles" .}}
    {{template "invoice-new-responsive-styles" .}}
    {{template "nav-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">

    {{if eq .Mode "edit"}}
    <div class="banner" style="margin: 16px 16px 0;">
        <span>✏️ {{.T.InvoiceNewEditingBanner}} {{if eq .DocumentType "estimate"}}{{.T.InvoiceNewCreateEstimate}}{{else}}{{.T.InvoiceNewCreateInvoice}}{{end}}</span>
        <strong>#{{.Invoice.InvoiceNumber}}</strong>
    </div>
    {{end}}

    {{if eq .Mode "duplicate"}}
    <div class="banner" style="background:#e0e7ff; color:#1e40af; border-color:#bfdbfe; margin: 16px 16px 0;">
        <span>📋 {{.T.InvoiceNewDuplicateBanner}}</span>
        <strong>#{{.Invoice.InvoiceNumber}}</strong>
    </div>
    {{end}}

    {{if .Errors}}
    <div class="error-banner" style="margin: 16px 16px 0;">
        <strong>{{.T.InvoiceNewFixErrors}}</strong>
        <ul>
            {{range .Errors}}
            <li>{{.Message}}</li>
            {{end}}
        </ul>
    </div>
    {{end}}

    <form id="invoice-form" method="POST"
	action="{{if eq .DocumentType "estimate"}}{{if eq .Mode "edit"}}/estimates/{{.Invoice.ID}}/edit{{else}}/estimates/create{{end}}{{else}}{{if eq .Mode "edit"}}/invoices/{{.Invoice.ID}}/edit{{else}}/invoices/create{{end}}{{end}}">
                 {{.csrfField}}

        <div class="layout">

            {{/* ══════════════════════════════════════════════════════
                 MAIN FORM COLUMN
            ══════════════════════════════════════════════════════ */}}
            <div class="main">
{{template "invoice-new-mobile-appearance" .}}
{{template "invoice-new-preview" .}}
                <h1>
                    {{if eq .DocumentType "estimate"}}
                        {{if eq .Mode "edit"}}{{.T.InvoiceNewEditEstimate}}{{else}}{{.T.InvoiceNewCreateEstimate}}{{end}}
                    {{else}}
                        {{if eq .Mode "edit"}}{{.T.InvoiceNewEditInvoice}}
                        {{else if eq .Mode "duplicate"}}{{.T.InvoiceNewDuplicateInvoice}}
                        {{else}}{{.T.InvoiceNewCreateInvoice}}{{end}}
                    {{end}}
                </h1>

                {{/* ── Section 1: Company ── */}}
                <section class="section">
                    <div class="step-badge">
                        <span class="step-dot active"></span>
                        <span class="step-dot"></span>
                        <span class="step-dot"></span>
                        {{.T.InvoiceNewStep1}}
                    </div>
                    <h2>{{.T.InvoiceNewYourDetails}}</h2>
                    <input type="hidden" name="company_override" id="company-override" value="0">

                    <div id="company-override-banner" class="co-banner co-banner--profile" data-profile-title="{{.T.InvoiceNewUsingProfile}}" data-profile-sub="{{.T.InvoiceNewUsingProfileSub}}" data-override-title="{{.T.InvoiceNewOverride}}" data-override-sub="{{.T.InvoiceNewOverrideSub}}">
                        <div class="co-banner-text">
                            <span class="co-banner-icon">🏢</span>
                            <div>
                                <div class="co-banner-title" id="co-banner-title">{{.T.InvoiceNewUsingProfile}}</div>
                                <div class="co-banner-sub" id="co-banner-sub">{{.T.InvoiceNewUsingProfileSub}}</div>
                            </div>
                        </div>
                        <button type="button" id="co-override-btn" class="co-action-btn"
                                onclick="setCompanyOverride(true)">{{.T.InvoiceNewOverride}}</button>
                        <button type="button" id="co-reset-btn" class="co-action-btn co-action-btn--reset"
                                onclick="setCompanyOverride(false)" style="display:none">{{.T.InvoiceNewResetProfile}}</button>
                    </div>

                    <div id="company-summary" class="co-summary">
                        <div class="co-summary-name">{{field .Invoice.CompanyName}}</div>
                        {{if .Invoice.CompanyEmail}}<div class="co-summary-detail">📧 {{field .Invoice.CompanyEmail}}</div>{{end}}
                        {{if .Invoice.CompanyAddress}}<div class="co-summary-detail">📍 {{field .Invoice.CompanyAddress}}{{if .Invoice.CompanyCity}}, {{field .Invoice.CompanyCity}}{{end}}{{if .Invoice.CompanyState}} {{field .Invoice.CompanyState}}{{end}}{{if .Invoice.CompanyZip}} {{field .Invoice.CompanyZip}}{{end}}</div>{{end}}
                    </div>

                    <div id="company-fields" style="display:none">
                    <div class="grid-2">
                        <div>
                            <label>{{.T.InvoiceNewCompanyName}} <span style="color:var(--danger)">*</span></label>
                            <input type="text" name="company_name" required
                                   value="{{field .Invoice.CompanyName}}"
                                   placeholder="{{.T.InvoiceNewPlaceholderCompany}}"
                                   autocomplete="organization">
                        </div>
                        <div>
                            <label>{{.T.InvoiceNewEmail}}</label>
                            <input type="email" name="company_email"
                                   value="{{field .Invoice.CompanyEmail}}"
                                   placeholder="{{.T.InvoiceNewPlaceholderCoEmail}}"
                                   autocomplete="email"
                                   inputmode="email">
                        </div>
                    </div>

                    <div class="grid-3" style="margin-top:16px;">
                        <div>
                            <label>{{.T.InvoiceNewAddress}}</label>
				<input type="text" name="company_address"
       				value="{{field .Invoice.CompanyAddress}}"
       				placeholder="{{.T.InvoiceNewPlaceholderCoAddr}}"
       				autocomplete="street-address"
       				data-address-autocomplete>
                        </div>
                        <div>
                            <label>{{.T.InvoiceNewCity}}</label>
				<input type="text" name="company_city"
       				       data-address-city
                                   value="{{field .Invoice.CompanyCity}}"
                                   placeholder="{{.T.InvoiceNewPlaceholderCoCity}}"
                                   autocomplete="address-level2">
                        </div>
                        <div>
                            <label>{{.T.InvoiceNewZip}}</label>
                            <input type="text" name="company_zip"
                                   value="{{field .Invoice.CompanyZip}}"
                                   placeholder="{{.T.InvoiceNewPlaceholderCoZip}}"
                                   autocomplete="postal-code"
                                   inputmode="numeric">
                        </div>
                    </div>

                    <div class="grid-2" style="margin-top:16px;">
                        <div>
                            <label>{{.T.InvoiceNewCountry}}</label>
				   <input type="text" name="company_country"
       					data-address-country
                                   value="{{field .Invoice.CompanyCountry}}"
                                   placeholder="{{.T.InvoiceNewPlaceholderCountry}}"
                                   autocomplete="country-name">
                        </div>
                        <div>
                            <label>{{.T.InvoiceNewStateRegion}}</label>
				<select name="company_state" autocomplete="address-level1"
        				data-address-state>
                                <option value="">{{.T.InvoiceNewSelectState}}</option>
                                {{range .USStates}}
                                <option value="{{.Name}}" {{if eq $.Invoice.CompanyState .Name}}selected{{end}}>{{.Name}}</option>
                                {{end}}
                            </select>
                        </div>
                    </div>
                    </div>
                </section>

{{template "invoice-new-client" .}}
{{template "invoice-new-line-items" .}}
            </div>

            {{/* ══════════════════════════════════════════════════════
                 SIDEBAR
            ══════════════════════════════════════════════════════ */}}

{{template "invoice-new-sidebar" .}}
            </div>

    </form>
</div>

<div class="mobile-total-bar">
    <div>
        <div class="mobile-total-label">{{.T.InvoiceNewMobileTotal}}</div>
        <div class="mobile-total-amount" id="mobile_total_display">$0.00</div>
    </div>
    <button type="button" class="mobile-submit-btn"
            onclick="document.getElementById('invoice-form').submit()">
        {{if eq .DocumentType "estimate"}}
            {{if eq .Mode "edit"}}{{.T.InvoiceNewUpdateEstimate}}{{else}}{{.T.InvoiceNewSaveEstimate}}{{end}}
        {{else}}
            {{if eq .Mode "edit"}}{{.T.InvoiceNewUpdateInvoice}}{{else}}{{.T.InvoiceNewSaveInvoice}}{{end}}
        {{end}}
    </button>
</div>

{{template "invoice-new-scripts" .}}
<script src="/static/js/address-autocomplete.js"></script>
</body>
</html>
