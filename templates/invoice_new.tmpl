<!DOCTYPE html>
<html lang="en">
<head>
<title>
        {{if eq .DocumentType "estimate"}}
            {{if eq .Mode "edit"}}Edit Estimate{{else}}Create Estimate{{end}}
        {{else}}
            {{if eq .Mode "edit"}}Edit Invoice
            {{else if eq .Mode "duplicate"}}Duplicate Invoice
            {{else}}Create Invoice{{end}}
        {{end}} — PsiloConValley
</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Create professional invoices in seconds.">


    {{template "invoice-new-layout-styles" .}}
    {{template "invoice-new-form-styles" .}}
    {{template "invoice-new-items-styles" .}}
    {{template "invoice-new-sidebar-styles" .}}
    {{template "invoice-new-responsive-styles" .}}
    {{template "nav-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">

    {{if eq .Mode "edit"}}
    <div class="banner" style="margin: 16px 16px 0;">
	  <span>✏️ Editing {{if eq .DocumentType "estimate"}}Estimate{{else}}Invoice{{end}}</span>
        <strong>#{{.Invoice.InvoiceNumber}}</strong>
    </div>
    {{end}}

    {{if eq .Mode "duplicate"}}
    <div class="banner" style="background:#e0e7ff; color:#1e40af; border-color:#bfdbfe; margin: 16px 16px 0;">
        <span>📋 Creating duplicate copy</span>
        <strong>#{{.Invoice.InvoiceNumber}}</strong>
    </div>
    {{end}}

    {{/* ── Validation error banner ──
         Rendered when the handler calls reRenderInvoiceForm with errors.
         All field errors are listed here AND inline beneath their input.
         Both are needed: the banner gives a summary the user sees
         immediately without scrolling; the inline errors show exactly
         which field failed without hunting.
    ── */}}
    {{if .Errors}}
    <div class="error-banner" style="margin: 16px 16px 0;">
        <strong>Please fix the following before saving:</strong>
        <ul>
            {{range .Errors}}
            <li>{{.Message}}</li>
            {{end}}
        </ul>
    </div>
    {{end}}

    <form id="invoice-form" method="POST"
	action="{{if eq .DocumentType "estimate"}}{{if eq .Mode "edit"}}/estimates/{{.Invoice.ID}}/edit{{else}}/estimates/create{{end}}{{else}}{{if eq .Mode "edit"}}/invoices/{{.Invoice.ID}}/edit{{else}}/invoices/create{{end}}{{end}}">
                 {{.csrfField}}

        <div class="layout">

            {{/* ══════════════════════════════════════════════════════
                 MAIN FORM COLUMN
            ══════════════════════════════════════════════════════ */}}
            <div class="main">
		{{/* ── Mobile-only Appearance Controls ──
     Shown above the preview on mobile so users don't have to
     scroll to the bottom sidebar to toggle logo/title.
     These have separate IDs from the sidebar toggles.
     JS syncs both pairs.
── */}}
<div class="mobile-appearance" style="
    background: #0d1422;
    color: white;
    padding: 16px 20px;
    border-radius: 10px;
    margin-bottom: 16px;
">
    <div style="
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 12px;
    ">Appearance</div>

    <label class="config-toggle">
        <span class="config-item-label">Show Logo</span>
        <input type="checkbox" id="toggle_logo_mobile" {{if .Invoice.ShowLogo}}checked{{end}}>
        <span class="toggle-slider"><span class="toggle-knob"></span></span>
	       </label>

    <div class="logo-position-row" style="margin-bottom:12px;">
        <span class="config-item-label">Logo Position</span>
        <div class="logo-pos-btns">
            <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "left"}}active{{end}}" data-pos="left" onclick="setLogoPos('left')">Left</button>
            <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "center"}}active{{end}}" data-pos="center" onclick="setLogoPos('center')">Center</button>
            <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "right"}}active{{end}}" data-pos="right" onclick="setLogoPos('right')">Right</button>
        </div>
    </div>

    <label class="config-toggle" style="margin-bottom:0;">
	 <span class="config-item-label">Show {{if eq .DocumentType "estimate"}}Estimate{{else}}Invoice{{end}} Title</span>
           <input type="checkbox" id="toggle_title_mobile" {{if .Invoice.ShowTitle}}checked{{end}}>
        <span class="toggle-slider"><span class="toggle-knob"></span></span>
    </label>
</div>
		{{/* ── Live Invoice Preview ──
     Mirrors exactly what invoice_detail.tmpl renders at the top.
     Logo and title visibility are controlled by the sidebar toggles.
     JS sets initial state on DOMContentLoaded from checkbox checked state.
     If no logo is uploaded yet, a placeholder is shown instead.
── */}}
<div id="invoice-preview-header" style="
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px 24px;
    margin-bottom: 32px;
">
    <div style="
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 14px;
">{{if eq .DocumentType "estimate"}}Estimate{{else}}Invoice{{end}} Preview</div>

    <div style="height: 4px; background: #0d1422; border-radius: 2px; margin-bottom: 16px;"></div>

    {{/* Logo */}}
    <div id="preview_logo" style="margin-bottom: 12px; text-align:{{if .Invoice.LogoPosition}}{{.Invoice.LogoPosition}}{{else}}left{{end}};">
        {{if .Invoice.LogoURL}}
        <img
            src="{{.Invoice.LogoURL}}"
            alt="{{.Invoice.CompanyName}}"
            style="max-width:200px; max-height:80px; object-fit:contain; display:inline-block;"
        >
   	          {{else}}
            {{if .User}}
            <a href="/profile" style="
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 16px;
                background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
                border: 1.5px dashed #93c5fd;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.25s ease;
                max-width: 280px;
                animation: hintPulse 2.5s ease-in-out infinite;
            " onmouseover="this.style.borderColor='#3b82f6';this.style.background='linear-gradient(135deg,#dbeafe 0%,#dcfce7 100%)';this.style.transform='translateY(-1px)';this.style.boxShadow='0 4px 12px rgba(59,130,246,0.15)'"
               onmouseout="this.style.borderColor='#93c5fd';this.style.background='linear-gradient(135deg,#eff6ff 0%,#f0fdf4 100%)';this.style.transform='none';this.style.boxShadow='none'">
                <span style="
                    font-size: 22px;
                    line-height: 1;
                    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
                ">📸</span>
                <span style="
                    font-size: 12px;
                    font-weight: 600;
                    color: #1e40af;
                    line-height: 1.3;
                ">Add your logo<br>
                <span style="font-weight: 400; color: #64748b; font-size: 11px;">Upload in Business Profile →</span>
                </span>
            </a>
            {{else}}
            <a href="/register" style="
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 16px;
                background: linear-gradient(135deg, #fdf4ff 0%, #eff6ff 100%);
                border: 1.5px dashed #c084fc;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.25s ease;
                max-width: 280px;
                animation: hintPulse 2.5s ease-in-out infinite;
            " onmouseover="this.style.borderColor='#a855f7';this.style.background='linear-gradient(135deg,#fae8ff 0%,#dbeafe 100%)';this.style.transform='translateY(-1px)';this.style.boxShadow='0 4px 12px rgba(168,85,247,0.15)'"
               onmouseout="this.style.borderColor='#c084fc';this.style.background='linear-gradient(135deg,#fdf4ff 0%,#eff6ff 100%)';this.style.transform='none';this.style.boxShadow='none'">
                <span style="
                    font-size: 22px;
                    line-height: 1;
                    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
                ">✨</span>
                <span style="
                    font-size: 12px;
                    font-weight: 600;
                    color: #7e22ce;
                    line-height: 1.3;
                ">Create an account<br>
                <span style="font-weight: 400; color: #64748b; font-size: 11px;">Save your logo and brand your invoices →</span>
                </span>
            </a>
            {{end}}
        {{end}}
          </div>

    {{/* Title */}}
    <div style="display: flex; align-items: baseline; gap: 12px;">
        <span id="preview_title" style="
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0d1422;
	">{{if eq .DocumentType "estimate"}}ESTIMATE{{else}}INVOICE{{end}}</span>
        <span style="font-size: 16px; font-weight: 700; color: #64748b;">#{{.Invoice.InvoiceNumber}}</span>
    </div>
</div>
                <h1>
			{{if eq .DocumentType "estimate"}}
                            {{if eq .Mode "edit"}}Edit Estimate{{else}}Create Estimate{{end}}
                    {{else}}
                        {{if eq .Mode "edit"}}Edit Invoice
                        {{else if eq .Mode "duplicate"}}New Invoice Copy
                        {{else}}Create Invoice{{end}}
                    {{end}}
                </h1>

                {{/* ── Section 1: Company ── */}}
                <section class="section">
                    <div class="step-badge">
                        <span class="step-dot active"></span>
                        <span class="step-dot"></span>
                        <span class="step-dot"></span>
                        Step 1 of 3
                    </div>
                    <h2>Your Business Details</h2>

                    <div class="grid-2">
                        <div>
                            <label>Company Name <span style="color:var(--danger)">*</span></label>
                            <input type="text" name="company_name" required
                                   value="{{field .Invoice.CompanyName}}"
                                   placeholder="Acme Agency LLC"
                                   autocomplete="organization">
                        </div>
                        <div>
                            <label>Email</label>
                            <input type="email" name="company_email"
                                   value="{{field .Invoice.CompanyEmail}}"
                                   placeholder="billing@acme.com"
                                   autocomplete="email"
                                   inputmode="email">
                        </div>
                    </div>

                    <div class="grid-3" style="margin-top:16px;">
                        <div>
                            <label>Address</label>
                            <input type="text" name="company_address"
                                   value="{{field .Invoice.CompanyAddress}}"
                                   placeholder="123 Innovation Way"
                                   autocomplete="street-address">
                        </div>
                        <div>
                            <label>City</label>
                            <input type="text" name="company_city"
                                   value="{{field .Invoice.CompanyCity}}"
                                   placeholder="San Francisco"
                                   autocomplete="address-level2">
                        </div>
                        <div>
                            <label>ZIP / Postal</label>
                            <input type="text" name="company_zip"
                                   value="{{field .Invoice.CompanyZip}}"
                                   placeholder="94103"
                                   autocomplete="postal-code"
                                   inputmode="numeric">
                        </div>
                    </div>

                        <div class="grid-2" style="margin-top:16px;">
                        <div>
                            <label>Country</label>
                            <input type="text" name="company_country"
                                   value="{{field .Invoice.CompanyCountry}}"
                                   placeholder="United States"
                                   autocomplete="country-name">
                        </div>
                        <div>
                            <label>State / Region</label>
                            <select name="company_state" autocomplete="address-level1">
                                <option value="">— Select State —</option>
                                {{range .USStates}}
                                <option value="{{.Name}}" {{if eq $.Invoice.CompanyState .Name}}selected{{end}}>{{.Name}}</option>
                                {{end}}
                            </select>
                        </div>
                    </div>
                </section>

                {{/* ── Section 2: Client ── */}}
                <section class="section">
                    <div class="step-badge">
                        <span class="step-dot active"></span>
                        <span class="step-dot active"></span>
                        <span class="step-dot"></span>
                        Step 2 of 3
                    </div>
                    <h2>Customer Details</h2>

                    {{if .Clients}}
                    <div style="margin-bottom:20px;">
                        <label>Auto-Fill Saved Customer</label>
                        <select id="client_selector" onchange="fillClient(this)">
                            <option value="">— Type below or choose saved —</option>
                            {{range .Clients}}
                            <option value="{{.ID}}"
                                data-name="{{.Name}}"
                                data-email="{{.Email}}"
                                data-address="{{.Address}}"
                                data-city="{{.City}}"
                                data-state="{{.State}}"
                                data-zip="{{.Zip}}"
                                data-country="{{.Country}}"
                                {{if $.Invoice.ClientID}}{{if eq $.Invoice.ClientID .ID}}selected{{end}}{{end}}>
                                {{.Name}}{{if .Email}} ({{.Email}}){{end}}
                            </option>
                            {{end}}
                        </select>
                    </div>
                    {{end}}

                    <input type="hidden" name="client_id" id="client_id"
                           value="{{if .Invoice.ClientID}}{{.Invoice.ClientID}}{{end}}">

                    <div class="grid-3">
                        <div>
                            <label>Customer Name <span style="color:var(--danger)">*</span></label>
                            <input type="text" name="client_name" id="client_name" required
                                   value="{{field .Invoice.ClientName}}"
                                   placeholder="Globex Corp"
                                   autocomplete="off">
                        </div>
                        <div>
                            <label>Email</label>
                            <input type="email" name="client_email" id="client_email"
                                   value="{{field .Invoice.ClientEmail}}"
                                   placeholder="ap@globex.com"
                                   inputmode="email"
                                   autocomplete="off">
                        </div>
                        <div>
				<label>{{if eq .DocumentType "estimate"}}Estimate Number{{else}}Invoice Number{{end}}</label>
                            {{if eq .Mode "edit"}}
                            <input type="text" name="invoice_number" readonly
                                   value="{{.Invoice.InvoiceNumber}}">
                            {{else}}
                            <input type="text" name="invoice_number"
                                   value="{{field .Invoice.InvoiceNumber}}"
                                   placeholder="INV-2026-001">
                            {{end}}
                            {{if .Errors}}
                            {{range .Errors}}
                            {{if eq .Field "invoice_number"}}
                            <div class="field-error">{{.Message}}</div>
                            {{end}}
                            {{end}}
                            {{end}}

		    </div>
                    </div>

                    <div class="grid-2" style="margin-top:16px;">
                        <div>
                            <label>Issue Date</label>
                            {{/* font-size:16px on date inputs prevents iOS Safari
                                 from zooming the viewport on focus — a major mobile UX
                                 regression that was present in the original template */}}
                            <input type="date" name="issue_date"
                                   value="{{field .Invoice.IssueDate}}"
                                   style="font-size:16px;">
                        </div>
                        <div>
                            <label>Due Date</label>
                            <input type="date" name="due_date"
                                   value="{{field .Invoice.DueDate}}"
                                   style="font-size:16px;">
                        </div>
                    </div>

                    <div class="grid-3" style="margin-top:16px;">
                        <div>
                            <label>Address</label>
                            <input type="text" name="client_address" id="client_address"
                                   value="{{field .Invoice.ClientAddress}}"
                                   placeholder="456 Enterprise Dr">
                        </div>
                        <div>
                            <label>City</label>
                            <input type="text" name="client_city" id="client_city"
                                   value="{{field .Invoice.ClientCity}}"
                                   placeholder="Austin">
                        </div>
                        <div>
                            <label>ZIP / Postal</label>
                            <input type="text" name="client_zip" id="client_zip"
                                   value="{{field .Invoice.ClientZip}}"
                                   placeholder="73301"
                                   inputmode="numeric">
                        </div>
                    </div>

                        <div class="grid-2" style="margin-top:16px;">
                        <div>
                            <label>Country</label>
                            <input type="text" name="client_country" id="client_country"
                                   value="{{field .Invoice.ClientCountry}}"
                                   placeholder="United States">
                        </div>
                        <div>
                            <label>State / Region</label>
                            <select name="client_state" id="client_state">
                                <option value="">— Select State —</option>
                                {{range .USStates}}
                                <option value="{{.Name}}" {{if eq $.Invoice.ClientState .Name}}selected{{end}}>{{.Name}}</option>
                                {{end}}
                            </select>
                        </div>
                    </div>

                {{/* ── Section 3: Line Items ── */}}
                <section class="section">
                    <div class="step-badge">
                        <span class="step-dot active"></span>
                        <span class="step-dot active"></span>
                        <span class="step-dot active"></span>
                        Step 3 of 3
                    </div>
                    <h2>Items to Bill</h2>

                    {{if .Errors}}
                    {{range .Errors}}
                    {{if eq .Field "items"}}
                    <div class="field-error" style="margin-bottom:12px;">{{.Message}}</div>
                    {{end}}
                    {{end}}
                    {{end}}

                    {{/* ── DESKTOP: 6-column table ── */}}
                    <div class="items-desktop items-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:33%;">Description</th>
                                    <th style="width:27%;">Details / Notes</th>
                                    <th style="width:10%;">Qty</th>
                                    <th style="width:14%;">Unit Price</th>
                                    <th style="width:10%; text-align:right;">Amount</th>
                                    <th style="width:6%;"></th>
                                </tr>
                            </thead>
                            <tbody id="items_body_desktop">
                                {{if .Invoice.Items}}
                                    {{range .Invoice.Items}}
                                    <tr>
                                        <td><input type="text" name="description[]" class="item-desc"
                                                   value="{{.Description}}" placeholder="Web Development"></td>
                                        <td><input type="text" name="details[]" class="item-details"
                                                   value="{{.Details}}" placeholder="40 hours @ $X"></td>
                                        <td><input type="number" step="0.01" min="0.01" name="quantity[]"
                                                   class="qty" value="{{.QuantityRaw}}" inputmode="decimal"></td>
                                        <td><input type="number" step="0.01" min="0" name="unit_price[]"
                                                   class="price"
                                                   value="{{if .UnitPriceCents}}{{formatCents .UnitPriceCents}}{{else}}0.00{{end}}"
                                                   inputmode="decimal"></td>
                                        <td class="right row-amount">{{if .LineTotal}}{{.LineTotal}}{{else}}$0.00{{end}}</td>
                                        <td style="text-align:center;">
                                            <button type="button" class="remove-btn" onclick="removeRow(this,'desktop')">×</button>
                                        </td>
                                    </tr>
                                    {{end}}
                                {{else}}
                                    <tr>
                                        <td><input type="text" name="description[]" class="item-desc"
                                                   placeholder="Web Development"></td>
                                        <td><input type="text" name="details[]" class="item-details"
                                                   placeholder="40 hours @ $X"></td>
                                        <td><input type="number" step="0.01" min="0.01" name="quantity[]"
                                                   class="qty" value="1" inputmode="decimal"></td>
                                        <td><input type="number" step="0.01" min="0" name="unit_price[]"
                                                   class="price" value="0.00" inputmode="decimal"></td>
                                        <td class="right row-amount">$0.00</td>
                                        <td style="text-align:center;">
                                            <button type="button" class="remove-btn" onclick="removeRow(this,'desktop')">×</button>
                                        </td>
                                    </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>

                    {{/* ── MOBILE: stacked item cards ──
                         Same field names as the desktop table — the Go parser
                         receives identical description[] / details[] / quantity[]
                         / unit_price[] arrays from both layouts.
                         inputmode="decimal" shows the decimal keypad on iOS/Android.
                    ── */}}
                    <div class="items-mobile-list" id="items_body_mobile">
                        {{if .Invoice.Items}}
                            {{range .Invoice.Items}}
                            <div class="item-card-mobile">
                                <label style="font-size:11px;">Description</label>
                                <input type="text" name="description[]" class="item-desc"
                                       value="{{.Description}}" placeholder="Web Development">
                                <label style="font-size:11px;">Details (optional)</label>
                                <input type="text" name="details[]" class="item-details"
                                       value="{{.Details}}" placeholder="40 hours @ $X">
                                <div class="item-row-meta">
                                    <div>
                                        <label>Qty</label>
                                        <input type="number" step="0.01" min="0.01" name="quantity[]"
                                               class="qty" value="{{.QuantityRaw}}" inputmode="decimal">
                                    </div>
                                    <div>
                                        <label>Price</label>
                                        <input type="number" step="0.01" min="0" name="unit_price[]"
                                               class="price"
                                               value="{{if .UnitPriceCents}}{{formatCents .UnitPriceCents}}{{else}}0.00{{end}}"
                                               inputmode="decimal">
                                    </div>
                                    <div class="row-total">$0.00</div>
                                    <button type="button" class="remove-btn" onclick="removeRow(this,'mobile')">×</button>
                                </div>
                            </div>
                            {{end}}
                        {{else}}
                            <div class="item-card-mobile">
                                <label style="font-size:11px;">Description</label>
                                <input type="text" name="description[]" class="item-desc"
                                       placeholder="Web Development">
                                <label style="font-size:11px;">Details (optional)</label>
                                <input type="text" name="details[]" class="item-details"
                                       placeholder="40 hours @ $X">
                                <div class="item-row-meta">
                                    <div>
                                        <label>Qty</label>
                                        <input type="number" step="0.01" min="0.01" name="quantity[]"
                                               class="qty" value="1" inputmode="decimal">
                                    </div>
                                    <div>
                                        <label>Price</label>
                                        <input type="number" step="0.01" min="0" name="unit_price[]"
                                               class="price" value="0.00" inputmode="decimal">
                                    </div>
                                    <div class="row-total">$0.00</div>
                                    <button type="button" class="remove-btn" onclick="removeRow(this,'mobile')">×</button>
                                </div>
                            </div>
                        {{end}}
                    </div>

                    <button type="button" class="add-btn" onclick="addRow()">+ Add Line Item</button>

                    <div style="margin-top:32px;">
                        <label>Invoice Memo / Footer Notes</label>
                        <textarea name="notes"
                                  placeholder="Thank you for your business! Payment is due within 30 days.">{{.Invoice.Notes}}</textarea>
                    </div>
                </section>

            </div>

            {{/* ══════════════════════════════════════════════════════
                 SIDEBAR
            ══════════════════════════════════════════════════════ */}}

	            <aside class="sidebar">
                <div class="sidebar-box">
                    <h2 class="summary-title">{{if eq .DocumentType "estimate"}}Customize Estimate{{else}}Customize Invoice{{end}}</h2>

                    {{/* ── Appearance Toggles ── */}}
                    <div class="sidebar-section desktop-appearance">
                        <div class="sidebar-section-label">Appearance</div>

                        <label class="config-toggle">
                            <span class="config-item-label">Show Logo</span>
                		<input type="checkbox" name="show_logo" id="toggle_logo" {{if .Invoice.ShowLogo}}checked{{end}}>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>

			 </label>

                        <div class="logo-position-row" id="logo-position-desktop">
                            <span class="config-item-label">Logo Position</span>
                            <div class="logo-pos-btns">
                                <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "left"}}active{{end}}" data-pos="left" onclick="setLogoPos('left')">Left</button>
                                <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "center"}}active{{end}}" data-pos="center" onclick="setLogoPos('center')">Center</button>
                                <button type="button" class="logo-pos-btn {{if eq .Invoice.LogoPosition "right"}}active{{end}}" data-pos="right" onclick="setLogoPos('right')">Right</button>
                            </div>
                            <input type="hidden" name="logo_position" id="logo_position_input" value="{{if .Invoice.LogoPosition}}{{.Invoice.LogoPosition}}{{else}}left{{end}}">
                        </div>

                        <label class="config-toggle">
				<span class="config-item-label">Show {{if eq .DocumentType "estimate"}}Estimate{{else}}Invoice{{end}} Title</span>

                                                        <input type="checkbox" name="show_title" id="toggle_title" {{if .Invoice.ShowTitle}}checked{{end}}>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>
                        </label>
                    </div>
                    {{/* ── Template & Brand Color ── */}}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Template</div>

                        <div class="template-grid">
                            {{range .Templates}}
                            {{if and .ProOnly (not (and $.User (eq $.User.Plan "pro")))}}
                            <div class="template-option locked">
                                <div class="template-dot"></div>
                                <div>
                                    <div class="template-name">{{.Name}}</div>
                                    <div class="template-desc">{{.Description}}</div>
                                </div>
                                <span class="template-lock">🔒</span>
                            </div>
                            {{else}}
                            <label class="template-option {{if eq $.Invoice.TemplateID .ID}}selected{{end}}">
                                <input type="radio" name="template_id" value="{{.ID}}"
                                    {{if eq $.Invoice.TemplateID .ID}}checked{{end}}
                                    onchange="this.closest('.template-grid').querySelectorAll('.template-option').forEach(o=>o.classList.remove('selected')); this.closest('.template-option').classList.add('selected')">
                                <div class="template-dot"></div>
                                <div>
                                    <div class="template-name">{{.Name}}</div>
                                    <div class="template-desc">{{.Description}}</div>
                                </div>
                            </label>
                            {{end}}
                            {{end}}
                        </div>

                        {{if and .User (eq .User.Plan "pro")}}
                        <div style="margin-top: 16px;">
                            <div class="sidebar-section-label" style="margin-bottom: 10px;">Brand Color</div>
                            <div class="color-picker-row">
                                <input type="color" name="brand_color" id="brand_color_picker"
                                    value="{{.Invoice.BrandColor}}"
                                    oninput="document.getElementById('brand_color_hex').textContent = this.value">
                                <div>
                                    <div class="color-picker-label">Accent Color</div>
                                    <div class="color-picker-hex" id="brand_color_hex">{{.Invoice.BrandColor}}</div>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div style="margin-top: 16px; opacity: 0.4;">
                            <div class="sidebar-section-label" style="margin-bottom: 10px;">Brand Color</div>
                            <div class="color-picker-row">
                                <input type="color" disabled value="#0d1422"
                                    style="cursor: not-allowed;">
                                <div>
                                    <div class="color-picker-label">Accent Color</div>
                                    <div class="color-picker-hex">
                                        <a href="/pricing?reason=brand-color" style="color: #fbbf24; text-decoration: none; font-weight: 600;">Upgrade to Pro</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{end}}
                    </div>
		                        {{/* ── Payment Reminders ── */}}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Reminders</div>

                        {{if and .User (eq .User.Plan "pro")}}
                        <label class="config-toggle">
                            <span class="config-item-label">Auto Reminders</span>
                            <input type="checkbox" name="auto_reminders" id="toggle_reminders" {{if .Invoice.AutoReminders}}checked{{end}}>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>
                        </label>
                        <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: -4px; line-height: 1.4;">
                            Automatically remind your client before and after the due date if unpaid.
                        </div>
                        {{else}}
                        <label class="config-toggle" style="opacity: 0.4; cursor: not-allowed;">
                            <span class="config-item-label">Auto Reminders</span>
                            <input type="checkbox" disabled>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>
                        </label>
                        <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: -4px; line-height: 1.4;">
                            <a href="/pricing?reason=reminders" style="color: #fbbf24; text-decoration: none; font-weight: 600;">Upgrade to Pro</a> to send automatic payment reminders.
                        </div>
                        {{end}}
                    </div>
		                        {{/* ── Recurring Schedule ── */}}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Recurring</div>

                        {{if and .User (eq .User.Plan "pro")}}
                        <label class="config-toggle">
                            <span class="config-item-label">Make Recurring</span>
                            <input type="checkbox" name="is_recurring" id="toggle_recurring" {{if .Invoice.IsRecurring}}checked{{end}}>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>
                        </label>

                        <div id="recurring_options" style="display: none; margin-top: 12px;">
                            <div style="margin-bottom: 12px;">
                                <label>Frequency</label>
                                <select name="recurring_frequency" id="recurring_frequency" style="width: 100%;">
                                    <option value="weekly" {{if eq .Invoice.RecurringFrequency "weekly"}}selected{{end}}>Weekly</option>
                                    <option value="monthly" {{if eq .Invoice.RecurringFrequency "monthly"}}selected{{end}}>Monthly</option>
                                    <option value="quarterly" {{if eq .Invoice.RecurringFrequency "quarterly"}}selected{{end}}>Quarterly</option>
                                    <option value="yearly" {{if eq .Invoice.RecurringFrequency "yearly"}}selected{{end}}>Yearly</option>
                                </select>
                            </div>

                            <label class="config-toggle">
                                <span class="config-item-label">Auto-send</span>
                                <input type="checkbox" name="recurring_auto_send" id="toggle_auto_send" {{if .Invoice.RecurringAutoSend}}checked{{end}}>
                                <span class="toggle-slider"><span class="toggle-knob"></span></span>
                            </label>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: -4px; line-height: 1.4;">
                                Automatically email the invoice when generated.
                            </div>
                        </div>
                        {{else}}
                        <label class="config-toggle" style="opacity: 0.4; cursor: not-allowed;">
                            <span class="config-item-label">Make Recurring</span>
                            <input type="checkbox" disabled>
                            <span class="toggle-slider"><span class="toggle-knob"></span></span>
                        </label>
                        <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: -4px; line-height: 1.4;">
                            <a href="/pricing?reason=recurring" style="color: #fbbf24; text-decoration: none; font-weight: 600;">Upgrade to Pro</a> to create recurring invoices.
                        </div>
                        {{end}}
                    </div>

                    {{/* ── Financial Controls ── */}}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Invoice Settings</div>

                        <div style="margin-bottom:16px;">
                            <label>Currency</label>
                            <select name="currency" id="currency">
                                {{range .Currencies}}
                                <option value="{{.Code}}" data-symbol="{{.Symbol}}"
                                        {{if eq $.Invoice.Currency .Code}}selected{{end}}>
                                    {{.Code}} — {{.Name}}
                                </option>
                                {{end}}
                            </select>
                        </div>

                        <div style="margin-bottom:16px;">
                            <label>Tax Rate (%)</label>
                            <input type="number" step="0.01" min="0" name="tax_rate" id="tax_rate"
                                   value="{{if .Invoice.TaxRateBps}}{{bpsToPercent .Invoice.TaxRateBps}}{{else}}0{{end}}"
                                   placeholder="0.00" inputmode="decimal">
                        </div>

                        <div style="margin-bottom:16px;">
                            <label>Discount ($)</label>
                            <input type="number" step="0.01" min="0" name="discount_amount" id="discount_amount"
                                   value="{{if .Invoice.DiscountAmountCentsRaw}}{{formatCents .Invoice.DiscountAmountCentsRaw}}{{else}}0.00{{end}}"
                                   placeholder="0.00" inputmode="decimal">
                        </div>

                        <div>
                            <label>Payment Instructions</label>
                            <textarea name="payment_details" rows="3"
                                      placeholder="Bank: Chase · Routing: xxx · Account: xxxx">{{.Invoice.PaymentDetails}}</textarea>
                        </div>
                    </div>

                    {{/* ── Financial Summary ── */}}
                    <div class="sidebar-section">
                        <div class="sidebar-section-label">Summary</div>

                        <div class="summary-line">
                            <span>Subtotal</span>
                            <span id="subtotal_display">{{if .Invoice.Subtotal}}{{.Invoice.Subtotal}}{{else}}$0.00{{end}}</span>
                        </div>
                        <div class="summary-line">
                            <span>Tax</span>
                            <span id="tax_display">{{if .Invoice.TaxAmount}}{{.Invoice.TaxAmount}}{{else}}$0.00{{end}}</span>
                        </div>
                        <div class="summary-line" id="discount_line" style="display:none;">
                            <span>Discount</span>
                            <span id="discount_display">-$0.00</span>
                        </div>
                        <div class="summary-line summary-total">
                            <span>Total</span>
                            <span id="total_display">{{if .Invoice.Total}}{{.Invoice.Total}}{{else}}$0.00{{end}}</span>
                        </div>
                    </div>
			<button type="submit" class="save-btn">
                        {{if eq .DocumentType "estimate"}}
                            {{if eq .Mode "edit"}}💾 Update Estimate{{else}}✅ Save Estimate{{end}}
                        {{else}}
                            {{if eq .Mode "edit"}}💾 Update Invoice{{else}}✅ Save Invoice{{end}}
                        {{end}}	
			</button>
                    <div id="draft-indicator" style="text-align:center;margin-top:12px;font-size:12px;color:rgba(255,255,255,0.6);opacity:0;transition:opacity 0.3s ease;"></div>
                </div>

                <div class="sidebar-box sidebar-integrations">
                    <div class="sidebar-section-label">Payment & Integrations</div>
                    <div class="integration-item">
                        <span class="integration-icon">🏦</span>
                        <div>
                            <div class="integration-name">Bank Transfer</div>
                            <div class="integration-desc">Add payment instructions above</div>
                        </div>
                    </div>
                    <div class="integration-item">
                        <span class="integration-icon">📨</span>
                        <div>
                            <div class="integration-name">Email Delivery</div>
                            <div class="integration-desc">Send invoices directly to clients</div>
                        </div>
                    </div>
                    <div class="integration-item">
                        <span class="integration-icon">👥</span>
                        <div>
                            <div class="integration-name">Saved Clients</div>
                            <div class="integration-desc">Auto-fill from your client list</div>
                        </div>
                    </div>
                    <div class="integration-item">
                        <span class="integration-icon">🔗</span>
                        <div>
                            <div class="integration-name">Crypto Payments</div>
                            <div class="integration-desc coming-soon">Coming Soon</div>
                        </div>
                    </div>
                </div>
            </aside>
	           </div>



    </form>
</div>

{{/* ── Mobile fixed bottom bar ──
     Only visible on screens < 640px via CSS.
     Shows the running total and a submit trigger.
     The button calls form.submit() — no duplicate form, no CSRF issue.
     The full sidebar (with tax/currency controls) still renders below
     the form for users who need to adjust those settings.
── */}}
<div class="mobile-total-bar">
    <div>
        <div class="mobile-total-label">Total</div>
        <div class="mobile-total-amount" id="mobile_total_display">$0.00</div>
    </div>
    <button type="button" class="mobile-submit-btn"
            onclick="document.getElementById('invoice-form').submit()">
        {{if eq .DocumentType "estimate"}}
            {{if eq .Mode "edit"}}Update{{else}}Save Estimate{{end}}
        {{else}}
            {{if eq .Mode "edit"}}Update{{else}}Save Invoice{{end}}
        {{end}}
    </button>
</div>

{{template "invoice-new-scripts" .}}

</body>
