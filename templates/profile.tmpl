<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head-no-title" .}}
    <title>{{.T.ProfileTitle}} | PSILOCONVALLEY</title>
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "profile-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">
    <div class="page-header">
        <h1 class="page-title">{{.T.ProfileTitle}}</h1>
        <p class="page-subtitle">{{.T.ProfileSubtitle}}</p>
    </div>

    {{if .Welcome}}
    <div class="pr-welcome">
        <div class="pr-welcome-icon">🎉</div>
        <div>
            <div class="pr-welcome-title">{{.T.ProfileWelcomeTitle}}</div>
            <div class="pr-welcome-body">{{.T.ProfileWelcomeBody}}</div>
            <div class="pr-welcome-actions">
                <span>{{.T.ProfileWelcomeStep}}</span>
                <span>·</span>
                <a href="/dashboard">{{.T.ProfileWelcomeSkip}}</a>
            </div>
        </div>
    </div>
    {{end}}

    {{if .Saved}}
    <div class="success-banner">{{.T.ProfileSaved}}</div>
    {{end}}
    {{if .PasswordSaved}}
    <div class="success-banner">{{.T.ProfilePasswordSaved}}</div>
    {{end}}
    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}

    {{if .MagicLogin}}
    <div class="pr-magic-banner">
        <div class="pr-magic-icon">🔐</div>
        <div>
            <div class="pr-magic-title">{{.T.ProfileMagicTitle}}</div>
            <div class="pr-magic-body">{{.T.ProfileMagicBody}}</div>
        </div>
    </div>
    {{end}}

    <div class="studio">
        <div class="controls">
            <form method="POST" action="/profile" enctype="multipart/form-data">
                {{.csrfField}}

                {{if and .Profile .Profile.Slug}}
                <div class="pr-public-section">
                    <div class="section-title section-title-green">🔗 {{.T.ProfilePublicPage}}</div>
                    <div class="pr-public-row">
                        <input type="text" readonly
                               value="{{$.BaseURL}}/biz/{{.Profile.Slug}}"
                               id="public-url"
                               class="pr-url-input">
                        <button type="button" onclick="copyPublicURL()" class="pr-copy-btn">
                            {{.T.ProfileCopyLink}}
                        </button>
                        <a href="/biz/{{.Profile.Slug}}" target="_blank" class="pr-preview-link">
                            {{.T.ProfilePreview}}
                        </a>
                    </div>
                    <div class="pr-public-hint">{{.T.ProfilePublicPageHint}}</div>
                </div>
                {{end}}

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionLogo}}</div>
                    <div class="form-group form-group-tight">
                        {{if .Profile}}{{if .Profile.LogoURL}}
                        <img src="{{.Profile.LogoURL}}" alt="Logo" class="pr-logo-preview">
                        {{end}}{{end}}
                        <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg">
                        <div class="hint">{{.T.ProfileLogoHint}}</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionCompany}}</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileCompanyName}}</label>
                            <input type="text" name="name" id="field-name" value="{{if .Profile}}{{.Profile.Name}}{{end}}" required>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileEmail}}</label>
                            <input type="email" name="email" id="field-email" value="{{if .Profile}}{{.Profile.Email}}{{end}}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ProfilePhone}}</label>
                        <input type="tel" name="phone" value="{{if .Profile}}{{.Profile.Phone}}{{end}}" placeholder="(555) 123-4567">
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionAddress}}</div>
                    <div class="form-group">
                        <label>{{.T.ProfileStreetAddress}}</label>
                        <input type="text" name="address" value="{{if .Profile}}{{.Profile.Address}}{{end}}" data-address-autocomplete>
                    </div>
                    <div class="grid-3">
                        <div class="form-group">
                            <label>{{.T.ProfileCity}}</label>
                            <input type="text" name="city" value="{{if .Profile}}{{.Profile.City}}{{end}}" data-address-city>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileStateRegion}}</label>
                            <input type="text" name="state" value="{{if .Profile}}{{.Profile.State}}{{end}}" data-address-state>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileZipPostal}}</label>
                            <input type="text" name="zip" value="{{if .Profile}}{{.Profile.Zip}}{{end}}" data-address-zip>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ProfileCountry}}</label>
                        <input type="text" name="country" value="{{if .Profile}}{{.Profile.Country}}{{end}}" data-address-country>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionFinancial}}</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileTaxID}}</label>
                            <input type="text" name="tax_id" value="{{if .Profile}}{{.Profile.TaxID}}{{end}}">
                            <div class="hint">{{.T.ProfileTaxIDHint}}</div>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileCurrency}}</label>
                            <select name="currency">
                                <option value="USD" {{if .Profile}}{{if eq .Profile.Currency "USD"}}selected{{end}}{{else}}selected{{end}}>USD — US Dollar</option>
                                <option value="CAD" {{if .Profile}}{{if eq .Profile.Currency "CAD"}}selected{{end}}{{end}}>CAD — Canadian Dollar</option>
                                <option value="GBP" {{if .Profile}}{{if eq .Profile.Currency "GBP"}}selected{{end}}{{end}}>GBP — British Pound</option>
                                <option value="EUR" {{if .Profile}}{{if eq .Profile.Currency "EUR"}}selected{{end}}{{end}}>EUR — Euro</option>
                                <option value="MXN" {{if .Profile}}{{if eq .Profile.Currency "MXN"}}selected{{end}}{{end}}>MXN — Mexican Peso</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title section-title-amber">💸 {{.T.ProfileQuickPay}}</div>
                    <div class="section-sub">{{.T.ProfileQuickPaySub}}</div>
                    <div class="form-group">
                        <label>{{.T.ProfileZelleLabel}}</label>
                        <input type="text" name="zelle_id"
                               value="{{if .Profile}}{{.Profile.ZelleID}}{{end}}"
                               placeholder="your@email.com or (555) 123-4567">
                    </div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileVenmoLabel}}</label>
                            <input type="text" name="venmo_handle"
                                   value="{{if .Profile}}{{.Profile.VenmoHandle}}{{end}}"
                                   placeholder="@your-username">
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileCashAppLabel}}</label>
                            <input type="text" name="cashapp_handle"
                                   value="{{if .Profile}}{{.Profile.CashAppHandle}}{{end}}"
                                   placeholder="$yourtag">
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">🗺️ {{.T.ProfileServiceAreas}}</div>
                    <div class="form-group">
                        <input type="text" name="service_areas"
                               value="{{if .Profile}}{{.Profile.ServiceAreas}}{{end}}"
                               placeholder="San Antonio, Helotes, Leon Valley, Boerne">
                        <div class="hint">{{.T.ProfileServiceAreasHint}}</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionPayment}}</div>
                    {{if .StripeConnected}}
                    <div class="success-banner">✅ {{.T.ProfileStripeConnected}}</div>
                    {{end}}
                    {{if .StripeError}}
                    <div class="error-banner">❌ {{.T.ProfileStripeError}}</div>
                    {{end}}

                    {{if .User.StripeConnectID}}
                    <div class="pr-stripe-connected">
                        <span class="pr-stripe-connected-icon">✅</span>
                        <div>
                            <div class="pr-stripe-connected-name">{{.T.ProfileStripeConnected}}</div>
                            <div class="pr-stripe-connected-sub">{{.T.ProfileStripeConnectedSub}} · {{.User.StripeConnectID}}</div>
                        </div>
                    </div>
                    {{else}}
                    <div class="pr-stripe-disconnected">
                        <span class="pr-stripe-disconnected-icon">💳</span>
                        <div class="pr-stripe-disconnected-body">
                            <div class="pr-stripe-disconnected-name">{{.T.ProfileStripeAcceptCards}}</div>
                            <div class="pr-stripe-disconnected-sub">{{.T.ProfileStripeAcceptCardsSub}}</div>
                        </div>
                        <a href="/auth/stripe/connect" class="pr-stripe-btn">{{.T.ProfileStripeConnect}}</a>
                    </div>
                    {{end}}
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionLanguage}}</div>
                    <div class="form-group">
                        <label>{{.T.ProfileSectionLanguage}}</label>
                        <select name="language">
                            <option value="en" {{if eq .User.Language "en"}}selected{{end}}>English</option>
                            <option value="es" {{if eq .User.Language "es"}}selected{{end}}>Español</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn-primary">{{.T.ProfileSave}}</button>
            </form>

            <div class="pr-divider" id="passkey">
                <h2 class="pr-security-heading">{{.T.ProfileSectionSecurity}}</h2>
                <div class="section-title">{{.T.ProfilePasskeyTitle}}</div>
                <p class="hint">{{.T.ProfilePasskeySubtitle}}</p>

                {{if .PasskeyDeleted}}
                <div class="success-banner">{{.T.ProfilePasskeyDeleted}}</div>
                {{end}}

                {{if .Passkeys}}
                <div class="pr-passkey-list">
                    <div class="pr-passkey-list-label">{{.T.ProfilePasskeyListTitle}}</div>
                    {{range .Passkeys}}
                    <div class="pr-passkey-item">
                        <div>
                            <div class="pr-passkey-name">{{.DeviceName}}</div>
                            <div class="pr-passkey-meta">
                                {{$.T.ProfilePasskeyAddedOn}} {{.CreatedAt.Format "Jan 2, 2006"}}
                                {{if .LastUsedAt}} · {{$.T.ProfilePasskeyLastUsed}} {{.LastUsedAt.Format "Jan 2, 2006"}}{{end}}
                            </div>
                        </div>
                        <form method="POST" action="/passkeys/{{.ID}}/delete"
                              onsubmit="return confirm('{{$.T.ProfilePasskeyDeleteConfirm}}');">
                            {{$.csrfField}}
                            <button type="submit" class="pr-passkey-delete">{{$.T.ProfilePasskeyDelete}}</button>
                        </form>
                    </div>
                    {{end}}
                </div>
                {{else}}
                <p class="pr-passkey-empty">{{.T.ProfilePasskeyListEmpty}}</p>
                {{end}}

                <div id="passkey-status" class="pr-passkey-status"></div>
                <button type="button" id="passkey-register-btn" class="btn-primary-sm">
                    {{.T.ProfilePasskeyAdd}}
                </button>
            </div>

            <script>
            (function() {
                var btn = document.getElementById('passkey-register-btn');
                var status = document.getElementById('passkey-status');

                if (!window.PublicKeyCredential) {
                    btn.style.display = 'none';
                    status.innerHTML = '<span style="font-size:12px;color:rgba(255,255,255,0.3);">{{.T.ProfilePasskeyNoSupport}}</span>';
                    return;
                }

                btn.addEventListener('click', async function() {
                    btn.disabled = true;
                    btn.textContent = '{{.T.ProfilePasskeyRegistering}}';
                    try {
                        var beginResp = await fetch('/passkeys/register/begin', { method: 'POST', credentials: 'same-origin' });
                        if (!beginResp.ok) throw new Error('{{.T.ProfilePasskeyErrorGeneric}}');
                        var options = await beginResp.json();

                        options.publicKey.challenge = base64urlToBuffer(options.publicKey.challenge);
                        options.publicKey.user.id = base64urlToBuffer(options.publicKey.user.id);
                        if (options.publicKey.excludeCredentials) {
                            options.publicKey.excludeCredentials = options.publicKey.excludeCredentials.map(function(c) {
                                c.id = base64urlToBuffer(c.id); return c;
                            });
                        }

                        var credential = await navigator.credentials.create(options);
                        var body = JSON.stringify({
                            id: credential.id,
                            rawId: bufferToBase64url(credential.rawId),
                            type: credential.type,
                            response: {
                                attestationObject: bufferToBase64url(credential.response.attestationObject),
                                clientDataJSON: bufferToBase64url(credential.response.clientDataJSON)
                            }
                        });

                        var finishResp = await fetch('/passkeys/register/finish', {
                            method: 'POST', credentials: 'same-origin',
                            headers: { 'Content-Type': 'application/json' }, body: body
                        });

                        if (finishResp.ok) {
                            status.innerHTML = '<span style="color:#4ade80;font-weight:700;">{{.T.ProfilePasskeySuccess}}</span>';
                            btn.textContent = '{{.T.ProfilePasskeyAdded}}';
                            btn.disabled = true;
                        } else {
                            throw new Error('{{.T.ProfilePasskeyErrorGeneric}}');
                        }
                    } catch (e) {
                        status.innerHTML = '<span style="color:#fca5a5;">{{.T.ProfilePasskeyErrorPrefix}} ' + e.message + '</span>';
                        btn.disabled = false;
                        btn.textContent = '{{.T.ProfilePasskeyAdd}}';
                    }
                });

                function base64urlToBuffer(base64url) {
                    var base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
                    var pad = base64.length % 4;
                    if (pad) base64 += '='.repeat(4 - pad);
                    var binary = atob(base64);
                    var bytes = new Uint8Array(binary.length);
                    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                    return bytes.buffer;
                }

                function bufferToBase64url(buffer) {
                    var bytes = new Uint8Array(buffer);
                    var binary = '';
                    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
                    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
                }
            })();
            </script>

            <div class="pr-divider">
                <div class="section-title">
                    {{if .HasPassword}}{{.T.ProfileChangePassword}}{{else}}{{.T.ProfileSetPassword}}{{end}}
                </div>

                {{if eq .PasswordError "current"}}
                <div class="error-banner">{{.T.ProfileErrCurrentPW}}</div>
                {{else if eq .PasswordError "short"}}
                <div class="error-banner">{{.T.ProfileErrShortPW}}</div>
                {{else if eq .PasswordError "mismatch"}}
                <div class="error-banner">{{.T.ProfileErrMismatchPW}}</div>
                {{else if eq .PasswordError "failed"}}
                <div class="error-banner">{{.T.ProfileErrFailedPW}}</div>
                {{end}}

                <form method="POST" action="/profile/password" autocomplete="off">
                    {{.csrfField}}
                    {{if .HasPassword}}
                    <div class="form-group">
                        <label>{{.T.ProfileCurrentPassword}}</label>
                        <input type="password" name="current_password" autocomplete="current-password" placeholder="••••••••" required>
                    </div>
                    {{end}}
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileNewPassword}}</label>
                            <input type="password" name="new_password" id="new-password" autocomplete="new-password" placeholder="{{.T.ProfilePasswordMin}}" minlength="8" required>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileConfirmPassword}}</label>
                            <input type="password" name="confirm_password" id="confirm-password" autocomplete="new-password" placeholder="{{.T.ProfilePasswordRepeat}}" minlength="8" required>
                        </div>
                    </div>
                    <div id="pw-match-hint" class="pr-pw-hint"></div>
                    <button type="submit" class="btn-primary" id="pw-submit-btn">
                        {{if .HasPassword}}{{.T.ProfileUpdatePassword}}{{else}}{{.T.ProfileSetPassword}}{{end}}
                    </button>
                </form>

                {{if .IsGoogleUser}}
                <p class="pr-google-note">{{.T.ProfileGoogleSignIn}}</p>
                {{end}}
            </div>
        </div>

        {{template "profile-preview" .}}
    </div>
</div>

{{template "profile-scripts" .}}
<script src="/static/js/password-toggle.js" defer></script>
<script src="/static/js/address-autocomplete.js"></script>
<script>
function copyPublicURL() {
    var input = document.getElementById('public-url');
    input.select();
    navigator.clipboard.writeText(input.value).then(function() {
        var btn = event.target;
        var orig = btn.textContent;
        btn.textContent = '{{.T.ProfileCopied}}';
        setTimeout(function() { btn.textContent = orig; }, 2000);
    });
}
</script>

</body>
</html>
