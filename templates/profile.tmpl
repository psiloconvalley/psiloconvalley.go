<!DOCTYPE html>
<html>
<head>
    <title>{{.T.ProfileTitle}} | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "profile-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">
    <div class="page-header">
        <h1 class="page-title">{{.T.ProfileTitle}}</h1>
        <p class="page-subtitle">{{.T.ProfileSubtitle}}</p>
    </div>
    {{if .Welcome}}
    <div style="
        background: linear-gradient(135deg, rgba(74,222,128,0.08) 0%, rgba(34,197,94,0.04) 100%);
        border: 1px solid rgba(74,222,128,0.2);
        border-radius: 14px;
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    ">
        <div style="
            font-size: 32px;
            line-height: 1;
            flex-shrink: 0;
        ">🎉</div>
        <div>
            <div style="font-size: 18px; font-weight: 800; color: #4ade80; margin-bottom: 6px;">
                {{.T.ProfileWelcomeTitle}}
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6;">
                {{.T.ProfileWelcomeBody}}
            </div>
            <div style="
                margin-top: 14px;
                display: flex;
                gap: 16px;
                font-size: 12px;
                color: rgba(255,255,255,0.3);
            ">
                <span>{{.T.ProfileWelcomeStep}}</span>
                <span>·</span>
                <a href="/dashboard" style="color: rgba(255,255,255,0.4); text-decoration: none;">{{.T.ProfileWelcomeSkip}}</a>
            </div>
        </div>
    </div>
    {{end}}

    {{if .Saved}}
    <div class="success-banner">{{.T.ProfileSaved}}</div>
    {{end}}
    {{if .PasswordSaved}}
    <div class="success-banner">{{.T.ProfilePasswordSaved}}</div>
    {{end}}

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}
    {{if .MagicLogin}}
    <div style="
        background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(99,102,241,0.04) 100%);
        border: 1px solid rgba(129,140,248,0.2);
        border-radius: 14px;
        padding: 24px 28px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    ">
        <div style="font-size: 28px; flex-shrink: 0; line-height: 1;">🔐</div>
        <div>
            <div style="font-size: 15px; font-weight: 800; color: #a5b4fc; margin-bottom: 6px;">
                {{.T.ProfileMagicTitle}}
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6;">
                {{.T.ProfileMagicBody}}
            </div>
        </div>
    </div>
    {{end}}

    <div class="studio">
        <!-- ═══════════ LEFT: FORM CONTROLS ═══════════ -->
        <div class="controls">
            <form method="POST" action="/profile" enctype="multipart/form-data">
                {{.csrfField}}

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionLogo}}</div>
                    <div class="form-group" style="margin-bottom: 0;">
                        {{if .Profile}}
                            {{if .Profile.LogoURL}}
                            <div style="margin-bottom: 12px;">
                                <img
                                    src="{{.Profile.LogoURL}}"
                                    alt="Logo"
                                    style="max-width:140px; max-height:60px; object-fit:contain; background:#fff; border:1px solid #eee; border-radius:8px; padding:10px;"
                                >
                            </div>
                            {{end}}
                        {{end}}
                        <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg">
                        <div class="hint">{{.T.ProfileLogoHint}}</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionCompany}}</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileCompanyName}}</label>
                            <input type="text" name="name" id="field-name" value="{{if .Profile}}{{.Profile.Name}}{{end}}" required>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileEmail}}</label>
                            <input type="email" name="email" id="field-email" value="{{if .Profile}}{{.Profile.Email}}{{end}}">
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionAddress}}</div>
                    <div class="form-group">
                        <label>{{.T.ProfileStreetAddress}}</label>
                        <input type="text" name="address" value="{{if .Profile}}{{.Profile.Address}}{{end}}">
                    </div>
                    <div class="grid-3">
                        <div class="form-group">
                            <label>{{.T.ProfileCity}}</label>
                            <input type="text" name="city" value="{{if .Profile}}{{.Profile.City}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileStateRegion}}</label>
                            <input type="text" name="state" value="{{if .Profile}}{{.Profile.State}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileZipPostal}}</label>
                            <input type="text" name="zip" value="{{if .Profile}}{{.Profile.Zip}}{{end}}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ProfileCountry}}</label>
                        <input type="text" name="country" value="{{if .Profile}}{{.Profile.Country}}{{end}}">
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionFinancial}}</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileTaxID}}</label>
                            <input type="text" name="tax_id" value="{{if .Profile}}{{.Profile.TaxID}}{{end}}">
                            <div class="hint">{{.T.ProfileTaxIDHint}}</div>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileCurrency}}</label>
                            <select name="currency">
                                <option value="USD" {{if .Profile}}{{if eq .Profile.Currency "USD"}}selected{{end}}{{else}}selected{{end}}>USD — US Dollar</option>
                                <option value="CAD" {{if .Profile}}{{if eq .Profile.Currency "CAD"}}selected{{end}}{{end}}>CAD — Canadian Dollar</option>
                                <option value="GBP" {{if .Profile}}{{if eq .Profile.Currency "GBP"}}selected{{end}}{{end}}>GBP — British Pound</option>
                                <option value="EUR" {{if .Profile}}{{if eq .Profile.Currency "EUR"}}selected{{end}}{{end}}>EUR — Euro</option>
                                <option value="MXN" {{if .Profile}}{{if eq .Profile.Currency "MXN"}}selected{{end}}{{end}}>MXN — Mexican Peso</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionPayment}}</div>
                    {{if .StripeConnected}}
                    <div class="success-banner">✅ {{.T.ProfileStripeConnected}}</div>
                    {{end}}
                    {{if .StripeError}}
                    <div class="error-banner">❌ {{.T.ProfileStripeError}}</div>
                    {{end}}

                    {{if .User.StripeConnectID}}
                    <div style="display: flex; align-items: center; gap: 12px; padding: 14px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px;">
                        <span style="font-size: 20px;">✅</span>
                        <div>
                            <div style="font-weight: 700; font-size: 13px; color: #6ee7b7;">{{.T.ProfileStripeConnected}}</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">{{.T.ProfileStripeConnectedSub}} Account: {{.User.StripeConnectID}}</div>
                        </div>
                    </div>
                    {{else}}
                    <div style="display: flex; align-items: center; gap: 14px; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;">
                        <span style="font-size: 24px;">💳</span>
                        <div style="flex: 1;">
                            <div style="font-weight: 700; font-size: 13px; color: #fff;">{{.T.ProfileStripeAcceptCards}}</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">{{.T.ProfileStripeAcceptCardsSub}}</div>
                        </div>
                        <a href="/auth/stripe/connect" style="background: #635bff; color: white; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap;">{{.T.ProfileStripeConnect}}</a>
                    </div>
                    {{end}}
                </div>

                <div class="section">
                    <div class="section-title">{{.T.ProfileSectionLanguage}}</div>
                    <div class="form-group">
                        <label>{{.T.ProfileSectionLanguage}}</label>
                        <select name="language">
                            <option value="en" {{if eq .User.Language "en"}}selected{{end}}>English</option>
                            <option value="es" {{if eq .User.Language "es"}}selected{{end}}>Español</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-primary">{{.T.ProfileSave}}</button>
            </form>
        <!-- ═══════════ PASSKEY ═══════════ -->
            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.08);">
	    <h2 style="font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 24px;">{{.T.ProfileSectionSecurity}}</h2>
		<div class="section-title">{{.T.ProfilePasskeyTitle}}</div>
                <p style="font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 16px;">
		{{.T.ProfilePasskeySubtitle}}
                </p>
		{{if .PasskeyDeleted}}
                <div class="success-banner">{{.T.ProfilePasskeyDeleted}}</div>
                {{end}}

                {{if .Passkeys}}
                <div style="margin-bottom: 16px;">
                    <div style="font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px;">{{.T.ProfilePasskeyListTitle}}</div>
                    {{range .Passkeys}}
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; margin-bottom: 8px;">
                        <div>
                            <div style="font-size: 13px; font-weight: 600; color: #fff;">{{.DeviceName}}</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 2px;">
                                {{$.T.ProfilePasskeyAddedOn}} {{.CreatedAt.Format "Jan 2, 2006"}}
                                {{if .LastUsedAt}} · {{$.T.ProfilePasskeyLastUsed}} {{.LastUsedAt.Format "Jan 2, 2006"}}{{end}}
                            </div>
                        </div>
                        <form method="POST" action="/passkeys/{{.ID}}/delete"
                              onsubmit="return confirm('{{$.T.ProfilePasskeyDeleteConfirm}}');">
                            {{$.csrfField}}
                            <button type="submit" style="background: rgba(239,68,68,0.1); color: #fca5a5; border: 1px solid rgba(239,68,68,0.2); padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
                                {{$.T.ProfilePasskeyDelete}}
                            </button>
                        </form>
                    </div>
                    {{end}}
                </div>
                {{else}}
                <p style="font-size: 12px; color: rgba(255,255,255,0.25); margin-bottom: 16px;">{{.T.ProfilePasskeyListEmpty}}</p>
                {{end}}
                <div id="passkey-status" style="margin-bottom: 16px;"></div>
                <button type="button" id="passkey-register-btn" class="btn-primary" style="width: auto;">
		{{.T.ProfilePasskeyAdd}}
                </button>
            </div>

            <script>
            (function() {
                var btn = document.getElementById('passkey-register-btn');
                var status = document.getElementById('passkey-status');

                // Hide button if browser doesn't support WebAuthn
                if (!window.PublicKeyCredential) {
                    btn.style.display = 'none';
		    status.innerHTML = '<div style="font-size:12px; color:rgba(255,255,255,0.3);">{{.T.ProfilePasskeyNoSupport}}</div>';
                    return;
                }

                btn.addEventListener('click', async function() {
                    btn.disabled = true;
		btn.textContent = '{{.T.ProfilePasskeyRegistering}}';
                    try {
                        // 1. Get registration options from server
                        var beginResp = await fetch('/passkeys/register/begin', {
                            method: 'POST',
                            credentials: 'same-origin'
                        });
			if (!beginResp.ok) throw new Error('{{.T.ProfilePasskeyErrorGeneric}}');
                        var options = await beginResp.json();

                        // 2. Decode base64url fields for the browser API
                        options.publicKey.challenge = base64urlToBuffer(options.publicKey.challenge);
                        options.publicKey.user.id = base64urlToBuffer(options.publicKey.user.id);
                        if (options.publicKey.excludeCredentials) {
                            options.publicKey.excludeCredentials = options.publicKey.excludeCredentials.map(function(c) {
                                c.id = base64urlToBuffer(c.id);
                                return c;
                            });
                        }

                        // 3. Trigger Face ID / Touch ID / PIN
                        var credential = await navigator.credentials.create(options);

                        // 4. Encode response for server
                        var body = JSON.stringify({
                            id: credential.id,
                            rawId: bufferToBase64url(credential.rawId),
                            type: credential.type,
                            response: {
                                attestationObject: bufferToBase64url(credential.response.attestationObject),
                                clientDataJSON: bufferToBase64url(credential.response.clientDataJSON)
                            }
                        });

                        // 5. Send to server
                        var finishResp = await fetch('/passkeys/register/finish', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'Content-Type': 'application/json' },
                            body: body
                        });

                        if (finishResp.ok) {
			    status.innerHTML = '<div style="color:#4ade80; font-size:13px; font-weight:700;">{{.T.ProfilePasskeySuccess}}</div>';
			    btn.textContent = '{{.T.ProfilePasskeyAdded}}';
                            btn.disabled = true;
                        } else {
			throw new Error('{{.T.ProfilePasskeyErrorGeneric}}');
                        }
                    } catch (e) {
			status.innerHTML = '<div style="color:#fca5a5; font-size:13px;">{{.T.ProfilePasskeyErrorPrefix}} ' + e.message + '</div>';
                        btn.disabled = false;
		    btn.textContent = '{{.T.ProfilePasskeyAdd}}';
                    }
                });

                function base64urlToBuffer(base64url) {
                    var base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
                    var pad = base64.length % 4;
                    if (pad) base64 += '='.repeat(4 - pad);
                    var binary = atob(base64);
                    var bytes = new Uint8Array(binary.length);
                    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                    return bytes.buffer;
                }

                function bufferToBase64url(buffer) {
                    var bytes = new Uint8Array(buffer);
                    var binary = '';
                    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
                    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
                }
            })();
            </script>
            <!-- ═══════════ PASSWORD ═══════════ -->
            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.08);">
                <div class="section-title">
                    {{if .HasPassword}}{{.T.ProfileChangePassword}}{{else}}{{.T.ProfileSetPassword}}{{end}}
                </div>

                {{if eq .PasswordError "current"}}
                <div class="error-banner">{{.T.ProfileErrCurrentPW}}</div>
                {{else if eq .PasswordError "short"}}
                <div class="error-banner">{{.T.ProfileErrShortPW}}</div>
                {{else if eq .PasswordError "mismatch"}}
                <div class="error-banner">{{.T.ProfileErrMismatchPW}}</div>
                {{else if eq .PasswordError "failed"}}
                <div class="error-banner">{{.T.ProfileErrFailedPW}}</div>
                {{end}}

                <form method="POST" action="/profile/password" autocomplete="off">
                    {{.csrfField}}

                    {{if .HasPassword}}
                    <div class="form-group">
                        <label>{{.T.ProfileCurrentPassword}}</label>
                        <input
                            type="password"
                            name="current_password"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required>
                    </div>
                    {{end}}

                    <div class="grid-2">
                        <div class="form-group">
                            <label>{{.T.ProfileNewPassword}}</label>
                            <input
                                type="password"
                                name="new_password"
                                id="new-password"
                                autocomplete="new-password"
                                placeholder="{{.T.ProfilePasswordMin}}"
                                minlength="8"
                                required>
                        </div>
                        <div class="form-group">
                            <label>{{.T.ProfileConfirmPassword}}</label>
                            <input
                                type="password"
                                name="confirm_password"
                                id="confirm-password"
                                autocomplete="new-password"
                                placeholder="{{.T.ProfilePasswordRepeat}}"
                                minlength="8"
                                required>
                        </div>
                    </div>

                    <div id="pw-match-hint" style="font-size:12px;color:rgba(255,255,255,0.3);margin-bottom:16px;min-height:18px;"></div>

                    <button type="submit" class="btn-primary" id="pw-submit-btn">
                        {{if .HasPassword}}{{.T.ProfileUpdatePassword}}{{else}}{{.T.ProfileSetPassword}}{{end}}
                    </button>
                </form>

                {{if .IsGoogleUser}}
                <p style="font-size:12px;color:rgba(255,255,255,0.3);margin-top:14px;line-height:1.6;">
                    {{.T.ProfileGoogleSignIn}}
                </p>
                {{end}}
            </div>
        </div>
{{template "profile-preview" .}}
    </div>
</div>
{{template "profile-scripts" .}}
</body>
</html>
