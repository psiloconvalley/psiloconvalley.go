<!DOCTYPE html>
<html>
<head>
    <title>Business Profile | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #f5f5f5; color: #111; font-family: 'Inter', sans-serif; }
        .page { max-width: 720px; margin: 48px auto; padding: 0 24px; }
        .card { background: white; border-radius: 16px; padding: 48px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
        .page-title { font-size: 32px; font-weight: 700; letter-spacing: -1px; margin-bottom: 8px; }
        .page-subtitle { font-size: 14px; color: #666; margin-bottom: 40px; }
        .success-banner { background: #dcfce7; border: 1px solid #bbf7d0; color: #15803d; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 32px; }
        .error-banner { background: #fee2e2; border: 1px solid #fecaca; color: #dc2626; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 32px; }
        .section-title { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #999; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #444; margin-bottom: 8px; }
        .form-group input, .form-group select { width: 100%; padding: 12px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; font-family: 'Inter', sans-serif; color: #111; background: #fff; }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: #111; }
        .section { margin-bottom: 40px; }
        .btn-primary { background: #111; color: white; border: none; padding: 14px 32px; border-radius: 8px; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; width: 100%; margin-top: 8px; }
        .btn-primary:hover { background: #333; }
        .hint { font-size: 12px; color: #999; margin-top: 6px; }
        @media (max-width: 600px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } .card { padding: 32px 24px; } }
    </style>
</head>
<body>

{{template "nav-styles" .}}
{{template "nav" .}}

<div class="page">
    <div class="card">
        <h1 class="page-title">Business Profile</h1>
        <p class="page-subtitle">Saved once. Auto-fills every new invoice.</p>

        {{if .Saved}}
        <div class="success-banner">✓ Profile saved successfully</div>
        {{end}}

        {{if .Error}}
        <div class="error-banner">{{.Error}}</div>
        {{end}}

	<form method="POST" action="/profile" enctype="multipart/form-data">

            {{.csrfField}}

            <div class="section">
                <div class="section-title">Company Information</div>
                <!-- Logo Upload -->
<div class="form-group" style="margin-bottom:32px;">
    <label>Company Logo</label>

    {{if .Profile}}
        {{if .Profile.LogoURL}}
        <div style="margin-bottom:16px;">
            <img
                src="{{.Profile.LogoURL}}"
                alt="Company Logo"
                style="
                    max-width:180px;
                    max-height:80px;
                    object-fit:contain;
                    background:#fff;
                    border:1px solid #eee;
                    border-radius:8px;
                    padding:12px;
                "
            >
        </div>
        {{end}}
    {{end}}

    <input
        type="file"
        name="logo"
        accept=".png,.jpg,.jpeg,.webp,.svg"
    >

    <div class="hint">
        PNG recommended. Max 2MB.
        Appears on invoices and PDFs.
    </div>
</div>
		<div class="grid-2">
                    <div class="form-group">
                        <label>Company Name *</label>
                        <input type="text" name="name" value="{{if .Profile}}{{.Profile.Name}}{{end}}" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" value="{{if .Profile}}{{.Profile.Email}}{{end}}">
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Address</div>
                <div class="form-group">
                    <label>Street Address</label>
                    <input type="text" name="address" value="{{if .Profile}}{{.Profile.Address}}{{end}}">
                </div>
                <div class="grid-3">
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" name="city" value="{{if .Profile}}{{.Profile.City}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>State / Region</label>
                        <input type="text" name="state" value="{{if .Profile}}{{.Profile.State}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>Zip / Postal Code</label>
                        <input type="text" name="zip" value="{{if .Profile}}{{.Profile.Zip}}{{end}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>Country</label>
                    <input type="text" name="country" value="{{if .Profile}}{{.Profile.Country}}{{end}}">
                </div>
            </div>

            <div class="section">
                <div class="section-title">Financial Settings</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Tax ID / EIN</label>
                        <input type="text" name="tax_id" value="{{if .Profile}}{{.Profile.TaxID}}{{end}}">
                        <div class="hint">Optional. Appears on invoices if provided.</div>
                    </div>
                    <div class="form-group">
                        <label>Default Currency</label>
                        <select name="currency">
                            <option value="USD" {{if .Profile}}{{if eq .Profile.Currency "USD"}}selected{{end}}{{else}}selected{{end}}>USD — US Dollar</option>
                            <option value="CAD" {{if .Profile}}{{if eq .Profile.Currency "CAD"}}selected{{end}}{{end}}>CAD — Canadian Dollar</option>
                            <option value="GBP" {{if .Profile}}{{if eq .Profile.Currency "GBP"}}selected{{end}}{{end}}>GBP — British Pound</option>
                            <option value="EUR" {{if .Profile}}{{if eq .Profile.Currency "EUR"}}selected{{end}}{{end}}>EUR — Euro</option>
                            <option value="MXN" {{if .Profile}}{{if eq .Profile.Currency "MXN"}}selected{{end}}{{end}}>MXN — Mexican Peso</option>
                        </select>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-primary">Save Profile</button>
        </form>
    </div>
</div>

</body>
</html>
