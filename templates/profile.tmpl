<!DOCTYPE html>
<html>
<head>
    <title>Business Profile | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #0a0f1a; color: #fff; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
	.page { max-width: 1200px; margin: 48px auto; padding: 0 24px; }
        .page-header { margin-bottom: 32px; border-left: 2px solid #fff; padding-left: 25px; }
        .page-title { font-size: 32px; font-weight: 700; letter-spacing: -1px; margin-bottom: 8px; text-transform: uppercase; }
        .page-subtitle { font-size: 13px; color: rgba(255,255,255,0.4); font-family: monospace; }

        .success-banner { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 24px; }
        .error-banner { background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.3); color: #fca5a5; padding: 14px 18px; border-radius: 10px; font-size: 14px; font-weight: 600; margin-bottom: 24px; }
        
        /* ── Studio Layout ── */
        .studio {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 32px;
            align-items: start;
        }

               /* ── Left: Form Controls ── */
        .controls {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 40px;
        }

        .section-title {
            font-size: 11px; font-weight: 600; letter-spacing: 2px;
            text-transform: uppercase; color: rgba(255,255,255,0.4);
            margin-bottom: 20px; padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .section { margin-bottom: 36px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.6); margin-bottom: 8px; }
        .form-group input, .form-group select {
            width: 100%; padding: 10px 12px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px; font-size: 14px; font-family: inherit;
            color: #fff; background: rgba(255,255,255,0.05);
        }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.08); }
        .form-group select option { background: #1e293b; color: #fff; }
        .hint { font-size: 12px; color: rgba(255,255,255,0.3); margin-top: 6px; }

        .btn-primary {
            background: #fff; color: #0a0f1a; border: none;
            padding: 12px 28px; border-radius: 8px; font-size: 14px;
            font-weight: 700; font-family: inherit;
            cursor: pointer; width: 100%; margin-top: 8px;
        }
        .btn-primary:hover { background: #e5e5e5; } 
        /* ── Right: Preview Rail ── */
        .preview-rail {
            position: sticky;
            top: 80px;
        }
        .preview-label {
            font-size: 11px; font-weight: 700; letter-spacing: 2px;
            text-transform: uppercase; color: #94a3b8;
            margin-bottom: 12px;
        }
        .preview-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        }
        .preview-accent { height: 5px; background: #0d1422; }
        .preview-body { padding: 24px; }

        .preview-logo-area {
            margin-bottom: 14px;
            min-height: 40px;
        }
        .preview-logo-placeholder {
            width: 120px; height: 40px;
            background: #f1f5f9; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 10px; color: #94a3b8; font-weight: 600;
        }
        .preview-logo-img {
            max-width: 140px; max-height: 55px;
            object-fit: contain; display: block;
        }

        .preview-header {
            display: flex; justify-content: space-between;
            align-items: baseline; margin-bottom: 18px;
        }
        .preview-title { font-size: 15px; font-weight: 800; color: #0d1422; letter-spacing: -0.3px; }
        .preview-company-name { font-size: 11px; font-weight: 600; color: #64748b; margin-top: 3px; }
        .preview-inv-label { font-size: 9px; font-weight: 700; text-transform: uppercase; color: #94a3b8; letter-spacing: 0.8px; }
        .preview-inv-number { font-size: 11px; font-weight: 600; color: #0d1422; }

        .preview-items { border-top: 1px solid #e2e8f0; padding-top: 12px; }
        .preview-item {
            display: flex; justify-content: space-between;
            font-size: 11px; color: #64748b; margin-bottom: 7px;
        }
        .preview-item-name { font-weight: 700; color: #0d1422; }
        .preview-item-amount { font-variant-numeric: tabular-nums; }

        .preview-total {
            border-top: 1px solid #cbd5e1;
            margin-top: 14px; padding-top: 12px;
            display: flex; justify-content: space-between;
            font-size: 14px; font-weight: 800; color: #0d1422;
        }
        .preview-total-amount { font-variant-numeric: tabular-nums; }

        .preview-hint {
            font-size: 10px; color: #94a3b8; text-align: center;
            margin-top: 16px; font-style: italic;
        }

        /* ── Mobile: stack + floating preview button ── */
        .mobile-preview-btn {
            display: none;
            position: fixed; bottom: 24px; right: 24px;
            background: #0d1422; color: white;
            border: none; border-radius: 50px;
            padding: 14px 20px; font-size: 13px; font-weight: 700;
	    font-family: inherit;
            cursor: pointer; z-index: 100;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .mobile-preview-btn:hover { background: #1e293b; }

        .preview-overlay {
            display: none;
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5); z-index: 200;
        }
        .preview-sheet {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: white; border-radius: 20px 20px 0 0;
            padding: 24px; max-height: 80vh; overflow-y: auto;
            z-index: 201; transform: translateY(100%);
            transition: transform 0.3s ease;
        }
        .preview-sheet.open { transform: translateY(0); }
        .preview-sheet-handle {
            width: 40px; height: 4px; background: #ddd;
            border-radius: 2px; margin: 0 auto 20px;
        }
        .preview-sheet-close {
            position: absolute; top: 16px; right: 20px;
            background: none; border: none; font-size: 20px;
            cursor: pointer; color: #999;
        }

        @media (max-width: 860px) {
            .studio { grid-template-columns: 1fr; }
            .preview-rail { display: none; }
            .mobile-preview-btn { display: flex; align-items: center; gap: 8px; }
        }
        @media (max-width: 600px) {
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .controls { padding: 28px 20px; }
        }
    </style>
</head>
<body>

{{template "nav-styles" .}}
{{template "nav" .}}

<div class="page">
    <div class="page-header">
        <h1 class="page-title">Business Profile</h1>
        <p class="page-subtitle">Design your invoice identity. Changes appear instantly in the preview.</p>
    </div>
        {{if .Welcome}}
    <div style="
        background: linear-gradient(135deg, rgba(74,222,128,0.08) 0%, rgba(34,197,94,0.04) 100%);
        border: 1px solid rgba(74,222,128,0.2);
        border-radius: 14px;
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    ">
        <div style="
            font-size: 32px;
            line-height: 1;
            flex-shrink: 0;
        ">🎉</div>
        <div>
            <div style="font-size: 18px; font-weight: 800; color: #4ade80; margin-bottom: 6px;">
                Welcome to PsiloConValley
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6;">
                Your account is ready. Start by filling out your business profile below —
                your name, logo, and contact info will appear on every invoice you send.
                This takes about 30 seconds.
            </div>
            <div style="
                margin-top: 14px;
                display: flex;
                gap: 16px;
                font-size: 12px;
                color: rgba(255,255,255,0.3);
            ">
                <span>✓ Step 1 of 4 complete</span>
                <span>·</span>
                <a href="/dashboard" style="color: rgba(255,255,255,0.4); text-decoration: none;">Skip to Dashboard →</a>
            </div>
        </div>
    </div>
    {{end}}

    {{if .Saved}}
    <div class="success-banner">✓ Profile saved successfully</div>
    {{end}}

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}
      {{if .MagicLogin}}
    <div style="
        background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(99,102,241,0.04) 100%);
        border: 1px solid rgba(129,140,248,0.2);
        border-radius: 14px;
        padding: 24px 28px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    ">
        <div style="font-size: 28px; flex-shrink: 0; line-height: 1;">🔐</div>
        <div>
            <div style="font-size: 15px; font-weight: 800; color: #a5b4fc; margin-bottom: 6px;">
                You're signed in via magic link
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6;">
                Set a password below so you can sign in with email next time.
                This is optional — you can always request another sign-in link.
            </div>
        </div>
    </div>
    {{end}}

    <div class="studio">
        <!-- ═══════════ LEFT: FORM CONTROLS ═══════════ -->
        <div class="controls">
            <form method="POST" action="/profile" enctype="multipart/form-data">
                {{.csrfField}}

                <div class="section">
                    <div class="section-title">Logo</div>
                    <div class="form-group" style="margin-bottom: 0;">
                        {{if .Profile}}
                            {{if .Profile.LogoURL}}
                            <div style="margin-bottom: 12px;">
                                <img
                                    src="{{.Profile.LogoURL}}"
                                    alt="Company Logo"
                                    style="max-width:140px; max-height:60px; object-fit:contain; background:#fff; border:1px solid #eee; border-radius:8px; padding:10px;"
                                >
                            </div>
                            {{end}}
                        {{end}}
                        <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg">
                        <div class="hint">PNG recommended. Max 2MB.</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Company Information</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Company Name *</label>
                            <input type="text" name="name" id="field-name" value="{{if .Profile}}{{.Profile.Name}}{{end}}" required>
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" id="field-email" value="{{if .Profile}}{{.Profile.Email}}{{end}}">
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Address</div>
                    <div class="form-group">
                        <label>Street Address</label>
                        <input type="text" name="address" value="{{if .Profile}}{{.Profile.Address}}{{end}}">
                    </div>
                    <div class="grid-3">
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" value="{{if .Profile}}{{.Profile.City}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>State / Region</label>
                            <input type="text" name="state" value="{{if .Profile}}{{.Profile.State}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>Zip / Postal Code</label>
                            <input type="text" name="zip" value="{{if .Profile}}{{.Profile.Zip}}{{end}}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Country</label>
                        <input type="text" name="country" value="{{if .Profile}}{{.Profile.Country}}{{end}}">
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Financial Settings</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Tax ID / EIN</label>
                            <input type="text" name="tax_id" value="{{if .Profile}}{{.Profile.TaxID}}{{end}}">
                            <div class="hint">Optional. Appears on invoices if provided.</div>
                        </div>
                        <div class="form-group">
                            <label>Default Currency</label>
                            <select name="currency">
                                <option value="USD" {{if .Profile}}{{if eq .Profile.Currency "USD"}}selected{{end}}{{else}}selected{{end}}>USD — US Dollar</option>
                                <option value="CAD" {{if .Profile}}{{if eq .Profile.Currency "CAD"}}selected{{end}}{{end}}>CAD — Canadian Dollar</option>
                                <option value="GBP" {{if .Profile}}{{if eq .Profile.Currency "GBP"}}selected{{end}}{{end}}>GBP — British Pound</option>
                                <option value="EUR" {{if .Profile}}{{if eq .Profile.Currency "EUR"}}selected{{end}}{{end}}>EUR — Euro</option>
                                <option value="MXN" {{if .Profile}}{{if eq .Profile.Currency "MXN"}}selected{{end}}{{end}}>MXN — Mexican Peso</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Payment Processing</div>
                    {{if .StripeConnected}}
                    <div class="success-banner">✅ Stripe account connected successfully!</div>
                    {{end}}
                    {{if .StripeError}}
                    <div class="error-banner">❌ Could not connect Stripe account. Please try again.</div>
                    {{end}}

		   {{if .User.StripeConnectID}}
                    <div style="display: flex; align-items: center; gap: 12px; padding: 14px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px;">
                        <span style="font-size: 20px;">✅</span>
                        <div>
                            <div style="font-weight: 700; font-size: 13px; color: #6ee7b7;">Stripe Connected</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">Clients can pay by card. Account: {{.User.StripeConnectID}}</div>
                        </div>
                    </div>
                    {{else}}
                    <div style="display: flex; align-items: center; gap: 14px; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;">
                        <span style="font-size: 24px;">💳</span>
                        <div style="flex: 1;">
                            <div style="font-weight: 700; font-size: 13px; color: #fff;">Accept Card Payments</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">Connect Stripe so clients can pay invoices directly.</div>
                        </div>
                        <a href="/auth/stripe/connect" style="background: #635bff; color: white; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap;">Connect Stripe</a>
                    </div>
                    {{end}}
                                    </div>

		                <div class="section">
                    <div class="section-title">Language / Idioma</div>
                    <div class="form-group">
                        <label>Interface Language / Idioma de la Interfaz</label>
                        <select name="language">
                            <option value="en" {{if eq .User.Language "en"}}selected{{end}}>English</option>
                            <option value="es" {{if eq .User.Language "es"}}selected{{end}}>Español</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-primary">Save Profile</button>
            </form>
	        <!-- ═══════════ PASSWORD ═══════════ -->
            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.08);">
                <div class="section-title">
                    {{if .HasPassword}}Change Password{{else}}Set a Password{{end}}
                </div>

                {{if eq .PasswordError "current"}}
                <div class="error-banner">Current password is incorrect.</div>
                {{else if eq .PasswordError "short"}}
                <div class="error-banner">New password must be at least 8 characters.</div>
                {{else if eq .PasswordError "mismatch"}}
                <div class="error-banner">Passwords do not match.</div>
                {{else if eq .PasswordError "failed"}}
                <div class="error-banner">Could not update password. Please try again.</div>
                {{end}}

                {{if .PasswordSaved}}
                <div class="success-banner">✓ Password updated successfully.</div>
                {{end}}

                <form method="POST" action="/profile/password" autocomplete="off">
                    {{.csrfField}}

                    {{if .HasPassword}}
                    <div class="form-group">
                        <label>Current Password</label>
                        <input
                            type="password"
                            name="current_password"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required>
                    </div>
                    {{end}}

                    <div class="grid-2">
                        <div class="form-group">
                            <label>New Password</label>
                            <input
                                type="password"
                                name="new_password"
                                id="new-password"
                                autocomplete="new-password"
                                placeholder="Min. 8 characters"
                                minlength="8"
                                required>
                        </div>
                        <div class="form-group">
                            <label>Confirm Password</label>
                            <input
                                type="password"
                                name="confirm_password"
                                id="confirm-password"
                                autocomplete="new-password"
                                placeholder="Repeat new password"
                                minlength="8"
                                required>
                        </div>
                    </div>

                    <div id="pw-match-hint" style="font-size:12px;color:rgba(255,255,255,0.3);margin-bottom:16px;min-height:18px;"></div>

                    <button type="submit" class="btn-primary" id="pw-submit-btn">
                        {{if .HasPassword}}Update Password{{else}}Set Password{{end}}
                    </button>
                </form>

                {{if .IsGoogleUser}}
                <p style="font-size:12px;color:rgba(255,255,255,0.3);margin-top:14px;line-height:1.6;">
                    Your account uses Google sign-in.
                    Setting a password lets you also sign in with email.
                </p>
                {{end}}
            </div>
        </div>

        <!-- ═══════════ RIGHT: PREVIEW RAIL ═══════════ -->
        <div class="preview-rail">
            <div class="preview-label">Invoice Preview</div>
            <div class="preview-card">
                <div class="preview-accent"></div>
                <div class="preview-body">
                    <!-- Logo -->
                    <div class="preview-logo-area">
                        {{if .Profile}}
                            {{if .Profile.LogoURL}}
                            <img id="preview-logo" class="preview-logo-img" src="{{.Profile.LogoURL}}" alt="Logo preview">
                            {{else}}
                            <div id="preview-logo-placeholder" class="preview-logo-placeholder">YOUR LOGO</div>
                            {{end}}
                        {{else}}
                        <div id="preview-logo-placeholder" class="preview-logo-placeholder">YOUR LOGO</div>
                        {{end}}
                    </div>

                    <!-- Header -->
                    <div class="preview-header">
                        <div>
                            <div class="preview-title">INVOICE</div>
                            <div id="preview-company" class="preview-company-name">
                                {{if .Profile}}{{if .Profile.Name}}{{.Profile.Name}}{{else}}Your Company{{end}}{{else}}Your Company{{end}}
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div class="preview-inv-label">Invoice</div>
                            <div class="preview-inv-number">#INV-001</div>
                        </div>
                    </div>

                    <!-- Line items -->
                    <div class="preview-items">
                        <div class="preview-item">
                            <span class="preview-item-name">Web Design</span>
                            <span class="preview-item-amount">$1,200.00</span>
                        </div>
                        <div class="preview-item">
                            <span class="preview-item-name">Brand Strategy</span>
                            <span class="preview-item-amount">$800.00</span>
                        </div>
                        <div class="preview-item">
                            <span class="preview-item-name">Consulting</span>
                            <span class="preview-item-amount">$500.00</span>
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="preview-total">
                        <span>Total</span>
                        <span class="preview-total-amount">$2,500.00</span>
                    </div>
                </div>
            </div>
            <div class="preview-hint">Updates live as you type</div>
        </div>
    </div>
</div>

<!-- ═══════════ MOBILE: FLOATING PREVIEW BUTTON + SHEET ═══════════ -->
<button class="mobile-preview-btn" onclick="openPreviewSheet()">
    👁 Preview Invoice
</button>

<div class="preview-overlay" id="previewOverlay" onclick="closePreviewSheet()"></div>
<div class="preview-sheet" id="previewSheet">
    <div class="preview-sheet-handle"></div>
    <button class="preview-sheet-close" onclick="closePreviewSheet()">✕</button>
    <div class="preview-label" style="margin-bottom: 16px;">Invoice Preview</div>
    <div class="preview-card">
        <div class="preview-accent"></div>
        <div class="preview-body">
            <div class="preview-logo-area">
                {{if .Profile}}
                    {{if .Profile.LogoURL}}
                    <img id="preview-logo-mobile" class="preview-logo-img" src="{{.Profile.LogoURL}}" alt="Logo preview">
                    {{else}}
                    <div id="preview-logo-placeholder-mobile" class="preview-logo-placeholder">YOUR LOGO</div>
                    {{end}}
                {{else}}
                <div id="preview-logo-placeholder-mobile" class="preview-logo-placeholder">YOUR LOGO</div>
                {{end}}
            </div>
            <div class="preview-header">
                <div>
                    <div class="preview-title">INVOICE</div>
                    <div id="preview-company-mobile" class="preview-company-name">
                        {{if .Profile}}{{if .Profile.Name}}{{.Profile.Name}}{{else}}Your Company{{end}}{{else}}Your Company{{end}}
                    </div>
                </div>
                <div style="text-align: right;">
                    <div class="preview-inv-label">Invoice</div>
                    <div class="preview-inv-number">#INV-001</div>
                </div>
            </div>
            <div class="preview-items">
                <div class="preview-item">
                    <span class="preview-item-name">Web Design</span>
                    <span class="preview-item-amount">$1,200.00</span>
                </div>
                <div class="preview-item">
                    <span class="preview-item-name">Brand Strategy</span>
                    <span class="preview-item-amount">$800.00</span>
                </div>
                <div class="preview-item">
                    <span class="preview-item-name">Consulting</span>
                    <span class="preview-item-amount">$500.00</span>
                </div>
            </div>
            <div class="preview-total">
                <span>Total</span>
                <span class="preview-total-amount">$2,500.00</span>
            </div>
        </div>
    </div>
</div>

</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.getElementById('field-name');
    const previewCompany = document.getElementById('preview-company');
    const previewCompanyMobile = document.getElementById('preview-company-mobile');

    if (nameInput) {
        nameInput.addEventListener('input', function() {
            const val = this.value || 'Your Company';
            if (previewCompany) previewCompany.textContent = val;
            if (previewCompanyMobile) previewCompanyMobile.textContent = val;
        });
    }

    const logoInput = document.querySelector('input[name="logo"]');
    if (logoInput) {
        logoInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(ev) {
                const src = ev.target.result;

                // Update desktop preview
                updatePreviewLogo('preview-logo', 'preview-logo-placeholder', src);
                // Update mobile preview
                updatePreviewLogo('preview-logo-mobile', 'preview-logo-placeholder-mobile', src);
            };
            reader.readAsDataURL(file);
        });
    }

    function updatePreviewLogo(imgId, placeholderId, src) {
        let img = document.getElementById(imgId);
        let placeholder = document.getElementById(placeholderId);

        if (img) {
            img.src = src;
        } else if (placeholder) {
            const newImg = document.createElement('img');
            newImg.id = imgId;
            newImg.className = 'preview-logo-img';
            newImg.src = src;
            newImg.alt = 'Logo preview';
            placeholder.replaceWith(newImg);
        }
    }
});

function openPreviewSheet() {
    document.getElementById('previewOverlay').style.display = 'block';
    const sheet = document.getElementById('previewSheet');
    sheet.style.display = 'block';
    requestAnimationFrame(() => sheet.classList.add('open'));
}

function closePreviewSheet() {
    document.getElementById('previewOverlay').style.display = 'none';
    const sheet = document.getElementById('previewSheet');
    sheet.classList.remove('open');
    setTimeout(() => sheet.style.display = 'none', 300);
}
// Password match indicator
(function() {
    const np = document.getElementById('new-password');
    const cp = document.getElementById('confirm-password');
    const hint = document.getElementById('pw-match-hint');
    const btn = document.getElementById('pw-submit-btn');

    if (!np || !cp || !hint) return;

    function check() {
        if (cp.value === '') {
            hint.textContent = '';
            hint.style.color = 'rgba(255,255,255,0.3)';
            if (btn) btn.disabled = false;
            return;
        }
        if (np.value === cp.value) {
            hint.textContent = '✓ Passwords match';
            hint.style.color = '#6ee7b7';
            if (btn) btn.disabled = false;
        } else {
            hint.textContent = '✗ Passwords do not match';
            hint.style.color = '#fca5a5';
            if (btn) btn.disabled = true;
        }
    }

    np.addEventListener('input', check);
    cp.addEventListener('input', check);
})();
</script>

</body>
</html>
