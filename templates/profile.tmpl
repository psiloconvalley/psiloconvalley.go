<!DOCTYPE html>
<html>
<head>
    <title>Business Profile | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "profile-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">
    <div class="page-header">
        <h1 class="page-title">Business Profile</h1>
        <p class="page-subtitle">Design your invoice identity. Changes appear instantly in the preview.</p>
    </div>
        {{if .Welcome}}
    <div style="
        background: linear-gradient(135deg, rgba(74,222,128,0.08) 0%, rgba(34,197,94,0.04) 100%);
        border: 1px solid rgba(74,222,128,0.2);
        border-radius: 14px;
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    ">
        <div style="
            font-size: 32px;
            line-height: 1;
            flex-shrink: 0;
        ">🎉</div>
        <div>
            <div style="font-size: 18px; font-weight: 800; color: #4ade80; margin-bottom: 6px;">
                Welcome to PsiloConValley
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6;">
                Your account is ready. Start by filling out your business profile below —
                your name, logo, and contact info will appear on every invoice you send.
                This takes about 30 seconds.
            </div>
            <div style="
                margin-top: 14px;
                display: flex;
                gap: 16px;
                font-size: 12px;
                color: rgba(255,255,255,0.3);
            ">
                <span>✓ Step 1 of 4 complete</span>
                <span>·</span>
                <a href="/dashboard" style="color: rgba(255,255,255,0.4); text-decoration: none;">Skip to Dashboard →</a>
            </div>
        </div>
    </div>
    {{end}}

    
    {{if .Saved}}
    <div class="success-banner">✓ Profile saved successfully</div>
    {{end}}
     {{if .PasswordSaved}}
    <div class="success-banner">✓ Password updated successfully. You can now sign in with your new password.</div>
    {{end}}

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}
    {{if .MagicLogin}}
    <div style="
        background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(99,102,241,0.04) 100%);
        border: 1px solid rgba(129,140,248,0.2);
        border-radius: 14px;
        padding: 24px 28px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    ">
        <div style="font-size: 28px; flex-shrink: 0; line-height: 1;">🔐</div>
        <div>
            <div style="font-size: 15px; font-weight: 800; color: #a5b4fc; margin-bottom: 6px;">
                You're signed in via magic link
            </div>
            <div style="font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6;">
                Set a password below so you can sign in with email next time.
                This is optional — you can always request another sign-in link.
            </div>
        </div>
    </div>
    {{end}}

    <div class="studio">
        <!-- ═══════════ LEFT: FORM CONTROLS ═══════════ -->
        <div class="controls">
            <form method="POST" action="/profile" enctype="multipart/form-data">
                {{.csrfField}}

                <div class="section">
                    <div class="section-title">Logo</div>
                    <div class="form-group" style="margin-bottom: 0;">
                        {{if .Profile}}
                            {{if .Profile.LogoURL}}
                            <div style="margin-bottom: 12px;">
                                <img
                                    src="{{.Profile.LogoURL}}"
                                    alt="Company Logo"
                                    style="max-width:140px; max-height:60px; object-fit:contain; background:#fff; border:1px solid #eee; border-radius:8px; padding:10px;"
                                >
                            </div>
                            {{end}}
                        {{end}}
                        <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg">
                        <div class="hint">PNG recommended. Max 2MB.</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Company Information</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Company Name *</label>
                            <input type="text" name="name" id="field-name" value="{{if .Profile}}{{.Profile.Name}}{{end}}" required>
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" id="field-email" value="{{if .Profile}}{{.Profile.Email}}{{end}}">
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Address</div>
                    <div class="form-group">
                        <label>Street Address</label>
                        <input type="text" name="address" value="{{if .Profile}}{{.Profile.Address}}{{end}}">
                    </div>
                    <div class="grid-3">
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" value="{{if .Profile}}{{.Profile.City}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>State / Region</label>
                            <input type="text" name="state" value="{{if .Profile}}{{.Profile.State}}{{end}}">
                        </div>
                        <div class="form-group">
                            <label>Zip / Postal Code</label>
                            <input type="text" name="zip" value="{{if .Profile}}{{.Profile.Zip}}{{end}}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Country</label>
                        <input type="text" name="country" value="{{if .Profile}}{{.Profile.Country}}{{end}}">
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Financial Settings</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Tax ID / EIN</label>
                            <input type="text" name="tax_id" value="{{if .Profile}}{{.Profile.TaxID}}{{end}}">
                            <div class="hint">Optional. Appears on invoices if provided.</div>
                        </div>
                        <div class="form-group">
                            <label>Default Currency</label>
                            <select name="currency">
                                <option value="USD" {{if .Profile}}{{if eq .Profile.Currency "USD"}}selected{{end}}{{else}}selected{{end}}>USD — US Dollar</option>
                                <option value="CAD" {{if .Profile}}{{if eq .Profile.Currency "CAD"}}selected{{end}}{{end}}>CAD — Canadian Dollar</option>
                                <option value="GBP" {{if .Profile}}{{if eq .Profile.Currency "GBP"}}selected{{end}}{{end}}>GBP — British Pound</option>
                                <option value="EUR" {{if .Profile}}{{if eq .Profile.Currency "EUR"}}selected{{end}}{{end}}>EUR — Euro</option>
                                <option value="MXN" {{if .Profile}}{{if eq .Profile.Currency "MXN"}}selected{{end}}{{end}}>MXN — Mexican Peso</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Payment Processing</div>
                    {{if .StripeConnected}}
                    <div class="success-banner">✅ Stripe account connected successfully!</div>
                    {{end}}
                    {{if .StripeError}}
                    <div class="error-banner">❌ Could not connect Stripe account. Please try again.</div>
                    {{end}}

		   {{if .User.StripeConnectID}}
                    <div style="display: flex; align-items: center; gap: 12px; padding: 14px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px;">
                        <span style="font-size: 20px;">✅</span>
                        <div>
                            <div style="font-weight: 700; font-size: 13px; color: #6ee7b7;">Stripe Connected</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">Clients can pay by card. Account: {{.User.StripeConnectID}}</div>
                        </div>
                    </div>
                    {{else}}
                    <div style="display: flex; align-items: center; gap: 14px; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;">
                        <span style="font-size: 24px;">💳</span>
                        <div style="flex: 1;">
                            <div style="font-weight: 700; font-size: 13px; color: #fff;">Accept Card Payments</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px;">Connect Stripe so clients can pay invoices directly.</div>
                        </div>
                        <a href="/auth/stripe/connect" style="background: #635bff; color: white; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap;">Connect Stripe</a>
                    </div>
                    {{end}}
                                    </div>

		                <div class="section">
                    <div class="section-title">Language / Idioma</div>
                    <div class="form-group">
                        <label>Interface Language / Idioma de la Interfaz</label>
                        <select name="language">
                            <option value="en" {{if eq .User.Language "en"}}selected{{end}}>English</option>
                            <option value="es" {{if eq .User.Language "es"}}selected{{end}}>Español</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-primary">Save Profile</button>
            </form>
	        <!-- ═══════════ PASSWORD ═══════════ -->
            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.08);">
                <div class="section-title">
                    {{if .HasPassword}}Change Password{{else}}Set a Password{{end}}
                </div>

                {{if eq .PasswordError "current"}}
                <div class="error-banner">Current password is incorrect.</div>
                {{else if eq .PasswordError "short"}}
                <div class="error-banner">New password must be at least 8 characters.</div>
                {{else if eq .PasswordError "mismatch"}}
                <div class="error-banner">Passwords do not match.</div>
                {{else if eq .PasswordError "failed"}}
                <div class="error-banner">Could not update password. Please try again.</div>
                {{end}}

                <form method="POST" action="/profile/password" autocomplete="off">
                    {{.csrfField}}

                    {{if .HasPassword}}
                    <div class="form-group">
                        <label>Current Password</label>
                        <input
                            type="password"
                            name="current_password"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required>
                    </div>
                    {{end}}

                    <div class="grid-2">
                        <div class="form-group">
                            <label>New Password</label>
                            <input
                                type="password"
                                name="new_password"
                                id="new-password"
                                autocomplete="new-password"
                                placeholder="Min. 8 characters"
                                minlength="8"
                                required>
                        </div>
                        <div class="form-group">
                            <label>Confirm Password</label>
                            <input
                                type="password"
                                name="confirm_password"
                                id="confirm-password"
                                autocomplete="new-password"
                                placeholder="Repeat new password"
                                minlength="8"
                                required>
                        </div>
                    </div>

                    <div id="pw-match-hint" style="font-size:12px;color:rgba(255,255,255,0.3);margin-bottom:16px;min-height:18px;"></div>

                    <button type="submit" class="btn-primary" id="pw-submit-btn">
                        {{if .HasPassword}}Update Password{{else}}Set Password{{end}}
                    </button>
                </form>

                {{if .IsGoogleUser}}
                <p style="font-size:12px;color:rgba(255,255,255,0.3);margin-top:14px;line-height:1.6;">
                    Your account uses Google sign-in.
                    Setting a password lets you also sign in with email.
                </p>
                {{end}}
            </div>
{{template "profile-preview" .}}
      </div>
</div>
{{template "profile-scripts" .}}
</body>
</html>
