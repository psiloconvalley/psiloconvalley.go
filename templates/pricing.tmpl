<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pricing | Psiloconvalley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Simple pricing for Psiloconvalley Pro.">


    {{template "nav-styles" .}}

    <style>
        :root {
            --bg: #0a0f1a;
            --card: rgba(255,255,255,0.04);
            --border: rgba(255,255,255,0.08);
            --text: #ffffff;
            --muted: rgba(255,255,255,0.65);
            --accent: #ffffff;
            --success: #22c55e;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            max-width: 960px;
            margin: 0 auto;
            padding: 56px 20px 80px;
        }

        .hero {
            text-align: center;
            margin-bottom: 48px;
        }

        .eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
            margin-bottom: 14px;
        }

        h1 {
            font-size: 42px;
            font-weight: 800;
            letter-spacing: -1.5px;
            margin-bottom: 12px;
        }

        .hero p {
            max-width: 620px;
            margin: 0 auto;
            color: var(--muted);
            line-height: 1.7;
            font-size: 16px;
        }

        .notice {
            max-width: 720px;
            margin: 0 auto 24px;
            padding: 14px 16px;
            border-radius: 10px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: var(--text);
            font-size: 14px;
        }

        .notice.success {
            border-color: rgba(34,197,94,0.35);
            background: rgba(34,197,94,0.12);
            color: #dcfce7;
        }

        .pricing-card {
            max-width: 560px;
            margin: 0 auto;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 36px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
            text-align: center;
        }

        .plan-name {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.5);
            font-weight: 700;
            margin-bottom: 16px;
        }

        .price {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        .price .amount {
            font-size: 56px;
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1;
        }

        .price .unit {
            font-size: 16px;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .subtext {
            color: var(--muted);
            margin-bottom: 28px;
            line-height: 1.7;
            font-size: 15px;
        }

        .features {
            list-style: none;
            margin-bottom: 30px;
            text-align: left;
        }

        .features li {
            padding: 12px 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.9);
            font-size: 15px;
        }

        .features li:first-child {
            border-top: none;
        }

        .cta-form,
        .cta-actions {
            margin-top: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 50px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.15s ease, opacity 0.15s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
        }

        .btn-secondary {
            background: transparent;
            color: #ffffff;
            border: 1px solid rgba(255,255,255,0.16);
            margin-top: 12px;
        }

        .plan-state {
            margin-top: 18px;
            font-size: 14px;
            color: #cbd5e1;
        }

        @media (max-width: 640px) {
            .page { padding: 40px 16px 64px; }
            h1 { font-size: 34px; }
            .pricing-card { padding: 24px; }
            .price .amount { font-size: 44px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="page">
	{{if eq .Reason "invoice-limit"}}
<div class="notice">
    You've reached the free plan limit of 10 invoices per month. Upgrade to Pro for unlimited invoices.
</div>
{{end}}
{{if eq .Reason "email-pro"}}
<div class="notice">
    Email delivery is a Pro feature. Upgrade to send invoices directly to your clients.
</div>
{{end}}

{{if eq .Reason "client-limit"}}
<div class="notice">
    You've reached the free plan limit of 5 clients. Upgrade to Pro for unlimited clients.
</div>
{{end}}

    {{if .CheckoutSuccess}}
    <div class="notice success">
        Payment received. If your account does not reflect Pro immediately, refresh in a few seconds.
    </div>
    {{end}}

    {{if .CheckoutCanceled}}
    <div class="notice">
        Checkout was canceled. No charge was made.
    </div>
    {{end}}

    {{if .AlreadyPro}}
    <div class="notice">
        You are already on the Pro plan.
    </div>
    {{end}}

    <div class="hero">
        <div class="eyebrow">Simple Pricing</div>
        <h1>Psiloconvalley Pro</h1>
        <p>
            Unlimited invoices. Unlimited clients. Simple billing.
            Built for freelancers and small businesses who just want to get paid.
        </p>
    </div>

    <div class="pricing-card">
        <div class="plan-name">Pro Plan</div>

        <div class="price">
            <div class="amount">$18.88</div>
            <div class="unit">/ month</div>
        </div>

        <div class="subtext">
	The complete toolkit. Estimates, recurring billing, client payments, and automated PDFs. Run your business, not your software.
        </div>

        <ul class="features">
	    <li>Unlimited invoices & estimates</li>
            <li>Direct client payment portal</li>
            <li>Automated PDF generation</li>
            <li>Professional email delivery</li>
            <li>Recurring monthly billing</li>
            <li>Client approval workflow</li>
            <li>Full business analytics</li>
            <li>Priority founder support</li>
        </ul>

        {{if .User}}
            {{if eq .User.Plan "pro"}}
	     <form method="POST" action="/billing/portal" class="cta-form">
        {{.csrfField}}
        <button type="submit" class="btn btn-secondary">Manage Billing</button>
    </form>
    <div class="plan-state">Your current plan: <strong>Pro</strong></div>
            {{else}}
                <form method="POST" action="/checkout" class="cta-form">
                    {{.csrfField}}
                    <button type="submit" class="btn btn-primary">Upgrade to Pro</button>
                </form>
                <div class="plan-state">Your current plan: <strong>{{.User.Plan}}</strong></div>
            {{end}}
        {{else}}
            <div class="cta-actions">
                <a href="/register" class="btn btn-primary">Create Free Account</a>
                <a href="/login" class="btn btn-secondary">Log In to Upgrade</a>
            </div>
        {{end}}
    </div>
</div>

</body>
</html>
