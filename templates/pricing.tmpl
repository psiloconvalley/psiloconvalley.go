<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pricing | Psiloconvalley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Free invoicing to start. Growth at $8.88/mo. Pro at $18.88/mo. Unlimited invoices, estimates, reports, recurring billing, and payment processing.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com/pricing">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PsiloConValley">
    <meta property="og:url" content="https://psiloconvalley.com/pricing">
    <meta property="og:title" content="Pricing | PsiloConValley">
    <meta property="og:description" content="Free invoicing to start. Growth at $8.88/mo. Pro at $18.88/mo. Unlimited everything.">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Pricing | PsiloConValley">
    <meta name="twitter:description" content="Simple, transparent pricing for professional invoicing. Free to start.">

    {{template "nav-styles" .}}
    {{template "base-styles" .}}

<style>
        .page {
            max-width: 960px;
            margin: 0 auto;
            padding: 56px 20px 80px;
        }

        .hero {
            text-align: center;
            margin-bottom: 48px;
        }

        .hero .eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(74,222,128,0.7);
            margin-bottom: 14px;
        }

        .hero h1 {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 12px;
        }

        .hero p {
            max-width: 620px;
            margin: 0 auto;
            color: rgba(255,255,255,0.55);
            line-height: 1.7;
            font-size: 16px;
        }

        .notice {
            max-width: 720px;
            margin: 0 auto 24px;
            padding: 14px 16px;
            border-radius: 10px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #ffffff;
            font-size: 14px;
        }

        .notice.success {
            border-color: rgba(74,222,128,0.35);
            background: rgba(74,222,128,0.12);
            color: #dcfce7;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 24px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .pricing-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 36px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
            text-align: center;
            display: flex;
            flex-direction: column;
        }

        .pricing-card.growth {
            border-color: rgba(74,222,128,0.3);
            background: rgba(74,222,128,0.04);
            position: relative;
        }

        .pricing-card.pro {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
        }

        .pricing-card .features {
            flex: 1;
        }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: #4ade80;
            color: #0a0f1a;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 4px 16px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .plan-name {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.5);
            font-weight: 700;
            margin-bottom: 16px;
        }

        .growth .plan-name { color: #4ade80; }

        .price {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        .price .amount {
            font-size: 56px;
            font-weight: 800;
            letter-spacing: -2px;
            line-height: 1;
        }

        .price .unit {
            font-size: 16px;
            color: rgba(255,255,255,0.55);
            margin-bottom: 8px;
        }

        .subtext {
            color: rgba(255,255,255,0.55);
            margin-bottom: 28px;
            line-height: 1.7;
            font-size: 14px;
        }

        .features {
            list-style: none;
            margin-bottom: 30px;
            text-align: left;
        }

        .features li {
            padding: 10px 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.9);
            font-size: 14px;
        }

        .features li:first-child { border-top: none; }

        .cta-form, .cta-actions { margin-top: 8px; }

        .page .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 50px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.15s ease, opacity 0.15s ease;
        }

        .page .btn:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        .page .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
        }

        .page .btn-growth {
            background: #4ade80;
            color: #0a0f1a;
        }

        .page .btn-growth:hover {
            background: #22c55e;
        }

        .page .btn-secondary {
            background: transparent;
            color: #ffffff;
            border: 1px solid rgba(255,255,255,0.16);
            margin-top: 12px;
        }

        .plan-state {
            margin-top: 18px;
            font-size: 14px;
            color: #cbd5e1;
        }

        .ent-callout {
            max-width: 720px;
            margin: 48px auto 0;
            padding: 32px;
            background: rgba(74,222,128,0.04);
            border: 1px solid rgba(74,222,128,0.15);
            border-radius: 14px;
            text-align: center;
        }

        .ent-callout h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #ffffff;
        }

        .ent-callout p {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .ent-callout a {
            color: #4ade80;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .ent-callout a:hover {
            text-decoration: underline;
        }

        @media (max-width: 900px) {
            .pricing-grid { grid-template-columns: 1fr; max-width: 480px; }
        }

        @media (max-width: 640px) {
            .page { padding: 40px 16px 64px; }
            .hero h1 { font-size: 34px; }
            .pricing-card { padding: 24px; }
            .price .amount { font-size: 44px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="page">

    {{if eq .Reason "invoice-limit"}}
    <div class="notice">
        You've reached the free plan limit of 10 invoices per month. Upgrade to Pro for unlimited invoices.
    </div>
    {{end}}
    {{if eq .Reason "email-pro"}}
    <div class="notice">
        Email delivery is a Pro feature. Upgrade to send invoices directly to your clients.
    </div>
    {{end}}
    {{if eq .Reason "client-limit"}}
    <div class="notice">
        You've reached the free plan limit of 5 clients. Upgrade to Pro for unlimited clients.
    </div>
    {{end}}
     {{if eq .Reason "expenses"}}
    <div class="notice">
        Expense tracking is available on Growth and above. Upgrade to track spending, upload receipts, and see your real net profit.
    </div>
    {{end}}
    {{if .CheckoutSuccess}}
    <div class="notice success">
        Payment received. Your plan has been upgraded. Welcome to the next level.
    </div>
    {{end}}
    {{if .CheckoutCanceled}}
    <div class="notice">
        Checkout was canceled. No charge was made.
    </div>
    {{end}}
    {{if .AlreadyPro}}
    <div class="notice">
        You are already on the Pro plan.
    </div>
    {{end}}

    <div class="hero">
        <div class="eyebrow">Simple Pricing</div>
        <h1>Start Free. Scale Up.</h1>
        <p>
            Three tiers built for where you are right now.
            No hidden fees. Cancel anytime.
        </p>
    </div>

    <div class="pricing-grid">

        {{/* ── FREE ── */}}
        <div class="pricing-card">
            <div class="plan-name">Free</div>
            <div class="price">
                <div class="amount">$0</div>
                <div class="unit">/ forever</div>
            </div>
            <div class="subtext">
                Get started immediately. No credit card required.
            </div>
            <ul class="features">
                <li>✓ 10 invoices per month</li>
                <li>✓ 5 estimates per month</li>
                <li>✓ 5 saved clients</li>
                <li>✓ Basic PDF export</li>
                <li>✓ Manual payment tracking</li>
                <li>✓ 3 invoice templates</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "free"}}
                <div class="plan-state">✓ Your current plan</div>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-secondary">Create Free Account</a>
                </div>
            {{end}}
        </div>

        {{/* ── GROWTH ── */}}
        <div class="pricing-card growth">
            <div class="popular-badge">Most Popular</div>
            <div class="plan-name">Growth</div>
            <div class="price">
                <div class="amount">$8.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="subtext">
                Business intelligence that tells you what's happening — and what to do about it.
            </div>
            <ul class="features">
                <li>✓ Everything in Free</li>
                <li>✓ Unlimited invoices & estimates</li>
                <li>✓ Unlimited clients</li>
                <li>✓ Client scorecard — reliability scores</li>
                <li>✓ Invoice reports + CSV export</li>
                <li>✓ Remove PsiloConValley branding</li>
                <li>✓ Cash flow insights</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "growth"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else if eq .User.Plan "pro"}}
                    <div class="plan-state">You're on Pro — already included</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="growth">
                        <button type="submit" class="btn btn-growth">Upgrade to Growth →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-growth">Get Started →</a>
                </div>
            {{end}}
        </div>

        {{/* ── PRO ── */}}
        <div class="pricing-card pro">
            <div class="plan-name">Pro</div>
            <div class="price">
                <div class="amount">$18.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="subtext">
                The complete toolkit. Recurring billing, automation, and client payment portals.
            </div>
            <ul class="features">
                <li>✓ Everything in Growth</li>
                <li>✓ Recurring invoice automation</li>
                <li>✓ Auto payment reminders</li>
                <li>✓ Direct client payment portal</li>
                <li>✓ Professional email delivery</li>
                <li>✓ Client approval workflow</li>
                <li>✓ Priority founder support</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "pro"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="pro">
                        <button type="submit" class="btn btn-primary">Upgrade to Pro →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-primary">Create Free Account</a>
                    <a href="/login" class="btn btn-secondary">Log In to Upgrade</a>
                </div>
            {{end}}
        </div>

    </div>
    <div class="ent-callout">
        <h3>Need enterprise controls?</h3>
        <p>Medical offices, law firms, and agencies — audit logs, session timeout, and dedicated support.</p>
        <a href="/enterprise">Explore Enterprise →</a>
    </div>

</div>

{{template "public-footer" .}}

</body>
</html>
