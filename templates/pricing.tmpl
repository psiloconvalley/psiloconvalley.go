<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    <title>Pricing | PSILOCONVALLEY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Free invoicing to start. Pro at $18.88/mo. Pro Max at $28.88/mo unlimited.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com/pricing">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PSILOCONVALLEY">
    <meta property="og:url" content="https://psiloconvalley.com/pricing">
    <meta property="og:title" content="Pricing | PSILOCONVALLEY">
    <meta property="og:description" content="Free invoicing to start. Pro at $18.88/mo. Pro Max at $28.88/mo unlimited.">
    <meta property="og:image" content="https://psiloconvalley.com/og/default.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://psiloconvalley.com/og/default.jpg">
    <meta name="twitter:title" content="Pricing | PSILOCONVALLEY">
    <meta name="twitter:description" content="Simple, transparent pricing for professional invoicing. Free to start.">

    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    {{template "pricing-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">

    {{if eq .Reason "send-limit"}}
    <div class="notice">{{.T.PricingNoticeSendLimit}}</div>
    {{end}}
    {{if eq .Reason "estimate-limit"}}
    <div class="notice">{{.T.PricingNoticeEstimateLimit}}</div>
    {{end}}
    {{if eq .Reason "report-limit"}}
    <div class="notice">{{.T.PricingNoticeReportLimit}}</div>
    {{end}}
    {{if eq .Reason "payments"}}
    <div class="notice">{{.T.PricingNoticePayments}}</div>
    {{end}}
    {{if eq .Reason "invoice-limit"}}
    <div class="notice">{{.T.PricingNoticeInvoiceLimit}}</div>
    {{end}}
    {{if eq .Reason "client-limit"}}
    <div class="notice">{{.T.PricingNoticeClientLimit}}</div>
    {{end}}
    {{if eq .Reason "email-pro"}}
    <div class="notice">{{.T.PricingNoticeEmailPro}}</div>
    {{end}}
    {{if eq .Reason "expenses"}}
    <div class="notice">{{.T.PricingNoticeExpenses}}</div>
    {{end}}
    {{if .CheckoutSuccess}}
    <div class="notice success">{{.T.PricingNoticeSuccess}}</div>
    {{end}}
    {{if .CheckoutCanceled}}
    <div class="notice">{{.T.PricingNoticeCanceled}}</div>
    {{end}}
    {{if .AlreadyPro}}
    <div class="notice">{{.T.PricingNoticeAlreadyPro}}</div>
    {{end}}

    <div class="hero">
        <div class="eyebrow">{{.T.PricingEyebrow}}</div>
        <h1>{{.T.PricingHeroTitle}}</h1>
        <p>{{.T.PricingHeroSub}}</p>
    </div>

    <div class="pricing-grid">

        {{/* ── FREE ── */}}
        <div class="pricing-card">
            <div class="plan-name">{{.T.PricingFreeTitle}}</div>
            <div class="price">
                <div class="amount">$0</div>
                <div class="unit">{{.T.PricingFreeUnit}}</div>
            </div>
            <div class="subtext">{{.T.PricingFreeSub}}</div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>{{.T.PricingFreeInvoices}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingFreeEstimates}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingFreeClients}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingFreeEmails}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingFreePDF}}</span></li>
                <li><span class="feat-yes">✓</span><span>Public business page + QR</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingFreeNoStripe}}</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingFreeNoExpenses}}</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingFreeNoReports}}</span></li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "free"}}
                <div class="plan-state">{{.T.PricingFreeCurrentPlan}}</div>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-secondary">{{.T.PricingFreeCtaRegister}}</a>
                </div>
            {{end}}
        </div>

        {{/* ── PRO ── */}}
        <div class="pricing-card popular">
            <div class="popular-badge">Most Popular</div>
            <div class="plan-name">{{.T.PricingProTitle}}</div>
            <div class="price">
                <div class="amount">$18.88</div>
                <div class="unit">{{.T.PricingProUnit}}</div>
            </div>
            <div class="subtext">{{.T.PricingProSub}}</div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProInvoices}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProEstimates}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProClients}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProEmails}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProStripe}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProExpenses}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProReports}}</span></li>
                <li><span class="feat-yes">✓</span><span>Public business page + QR</span></li>
                <li><span class="feat-yes">✓</span><span>Smart address autocomplete</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingProRecurring}}</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingProReminders}}</span></li>
                <li><span class="feat-no">✗</span><span>{{.T.PricingProTemplates}}</span></li>
            </ul>
            {{if .User}}
                {{if or (eq .User.Plan "pro") (eq .User.Plan "growth")}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">{{.T.PricingProManageBilling}}</button>
                    </form>
                    <div class="plan-state">{{.T.PricingProCurrentPlan}}</div>
                {{else if eq .User.Plan "promax"}}
                    <div class="plan-state">{{.T.PricingProMaxAlreadyMax}}</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="pro">
                        <button type="submit" class="btn btn-pro">{{.T.PricingProUpgrade}}</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-pro">{{.T.PricingProCtaRegister}}</a>
                </div>
            {{end}}
        </div>

        {{/* ── PRO MAX ── */}}
        <div class="pricing-card promax">
            <div class="popular-badge promax-badge">{{.T.PricingProMaxBadge}}</div>
            <div class="plan-name">{{.T.PricingProMaxTitle}}</div>
            <div class="price">
                <div class="amount">$28.88</div>
                <div class="unit">{{.T.PricingProMaxUnit}}</div>
            </div>
            <div class="subtext">{{.T.PricingProMaxSub}}</div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxInvoices}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxEstimates}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxClients}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxEmails}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxStripe}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxExpenses}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxReports}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxRecurring}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxReminders}}</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxTemplates}}</span></li>
                <li><span class="feat-yes">✓</span><span>Public business page + QR</span></li>
                <li><span class="feat-yes">✓</span><span>Google-powered address autocomplete</span></li>
                <li><span class="feat-yes">✓</span><span>{{.T.PricingProMaxSupport}}</span></li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "promax"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">{{.T.PricingProMaxManageBilling}}</button>
                    </form>
                    <div class="plan-state">{{.T.PricingProMaxCurrentPlan}}</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="promax">
                        <button type="submit" class="btn btn-primary">{{.T.PricingProMaxUpgrade}}</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-primary">{{.T.PricingProMaxCtaRegister}}</a>
                    <a href="/login" class="btn btn-secondary">{{.T.PricingProCtaLogin}}</a>
                </div>
            {{end}}
        </div>

    </div>

    <div class="ent-callout">
        <h3>{{.T.PricingEntTitle}}</h3>
        <p>{{.T.PricingEntSub}}</p>
        <a href="/enterprise">{{.T.PricingEntCta}}</a>
    </div>

</div>

{{template "public-footer" .}}

</body>
</html>
