<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pricing | Psiloconvalley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Free invoicing to start. Growth at $8.88/mo. Pro at $18.88/mo. Unlimited invoices, estimates, reports, recurring billing, and payment processing.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com/pricing">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PsiloConValley">
    <meta property="og:url" content="https://psiloconvalley.com/pricing">
    <meta property="og:title" content="Pricing | PsiloConValley">
    <meta property="og:description" content="Free invoicing to start. Growth at $8.88/mo. Pro at $18.88/mo. Unlimited everything.">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Pricing | PsiloConValley">
    <meta name="twitter:description" content="Simple, transparent pricing for professional invoicing. Free to start.">

    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    {{template "pricing-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="page">

    {{if eq .Reason "invoice-limit"}}
    <div class="notice">
        You've reached the free plan limit of 10 invoices per month. Upgrade to Pro for unlimited invoices.
    </div>
    {{end}}
    {{if eq .Reason "email-pro"}}
    <div class="notice">
        Email delivery is a Pro feature. Upgrade to send invoices directly to your clients.
    </div>
    {{end}}
    {{if eq .Reason "client-limit"}}
    <div class="notice">
        You've reached the free plan limit of 5 clients. Upgrade to Pro for unlimited clients.
    </div>
    {{end}}
     {{if eq .Reason "expenses"}}
    <div class="notice">
        Expense tracking is available on Growth and above. Upgrade to track spending, upload receipts, and see your real net profit.
    </div>
    {{end}}
    {{if .CheckoutSuccess}}
    <div class="notice success">
        Payment received. Your plan has been upgraded. Welcome to the next level.
    </div>
    {{end}}
    {{if .CheckoutCanceled}}
    <div class="notice">
        Checkout was canceled. No charge was made.
    </div>
    {{end}}
    {{if .AlreadyPro}}
    <div class="notice">
        You are already on the Pro plan.
    </div>
    {{end}}

    <div class="hero">
        <div class="eyebrow">Simple Pricing</div>
        <h1>Start Free. Scale Up.</h1>
        <p>
            Three tiers built for where you are right now.
            No hidden fees. Cancel anytime.
        </p>
    </div>

    <div class="pricing-grid">

        {{/* ── FREE ── */}}
        <div class="pricing-card">
            <div class="plan-name">Free</div>
            <div class="price">
                <div class="amount">$0</div>
                <div class="unit">/ forever</div>
            </div>
            <div class="subtext">
                Get started immediately. No credit card required.
            </div>
            <ul class="features">
                <li>✓ 10 invoices per month</li>
                <li>✓ 5 estimates per month</li>
                <li>✓ 5 saved clients</li>
                <li>✓ Basic PDF export</li>
                <li>✓ Manual payment tracking</li>
                <li>✓ 3 invoice templates</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "free"}}
                <div class="plan-state">✓ Your current plan</div>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-secondary">Create Free Account</a>
                </div>
            {{end}}
        </div>

        {{/* ── GROWTH ── */}}
        <div class="pricing-card growth">
            <div class="popular-badge">Most Popular</div>
            <div class="plan-name">Growth</div>
            <div class="price">
                <div class="amount">$8.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="subtext">
                Business intelligence that tells you what's happening — and what to do about it.
            </div>
            <ul class="features">
                <li>✓ Everything in Free</li>
                <li>✓ Unlimited invoices & estimates</li>
                <li>✓ Unlimited clients</li>
                <li>✓ Client scorecard — reliability scores</li>
                <li>✓ Invoice reports + CSV export</li>
                <li>✓ Remove PsiloConValley branding</li>
                <li>✓ Cash flow insights</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "growth"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else if eq .User.Plan "pro"}}
                    <div class="plan-state">You're on Pro — already included</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="growth">
                        <button type="submit" class="btn btn-growth">Upgrade to Growth →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-growth">Get Started →</a>
                </div>
            {{end}}
        </div>

        {{/* ── PRO ── */}}
        <div class="pricing-card pro">
            <div class="plan-name">Pro</div>
            <div class="price">
                <div class="amount">$18.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="subtext">
                The complete toolkit. Recurring billing, automation, and client payment portals.
            </div>
            <ul class="features">
                <li>✓ Everything in Growth</li>
                <li>✓ Recurring invoice automation</li>
                <li>✓ Auto payment reminders</li>
                <li>✓ Direct client payment portal</li>
                <li>✓ Professional email delivery</li>
                <li>✓ Client approval workflow</li>
                <li>✓ Priority founder support</li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "pro"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="pro">
                        <button type="submit" class="btn btn-primary">Upgrade to Pro →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-primary">Create Free Account</a>
                    <a href="/login" class="btn btn-secondary">Log In to Upgrade</a>
                </div>
            {{end}}
        </div>

    </div>
    <div class="ent-callout">
        <h3>Need enterprise controls?</h3>
        <p>Medical offices, law firms, and agencies — audit logs, session timeout, and dedicated support.</p>
        <a href="/enterprise">Explore Enterprise →</a>
    </div>

</div>

{{template "public-footer" .}}

</body>
</html>
