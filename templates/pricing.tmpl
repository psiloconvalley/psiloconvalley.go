<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pricing | Psiloconvalley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Free invoicing to start. Growth at $8.88/mo. Pro at $18.88/mo. Scale when you are ready.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com/pricing">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PsiloConValley">
    <meta property="og:url" content="https://psiloconvalley.com/pricing">
    <meta property="og:title" content="Pricing | PsiloConValley">
    <meta property="og:description" content="Free invoicing to start. Growth at $8.88/mo founding rate. Pro at $18.88/mo unlimited.">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Pricing | PsiloConValley">
    <meta name="twitter:description" content="Simple, transparent pricing for professional invoicing. Free to start.">

    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    {{template "pricing-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="page">

       {{if eq .Reason "send-limit"}}
    <div class="notice">
        You've reached the free plan limit of 3 email sends per month. Upgrade to Growth to keep sending professional invoices.
    </div>
    {{end}}
    {{if eq .Reason "estimate-limit"}}
    <div class="notice">
        You've reached the free plan limit of 3 estimates per month. Upgrade to Growth to win more jobs.
    </div>
    {{end}}
    {{if eq .Reason "report-limit"}}
    <div class="notice">
        Detailed reporting is a Growth feature. Upgrade to see your business analytics.
    </div>
    {{end}}
    {{if eq .Reason "payments"}}
    <div class="notice">
        Accepting card payments via Stripe is available on Growth and above. Upgrade to get paid faster.
    </div>
    {{end}}
    {{if eq .Reason "invoice-limit"}}
    <div class="notice">
        You've reached your plan's invoice limit this month. Upgrade to create more invoices.
    </div>
    {{end}}
    {{if eq .Reason "client-limit"}}
    <div class="notice">
        You've reached your plan's client limit. Upgrade to add more clients.
    </div>
    {{end}}
    {{if eq .Reason "email-pro"}}
    <div class="notice">
        You've reached your email send limit this month. Upgrade to send more invoices.
    </div>
    {{end}}
    {{if eq .Reason "expenses"}}
    <div class="notice">
        Expense tracking is available on Growth and above. Upgrade to track spending and see your real profit.
    </div>
    {{end}}
      {{if .CheckoutSuccess}}
    <div class="notice success">
        Payment received. Your plan has been upgraded. Welcome to the next level.
    </div>
    {{end}}
    {{if .CheckoutCanceled}}
    <div class="notice">
        Checkout was canceled. No charge was made.
    </div>
    {{end}}
    {{if .AlreadyPro}}
    <div class="notice">
        You are already on the Pro plan.
    </div>
    {{end}}

    <div class="hero">
        <div class="eyebrow">Simple Pricing</div>
        <h1>Start Free. Scale Up.</h1>
        <p>
            Three tiers built for where you are right now.
            No hidden fees. Cancel anytime.
        </p>
    </div>

        <div class="pricing-grid">

        {{/* ── FREE ── */}}
        <div class="pricing-card">
            <div class="plan-name">Free</div>
            <div class="price">
                <div class="amount">$0</div>
                <div class="unit">/ forever</div>
            </div>
            <div class="subtext">
                Try the full experience. No credit card required.
            </div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>5 invoices per month</span></li>
                <li><span class="feat-yes">✓</span><span>3 estimates per month</span></li>
                <li><span class="feat-yes">✓</span><span>5 saved clients</span></li>
                <li><span class="feat-yes">✓</span><span>3 email sends per month</span></li>
                <li><span class="feat-yes">✓</span><span>PDF download</span></li>
                <li><span class="feat-no">✗</span><span>Stripe card payments</span></li>
                <li><span class="feat-no">✗</span><span>Expense tracking</span></li>
                <li><span class="feat-no">✗</span><span>Reports</span></li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "free"}}
                <div class="plan-state">✓ Your current plan</div>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-secondary">Create Free Account</a>
                </div>
            {{end}}
        </div>

        {{/* ── GROWTH ── */}}
        <div class="pricing-card growth">
            <div class="popular-badge">Most Popular</div>
            <div class="plan-name">Growth</div>
            <div class="price">
                <div class="amount">$8.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="founding-tag">Founding Rate — Lock It In</div>
            <div class="subtext">
                Everything you need to get paid.
            </div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>15 invoices per month</span></li>
                <li><span class="feat-yes">✓</span><span>15 estimates per month</span></li>
                <li><span class="feat-yes">✓</span><span>15 saved clients</span></li>
                <li><span class="feat-yes">✓</span><span>15 email sends per month</span></li>
                <li><span class="feat-yes">✓</span><span>Accept card payments via Stripe</span></li>
                <li><span class="feat-yes">✓</span><span>Expense tracking</span></li>
                <li><span class="feat-yes">✓</span><span>1 report per month</span></li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "growth"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else if eq .User.Plan "pro"}}
                    <div class="plan-state">You're on Pro — already included</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="growth">
                        <button type="submit" class="btn btn-growth">Upgrade to Growth →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-growth">Get Started →</a>
                </div>
            {{end}}
        </div>

        {{/* ── PRO ── */}}
        <div class="pricing-card pro">
            <div class="plan-name">Pro</div>
            <div class="price">
                <div class="amount">$18.88</div>
                <div class="unit">/ month</div>
            </div>
            <div class="subtext">
                Unlimited scale. Zero friction. Full automation.
            </div>
            <ul class="features">
                <li><span class="feat-yes">✓</span><span>Unlimited invoices</span></li>
                <li><span class="feat-yes">✓</span><span>Unlimited estimates</span></li>
                <li><span class="feat-yes">✓</span><span>Unlimited clients</span></li>
                <li><span class="feat-yes">✓</span><span>Unlimited email sending</span></li>
                <li><span class="feat-yes">✓</span><span>Accept card payments via Stripe</span></li>
                <li><span class="feat-yes">✓</span><span>Expense tracking</span></li>
                <li><span class="feat-yes">✓</span><span>Unlimited reports</span></li>
                <li><span class="feat-yes">✓</span><span>Recurring invoice automation</span></li>
                <li><span class="feat-yes">✓</span><span>Auto payment reminders</span></li>
                <li><span class="feat-yes">✓</span><span>Advanced templates</span></li>
                <li><span class="feat-yes">✓</span><span>Priority founder support</span></li>
            </ul>
            {{if .User}}
                {{if eq .User.Plan "pro"}}
                    <form method="POST" action="/billing/portal" class="cta-form">
                        {{.csrfField}}
                        <button type="submit" class="btn btn-secondary">Manage Billing</button>
                    </form>
                    <div class="plan-state">✓ Your current plan</div>
                {{else}}
                    <form method="POST" action="/checkout" class="cta-form">
                        {{.csrfField}}
                        <input type="hidden" name="plan" value="pro">
                        <button type="submit" class="btn btn-primary">Upgrade to Pro →</button>
                    </form>
                {{end}}
            {{else}}
                <div class="cta-actions">
                    <a href="/register" class="btn btn-primary">Create Free Account</a>
                    <a href="/login" class="btn btn-secondary">Log In to Upgrade</a>
                </div>
            {{end}}
        </div>

    </div>
    <div class="ent-callout">
        <h3>Need enterprise controls?</h3>
        <p>Medical offices, law firms, and agencies — audit logs, session timeout, and dedicated support.</p>
        <a href="/enterprise">Explore Enterprise →</a>
    </div>

</div>

{{template "public-footer" .}}

</body>
</html>
