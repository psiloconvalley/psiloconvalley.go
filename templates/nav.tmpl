{{define "nav"}}
<nav class="site-nav">
    <div class="nav-inner">
        <a href="/" class="nav-brand">PsiloConValley</a>

        <button
            class="nav-toggle"
            type="button"
            aria-label="Menu"
            aria-controls="nav-links"
            aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="nav-links">
            {{if .User}}
            <a href="/dashboard">{{.T.NavDashboard}}</a>
                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-btn" onclick="toggleNavDropdown()">{{.T.NavBilling}} ▾</button>
                    <div class="nav-dropdown-menu" id="navDropdownMenu">
                        <a href="/invoices">{{.T.NavInvoices}}</a>
                        <a href="/estimates">{{.T.NavEstimates}}</a>
		        <a href="/recurring">{{.T.NavRecurring}}</a>
                        <a href="/reports">Reports</a>
                    </div>
                </div>
                <a href="/clients">{{.T.NavClients}}</a>
                <a href="/pricing">{{.T.NavPricing}}</a>
                <a href="/profile">{{.T.NavProfile}}</a>

                <form method="POST" action="/logout">
                    {{.csrfField}}
                    <button type="submit" class="nav-logout">{{.T.NavLogout}}</button>
                </form>
            {{else}}
                <a href="/tools">Tools</a>
                <a href="/research">Research</a>
                <a href="/pricing">Pricing</a>
                <a href="/invoices/new">New Invoice</a>
                <a href="/login">Login</a>
                <a href="/register" class="nav-cta">Sign Up</a>
            {{end}}
        </div>
    </div>
</nav>

<script src="/static/js/nav.js" defer></script>
<script>
function toggleNavDropdown() {
    document.getElementById('navDropdownMenu').classList.toggle('open');
}
document.addEventListener('click', function(e) {
    var dd = document.querySelector('.nav-dropdown');
    if (dd && !dd.contains(e.target)) {
        document.getElementById('navDropdownMenu').classList.remove('open');
    }
});
</script>
{{end}}

{{define "nav-styles"}}
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<link rel="stylesheet" href="/static/css/nav.css">
{{end}}
