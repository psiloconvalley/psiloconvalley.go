{{define "nav"}}
<nav class="site-nav">
    <div class="nav-inner">
        <a href="/" class="nav-brand">PsiloConValley</a>

        <button
            class="nav-toggle"
            type="button"
            aria-label="Menu"
            aria-controls="nav-links"
            aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="nav-links">
            {{if .User}}
		
		<a href="/dashboard">Dashboard</a>
                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-btn" onclick="toggleNavDropdown()">Billing ▾</button>
                    <div class="nav-dropdown-menu" id="navDropdownMenu">
                        <a href="/invoices">Invoices</a>
                        <a href="/estimates">Estimates</a>
                        <a href="/recurring">Recurring</a>
                    </div>
                </div>
                <a href="/clients">Clients</a>
                <a href="/pricing">Pricing</a>
                <a href="/profile">Profile</a>

                <form method="POST" action="/logout">
                    {{.csrfField}}
                    <button type="submit" class="nav-logout">Logout</button>
                </form>
            {{else}}
                <a href="/tools">Tools</a>
                <a href="/research">Research</a>
                <a href="/pricing">Pricing</a>
                <a href="/invoices/new">New Invoice</a>
                <a href="/login">Login</a>
                <a href="/register" class="nav-cta">Sign Up</a>
            {{end}}
        </div>
    </div>
</nav>

<script src="/static/js/nav.js" defer></script>
<script>
function toggleNavDropdown() {
    document.getElementById('navDropdownMenu').classList.toggle('open');
}
document.addEventListener('click', function(e) {
    var dd = document.querySelector('.nav-dropdown');
    if (dd && !dd.contains(e.target)) {
        document.getElementById('navDropdownMenu').classList.remove('open');
    }
});
</script>
{{end}}

{{define "nav-styles"}}
<link rel="stylesheet" href="/static/css/nav.css">
{{end}}
