<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{.T.ReportsTitle}} | PSILOCONVALLEY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "reports-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="container">

    <!-- Header -->
    <div class="top">
        <div>
            <h1>{{.T.ReportsTitle}}</h1>
            <div class="top-sub">{{.T.ReportsSubtitle}}</div>
        </div>
        <div class="top-actions">
            <a href="/reports/clients" class="btn-secondary">{{.T.ReportsScorecards}}</a>
        </div>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
        <div class="filter-group">
            <div class="filter-label">{{.T.ReportsDateRange}}</div>
            <div class="preset-buttons">
                <a href="/reports?preset=this_month&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "this_month"}}active{{end}}">{{.T.ReportsThisMonth}}</a>
                <a href="/reports?preset=last_month&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "last_month"}}active{{end}}">{{.T.ReportsLastMonth}}</a>
                <a href="/reports?preset=q1&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "q1"}}active{{end}}">Q1</a>
                <a href="/reports?preset=q2&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "q2"}}active{{end}}">Q2</a>
                <a href="/reports?preset=q3&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "q3"}}active{{end}}">Q3</a>
                <a href="/reports?preset=q4&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "q4"}}active{{end}}">Q4</a>
                <a href="/reports?preset=ytd&status={{.Status}}"
                   class="preset-btn {{if eq .Preset "ytd"}}active{{end}}">YTD</a>
            </div>
        </div>

        <div class="filter-group">
            <div class="filter-label">{{.T.ReportsStatus}}</div>
            <select onchange="applyStatusFilter(this.value)">
                <option value="all"     {{if eq .Status "all"}}selected{{end}}>{{.T.ReportsStatusAll}}</option>
                <option value="paid"    {{if eq .Status "paid"}}selected{{end}}>{{.T.ReportsStatusPaid}}</option>
                <option value="sent"    {{if eq .Status "sent"}}selected{{end}}>{{.T.ReportsStatusSent}}</option>
                <option value="overdue" {{if eq .Status "overdue"}}selected{{end}}>{{.T.ReportsStatusOverdue}}</option>
                <option value="draft"   {{if eq .Status "draft"}}selected{{end}}>{{.T.ReportsStatusDraft}}</option>
            </select>
        </div>

        <a href="/reports/export.csv?preset={{.Preset}}&status={{.Status}}&start={{.StartDate}}&end={{.EndDate}}"
           class="btn-export">
            {{.T.ReportsExport}}
        </a>
    </div>

    <!-- Summary cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">{{.T.ReportsCollected}}</div>
            <div class="stat-value green">{{.Collected}}</div>
            <div class="stat-sub">{{.T.ReportsCollectedSub}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ReportsOutstanding}}</div>
            <div class="stat-value yellow">{{.Outstanding}}</div>
            <div class="stat-sub">{{.T.ReportsOutstandingSub}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ReportsOverdue}}</div>
            <div class="stat-value red">{{.Overdue}}</div>
            <div class="stat-sub">{{.T.ReportsOverdueSub}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ReportsInvoices}}</div>
            <div class="stat-value">{{.InvoiceCount}}</div>
            <div class="stat-sub">{{.T.ReportsInvoicesSub}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ReportsAvgPayment}}</div>
            <div class="stat-value blue">{{if .AvgDays}}{{.AvgDays}}d{{else}}—{{end}}</div>
            <div class="stat-sub">{{.T.ReportsAvgPaymentSub}}</div>
        </div>
    </div>

    <!-- Invoice table -->
    <div class="section-title">{{.T.ReportsDetailTitle}}</div>
    <div class="table-wrap">
        {{if .Rows}}
        <table>
            <thead>
                <tr>
                    <th>{{.T.ReportsThInvoice}}</th>
                    <th>{{.T.ReportsThClient}}</th>
                    <th>{{.T.ReportsThIssued}}</th>
                    <th>{{.T.ReportsThDue}}</th>
                    <th>{{.T.ReportsThStatus}}</th>
                    <th>{{.T.ReportsThDaysToPay}}</th>
                    <th class="right">{{.T.ReportsThSubtotal}}</th>
                    <th class="right">{{.T.ReportsThTax}}</th>
                    <th class="right">{{.T.ReportsThTotal}}</th>
                </tr>
            </thead>
            <tbody>
                {{range .Rows}}
                <tr>
                    <td class="mono">{{if .InvoiceNumber}}{{.InvoiceNumber}}{{else}}—{{end}}</td>
                    <td>{{if .ClientName}}{{.ClientName}}{{else}}<span class="muted">—</span>{{end}}</td>
                    <td class="muted">{{.IssueDate.Format "Jan 2, 2006"}}</td>
                    <td class="muted">{{if .DueDate}}{{.DueDate.Format "Jan 2, 2006"}}{{else}}—{{end}}</td>
                    <td><span class="badge badge-{{.Status}}">{{.Status}}</span></td>
                    <td class="muted mono">{{if .DaysToPayment}}{{.DaysToPayment}}d{{else}}—{{end}}</td>
                    <td class="right mono">{{money .SubtotalCents}}</td>
                    <td class="right mono">{{money .TaxCents}}</td>
                    <td class="right mono"><strong>{{money .TotalCents}}</strong></td>
                </tr>
                {{end}}
            </tbody>
        </table>
        {{else}}
        <div class="empty">
            <div class="empty-icon">📊</div>
            <div class="empty-title">{{.T.ReportsEmptyTitle}}</div>
            <div class="empty-sub">{{.T.ReportsEmptySub}}</div>
        </div>
        {{end}}
    </div>

</div>

<script>
function applyStatusFilter(status) {
    const url = new URL(window.location.href);
    url.searchParams.set('status', status);
    window.location.href = url.toString();
}
</script>

</body>
</html>
