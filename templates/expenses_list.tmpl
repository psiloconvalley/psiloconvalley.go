<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "app-components" .}}
</head>
<body>

{{template "nav" .}}

<div class="container">
    <div class="top" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <div>
            <h1>{{.T.ExpensesListTitle}}</h1>
            <p class="top-subtitle" style="margin-top: 4px;">{{.T.ExpensesListSubtitle}}</p>
        </div>
        <a href="/expenses/new" class="btn-success">{{.T.ExpensesListNew}}</a>
    </div>
    
    {{if .Saved}}
    <div class="success-banner">{{.T.ExpensesListSaved}}</div>
    {{end}}

    {{if .Deleted}}
    <div class="success-banner">{{.T.ExpensesListDeleted}}</div>
    {{end}}

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">{{.T.ExpensesListThisMonth}}</div>
            <div class="stat-value">{{.MonthTotal}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ExpensesListThisYear}}</div>
            <div class="stat-value">{{.YearTotal}}</div>
        </div>
    </div>

    {{if .Expenses}}
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>{{.T.ExpensesListThDate}}</th>
                    <th>{{.T.ExpensesListThVendor}}</th>
                    <th>{{.T.ExpensesListThCategory}}</th>
                    <th>{{.T.ExpensesListThDesc}}</th>
                    <th class="right">{{.T.ExpensesListThAmount}}</th>
                    <th>{{.T.ExpensesListThReceipt}}</th>
                    <th></th>
                </tr>
            </thead>
               <tbody>
                {{range .Expenses}}
                <tr>
                    <td class="expense-date">{{.ExpenseDate.Format "Jan 02, 2006"}}</td>
                    <td class="expense-vendor">{{if .Vendor}}{{.Vendor}}{{else}}—{{end}}</td>
                    <td><span class="expense-category">{{.Category}}</span></td>
                    <td>{{if .Description}}{{.Description}}{{else}}—{{end}}</td>
                    <td class="expense-amount" style="text-align:right">{{money .AmountCents}}</td>
                    <td class="expense-receipt">
                        {{if .ReceiptURL}}<a href="{{.ReceiptURL}}" target="_blank">{{$.T.ExpensesListView}}</a>{{else}}—{{end}}
                    </td>
                    <td class="expense-actions">
                        <a href="/expenses/{{.ID}}/edit" style="color: var(--accent); text-decoration: none; font-weight: 600;">{{$.T.ExpensesListEdit}}</a>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <!-- Mobile cards -->
    <div class="mobile-cards">
        {{range .Expenses}}
        <div class="mobile-card" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 16px; margin-bottom: 12px;">
            <div class="mobile-card-top" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span class="mobile-card-vendor" style="font-weight: 700; color: #fff;">{{if .Vendor}}{{.Vendor}}{{else}}{{$.T.ExpensesListExpense}}{{end}}</span>
                <span class="mobile-card-amount" style="font-weight: 700; color: #4ade80;">{{money .AmountCents}}</span>
            </div>
            <div class="mobile-card-meta" style="display: flex; gap: 8px; font-size: 12px; color: rgba(255,255,255,0.4); align-items: center;">
                <span>{{.ExpenseDate.Format "Jan 02, 2006"}}</span>
                <span>·</span>
                <span class="expense-category">{{.Category}}</span>
                {{if .ReceiptURL}}
                <span>·</span>
                <a href="{{.ReceiptURL}}" target="_blank" style="color: rgba(255,255,255,0.6); text-decoration: none;">{{$.T.ExpensesListReceipt}}</a>
                {{end}}
            </div>
            {{if .Description}}
            <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-top:8px;">{{.Description}}</div>
            {{end}}
            <div class="mobile-card-actions" style="margin-top: 12px; text-align: right;">
                <a href="/expenses/{{.ID}}/edit" style="color: var(--accent); text-decoration: none; font-weight: 600; font-size: 13px;">{{$.T.ExpensesListEdit}}</a>
            </div>
        </div>
        {{end}}
    </div>

    {{else}}
    <div class="empty-state">
        <div class="empty-state-icon">💸</div>
        <div class="empty-state-title">{{.T.ExpensesListEmptyTitle}}</div>
        <div class="empty-state-sub">{{.T.ExpensesListEmptySub}}</div>
        <a href="/expenses/new" class="btn-success">{{.T.ExpensesListEmptyBtn}}</a>
    </div>
    {{end}}
</div>

</body>
</html>
