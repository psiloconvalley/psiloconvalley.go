<!DOCTYPE html>
<html lang="en">
<head>
    <title>Expenses | PSILOCONVALLEY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "expenses-list-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="container">
    <div class="top">
        <div>
            <h1>{{.T.ExpensesListTitle}}</h1>
            <p class="top-subtitle">{{.T.ExpensesListSubtitle}}</p>
        </div>
        <a href="/expenses/new" class="btn-new">{{.T.ExpensesListNew}}</a>
    </div>

    {{if .Saved}}
    <div class="success-banner">{{.T.ExpensesListSaved}}</div>
    {{end}}

    {{if .Deleted}}
    <div class="success-banner">{{.T.ExpensesListDeleted}}</div>
    {{end}}

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">{{.T.ExpensesListThisMonth}}</div>
            <div class="stat-value">{{.MonthTotal}}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">{{.T.ExpensesListThisYear}}</div>
            <div class="stat-value">{{.YearTotal}}</div>
        </div>
    </div>

    {{if .Expenses}}
    <table class="expense-table">
        <thead>
            <tr>
                <th>{{.T.ExpensesListThDate}}</th>
                <th>{{.T.ExpensesListThVendor}}</th>
                <th>{{.T.ExpensesListThCategory}}</th>
                <th>{{.T.ExpensesListThDesc}}</th>
                <th style="text-align:right">{{.T.ExpensesListThAmount}}</th>
                <th>{{.T.ExpensesListThReceipt}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{range .Expenses}}
            <tr>
                <td class="expense-date">{{.ExpenseDate.Format "Jan 02, 2006"}}</td>
                <td class="expense-vendor">{{if .Vendor}}{{.Vendor}}{{else}}—{{end}}</td>
                <td><span class="expense-category">{{.Category}}</span></td>
                <td>{{if .Description}}{{.Description}}{{else}}—{{end}}</td>
                <td class="expense-amount" style="text-align:right">{{money .AmountCents}}</td>
                <td class="expense-receipt">
                    {{if .ReceiptURL}}<a href="{{.ReceiptURL}}" target="_blank">{{$.T.ExpensesListView}}</a>{{else}}—{{end}}
                </td>
                <td class="expense-actions">
                    <a href="/expenses/{{.ID}}/edit">{{$.T.ExpensesListEdit}}</a>
                </td>
            </tr>
            {{end}}
        </tbody>
    </table>

    <!-- Mobile cards -->
    <div class="mobile-cards">
        {{range .Expenses}}
        <div class="mobile-card">
            <div class="mobile-card-top">
                <span class="mobile-card-vendor">{{if .Vendor}}{{.Vendor}}{{else}}{{$.T.ExpensesListExpense}}{{end}}</span>
                <span class="mobile-card-amount">{{money .AmountCents}}</span>
            </div>
            <div class="mobile-card-meta">
                <span>{{.ExpenseDate.Format "Jan 02, 2006"}}</span>
                <span class="expense-category">{{.Category}}</span>
                {{if .ReceiptURL}}<a href="{{.ReceiptURL}}" target="_blank" style="color:rgba(255,255,255,0.5);text-decoration:none;">{{$.T.ExpensesListReceipt}}</a>{{end}}
            </div>
            {{if .Description}}
            <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-top:8px;">{{.Description}}</div>
            {{end}}
            <div class="mobile-card-actions">
                <a href="/expenses/{{.ID}}/edit">{{$.T.ExpensesListEdit}}</a>
            </div>
        </div>
        {{end}}
    </div>

    {{else}}
    <div class="empty-state">
        <h3>{{.T.ExpensesListEmptyTitle}}</h3>
        <p>{{.T.ExpensesListEmptySub}}</p>
        <a href="/expenses/new" class="btn-new">{{.T.ExpensesListEmptyBtn}}</a>
    </div>
    {{end}}
</div>

</body>
</html>
