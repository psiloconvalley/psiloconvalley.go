<!DOCTYPE html>
<html lang="en">
<head>
    <title>Client Scorecards | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        /* ── Header ── */
        .top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -1px;
        }
        .top-sub {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            margin-top: 6px;
            font-family: monospace;
        }
        .top-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .btn-secondary {
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            white-space: nowrap;
            min-height: 38px;
            display: inline-flex;
            align-items: center;
        }
        .btn-secondary:hover { background: rgba(255,255,255,0.1); }

        /* ── Explainer ── */
        .explainer {
            margin-left: 27px;
            margin-bottom: 36px;
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            line-height: 1.6;
            max-width: 600px;
        }

        /* ── Score legend ── */
        .legend {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }
        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        /* ── Cards grid ── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .scorecard {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 24px;
            position: relative;
            transition: border-color 0.2s;
        }
        .scorecard:hover { border-color: rgba(255,255,255,0.15); }

        /* Score color border on left */
        .scorecard.score-green  { border-left: 3px solid #4ade80; }
        .scorecard.score-yellow { border-left: 3px solid #fbbf24; }
        .scorecard.score-red    { border-left: 3px solid #f87171; }

        /* ── Card header ── */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .client-name {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.3px;
            line-height: 1.2;
            max-width: 200px;
            word-break: break-word;
        }
        .score-badge {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 52px;
        }
        .score-number {
            font-size: 28px;
            font-weight: 900;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }
        .score-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-top: 2px;
        }
        .score-green  .score-number { color: #4ade80; }
        .score-yellow .score-number { color: #fbbf24; }
        .score-red    .score-number { color: #f87171; }

        /* ── Score bar ── */
        .score-bar-wrap {
            margin-bottom: 20px;
        }
        .score-bar-track {
            height: 4px;
            background: rgba(255,255,255,0.08);
            border-radius: 2px;
            overflow: hidden;
        }
        .score-bar-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.6s ease;
        }
        .score-green  .score-bar-fill { background: #4ade80; }
        .score-yellow .score-bar-fill { background: #fbbf24; }
        .score-red    .score-bar-fill { background: #f87171; }

        /* ── Stats rows ── */
        .stat-rows {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 16px;
        }
        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .stat-row-label {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
        }
        .stat-row-value {
            font-size: 13px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }
        .val-green  { color: #4ade80; }
        .val-yellow { color: #fbbf24; }
        .val-red    { color: #f87171; }
        .val-blue   { color: #93c5fd; }

        /* ── Insight tag ── */
        .insight {
            margin-top: 16px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 12px;
            line-height: 1.5;
            font-weight: 500;
        }
        .insight-green  { background: rgba(74,222,128,0.08); color: #4ade80; }
        .insight-yellow { background: rgba(251,191,36,0.08); color: #fbbf24; }
        .insight-red    { background: rgba(248,113,113,0.08); color: #f87171; }

        /* ── Empty state ── */
        .empty {
            text-align: center;
            padding: 80px 20px;
            color: rgba(255,255,255,0.3);
        }
        .empty-icon  { font-size: 48px; margin-bottom: 16px; }
        .empty-title { font-size: 20px; font-weight: 700; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
        .empty-sub   { font-size: 14px; line-height: 1.6; max-width: 380px; margin: 0 auto; }

        /* ── Mobile ── */
        @media (max-width: 640px) {
            .container { padding: 24px 16px 80px; }
            .top { padding-left: 16px; }
            .top h1 { font-size: 22px; }
            .cards-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="container">

    <div class="top">
        <div>
            <h1>Client Scorecards</h1>
            <div class="top-sub">Payment reliability · Revenue ranking · Business intelligence</div>
        </div>
        <div class="top-actions">
            <a href="/reports" class="btn-secondary">← Reports</a>
        </div>
    </div>

    <div class="explainer">
        Every client ranked by payment reliability. Score is calculated from on-time rate,
        average days to payment, and overdue history. Use this to decide who gets net-30,
        who needs a deposit, and who to chase first.
    </div>

    {{if .Cards}}

    <div class="legend">
        <div class="legend-item">
            <div class="legend-dot" style="background:#4ade80"></div>
            Score 8-10 — Reliable
        </div>
        <div class="legend-item">
            <div class="legend-dot" style="background:#fbbf24"></div>
            Score 5-7 — Watch
        </div>
        <div class="legend-item">
            <div class="legend-dot" style="background:#f87171"></div>
            Score 1-4 — At Risk
        </div>
    </div>

           <div class="cards-grid">
        {{range $i, $card := .Cards}}
        {{$scoreClass := "score-red"}}
        {{if ge $card.Score 8}}{{$scoreClass = "score-green"}}{{else if ge $card.Score 5}}{{$scoreClass = "score-yellow"}}{{end}}

        {{if and (not $.HasPaidPlan) (ge $i 2)}}
        {{/* ── Paywall card — blurred for free users ── */}}
        <div class="scorecard {{$scoreClass}}" style="position:relative;">
            <div style="filter: blur(4px); pointer-events: none; user-select: none;">
                <div class="card-header">
                    <div class="client-name">{{$card.ClientName}}</div>
                    <div class="score-badge">
                        <div class="score-number">{{$card.Score}}</div>
                        <div class="score-label">/ 10</div>
                    </div>
                </div>
                <div class="score-bar-wrap">
                    <div class="score-bar-track">
                        <div class="score-bar-fill" style="width: {{mul $card.Score 10}}%"></div>
                    </div>
                </div>
                <div class="stat-rows">
                    <div class="stat-row">
                        <div class="stat-row-label">Total Billed</div>
                        <div class="stat-row-value">{{money $card.TotalBilled}}</div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-row-label">On-Time Rate</div>
                        <div class="stat-row-value">{{$card.OnTimeRate}}%</div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-row-label">Avg. Days to Pay</div>
                        <div class="stat-row-value">{{$card.AvgDaysToPayment}} days</div>
                    </div>
                </div>
                <div class="insight insight-green">
                    ✓ Insight hidden. Upgrade to unlock.
                </div>
            </div>
            {{/* Upgrade overlay */}}
            <div style="
                position: absolute;
                top: 0; left: 0; right: 0; bottom: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: rgba(10,15,26,0.7);
                border-radius: 14px;
                padding: 24px;
                text-align: center;
                gap: 12px;
            ">
                <div style="font-size: 20px;">🔒</div>
                <div style="font-size: 14px; font-weight: 800; color: #fff;">
                    Unlock All Client Scores
                </div>
                <div style="font-size: 12px; color: rgba(255,255,255,0.5); line-height: 1.5;">
                    See reliability scores, payment patterns,<br>and plain English insights for every client.
                </div>
                <a href="/pricing" style="
                    margin-top: 4px;
                    padding: 10px 20px;
                    background: #4ade80;
                    color: #0a0f1a;
                    border-radius: 6px;
                    font-size: 13px;
                    font-weight: 800;
                    text-decoration: none;
                ">Upgrade to Growth — $8.88/mo →</a>
            </div>
        </div>
        {{else}}
        {{/* ── Full card — always visible ── */}}
        <div class="scorecard {{$scoreClass}}">
            <div class="card-header">
                <div class="client-name">{{$card.ClientName}}</div>
                <div class="score-badge">
                    <div class="score-number">{{$card.Score}}</div>
                    <div class="score-label">/ 10</div>
                </div>
            </div>
            <div class="score-bar-wrap">
                <div class="score-bar-track">
                    <div class="score-bar-fill" style="width: {{mul $card.Score 10}}%"></div>
                </div>
            </div>
            <div class="stat-rows">
                <div class="stat-row">
                    <div class="stat-row-label">Total Billed</div>
                    <div class="stat-row-value">{{money $card.TotalBilled}}</div>
                </div>
                <div class="stat-row">
                    <div class="stat-row-label">Total Collected</div>
                    <div class="stat-row-value val-green">{{money $card.TotalPaid}}</div>
                </div>
                {{if $card.Outstanding}}
                <div class="stat-row">
                    <div class="stat-row-label">Outstanding</div>
                    <div class="stat-row-value val-yellow">{{money $card.Outstanding}}</div>
                </div>
                {{end}}
                {{if $card.Overdue}}
                <div class="stat-row">
                    <div class="stat-row-label">Overdue</div>
                    <div class="stat-row-value val-red">{{money $card.Overdue}}</div>
                </div>
                {{end}}
                <div class="stat-row">
                    <div class="stat-row-label">Invoices Sent</div>
                    <div class="stat-row-value">{{$card.InvoiceCount}}</div>
                </div>
                <div class="stat-row">
                    <div class="stat-row-label">On-Time Rate</div>
                    <div class="stat-row-value {{if ge $card.OnTimeRate 80}}val-green{{else if ge $card.OnTimeRate 50}}val-yellow{{else}}val-red{{end}}">
                        {{$card.OnTimeRate}}%
                    </div>
                </div>
                <div class="stat-row">
                    <div class="stat-row-label">Avg. Days to Pay</div>
                    <div class="stat-row-value {{if le $card.AvgDaysToPayment 7}}val-green{{else if le $card.AvgDaysToPayment 21}}val-yellow{{else}}val-red{{end}}">
                        {{if $card.AvgDaysToPayment}}{{$card.AvgDaysToPayment}} days{{else}}—{{end}}
                    </div>
                </div>
            </div>
            {{if ge $card.Score 8}}
            <div class="insight insight-green">
                ✓ Reliable payer. Safe to extend net-30 terms.
            </div>
            {{else if ge $card.Score 5}}
            <div class="insight insight-yellow">
                ⚠ Pays but slow. Consider requesting a deposit on large jobs.
            </div>
            {{else}}
            <div class="insight insight-red">
                ✗ High risk. Require upfront deposit. Follow up immediately on outstanding invoices.
            </div>
            {{end}}
        </div>
        {{end}}
        {{end}}
    </div>
    {{else}}
       <div class="empty">
        <div class="empty-icon">📊</div>
        <div class="empty-title">No client data yet</div>
        <div class="empty-sub">
            Once you've sent invoices to clients, their payment reliability
            scores will appear here automatically.
        </div>
    </div>
    {{end}}

</div>

</body>
</html>
