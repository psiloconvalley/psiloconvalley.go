<!DOCTYPE html>
<html>
<head>
    <title>
        {{if eq .Mode "edit"}}{{.T.ClientFormEditTitle}}{{else}}{{.T.ClientFormNewTitle}}{{end}} | PSILOCONVALLEY
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    <style>
        .page {
            max-width: 720px;
            margin: 48px auto;
            padding: 0 24px;
        }

        .card {
            background: rgba(15, 15, 15, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 48px;
        }

        .page-title {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin-bottom: 8px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .page-subtitle {
            color: rgba(255, 255, 255, 0.5);
            font-size: 14px;
            margin-bottom: 40px;
        }

        .error-banner {
            background: rgba(220, 38, 38, 0.15);
            border: 1px solid rgba(220, 38, 38, 0.3);
            color: #fca5a5;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 14px;
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .section {
            margin-bottom: 40px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 8px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            color: #fff;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.08);
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: rgba(255, 255, 255, 0.2);
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        .btn-row {
            display: flex;
            gap: 16px;
            margin-top: 8px;
        }

        .btn-primary {
            background: #fff;
            color: #0a0f1a;
            border: none;
            padding: 14px 32px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            flex: 1;
        }

        .btn-primary:hover {
            background: #e5e5e5;
        }

        .btn-secondary {
            background: transparent;
            color: rgba(255,255,255,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            padding: 14px 32px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary:hover {
            border-color: rgba(255,255,255,0.4);
            color: #fff;
        }

        @media (max-width: 600px) {
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .card { padding: 32px 24px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="page">
    <div class="card">
        <h1 class="page-title">
            {{if eq .Mode "edit"}}{{.T.ClientFormEditTitle}}{{else}}{{.T.ClientFormNewTitle}}{{end}}
        </h1>
        <p class="page-subtitle">
            {{if eq .Mode "edit"}}
                {{.T.ClientFormEditSubtitle}}
            {{else}}
                {{.T.ClientFormNewSubtitle}}
            {{end}}
        </p>

        {{if .Error}}
        <div class="error-banner">{{.Error}}</div>
        {{end}}

        <form method="POST"
              action="{{if eq .Mode "edit"}}/clients/{{.Client.ID}}/edit{{else}}/clients/new{{end}}">
            {{.csrfField}}

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionContact}}</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>{{.T.ClientFormClientName}}</label>
                        <input type="text" name="name"
                               value="{{if .Client}}{{.Client.Name}}{{end}}"
                               required autofocus>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormEmail}}</label>
                        <input type="email" name="email"
                               value="{{if .Client}}{{.Client.Email}}{{end}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{.T.ClientFormPhone}}</label>
                    <input type="text" name="phone"
                           value="{{if .Client}}{{.Client.Phone}}{{end}}">
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionAddress}}</div>
                <div class="form-group">
                    <label>{{.T.ClientFormStreetAddress}}</label>
		          <input type="text" name="address"
                           data-address-autocomplete
                           value="{{if .Client}}{{.Client.Address}}{{end}}">
                </div>
                <div class="grid-3">
                    <div class="form-group">
                        <label>{{.T.ClientFormCity}}</label>
                        <input type="text" name="city"
                               data-address-city
                               value="{{if .Client}}{{.Client.City}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormStateRegion}}</label>
                        <input type="text" name="state"
                               data-address-state
                               value="{{if .Client}}{{.Client.State}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormZipPostal}}</label>
                        <input type="text" name="zip"
                               data-address-zip
                               value="{{if .Client}}{{.Client.Zip}}{{end}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{.T.ClientFormCountry}}</label>
                    <input type="text" name="country"
                           data-address-country
                           value="{{if .Client}}{{.Client.Country}}{{end}}">
                     </div>
            </div>

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionNotes}}</div>
                <div class="form-group">
                    <label>{{.T.ClientFormInternalNotes}}</label>
                    <textarea name="notes"
                              placeholder="{{.T.ClientFormNotesPlaceholder}}">{{if .Client}}{{.Client.Notes}}{{end}}</textarea>
                </div>
            </div>

            <div class="btn-row">
                <a href="/clients" class="btn-secondary">{{.T.ClientFormCancel}}</a>
                <button type="submit" class="btn-primary">
                    {{if eq .Mode "edit"}}{{.T.ClientFormSaveChanges}}{{else}}{{.T.ClientFormSaveClient}}{{end}}
                </button>
            </div>
	    <script src="/static/js/address-autocomplete.js"></script>
        </form>
    </div>
</div>

</body>
</html>
