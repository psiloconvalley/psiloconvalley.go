<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head-no-title" .}}
    <title>
        {{if eq .Mode "edit"}}{{.T.ClientFormEditTitle}}{{else}}{{.T.ClientFormNewTitle}}{{end}} | PSILOCONVALLEY
    </title>
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    <style>
        .container {
            max-width: 640px;
            margin: 0 auto;
            padding: 48px 20px 80px;
        }

        .top {
            margin-bottom: 32px;
            border-left: 2px solid #fff;
            padding-left: 25px;
        }
        .top h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin: 0;
        }
        .top-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
            font-family: monospace;
            margin-top: 4px;
        }

        .error-banner {
            background: rgba(220,38,38,0.1);
            border: 1px solid rgba(220,38,38,0.2);
            color: #fca5a5;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .form-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 40px;
        }

        .section-title {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .section { margin-bottom: 32px; }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        .form-group { margin-bottom: 20px; }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.6);
            margin-bottom: 8px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            color: #fff;
            background: rgba(255,255,255,0.05);
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: rgba(255,255,255,0.4);
            background: rgba(255,255,255,0.08);
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: rgba(255,255,255,0.2);
        }

        .form-group textarea {
            min-height: 80px;
            resize: vertical;
        }

        .btn-row {
            display: flex;
            gap: 16px;
            margin-top: 8px;
        }

        .btn-primary {
            background: #fff;
            color: #0a0f1a;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            flex: 1;
            transition: background 0.15s;
        }

        .btn-primary:hover { background: #e5e5e5; }

        .btn-secondary {
            background: transparent;
            color: rgba(255,255,255,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
            transition: border-color 0.15s, color 0.15s;
        }

        .btn-secondary:hover {
            border-color: rgba(255,255,255,0.4);
            color: #fff;
        }

        .btn-delete {
            background: none;
            border: 1px solid rgba(220,38,38,0.3);
            color: #fca5a5;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            width: 100%;
            margin-top: 12px;
            transition: background 0.15s;
        }

        .btn-delete:hover { background: rgba(220,38,38,0.1); }

        @media (max-width: 600px) {
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .form-card { padding: 28px 20px; }
            .btn-row { flex-direction: column-reverse; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="container">
    <div class="top">
        <h1>{{if eq .Mode "edit"}}{{.T.ClientFormEditTitle}}{{else}}{{.T.ClientFormNewTitle}}{{end}}</h1>
        <p class="top-subtitle">
            {{if eq .Mode "edit"}}{{.T.ClientFormEditSubtitle}}{{else}}{{.T.ClientFormNewSubtitle}}{{end}}
        </p>
    </div>

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}

    <div class="form-card">
        <form method="POST"
              action="{{if eq .Mode "edit"}}/clients/{{.Client.ID}}/edit{{else}}/clients/new{{end}}">
            {{.csrfField}}

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionContact}}</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>{{.T.ClientFormClientName}}</label>
                        <input type="text" name="name"
                               value="{{if .Client}}{{.Client.Name}}{{end}}"
                               required autofocus>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormEmail}}</label>
                        <input type="email" name="email"
                               value="{{if .Client}}{{.Client.Email}}{{end}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{.T.ClientFormPhone}}</label>
                    <input type="text" name="phone"
                           value="{{if .Client}}{{.Client.Phone}}{{end}}">
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionAddress}}</div>
                <div class="form-group">
                    <label>{{.T.ClientFormStreetAddress}}</label>
                    <input type="text" name="address"
                           data-address-autocomplete
                           value="{{if .Client}}{{.Client.Address}}{{end}}">
                </div>
                <div class="grid-3">
                    <div class="form-group">
                        <label>{{.T.ClientFormCity}}</label>
                        <input type="text" name="city"
                               data-address-city
                               value="{{if .Client}}{{.Client.City}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormStateRegion}}</label>
                        <input type="text" name="state"
                               data-address-state
                               value="{{if .Client}}{{.Client.State}}{{end}}">
                    </div>
                    <div class="form-group">
                        <label>{{.T.ClientFormZipPostal}}</label>
                        <input type="text" name="zip"
                               data-address-zip
                               value="{{if .Client}}{{.Client.Zip}}{{end}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{.T.ClientFormCountry}}</label>
                    <input type="text" name="country"
                           data-address-country
                           value="{{if .Client}}{{.Client.Country}}{{end}}">
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{.T.ClientFormSectionNotes}}</div>
                <div class="form-group">
                    <label>{{.T.ClientFormInternalNotes}}</label>
                    <textarea name="notes"
                              placeholder="{{.T.ClientFormNotesPlaceholder}}">{{if .Client}}{{.Client.Notes}}{{end}}</textarea>
                </div>
            </div>

            <div class="btn-row">
                <a href="/clients" class="btn-secondary">{{.T.ClientFormCancel}}</a>
                <button type="submit" class="btn-primary">
                    {{if eq .Mode "edit"}}{{.T.ClientFormSaveChanges}}{{else}}{{.T.ClientFormSaveClient}}{{end}}
                </button>
            </div>
            <script src="/static/js/address-autocomplete.js"></script>
        </form>

        {{if eq .Mode "edit"}}
        <form method="POST" action="/clients/{{.Client.ID}}/delete"
              onsubmit="return confirm('{{.T.ClientFormDeleteConfirm}}')">
            {{.csrfField}}
            <button type="submit" class="btn-delete">{{.T.ClientFormDelete}}</button>
        </form>
        {{end}}
    </div>
</div>

</body>
</html>
