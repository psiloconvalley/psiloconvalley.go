<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "endorsements-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="page">
    <div class="page-header">
        <div class="page-title">⭐ {{.T.EndorsementsTitle}}</div>
        <div class="page-sub">{{.T.EndorsementsSub}}</div>
    </div>

    <div class="en-stats">
        <div class="en-stat"><strong>{{.SubmittedCount}}</strong> {{.T.EndorsementsLive}}</div>
        <div class="en-stat"><strong>{{.PendingCount}}</strong> {{.T.EndorsementsPending}}</div>
    </div>

    {{if .Endorsements}}
    {{range .Endorsements}}
    <div class="en-card">
        <div class="en-card-header">
            <div>
                <div class="en-card-name">
                    {{if .EndorserName}}{{.EndorserName}}{{else}}{{$.T.EndorsementsPending}}{{end}}
                    {{if .EndorserLocation}}<span class="en-card-location"> · {{.EndorserLocation}}</span>{{end}}
                </div>
            </div>
            <div>
                {{if eq .Status "pending"}}
                <span class="en-badge en-badge-pending">{{$.T.EndorsementsPending}}</span>
                {{else if eq .Status "submitted"}}
                <span class="en-badge en-badge-submitted">{{$.T.EndorsementsLive}}</span>
                {{else}}
                <span class="en-badge en-badge-declined">{{$.T.EndorsementsDeclined}}</span>
                {{end}}
            </div>
        </div>

        {{if gt .Rating 0}}
        <div class="en-card-stars">
            {{$r := .Rating}}{{range seq 1 5}}{{if le . $r}}⭐{{end}}{{end}}
        </div>
        {{end}}

        {{if .Body}}
        <div class="en-card-body">{{.Body}}</div>
        {{end}}

        <div class="en-card-meta">
            {{$.T.EndorsementsRequested}} {{.RequestedAt.Format "Jan 2, 2006"}}
            {{if .SubmittedAt}} · {{$.T.EndorsementsSubmitted}} {{.SubmittedAt.Format "Jan 2, 2006"}}{{end}}
        </div>

        <div class="en-card-actions">
            {{if eq .Status "pending"}}
            <button type="button" class="en-copy-link"
                    onclick="navigator.clipboard.writeText('{{$.BaseURL}}/endorse/{{.Token}}'); this.textContent='✓ Copied'">
                {{$.T.EndorsementsCopyLink}}
            </button>
            {{end}}
            <form method="POST" action="/endorsements/{{.ID}}/delete"
                  onsubmit="return confirm('{{$.T.EndorsementsDelete}}?')">
                {{$.csrfField}}
                <button type="submit" class="en-btn-delete">{{$.T.EndorsementsDelete}}</button>
            </form>
        </div>
    </div>
    {{end}}

    {{else}}
    <div class="en-empty">
        <div class="en-empty-icon">⭐</div>
        <div class="en-empty-title">{{.T.EndorsementsEmpty}}</div>
        <div class="en-empty-sub">{{.T.EndorsementsEmptySub}}</div>
    </div>
    {{end}}
</div>

</body>
</html>
