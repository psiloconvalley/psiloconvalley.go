<!DOCTYPE html>
<html lang="en">
<head>
    <title>PsiloConValley — Invoices & Estimates in Minutes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Send estimates, get approval, convert to invoice, and get paid. The complete deal flow for independent businesses. Free to start.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PsiloConValley">
    <meta property="og:url" content="https://psiloconvalley.com">
    <meta property="og:title" content="PsiloConValley — Invoices & Estimates in Minutes">
    <meta property="og:description" content="Send estimates, get approval, convert to invoice, and get paid. Free to start.">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="PsiloConValley — Invoices & Estimates in Minutes">
    <meta name="twitter:description" content="Send estimates, get approval, convert to invoice, get paid. Free to start.">
       {{template "nav-styles" .}}

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Mycelium canvas */
        #mycelium-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
            opacity: 0.4;
        }

        .page-wrapper {
            position: relative;
            z-index: 2;
        }

        /* ═══════════════════════════════════════════════════════════════
           HERO SECTION — conversion focused
           ═══════════════════════════════════════════════════════════════ */
        .hero {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 24px 80px;
            text-align: center;
        }

        .hero-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 16px;
            border-radius: 20px;
            margin-bottom: 32px;
        }

        .hero h1 {
            font-size: clamp(36px, 6vw, 64px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -2px;
            margin-bottom: 24px;
        }

        .hero h1 span {
            background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: clamp(16px, 2vw, 20px);
            line-height: 1.7;
            color: rgba(255,255,255,0.6);
            max-width: 600px;
            margin: 0 auto 48px;
            font-weight: 400;
        }

        /* CTA buttons */
        .hero-cta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: center;
            margin-bottom: 48px;
        }

        .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: transparent;
            color: #ffffff;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.2s;
        }
        .btn-secondary:hover {
            border-color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.05);
        }

        .hero-note {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
        }
        .hero-note strong {
            color: rgba(255,255,255,0.7);
        }

        /* ═══════════════════════════════════════════════════════════════
           SOCIAL PROOF / TRUST
           ═══════════════════════════════════════════════════════════════ */
        .trust-bar {
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 32px 24px;
            background: rgba(12,18,32,0.5);
        }

        .trust-inner {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 40px;
            text-align: center;
        }

        .trust-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .trust-value {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
        }

        .trust-label {
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
        }

        /* ═══════════════════════════════════════════════════════════════
           HOW IT WORKS — 3 steps
           ═══════════════════════════════════════════════════════════════ */
        .steps-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 24px;
        }

        .section-title {
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .section-headline {
            text-align: center;
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 64px;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
        }

        .step-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 36px;
            transition: all 0.3s;
        }
        .step-card:hover {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.05);
            transform: translateY(-4px);
        }

        .step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .step-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .step-desc {
            font-size: 14px;
            line-height: 1.6;
            color: rgba(255,255,255,0.5);
        }

        /* ═══════════════════════════════════════════════════════════════
           FEATURES GRID
           ═══════════════════════════════════════════════════════════════ */
        .features-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px 100px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 24px;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .feature-icon {
            font-size: 24px;
            flex-shrink: 0;
        }

        .feature-text h4 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .feature-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.5;
        }

        /* ═══════════════════════════════════════════════════════════════
           FINAL CTA
           ═══════════════════════════════════════════════════════════════ */
        .final-cta {
            text-align: center;
            padding: 100px 24px;
            background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.02) 100%);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .final-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 16px;
        }

        .final-cta p {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 32px;
        }
	        /* ═══════════════════════════════════════════════════════════════
           PRICING CTA
           ═══════════════════════════════════════════════════════════════ */
        .pricing-cta {
            text-align: center;
            padding: 80px 24px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .pricing-cta .section-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 16px;
        }

        .pricing-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 12px;
        }

        .pricing-cta .pricing-sub {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 40px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
	.pricing-cta .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            max-width: 960px;
            margin: 0 auto 40px;
        }
	 .pricing-cta .plan-card.growth {
            border-color: rgba(74,222,128,0.3);
            background: rgba(74,222,128,0.04);
        }
        .pricing-cta .plan-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 32px 24px;
            text-align: center;
        }

        .pricing-cta .plan-card.pro {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
        }

        .pricing-cta .plan-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 12px;
        }

        .pricing-cta .plan-price {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .pricing-cta .plan-unit {
            font-size: 14px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .pricing-cta .plan-features {
            list-style: none;
            font-size: 14px;
            color: rgba(255,255,255,0.65);
            line-height: 2;
        }
		
        /* ═══════════════════════════════════════════════════════════════
           FOOTER
           ═══════════════════════════════════════════════════════════════ */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        footer a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        footer a:hover { color: #fff; }

        /* ═══════════════════════════════════════════════════════════════
           LOGGED-IN DASHBOARD VIEW
           ═══════════════════════════════════════════════════════════════ */
        .dashboard {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 24px 100px;
        }

        .dash-header {
            margin-bottom: 48px;
        }

        .dash-greeting {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 8px;
        }

        .dash-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 48px;
        }

        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .action-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
        }
        .action-card:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.06);
            transform: translateY(-2px);
        }

        .action-icon {
            font-size: 32px;
        }

        .action-text h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .action-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        @media (max-width: 640px) {
            .hero { padding: 60px 20px 60px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
            .trust-inner { gap: 24px; }
            .steps-section, .features-section { padding: 60px 20px; }
	    .pricing-cta .pricing-grid { grid-template-columns: 1fr; }
        }
            /* ═══════════════════════════════════════════════════════════════
           ANIMATIONS — scroll reveals, counters, interactive demo
           ═══════════════════════════════════════════════════════════════ */

        /* Scroll reveal */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Staggered children */
        .reveal-stagger > * {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .reveal-stagger.visible > *:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(2) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(3) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(4) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(5) { transition-delay: 0.5s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(6) { transition-delay: 0.6s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(7) { transition-delay: 0.7s; opacity: 1; transform: translateY(0); }
        .reveal-stagger.visible > *:nth-child(8) { transition-delay: 0.8s; opacity: 1; transform: translateY(0); }

        /* Live invoice demo */
        .demo-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 80px 24px 100px;
        }
        .demo-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            overflow: hidden;
            max-width: 700px;
            margin: 0 auto;
        }
        .demo-accent { height: 4px; background: linear-gradient(90deg, #4ade80, #22d3ee, #818cf8); }
        .demo-header {
            padding: 28px 32px 0;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .demo-title {
            font-size: 20px;
            font-weight: 800;
            color: #0d1422;
            letter-spacing: -0.5px;
        }
        .demo-number { font-size: 14px; color: #64748b; font-weight: 600; }
        .demo-badge {
            background: #dcfce7;
            color: #15803d;
            font-size: 10px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .demo-addresses {
            padding: 20px 32px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }
        .demo-addr-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .demo-addr-name { font-size: 14px; font-weight: 700; color: #0d1422; }
        .demo-addr-line { font-size: 12px; color: #64748b; line-height: 1.5; }
        .demo-items {
            padding: 0 32px;
        }
        .demo-items table { width: 100%; border-collapse: collapse; }
        .demo-items th {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #94a3b8;
            text-align: left;
            padding: 8px 0;
            border-bottom: 2px solid #e2e8f0;
        }
        .demo-items th.right { text-align: right; }
        .demo-items td {
            padding: 10px 0;
            font-size: 13px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
        }
        .demo-items td.right { text-align: right; font-weight: 600; color: #0d1422; font-variant-numeric: tabular-nums; }
        .demo-item-desc { font-weight: 600; color: #0d1422; }
        .demo-total-row {
            padding: 16px 32px 24px;
            display: flex;
            justify-content: flex-end;
        }
        .demo-total-box {
            background: #f8fafc;
            border-radius: 8px;
            padding: 16px 24px;
            border: 1px solid #e2e8f0;
            min-width: 200px;
        }
        .demo-total-line {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #64748b;
            padding: 4px 0;
        }
        .demo-total-line.grand {
            border-top: 1px solid #e2e8f0;
            margin-top: 8px;
            padding-top: 10px;
            font-size: 16px;
            font-weight: 800;
            color: #0d1422;
        }
        .demo-total-line.grand span:last-child { color: #4ade80; }

        /* Typewriter effect */
        .typewriter {
            overflow: hidden;
            border-right: 2px solid #4ade80;
            white-space: nowrap;
            animation: typing 2s steps(20, end) forwards, blink 0.8s step-end infinite;
            width: 0;
            display: inline-block;
        }
        @keyframes typing {
            from { width: 0; }
            to { width: 100%; }
        }
        @keyframes blink {
            50% { border-color: transparent; }
        }

        /* Demo items animation */
        .demo-row-animate {
            opacity: 0;
            transform: translateX(-10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .demo-row-animate.show {
            opacity: 1;
            transform: translateX(0);
        }
	        /* ═══════════════════════════════════════════════════════════════
           ANIMATED FLOW SHOWCASE
           ═══════════════════════════════════════════════════════════════ */
        .flow-section {
            max-width: 860px;
            margin: 0 auto;
            padding: 80px 24px 60px;
            text-align: center;
        }

        /* Pills */
        .flow-pills {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-bottom: 36px;
        }
        .flow-pill {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.5);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }
        .flow-pill:hover {
            border-color: rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.8);
        }
        .flow-pill.active {
            background: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.3);
            color: #ffffff;
        }

        /* Stage */
        .flow-stage {
            position: relative;
            min-height: 380px;
            margin-bottom: 24px;
        }

        /* Cards */
        .flow-card {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            overflow: hidden;
            opacity: 0;
            transform: translateX(40px);
            transition: opacity 0.45s ease, transform 0.45s ease;
            pointer-events: none;
            text-align: left;
        }
        .flow-card.active {
            opacity: 1;
            transform: translateX(0);
            pointer-events: all;
            position: relative;
        }
        .flow-card.exit {
            opacity: 0;
            transform: translateX(-40px);
        }

        /* Chrome bar */
        .fc-chrome {
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .fc-chrome-dots {
            display: flex;
            gap: 5px;
            flex-shrink: 0;
        }
        .fc-chrome-dots span {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.12);
            display: block;
        }
        .fc-chrome-dots span:nth-child(1) { background: rgba(255,95,87,0.6); }
        .fc-chrome-dots span:nth-child(2) { background: rgba(255,189,68,0.6); }
        .fc-chrome-dots span:nth-child(3) { background: rgba(40,201,64,0.6); }
        .fc-chrome-url {
            font-size: 11px;
            color: rgba(255,255,255,0.3);
            font-family: monospace;
            letter-spacing: 0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Body */
        .fc-body {
            padding: 24px 28px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .fc-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .fc-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
            width: 80px;
            flex-shrink: 0;
        }
        .fc-val {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }
        .fc-tag {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-block;
        }
        .fc-tag-est {
            background: rgba(139,92,246,0.2);
            border: 1px solid rgba(139,92,246,0.4);
            color: #c4b5fd;
        }
        .fc-tag-inv {
            background: rgba(59,130,246,0.2);
            border: 1px solid rgba(59,130,246,0.4);
            color: #93c5fd;
        }
        .fc-tag-accepted {
            background: rgba(74,222,128,0.15);
            border: 1px solid rgba(74,222,128,0.35);
            color: #86efac;
        }
        .fc-divider {
            height: 1px;
            background: rgba(255,255,255,0.07);
            margin: 4px 0;
        }
        .fc-items-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
        }
        .fc-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: rgba(255,255,255,0.8);
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .fc-amount {
            font-weight: 700;
            color: #ffffff;
            font-variant-numeric: tabular-nums;
        }
        .fc-total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .fc-total-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
        }
        .fc-total-val {
            font-size: 20px;
            font-weight: 800;
            color: #4ade80;
        }

        /* Send step */
        .fc-send-icon {
            font-size: 48px;
            margin-bottom: 8px;
        }
        .fc-send-title {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 4px;
        }
        .fc-send-meta {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            font-family: monospace;
            margin-bottom: 16px;
        }
        .fc-send-bar-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            max-width: 280px;
        }
        .fc-send-bar {
            flex: 1;
            height: 4px;
            background: rgba(255,255,255,0.1);
            border-radius: 4px;
            overflow: hidden;
        }
        .fc-send-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #4ade80, #22d3ee);
            border-radius: 4px;
            transition: width 1.2s ease;
        }
        .flow-card[data-card="1"].active .fc-send-bar-fill {
            width: 100%;
        }
        .fc-send-bar-label {
            font-size: 11px;
            font-weight: 700;
            color: #4ade80;
        }
        .fc-send-note {
            font-size: 12px;
            color: rgba(255,255,255,0.35);
            max-width: 320px;
            text-align: center;
            line-height: 1.6;
            margin-top: 8px;
        }

        /* Respond step */
        .fc-respond-header { margin-bottom: 4px; }
        .fc-respond-label {
            font-size: 13px;
            color: rgba(255,255,255,0.6);
            font-weight: 600;
        }
        .fc-respond-btns {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .fc-btn-accept, .fc-btn-suggest, .fc-btn-decline {
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: default;
            border: 1px solid;
            font-family: inherit;
            text-align: left;
        }
        .fc-btn-accept {
            background: rgba(74,222,128,0.15);
            border-color: rgba(74,222,128,0.4);
            color: #86efac;
        }
        .fc-btn-suggest {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.5);
        }
        .fc-btn-decline {
            background: rgba(255,255,255,0.03);
            border-color: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.3);
        }
        .fc-pulse {
            animation: fc-pulse-glow 1.5s ease-in-out infinite;
        }
        @keyframes fc-pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(74,222,128,0.3); }
            50% { box-shadow: 0 0 0 8px rgba(74,222,128,0); }
        }
        .fc-accepted-banner {
            background: rgba(74,222,128,0.12);
            border: 1px solid rgba(74,222,128,0.3);
            color: #86efac;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 8px;
            text-align: center;
        }

        /* Convert step */
        .fc-convert-area {
            display: flex;
            justify-content: center;
            padding: 8px 0;
        }
        .fc-convert-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.2);
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            padding: 14px 28px;
            border-radius: 10px;
            cursor: default;
            transition: all 0.3s;
        }
        .flow-card[data-card="3"].active .fc-convert-btn {
            animation: fc-convert-press 0.4s ease 0.9s forwards;
        }
        @keyframes fc-convert-press {
            0% { transform: scale(1); background: rgba(255,255,255,0.08); }
            50% { transform: scale(0.96); background: rgba(255,255,255,0.15); }
            100% { transform: scale(1); background: rgba(59,130,246,0.25); border-color: rgba(59,130,246,0.5); }
        }
        .fc-convert-result {
            text-align: center;
        }

        /* Pay step */
        .fc-pay-amount {
            font-size: 36px;
            font-weight: 800;
            color: #ffffff;
            text-align: center;
            letter-spacing: -1px;
            margin: 4px 0 16px;
        }
        .fc-stripe-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 16px;
        }
        .fc-stripe-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.3);
            margin-bottom: 6px;
        }
        .fc-stripe-input {
            font-size: 14px;
            font-family: monospace;
            color: rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            padding: 8px 12px;
        }
        .fc-stripe-pay-btn {
            background: #635bff;
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            margin-top: 12px;
        }
        .fc-paid-banner {
            background: rgba(74,222,128,0.12);
            border: 1px solid rgba(74,222,128,0.3);
            color: #86efac;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 8px;
            text-align: center;
        }

        /* Animate-in utility */
        .fc-animate-in {
            opacity: 0;
            transform: translateY(8px);
        }
        .flow-card.active .fc-animate-in {
            animation: fc-fade-up 0.4s ease forwards;
        }
        @keyframes fc-fade-up {
            to { opacity: 1; transform: translateY(0); }
        }

        /* Dots + arrows */
        .flow-dots {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 8px;
        }
        .flow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }
        .flow-dot.active {
            background: #ffffff;
            width: 20px;
            border-radius: 4px;
        }
        .flow-arrow {
            background: none;
            border: 1px solid rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.5);
            font-size: 14px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }
        .flow-arrow:hover {
            border-color: rgba(255,255,255,0.4);
            color: #ffffff;
        }

        @media (max-width: 639px) {
            .flow-pills { gap: 6px; }
            .flow-pill { font-size: 11px; padding: 6px 12px; }
            .fc-body { padding: 18px 16px; }
        }
    </style>
</head>

<body>
{{template "nav" .}}

<canvas id="mycelium-canvas"></canvas>

<div class="page-wrapper">

{{if .User}}
    <!-- ═══════════════════════════════════════════════════════════════
         LOGGED-IN USER: DASHBOARD VIEW
         ═══════════════════════════════════════════════════════════════ -->
    <div class="dashboard">
        <div class="dash-header">
            <p class="dash-greeting">Welcome back,</p>
            <h1 class="dash-title">{{.User.DisplayName}}</h1>
        </div>

        <div class="dash-grid">
            <div class="stat-card">
                <div class="stat-label">Plan</div>
                <div class="stat-value">{{if eq .User.Plan "pro"}}Pro{{else}}Free{{end}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">This Month</div>
                <div class="stat-value">—</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Status</div>
                <div class="stat-value" style="color: #4ade80;">Active</div>
            </div>
        </div>

        <div class="quick-actions">
            <a href="/invoices/new" class="action-card">
                <span class="action-icon">📄</span>
                <div class="action-text">
                    <h3>New Invoice</h3>
                    <p>Create and send a professional invoice</p>
                </div>
            </a>
            <a href="/invoices" class="action-card">
                <span class="action-icon">📊</span>
                <div class="action-text">
                    <h3>View Invoices</h3>
                    <p>Manage your invoice history</p>
                </div>
            </a>
            <a href="/clients" class="action-card">
                <span class="action-icon">👥</span>
                <div class="action-text">
                    <h3>Clients</h3>
                    <p>Manage your client directory</p>
                </div>
            </a>
            <a href="/profile" class="action-card">
                <span class="action-icon">⚙️</span>
                <div class="action-text">
                    <h3>Settings</h3>
                    <p>Business profile and preferences</p>
                </div>
            </a>
        </div>
    </div>

{{else}}
    <!-- ═══════════════════════════════════════════════════════════════
         ANONYMOUS VISITOR: LANDING PAGE
         ═══════════════════════════════════════════════════════════════ -->
    
    <!-- HERO -->
       <section class="hero">
        <div class="hero-badge">✦ Estimates · Invoices · Payments</div>
        
        <h1><span>From estimate to payment</span><br>in minutes</h1>
	<p class="hero-sub">
            The complete deal flow for independent businesses.
            Send estimates, get client approval, convert to invoice, get paid —
            without the back-and-forth.
        </p>
                          </p> 
        <div class="hero-cta">
            <a href="/estimates/new" class="btn-primary">
                Create Free Estimate →
            </a>
            <a href="/invoices/new" class="btn-secondary">
                Create Invoice
            </a>
        </div>
	 <p class="hero-note">
            <strong>Free to start:</strong> 10 invoices/month, 5 estimates, PDF downloads.
            <span>Growth &amp; Pro unlock unlimited invoices, branding removal, recurring billing, and more.</span>
        </p>
        </section> 
    <!-- TRUST BAR -->
    <div class="trust-bar reveal">
        <div class="trust-inner reveal-stagger">
            <div class="trust-item">
                <div class="trust-value">30s</div>
                <div class="trust-label">To create</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">$0</div>
                <div class="trust-label">To start</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">PDF</div>
                <div class="trust-label">Download</div>
            </div>
            <div class="trust-item">
                <div class="trust-value">0</div>
                <div class="trust-label">Tracking</div>
            </div>
        </div>
	       </div>

       <!-- ANIMATED FLOW SHOWCASE -->
    <section class="flow-section reveal">
        <p class="section-title">The complete deal flow</p>
        <h2 class="section-headline">From estimate to paid — watch it happen</h2>

        <!-- Step Pills -->
        <div class="flow-pills">
            <button class="flow-pill active" data-step="0">📝 Create</button>
            <button class="flow-pill" data-step="1">📨 Send</button>
            <button class="flow-pill" data-step="2">✅ Accept</button>
            <button class="flow-pill" data-step="3">🔄 Convert</button>
            <button class="flow-pill" data-step="4">💰 Pay</button>
        </div>

        <!-- Card Stage -->
        <div class="flow-stage">

            <!-- Step 0: Create Estimate -->
            <div class="flow-card active" data-card="0">
                <div class="fc-chrome">
                    <div class="fc-chrome-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="fc-chrome-url">psiloconvalley.com/estimates/new</div>
                </div>
                <div class="fc-body">
                    <div class="fc-row">
                        <div class="fc-label">DOCUMENT</div>
                        <div class="fc-val fc-tag fc-tag-est">ESTIMATE — EST-0001</div>
                    </div>
                    <div class="fc-row">
                        <div class="fc-label">CLIENT</div>
                        <div class="fc-val fc-type" id="fc-client-name">Globex Corporation</div>
                    </div>
                    <div class="fc-divider"></div>
                    <div class="fc-items-label">LINE ITEMS</div>
                    <div class="fc-item fc-animate-in" style="animation-delay:0.2s">
                        <span>Brand Identity Package</span>
                        <span class="fc-amount">$4,500</span>
                    </div>
                    <div class="fc-item fc-animate-in" style="animation-delay:0.5s">
                        <span>Website Design (5 pages)</span>
                        <span class="fc-amount">$3,200</span>
                    </div>
                    <div class="fc-item fc-animate-in" style="animation-delay:0.8s">
                        <span>Monthly Retainer × 3</span>
                        <span class="fc-amount">$2,400</span>
                    </div>
                    <div class="fc-divider"></div>
                    <div class="fc-total-row fc-animate-in" style="animation-delay:1.1s">
                        <span class="fc-total-label">TOTAL</span>
                        <span class="fc-total-val">$10,100.00</span>
                    </div>
                </div>
            </div>

            <!-- Step 1: Send -->
            <div class="flow-card" data-card="1">
                <div class="fc-chrome">
                    <div class="fc-chrome-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="fc-chrome-url">psiloconvalley.com/estimates/42/send</div>
                </div>
                <div class="fc-body" style="align-items:center; justify-content:center; min-height:260px;">
                    <div class="fc-send-icon fc-animate-in">📨</div>
                    <div class="fc-send-title fc-animate-in" style="animation-delay:0.3s">
                        Estimate sent successfully
                    </div>
                    <div class="fc-send-meta fc-animate-in" style="animation-delay:0.5s">
                        EST-0001 → sarah@globexcorp.com
                    </div>
                    <div class="fc-send-bar-wrap fc-animate-in" style="animation-delay:0.7s">
                        <div class="fc-send-bar">
                            <div class="fc-send-bar-fill"></div>
                        </div>
                        <span class="fc-send-bar-label">Delivered</span>
                    </div>
                    <div class="fc-send-note fc-animate-in" style="animation-delay:1s">
                        Client receives a secure link to review &amp; respond — no login required
                    </div>
                </div>
            </div>

            <!-- Step 2: Client Accepts -->
            <div class="flow-card" data-card="2">
                <div class="fc-chrome">
                    <div class="fc-chrome-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="fc-chrome-url">psiloconvalley.com/estimates/42/respond?access=••••</div>
                </div>
                <div class="fc-body">
                    <div class="fc-respond-header fc-animate-in">
                        <div class="fc-tag fc-tag-est" style="margin-bottom:8px;">EST-0001 — $10,100.00</div>
                        <div style="font-size:13px; color:rgba(255,255,255,0.5);">From: Your Company · To: Globex Corporation</div>
                    </div>
                    <div class="fc-divider"></div>
                    <div class="fc-respond-label fc-animate-in" style="animation-delay:0.3s">
                        How would you like to respond?
                    </div>
                    <div class="fc-respond-btns fc-animate-in" style="animation-delay:0.5s">
                        <button class="fc-btn-accept fc-pulse">✅ Accept Estimate</button>
                        <button class="fc-btn-suggest">💬 Suggest Changes</button>
                        <button class="fc-btn-decline">❌ Decline</button>
                    </div>
                    <div class="fc-accepted-banner fc-animate-in" style="animation-delay:1.2s">
                        🎉 Estimate accepted — owner notified
                    </div>
                </div>
            </div>

            <!-- Step 3: Convert to Invoice -->
            <div class="flow-card" data-card="3">
                <div class="fc-chrome">
                    <div class="fc-chrome-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="fc-chrome-url">psiloconvalley.com/estimates/42</div>
                </div>
                <div class="fc-body">
                    <div class="fc-row fc-animate-in">
                        <div class="fc-label">STATUS</div>
                        <div class="fc-tag fc-tag-accepted">✅ ACCEPTED</div>
                    </div>
                    <div class="fc-row fc-animate-in" style="animation-delay:0.2s">
                        <div class="fc-label">ESTIMATE</div>
                        <div class="fc-val">EST-0001 · $10,100.00</div>
                    </div>
                    <div class="fc-divider"></div>
                    <div class="fc-convert-area fc-animate-in" style="animation-delay:0.5s">
                        <div class="fc-convert-btn" id="fc-convert-btn">
                            🔄 Convert to Invoice
                        </div>
                    </div>
                    <div class="fc-convert-result fc-animate-in" style="animation-delay:1.3s">
                        <div class="fc-tag fc-tag-inv">INV-0001 CREATED</div>
                        <div style="font-size:12px; color:rgba(255,255,255,0.5); margin-top:6px;">
                            Draft invoice ready — no data re-entry
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 4: Pay -->
            <div class="flow-card" data-card="4">
                <div class="fc-chrome">
                    <div class="fc-chrome-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="fc-chrome-url">psiloconvalley.com/invoices/88/pay</div>
                </div>
                <div class="fc-body">
                    <div class="fc-row fc-animate-in">
                        <div class="fc-label">INVOICE</div>
                        <div class="fc-val">INV-0001 · Globex Corporation</div>
                    </div>
                    <div class="fc-pay-amount fc-animate-in" style="animation-delay:0.2s">
                        $10,100.00
                    </div>
                    <div class="fc-stripe-card fc-animate-in" style="animation-delay:0.5s">
                        <div class="fc-stripe-label">Card number</div>
                        <div class="fc-stripe-input">•••• •••• •••• 4242</div>
                        <div style="display:flex; gap:12px; margin-top:10px;">
                            <div style="flex:1">
                                <div class="fc-stripe-label">Expiry</div>
                                <div class="fc-stripe-input">12 / 28</div>
                            </div>
                            <div style="flex:1">
                                <div class="fc-stripe-label">CVC</div>
                                <div class="fc-stripe-input">•••</div>
                            </div>
                        </div>
                        <div class="fc-stripe-pay-btn fc-animate-in" style="animation-delay:0.8s">
                            Pay $10,100.00 via Stripe
                        </div>
                    </div>
                    <div class="fc-paid-banner fc-animate-in" style="animation-delay:1.5s">
                        ✅ Payment received · Invoice marked PAID
                    </div>
                </div>
            </div>

        </div><!-- /.flow-stage -->

        <!-- Dot Nav -->
        <div class="flow-dots">
            <button class="flow-arrow" id="flow-prev">←</button>
            <span class="flow-dot active" data-dot="0"></span>
            <span class="flow-dot" data-dot="1"></span>
            <span class="flow-dot" data-dot="2"></span>
            <span class="flow-dot" data-dot="3"></span>
            <span class="flow-dot" data-dot="4"></span>
            <button class="flow-arrow" id="flow-next">→</button>
        </div>

    </section>
    <!-- END ANIMATED FLOW SHOWCASE --> 
    <!-- LIVE DEMO -->
    <section class="demo-section reveal">
        <p class="section-title">See it in action</p>
           <h2 class="section-headline">Your invoice, generated instantly</h2>

        <div class="demo-card" id="demo-invoice">
            <div class="demo-accent"></div>
            <div class="demo-header">
                <div>
                    <div class="demo-title">INVOICE</div>
                    <div class="demo-number">#INV-2026-001</div>
                </div>
                <div class="demo-badge" id="demo-status">GENERATING...</div>
            </div>
            <div class="demo-addresses">
                <div>
                    <div class="demo-addr-label">From</div>
                    <div class="demo-addr-name">Your Company</div>
                    <div class="demo-addr-line">123 Innovation Way<br>San Francisco, CA 94103</div>
                </div>
                <div>
                    <div class="demo-addr-label">Bill To</div>
                    <div class="demo-addr-name">Client Name</div>
                    <div class="demo-addr-line">456 Enterprise Dr<br>Austin, TX 73301</div>
                </div>
            </div>
            <div class="demo-items">
                <table>
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="right">Qty</th>
                            <th class="right">Price</th>
                            <th class="right">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="demo-items-body">
                    </tbody>
                </table>
            </div>
            <div class="demo-total-row">
                <div class="demo-total-box">
