<!DOCTYPE html>
<html lang="en">
<head>
    <title>PsiloConValley — Professional Invoices in Seconds</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Create professional invoices instantly. No signup required. Download PDF free.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    {{template "nav-styles" .}}

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #ffffff;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Mycelium canvas */
        #mycelium-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
            opacity: 0.4;
        }

        .page-wrapper {
            position: relative;
            z-index: 2;
        }

        /* ═══════════════════════════════════════════════════════════════
           HERO SECTION — conversion focused
           ═══════════════════════════════════════════════════════════════ */
        .hero {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 24px 80px;
            text-align: center;
        }

        .hero-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 16px;
            border-radius: 20px;
            margin-bottom: 32px;
        }

        .hero h1 {
            font-size: clamp(36px, 6vw, 64px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -2px;
            margin-bottom: 24px;
        }

        .hero h1 span {
            background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: clamp(16px, 2vw, 20px);
            line-height: 1.7;
            color: rgba(255,255,255,0.6);
            max-width: 600px;
            margin: 0 auto 48px;
            font-weight: 400;
        }

        /* CTA buttons */
        .hero-cta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: center;
            margin-bottom: 48px;
        }

        .btn-primary {
            background: #ffffff;
            color: #0a0f1a;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: transparent;
            color: #ffffff;
            padding: 16px 32px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.2s;
        }
        .btn-secondary:hover {
            border-color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.05);
        }

        .hero-note {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
        }
        .hero-note strong {
            color: rgba(255,255,255,0.7);
        }

        /* ═══════════════════════════════════════════════════════════════
           SOCIAL PROOF / TRUST
           ═══════════════════════════════════════════════════════════════ */
        .trust-bar {
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 32px 24px;
            background: rgba(12,18,32,0.5);
        }

        .trust-inner {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 40px;
            text-align: center;
        }

        .trust-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .trust-value {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
        }

        .trust-label {
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
        }

        /* ═══════════════════════════════════════════════════════════════
           HOW IT WORKS — 3 steps
           ═══════════════════════════════════════════════════════════════ */
        .steps-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 24px;
        }

        .section-title {
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .section-headline {
            text-align: center;
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 64px;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
        }

        .step-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 36px;
            transition: all 0.3s;
        }
        .step-card:hover {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.05);
            transform: translateY(-4px);
        }

        .step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .step-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .step-desc {
            font-size: 14px;
            line-height: 1.6;
            color: rgba(255,255,255,0.5);
        }

        /* ═══════════════════════════════════════════════════════════════
           FEATURES GRID
           ═══════════════════════════════════════════════════════════════ */
        .features-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px 100px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 24px;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .feature-icon {
            font-size: 24px;
            flex-shrink: 0;
        }

        .feature-text h4 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .feature-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.5;
        }

        /* ═══════════════════════════════════════════════════════════════
           FINAL CTA
           ═══════════════════════════════════════════════════════════════ */
        .final-cta {
            text-align: center;
            padding: 100px 24px;
            background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.02) 100%);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .final-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 16px;
        }

        .final-cta p {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 32px;
        }
	        /* ═══════════════════════════════════════════════════════════════
           PRICING CTA
           ═══════════════════════════════════════════════════════════════ */
        .pricing-cta {
            text-align: center;
            padding: 80px 24px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .pricing-cta .section-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 16px;
        }

        .pricing-cta h2 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 12px;
        }

        .pricing-cta .pricing-sub {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 40px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .pricing-cta .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            max-width: 700px;
            margin: 0 auto 40px;
        }

        .pricing-cta .plan-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 32px 24px;
            text-align: center;
        }

        .pricing-cta .plan-card.pro {
            border-color: rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.06);
        }

        .pricing-cta .plan-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            margin-bottom: 12px;
        }

        .pricing-cta .plan-price {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .pricing-cta .plan-unit {
            font-size: 14px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 16px;
        }

        .pricing-cta .plan-features {
            list-style: none;
            font-size: 14px;
            color: rgba(255,255,255,0.65);
            line-height: 2;
        }
		
        /* ═══════════════════════════════════════════════════════════════
           FOOTER
           ═══════════════════════════════════════════════════════════════ */
        footer {
            text-align: center;
            padding: 40px 24px;
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        footer a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        footer a:hover { color: #fff; }

        /* ═══════════════════════════════════════════════════════════════
           LOGGED-IN DASHBOARD VIEW
           ═══════════════════════════════════════════════════════════════ */
        .dashboard {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 24px 100px;
        }

        .dash-header {
            margin-bottom: 48px;
        }

        .dash-greeting {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 8px;
        }

        .dash-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 48px;
        }

        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .action-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 24px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
        }
        .action-card:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.06);
            transform: translateY(-2px);
        }

        .action-icon {
            font-size: 32px;
        }

        .action-text h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .action-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        @media (max-width: 640px) {
            .hero { padding: 60px 20px 60px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
            .trust-inner { gap: 24px; }
            .steps-section, .features-section { padding: 60px 20px; }
	    .pricing-cta .pricing-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

