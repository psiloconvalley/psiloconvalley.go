<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sovereign Command Center — PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    {{template "nav-styles" .}}

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0a0a;
            color: #ffffff;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Fixed interactive organic background */
        #mycelium-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
            opacity: 0.55;
        }

        .app-interface {
            position: relative;
            z-index: 2;
            max-width: 1300px;
            margin: 0 auto;
            padding: 40px 24px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex-grow: 1;
            margin-top: 40px;
            margin-bottom: 80px;
        }

        .meta-tag {
            font-size: 11px;
            font-family: monospace;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: rgba(255, 255, 255, 0.4);
            margin-bottom: 16px;
        }

        h1 {
            font-size: clamp(40px, 7vw, 76px);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -2.5px;
            max-width: 900px;
            margin-bottom: 24px;
            text-transform: uppercase;
        }

        .tagline {
            font-size: clamp(16px, 2vw, 20px);
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.6);
            max-width: 650px;
            margin-bottom: 56px;
            font-weight: 300;
        }

        /* --- METRIC PULSE GRID --- */
        .pulse-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .metric-card {
            background: rgba(15, 15, 15, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 28px;
            border-radius: 12px;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s ease;
        }

        .metric-card:hover { border-color: rgba(255, 255, 255, 0.3); }

        .metric-card::before {
            content: ""; position: absolute; top: 0; left: 0; width: 3px; height: 100%;
        }
        .metric-card.outstanding::before { background: #f59e0b; }
        .metric-card.collected::before { background: #10b981; }
        .metric-card.velocity::before { background: #3b82f6; }

        .metric-label { font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; }
        .metric-val { font-size: 28px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; font-variant-numeric: tabular-nums; }
        .metric-sub { font-size: 12px; color: rgba(255,255,255,0.5); margin-top: 4px; font-weight: 300; }

        /* --- DASHBOARD SPLIT --- */
        .dashboard-split {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 32px;
        }

        .panel {
            background: rgba(15, 15, 15, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 36px;
            backdrop-filter: blur(10px);
        }

        .panel-title {
            font-size: 14px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 1.5px; color: #ffffff; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
        }

        /* Quick Launch Directory */
        .tools-directory {
            display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
            margin-bottom: 32px;
        }

        .tool-node {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 24px; border-radius: 10px;
            text-decoration: none; color: inherit; display: flex;
            flex-direction: column; justify-content: space-between;
            transition: all 0.2s ease;
        }

        .tool-node:hover {
            border-color: rgba(255, 255, 255, 0.5);
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-2px);
        }

        .node-index { font-size: 10px; font-family: monospace; color: rgba(255, 255, 255, 0.3); margin-bottom: 12px; }
        .node-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
        .node-description { font-size: 12px; line-height: 1.5; color: rgba(255, 255, 255, 0.5); }

        /* Empty State Table */
        .empty-state { text-align: center; padding: 40px 20px; border: 1px dashed rgba(255,255,255,0.1); border-radius: 8px; }
        .empty-icon { font-size: 24px; margin-bottom: 12px; opacity: 0.4; }
        .empty-text { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.6); margin-bottom: 6px; }

        /* ROADMAP LOOP POLL */
        .poll-container { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 20px; margin-bottom: 24px; }
        .poll-header { font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.8); margin-bottom: 16px; text-transform: uppercase; letter-spacing: 1px; }
        
        .poll-option {
            display: flex; align-items: center; justify-content: space-between;
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
            padding: 12px 16px; border-radius: 8px; margin-bottom: 10px; cursor: pointer;
            transition: all 0.2s; font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.8);
        }
        .poll-option:hover { border-color: #ffffff; background: rgba(255,255,255,0.1); color: #ffffff; }
        .poll-option.voted { background: #ffffff; color: #0a0a0a; border-color: #ffffff; font-weight: 700; }

        .vote-badge { font-size: 10px; background: rgba(255,255,255,0.1); padding: 2px 8px; border-radius: 12px; color: rgba(255,255,255,0.6); font-weight: 700; }
        .voted .vote-badge { background: rgba(0,0,0,0.15); color: #0a0a0a; }

        /* Anomaly input overrides */
        textarea.report-box {
            width: 100%; padding: 12px; font-size: 13px; border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.5);
            color: #ffffff; margin-bottom: 10px; font-family: inherit; resize: none;
        }
        textarea.report-box:focus { outline: none; border-color: #ffffff; }

        .btn-transmit {
            background: #ffffff; color: #0a0a0a; border: none; padding: 8px 16px;
            border-radius: 6px; font-weight: 700; font-size: 11px; text-transform: uppercase;
            letter-spacing: 1px; cursor: pointer; transition: all 0.2s;
        }
        .btn-transmit:hover { background: rgba(255,255,255,0.8); }

        footer {
            display: flex; justify-content: space-between; align-items: center; font-size: 12px;
            color: rgba(255, 255, 255, 0.3); border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 40px; text-transform: uppercase; letter-spacing: 1px;
        }

        @media (max-width: 960px) {
            .dashboard-split { grid-template-columns: 1fr; gap: 24px; }
            .tools-directory { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>
{{template "nav" .}}

<canvas id="mycelium-canvas"></canvas>

<!-- Inject Core Application Navbar -->


<div class="app-interface">
    
    <main>
        <div class="meta-tag">Core Infrastructure Group // Active Session</div>
        <h1>Sovereign<br>Business Tools.</h1>
        <p class="tagline">
            Fast, zero-compromise system utilities built to handle core financial operations independently. No tracking layers. Raw functional software.
        </p>

        <!-- FINANCIAL PULSE GRID -->
        <div class="pulse-grid">
            <div class="metric-card outstanding">
                <div class="metric-label">Outstanding Revenue</div>
                <div class="metric-val">$0.00</div>
                <div class="metric-sub">Draft & pending invoices</div>
            </div>
            <div class="metric-card collected">
                <div class="metric-label">Collected Money</div>
                <div class="metric-val">$0.00</div>
                <div class="metric-sub">Marked paid all-time</div>
            </div>
            <div class="metric-card velocity">
                <div class="metric-label">Engine Quota</div>
                <div class="metric-val">{{if .User}}{{if eq .User.Plan "pro"}}Unlimited{{else}}Active{{end}}{{else}}Free{{end}}</div>
                <div class="metric-sub">Raw deterministic pipeline</div>
            </div>
        </div>

        <!-- COMMAND CENTER SPLIT -->
        <div class="dashboard-split">
            
            <!-- LEFT PANEL: Quick Launch Directory -->
            <div class="panel">
                <div class="panel-title">
                    <span>⚡ Quick Launch Nodes</span>
                </div>

                <div class="tools-directory">
                    <a href="/invoices/new" class="tool-node">
                        <div>
                            <div class="node-index">[ Node // 01 ]</div>
                            <div class="node-title">Invoice Generator</div>
                            <div class="node-description">Render crisp, high-fidelity printable invoices instantly.</div>
                        </div>
                    </a>
                    <a href="/clients/new" class="tool-node">
                        <div>
                            <div class="node-index">[ Node // 02 ]</div>
                            <div class="node-title">Customer Registry</div>
                            <div class="node-description">Store and map encrypted customer routing profiles.</div>
                        </div>
                    </a>
                </div>

                <div class="panel-title" style="margin-top: 40px;">
                    <span>📊 Active Ledger Logs</span>
                    {{if .User}}
                    <a href="/invoices" style="font-size: 11px; color: rgba(255,255,255,0.5); text-decoration: none;">Inspect Ledger →</a>
                    {{end}}
                </div>

                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <div class="empty-text">Ledger requires identity initialization.</div>
                    <p style="font-size: 12px; color: rgba(255,255,255,0.4); max-width: 300px; margin: auto;">Issued invoices automatically securely register physical payment state transitions here.</p>
                </div>
            </div>

            <!-- RIGHT PANEL: STRATEGIC ROADMAP LOOP -->
            <div class="panel">
                <div class="panel-title">
                    <span>🎯 Product Intelligence</span>
                </div>
                
                <p style="font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 20px; line-height: 1.5;">
                    We build directly based on user demand velocity. Vote on the next automation module to push it to the top of our engineering queue.
                </p>

                <div class="poll-container">
                    <div class="poll-header">Engineering Priority Pipeline</div>
                    
                    <div class="poll-option" onclick="castVote(this, 'stripe')">
                        <span>💳 Stripe Instant Routing</span>
                        <span class="vote-badge">+32 Votes</span>
                    </div>
                    <div class="poll-option" onclick="castVote(this, 'reminders')">
                        <span>⏰ Automated Dunning</span>
                        <span class="vote-badge">+18 Votes</span>
                    </div>
                    <div class="poll-option" onclick="castVote(this, 'portal')">
                        <span>🔐 Signed Client Portals</span>
                        <span class="vote-badge">+24 Votes</span>
                    </div>
                </div>

                <!-- Custom Anomaly Reporter tied directly to your backend /feedback handler -->
                <div style="margin-top: 24px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px;">
                    <p style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.7); margin-bottom: 8px;">Encountered an Anomaly?</p>
                    <form method="POST" action="/feedback">
                        {{.csrfField}}
                        <textarea name="report" class="report-box" rows="2" placeholder="Describe the calculation failure or layout error..."></textarea>
                        <button type="submit" class="btn-transmit">Transmit Error Log</button>
                    </form>
                </div>
            </div>

        </div>

    </main>

    <footer>
        <div>Engine Status: Active & Secured</div>
        <div>Built independently // Go + Postgres + Railway</div>
    </footer>

</div>

<!-- PRESERVED LIVE ORGANIC MYCELIUM ANIMATION ENGINE -->
<script>
    const canvas = document.getElementById("mycelium-canvas");
    const ctx = canvas.getContext("2d");
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);
    window.addEventListener("resize", () => {
        width = (canvas.width = window.innerWidth);
        height = (canvas.height = window.innerHeight);
    });
    const mouse = { x: null, y: null, radius: 180 };
    window.addEventListener("mousemove", (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
    class Hypha {
        constructor(x, y, angle, depth) {
            this.x = x; this.y = y; this.px = x; this.py = y;
            this.angle = angle; this.speed = Math.random() * 1.5 + 0.5;
            this.depth = depth; this.age = 0;
            this.maxAge = Math.random() * 100 + 50 / (depth + 1);
            this.dead = false;
        }
        update() {
            if (this.dead) return;
            this.px = this.x; this.py = this.y;
            this.angle += (Math.random() - 0.5) * 0.4;
            if (mouse.x !== null && mouse.y !== null) {
                const dx = mouse.x - this.x; const dy = mouse.y - this.y;
                const dist = Math.hypot(dx, dy);
                if (dist < mouse.radius) {
                    const targetAngle = Math.atan2(dy, dx);
                    this.angle += (targetAngle - this.angle) * 0.08;
                }
            }
            this.x += Math.cos(this.angle) * this.speed;
            this.y += Math.sin(this.angle) * this.speed;
            this.age++;
            if (this.x < 0 || this.x > width || this.y < 0 || this.y > height || this.age >= this.maxAge) { this.dead = true; }
        }
        draw() {
            ctx.beginPath(); ctx.moveTo(this.px, this.py); ctx.lineTo(this.x, this.y);
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.15 / (this.depth + 1)})`;
            ctx.lineWidth = Math.max(0.5, 2 / (this.depth + 1));
            ctx.stroke();
        }
    }
    let hyphae = [];
    function seedNetwork(x, y) {
        const numBranches = Math.floor(Math.random() * 4) + 3;
        for (let i = 0; i < numBranches; i++) { hyphae.push(new Hypha(x, y, (Math.PI * 2 * i) / numBranches, 0)); }
    }
    for (let i = 0; i < 6; i++) { seedNetwork(Math.random() * width, Math.random() * height); }
    window.addEventListener("click", (e) => { seedNetwork(e.clientX, e.clientY); });
    function animate() {
        ctx.fillStyle = "rgba(10, 10, 10, 0.04)";
        ctx.fillRect(0, 0, width, height);
        let newHyphae = [];
        hyphae.forEach((h) => {
            h.update(); h.draw();
            if (!h.dead) {
                newHyphae.push(h);
                if (Math.random() < 0.02 && h.depth < 4 && h.age > 15) {
                    const branchAngle = h.angle + (Math.random() - 0.5) * 1.2;
                    newHyphae.push(new Hypha(h.x, h.y, branchAngle, h.depth + 1));
                }
            }
        });
        hyphae = newHyphae;
        if (hyphae.length < 15 && Math.random() < 0.05) { seedNetwork(Math.random() * width, Math.random() * height); }
        requestAnimationFrame(animate);
    }
    animate();

    // FRONT-END INTELLIGENCE POLL INTERACTION
    function castVote(el, module) {
        document.querySelectorAll('.poll-option').forEach(opt => opt.classList.remove('voted'));
        el.classList.add('voted');
        const badge = el.querySelector('.vote-badge');
        if (badge && !badge.dataset.incremented) {
            const currentVotes = parseInt(badge.textContent.replace(/\D/g, '')) || 0;
            badge.textContent = `+${currentVotes + 1} Votes`;
            badge.dataset.incremented = "true";
        }
        const formData = new FormData();
        const token = document.querySelector('input[name="csrf_token"]')?.value || '';
        formData.append('report', `[FEATURE_VOTE] User explicitly voted to accelerate module: ${module.toUpperCase()}`);
        if (token) formData.append('csrf_token', token);
        fetch('/feedback', { method: 'POST', body: formData }).catch(() => {});
    }
</script>

</body>
</html>
