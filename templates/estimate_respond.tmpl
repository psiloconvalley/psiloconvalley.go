<!DOCTYPE html>
<html lang="en">
<head>
    <title>Estimate {{.Invoice.InvoiceNumber}} | Review & Respond</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{template "estimate-respond-styles" .}}
</head>
<body>

<div class="page">

    <div class="header">
        <div class="header-label">Estimate for Review</div>
        <div class="header-title">{{.Invoice.CompanyName}}</div>
        <div class="header-sub">Please review the estimate below and let us know how you'd like to proceed.</div>
    </div>

    <!-- Estimate Summary -->
    <div class="estimate-card">
        <div class="estimate-accent"></div>
        <div class="estimate-body">
            <div class="estimate-meta">
                <div>
                    <div class="meta-label">Estimate</div>
                    <div class="meta-value">#{{.Invoice.InvoiceNumber}}</div>
                </div>
                <div>
                    <div class="meta-label">Issued</div>
                    <div class="meta-value">{{.Invoice.IssueDate}}</div>
                </div>
                {{if .Invoice.DueDate}}
                <div>
                    <div class="meta-label">Valid Until</div>
                    <div class="meta-value">{{.Invoice.DueDate}}</div>
                </div>
                {{end}}
                <div>
                    <div class="meta-label">Client</div>
                    <div class="meta-value">{{.Invoice.ClientName}}</div>
                </div>
            </div>

            <div class="items-header">Line Items</div>
            {{range .Invoice.Items}}
            <div class="item-row">
                <span class="item-name">{{.Description}}</span>
                <span class="item-amount">{{.LineTotal}}</span>
            </div>
            {{end}}

            <div class="estimate-total">
                <span class="total-label">Estimated Total</span>
                <span class="total-amount">{{.Invoice.Total}}</span>
            </div>

            {{if .Invoice.Notes}}
            <div style="font-size: 13px; color: #64748b; line-height: 1.6; padding-top: 16px; border-top: 1px solid #f1f5f9;">
                <div style="font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px;">Notes</div>
                {{.Invoice.Notes}}
            </div>
            {{end}}
        </div>
    </div>

    <!-- Response Section -->
    <div class="response-card">
        <div class="response-title">How would you like to proceed?</div>
        <div class="response-sub">Your response will be sent directly to {{.Invoice.CompanyName}}.</div>

        <div class="response-actions">
            <!-- Accept -->
            <form method="POST" action="/estimates/{{.Invoice.ID}}/respond?access={{.AccessToken}}">
                <input type="hidden" name="action" value="accepted">
                <input type="hidden" name="client_name" value="{{.Invoice.ClientName}}">
                <button type="submit" class="response-btn response-btn-accept">
                    <span class="response-btn-icon">✅</span>
                    <div>
                        <div class="response-btn-title">Accept Estimate</div>
                        <div class="response-btn-desc">Approve this estimate and proceed with the work</div>
                    </div>
                </button>
            </form>

            <!-- Suggest Changes -->
            <button type="button" class="response-btn response-btn-suggest" onclick="document.getElementById('suggest-form').classList.toggle('open')">
                <span class="response-btn-icon">💬</span>
                <div>
                    <div class="response-btn-title">Suggest Changes</div>
                    <div class="response-btn-desc">Request adjustments before approving</div>
                </div>
            </button>

            <!-- Decline -->
            <form method="POST" action="/estimates/{{.Invoice.ID}}/respond?access={{.AccessToken}}">
                <input type="hidden" name="action" value="declined">
                <input type="hidden" name="client_name" value="{{.Invoice.ClientName}}">
                <button type="submit" class="response-btn response-btn-decline">
                    <span class="response-btn-icon">❌</span>
                    <div>
                        <div class="response-btn-title">Decline Estimate</div>
                        <div class="response-btn-desc">Not interested at this time</div>
                    </div>
                </button>
            </form>
        </div>

        <!-- Suggestion Form -->
        <div class="suggest-form" id="suggest-form">
            <form method="POST" action="/estimates/{{.Invoice.ID}}/respond?access={{.AccessToken}}">
                <input type="hidden" name="action" value="suggestion">
                <input type="hidden" name="client_name" value="{{.Invoice.ClientName}}">
                <label>Your Name</label>
                <input type="text" name="client_name" value="{{.Invoice.ClientName}}" placeholder="Your name">
                <label>What changes would you suggest?</label>
                <textarea name="message" placeholder="For example: Can we reduce consulting hours to 3 instead of 5? Or can you break out the material costs separately?"></textarea>
                <button type="submit" class="suggest-submit">Send Suggestion →</button>
            </form>
        </div>
    </div>

    <div class="powered-by">
        Powered by <a href="https://psiloconvalley.com">PsiloConValley</a>
    </div>

</div>

</body>
</html>
