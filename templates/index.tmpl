<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PsiloConValley — Independent Systems for Borderless Operators</title>
    <meta name="description" content="Practical business tools for borderless operators. Create and send professional invoices fast with polished PDFs, hosted links, and email delivery.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    {{template "nav-styles" .}}

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            background: #000;
        }

        body {
            background: #000;
            color: #fff;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .landing-page {
            background: #000;
            color: #fff;
        }

        .hero {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 32px 60px;
        }

        .hero-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: clamp(36px, 6vw, 56px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -2px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 17px;
            line-height: 1.7;
            color: rgba(255,255,255,0.55);
            font-weight: 300;
            max-width: 580px;
            margin-bottom: 48px;
        }

        .cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 60px;
        }

        .card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 32px;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 200px;
            -webkit-tap-highlight-color: transparent;
        }

        .card:hover {
            border-color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.06);
            transform: translateY(-2px);
        }

        .card:active {
            background: rgba(255,255,255,0.08);
            transform: translateY(0);
        }

        .card-tag {
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 16px;
        }

        .card-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .card-desc {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .card-status {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .status-live {
            color: #00ff41;
        }

        .status-lab {
            color: #f59e0b;
        }

        .trust {
            font-size: 12px;
            color: rgba(255,255,255,0.25);
            text-align: center;
            letter-spacing: 1px;
        }

        .landing-footer {
            padding: 32px;
            text-align: center;
            font-size: 10px;
            color: rgba(255,255,255,0.15);
            letter-spacing: 2px;
            text-transform: uppercase;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        @media (max-width: 768px) {
            .hero {
                padding: 40px 20px 40px;
                justify-content: flex-start;
            }

            .hero h1 {
                letter-spacing: -1px;
            }

            .hero p {
                font-size: 15px;
                margin-bottom: 32px;
            }

            .cards {
                grid-template-columns: 1fr;
                gap: 12px;
                margin-bottom: 40px;
            }

            .card {
                min-height: auto;
                padding: 24px;
            }

            .card-title {
                font-size: 18px;
            }
        }
    </style>
</head>
<body class="landing-page">

    {{template "nav" .}}

    <main class="hero">
        <div class="hero-label">Independent Systems</div>

        <h1>Practical tools for<br>borderless operators.</h1>

        <p>
            Create and send professional invoices in 60 seconds.
            Polished PDF. Shareable hosted link. Email delivery.
            Built for freelancers, agencies, and independent teams
            billing clients across countries.
        </p>

        <div class="cards">
            <a href="/tools" class="card">
                <div>
                    <div class="card-tag">Production</div>
                    <div class="card-title">Business Tools</div>
                    <div class="card-desc">
                        Invoice engine, client management,
                        PDF generation, email delivery.
                        Create, send, and track invoices today.
                    </div>
                </div>
                <div class="card-status status-live">● Live</div>
            </a>

            <a href="/research" class="card">
                <div>
                    <div class="card-tag">Lab</div>
                    <div class="card-title">Research &amp; Experiments</div>
                    <div class="card-desc">
                        Early-stage concepts and prototypes.
                        Ideas we are exploring. Nothing here
                        is a shipped feature or a promise.
                    </div>
                </div>
                <div class="card-status status-lab">● Exploring</div>
            </a>
        </div>

        <div class="trust">
            Free to start. No credit card required. Built independently.
        </div>
    </main>

    <footer class="landing-footer">
        PsiloConValley — Independent systems for borderless operators
    </footer>

</body>
</html>
