<!DOCTYPE html>
<html lang="en">
<head>
    <title>How It Works | PSILOCONVALLEY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Send quotes, create invoices, accept card payments, and manage your clients. Professional tools for independent businesses. Free to start.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://psiloconvalley.com/tools">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PSILOCONVALLEY">
    <meta property="og:url" content="https://psiloconvalley.com/tools">
    <meta property="og:title" content="How It Works | PSILOCONVALLEY">
    <meta property="og:description" content="Send quotes, create invoices, accept card payments. Free to start.">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="How It Works | PSILOCONVALLEY">
    <meta name="twitter:description" content="Professional invoicing and quoting tools for independent businesses. Free to start.">

    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    {{template "tools-hub-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="hub-container">
    <div class="hub-header">
        <div class="hub-label">Everything you need</div>
        <h1>From quote to paid.</h1>
        <p>
            Send a quote. Create an invoice. Accept card payments.
            All in one place — built for independent businesses.
        </p>
    </div>

    <div class="tool-grid">
        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Get paid</div>
                <div class="tool-name">Invoices</div>
                <div class="tool-desc">
                    Create a professional invoice in 60 seconds.
                    Send it by email or share a link.
                    Your client pays by card.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Get approval</div>
                <div class="tool-name">Quotes &amp; Estimates</div>
                <div class="tool-desc">
                    Send a quote before you start.
                    Client approves with one tap — no account needed.
                    Convert to invoice when the work is done.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Stay organized</div>
                <div class="tool-name">Client Directory</div>
                <div class="tool-desc">
                    Save your clients once.
                    Their info auto-fills every time you create
                    an invoice or quote.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Set it and forget it</div>
                <div class="tool-name">Recurring Invoices</div>
                <div class="tool-desc">
                    Same client every month?
                    Set it up once. Invoices send themselves.
                    Payment reminders included.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Track everything</div>
                <div class="tool-name">Invoice History</div>
                <div class="tool-desc">
                    See every invoice you have sent.
                    Track who paid, who is late, and what is outstanding.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/register" class="tool-card">
            <div>
                <div class="tool-tag">Know your numbers</div>
                <div class="tool-name">Expense Tracking</div>
                <div class="tool-desc">
                    Log business expenses.
                    See what you earned and what you spent — all in one place.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>
    </div>

    <section class="feedback-section">
        <div class="feedback-label">Feedback</div>
        <form action="/feedback" method="POST">
            {{.csrfField}}
            <textarea name="report" placeholder="Report a bug or suggest an improvement..." required></textarea>
            <button type="submit" class="btn-submit">Send Feedback</button>
        </form>
        <div id="status-display"></div>
    </section>
</div>
{{template "public-footer" .}}
<script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('transmitted')) {
        document.getElementById('status-display').innerHTML =
            '<div class="success-msg">✓ Feedback received. Thank you.</div>';
    }
</script>

</body>
</html>
