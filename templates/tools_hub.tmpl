<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "nav-styles" .}}
    {{template "base-styles" .}}
    {{template "tools-hub-styles" .}}
</head>
<body>

{{template "nav" .}}

<div class="hub-container">
    <div class="hub-header">
        <div class="hub-label">{{.T.ToolsLabel}}</div>
        <h1>{{.T.ToolsTitle}}</h1>
        <p>{{.T.ToolsSub}}</p>
    </div>

    <div class="tool-grid">
        <a href="{{if .User}}/invoices/new{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagGetPaid}}</div>
                <div class="tool-name">{{.T.ToolsInvoices}}</div>
                <div class="tool-desc">{{.T.ToolsInvoicesSub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>

        <a href="{{if .User}}/estimates/new{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagApproval}}</div>
                <div class="tool-name">{{.T.ToolsEstimates}}</div>
                <div class="tool-desc">{{.T.ToolsEstimatesSub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>

        <a href="{{if .User}}/clients{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagOrganized}}</div>
                <div class="tool-name">{{.T.ToolsClients}}</div>
                <div class="tool-desc">{{.T.ToolsClientsSub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>

        <a href="{{if .User}}/recurring{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagAutomate}}</div>
                <div class="tool-name">{{.T.ToolsRecurring}}</div>
                <div class="tool-desc">{{.T.ToolsRecurringSub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>

        <a href="{{if .User}}/invoices{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagTrack}}</div>
                <div class="tool-name">{{.T.ToolsHistory}}</div>
                <div class="tool-desc">{{.T.ToolsHistorySub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>

        <a href="{{if .User}}/expenses{{else}}/register{{end}}" class="tool-card">
            <div>
                <div class="tool-tag">{{.T.ToolsTagNumbers}}</div>
                <div class="tool-name">{{.T.ToolsExpenses}}</div>
                <div class="tool-desc">{{.T.ToolsExpensesSub}}</div>
            </div>
            <div class="tool-status status-live">● {{.T.ToolsStatusLive}}</div>
        </a>
    </div>

    <!-- ── Request a Feature ── -->
    <section class="request-section">
        <div class="request-card">
            <div class="request-header">
                <div class="request-icon">💡</div>
                <div>
                    <div class="request-title">{{.T.ToolsRequestTitle}}</div>
                    <div class="request-sub">{{.T.ToolsRequestSub}}</div>
                </div>
            </div>
            <form action="/feedback" method="POST">
                {{.csrfField}}
                <textarea name="report" class="request-textarea"
                          placeholder="{{.T.ToolsRequestPlaceholder}}" required></textarea>
                <button type="submit" class="request-btn">{{.T.ToolsRequestSubmit}}</button>
            </form>
            <div id="status-display"></div>
        </div>
    </section>

    <!-- ── Need Help ── -->
    <div class="help-link">
        <span class="help-label">{{.T.ToolsNeedHelp}}</span>
        <span class="help-sub">{{.T.ToolsNeedHelpSub}}</span>
        <a href="mailto:support@psiloconvalley.com" class="help-email">support@psiloconvalley.com</a>
    </div>
</div>

{{template "public-footer" .}}

<script>
var params = new URLSearchParams(window.location.search);
if (params.has('transmitted')) {
    document.getElementById('status-display').innerHTML =
        '<div class="request-success">✓ {{.T.ToolsRequestSent}}</div>';
}
</script>

</body>
</html>
