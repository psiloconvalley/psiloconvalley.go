<!DOCTYPE html>
<html lang="en">
<head>
    <title>Business Tools | PsiloConValley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0a0f1a;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .hub-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 60px 20px 80px;
        }

        .hub-header {
            margin-bottom: 48px;
        }
        .hub-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 12px;
        }
        .hub-header h1 {
            font-size: 36px;
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.1;
        }
        .hub-header p {
            color: rgba(255,255,255,0.45);
            font-size: 15px;
            margin-top: 12px;
            line-height: 1.6;
            font-weight: 300;
            max-width: 500px;
        }

        .tool-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 60px;
        }

        .tool-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            padding: 28px;
            text-decoration: none;
            color: inherit;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
        }
        .tool-card:hover {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.25);
            transform: translateY(-2px);
        }

        .tool-tag {
            font-size: 10px;
            font-weight: 600;
            color: rgba(255,255,255,0.25);
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .tool-name {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .tool-desc {
            font-size: 13px;
            color: rgba(255,255,255,0.45);
            line-height: 1.65;
            font-weight: 300;
        }
        .tool-status {
            margin-top: 24px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.5);
        }
        .status-live { color: #00ff41; }
        .status-offline { color: rgba(255,255,255,0.15); }

        /* Feedback */
        .feedback-section {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 48px;
            max-width: 520px;
        }
        .feedback-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 16px;
        }
        .feedback-section textarea {
            width: 100%;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 16px;
            color: #fff;
            font-family: inherit;
            font-size: 13px;
            min-height: 90px;
            resize: vertical;
            outline: none;
            transition: border-color 0.2s;
        }
        .feedback-section textarea:focus {
            border-color: rgba(255,255,255,0.3);
        }
        .feedback-section textarea::placeholder {
            color: rgba(255,255,255,0.2);
        }
        .btn-submit {
            background: #fff;
            color: #000;
            border: none;
            padding: 10px 24px;
            border-radius: 6px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            margin-top: 12px;
            transition: opacity 0.2s;
        }
        .btn-submit:hover { opacity: 0.85; }

        .success-msg {
            color: #00ff41;
            font-size: 13px;
            margin-top: 12px;
            font-weight: 500;
        }

        @media (max-width: 600px) {
            .hub-container { padding: 40px 16px 60px; }
            .hub-header h1 { font-size: 28px; }
            .tool-grid { grid-template-columns: 1fr; }
            .tool-card { min-height: auto; padding: 24px; }
        }
    </style>
</head>
<body>

{{template "nav" .}}

<div class="hub-container">
    <div class="hub-header">
        <div class="hub-label">Production</div>
        <h1>Business Tools</h1>
        <p>
            Create, send, and track professional invoices.
            Manage clients. Download polished PDFs.
        </p>
    </div>

       <div class="tool-grid">
        <a href="/invoices/new" class="tool-card">
            <div>
                <div class="tool-tag">Module 01</div>
                <div class="tool-name">Invoice Engine</div>
                <div class="tool-desc">
                    Create professional invoices with sequential numbering,
                    PDF generation, and email delivery.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/estimates/new" class="tool-card">
            <div>
                <div class="tool-tag">Module 02</div>
                <div class="tool-name">Estimate Engine</div>
                <div class="tool-desc">
                    Send estimates clients can accept, decline, or suggest changes —
                    no login required. One click converts to invoice.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/clients" class="tool-card">
            <div>
                <div class="tool-tag">Module 03</div>
                <div class="tool-name">Client Directory</div>
                <div class="tool-desc">
                    Store client details. Auto-fill invoices and estimates.
                    Keep your contacts organized.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/recurring" class="tool-card">
            <div>
                <div class="tool-tag">Module 04</div>
                <div class="tool-name">Recurring Invoices</div>
                <div class="tool-desc">
                    Auto-generate invoices on a weekly, monthly, or yearly schedule.
                    Automatic payment reminders included.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <a href="/invoices" class="tool-card">
            <div>
                <div class="tool-tag">Module 05</div>
                <div class="tool-name">Invoice Records</div>
                <div class="tool-desc">
                    View all invoices, track payment status,
                    and manage your financial history.
                </div>
            </div>
            <div class="tool-status status-live">● Live</div>
        </a>

        <div class="tool-card" style="cursor:default; opacity:0.6;">
            <div>
                <div class="tool-tag">Module 06</div>
                <div class="tool-name">404not403</div>
                <div class="tool-desc">
                    Security tooling for developers. Hide what exists.
                    Reveal nothing.
                </div>
            </div>
            <div class="tool-status" style="color:rgba(255,255,255,0.2);">○ Coming Soon</div>
        </div>
    </div> 
    <section class="feedback-section">
        <div class="feedback-label">Feedback</div>
        <form action="/feedback" method="POST">
            {{.csrfField}}
            <textarea name="report" placeholder="Report a bug or suggest an improvement..." required></textarea>
            <button type="submit" class="btn-submit">Send Feedback</button>
        </form>
        <div id="status-display"></div>
    </section>
</div>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('transmitted')) {
        document.getElementById('status-display').innerHTML =
            '<div class="success-msg">✓ Feedback received. Thank you.</div>';
    }
</script>

</body>
</html>
