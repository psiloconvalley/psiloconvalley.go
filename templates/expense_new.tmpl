<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{if eq .Mode "edit"}}{{.T.ExpenseEditTitle}}{{else}}{{.T.ExpenseNewTitle}}{{end}} | PSILOCONVALLEY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{template "nav-styles" .}}
    {{template "app-styles" .}}
    {{template "expense-new-styles" .}}

</head>
<body>

{{template "nav" .}}

<div class="container">
    <div class="top">
        <h1>{{if eq .Mode "edit"}}{{.T.ExpenseEditTitle}}{{else}}{{.T.ExpenseNewTitle}}{{end}}</h1>
        <p class="top-subtitle">{{if eq .Mode "edit"}}{{.T.ExpenseEditSubtitle}}{{else}}{{.T.ExpenseNewSubtitle}}{{end}}</p>
    </div>

    {{if .Error}}
    <div class="error-banner">{{.Error}}</div>
    {{end}}

    <div class="form-card">
        <form method="POST"
              action="{{if eq .Mode "edit"}}/expenses/{{.Expense.ID}}/edit{{else}}/expenses/create{{end}}"
              enctype="multipart/form-data">
            {{.csrfField}}

            <div class="section">
                <div class="section-title">{{.T.ExpenseDetails}}</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>{{.T.ExpenseAmount}}</label>
                        <input type="number" name="amount" step="0.01" min="0.01"
                               value="{{if .Expense}}{{if .Expense.AmountCents}}{{formatCents .Expense.AmountCents}}{{end}}{{end}}"
                               placeholder="0.00" required>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ExpenseCurrency}}</label>
                        <select name="currency">
                            <option value="USD" {{if eq .Currency "USD"}}selected{{end}}>USD</option>
                            <option value="CAD" {{if eq .Currency "CAD"}}selected{{end}}>CAD</option>
                            <option value="GBP" {{if eq .Currency "GBP"}}selected{{end}}>GBP</option>
                            <option value="EUR" {{if eq .Currency "EUR"}}selected{{end}}>EUR</option>
                            <option value="MXN" {{if eq .Currency "MXN"}}selected{{end}}>MXN</option>
                        </select>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>{{.T.ExpenseCategory}}</label>
                        <select name="category" required>
                            <option value="">{{.T.ExpenseCategorySelect}}</option>
                            {{range .Categories}}
                            <option value="{{.}}" {{if $.Expense}}{{if eq $.Expense.Category .}}selected{{end}}{{end}}>{{.}}</option>
                            {{end}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{.T.ExpenseDate}}</label>
                        <input type="date" name="expense_date"
                               value="{{if .Expense}}{{.Expense.ExpenseDate.Format "2006-01-02"}}{{else}}{{.Today}}{{end}}"
                               required>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{.T.ExpenseVendor}}</label>
                    <input type="text" name="vendor"
                           value="{{if .Expense}}{{.Expense.Vendor}}{{end}}"
                           placeholder="{{.T.ExpenseVendorPlaceholder}}">
                </div>

                <div class="form-group">
                    <label>{{.T.ExpenseDescription}}</label>
                    <textarea name="description" placeholder="{{.T.ExpenseDescPlaceholder}}">{{if .Expense}}{{.Expense.Description}}{{end}}</textarea>
                </div>
            </div>

            <div class="section">
                <div class="section-title">{{.T.ExpenseOptional}}</div>

                <div class="form-group">
                    <label>{{.T.ExpenseLinkClient}}</label>
                    <select name="client_id">
                        <option value="">{{.T.ExpenseLinkNone}}</option>
                        {{range .Clients}}
                        <option value="{{.ID}}" {{if eq $.SelectedClientID .ID}}selected{{end}}>{{.Name}}</option>
                        {{end}}
                    </select>
                    <div class="hint">{{.T.ExpenseLinkHint}}</div>
                </div>

                <div class="form-group">
                    <label>{{.T.ExpenseReceipt}}</label>
                    <input type="file" name="receipt" accept=".jpg,.jpeg,.png,.webp,.pdf">
                    <div class="hint">{{.T.ExpenseReceiptHint}}</div>
                    {{if .Expense}}{{if .Expense.ReceiptURL}}
                    <div class="receipt-preview">
                        <a href="{{.Expense.ReceiptURL}}" target="_blank">{{.T.ExpenseReceiptView}}</a>
                    </div>
                    {{end}}{{end}}
                </div>
            </div>

            <button type="submit" class="btn-primary">
                {{if eq .Mode "edit"}}{{.T.ExpenseUpdate}}{{else}}{{.T.ExpenseSave}}{{end}}
            </button>
        </form>

        {{if eq .Mode "edit"}}
        <form method="POST" action="/expenses/{{.Expense.ID}}/delete"
              onsubmit="return confirm('{{.T.ExpenseDeleteConfirm}}')">
            {{.csrfField}}
            <button type="submit" class="btn-delete">{{.T.ExpenseDelete}}</button>
        </form>
        {{end}}
    </div>

    <a href="/expenses" class="back-link">{{.T.ExpenseBack}}</a>
</div>

</body>
</html>
