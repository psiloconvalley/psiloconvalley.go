<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "public-profile-styles" .}}
</head>
<body>

<div class="pp-wrap">

    <!-- ── Business Card ── -->
    <div class="pp-card">
        {{if .Profile.LogoURL}}
        <img src="{{.Profile.LogoURL}}" alt="{{.Profile.Name}}" class="pp-logo">
        {{end}}
        <div class="pp-name">{{.Profile.Name}}</div>
        {{if .Location}}
        <div class="pp-location">📍 {{.Location}}</div>
        {{end}}
        {{if .Profile.ServiceAreas}}
        <div class="pp-location" style="color:rgba(255,255,255,0.5); font-size:13px;">
            🗺️ Serving: {{.Profile.ServiceAreas}}
        </div>
        {{end}}
        {{if .DisplayPhone}}
        <div class="pp-contact">📞 <a href="tel:{{.Profile.Phone}}">{{.DisplayPhone}}</a></div>
        {{end}}
        {{if .Profile.Email}}
        <div class="pp-contact">📧 <a href="mailto:{{.Profile.Email}}">{{.Profile.Email}}</a></div>
        {{end}}
        {{if .Profile.ZelleID}}
        <div class="pp-contact">💸 <a href="#" onclick="copyText('{{.Profile.ZelleID}}', this); return false;">Zelle: {{.Profile.ZelleID}}</a></div>
        {{end}}
        {{if .Profile.VenmoHandle}}
        <div class="pp-contact">💜 <a href="https://venmo.com/{{.Profile.VenmoHandle}}" target="_blank" rel="noopener">Venmo: {{.Profile.VenmoHandle}}</a></div>
        {{end}}
        {{if .Profile.CashAppHandle}}
        <div class="pp-contact">💚 <a href="https://cash.app/{{.Profile.CashAppHandle}}" target="_blank" rel="noopener">CashApp: {{.Profile.CashAppHandle}}</a></div>
        {{end}}
    </div>

    <!-- ── Endorsements (trust before action) ── -->
    {{if .Endorsements}}
    <div style="margin-bottom:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
            <div style="font-size:13px; font-weight:700; color:rgba(255,255,255,0.7);">
                {{.T.EndorseWhatClients}}
            </div>
            {{if .AvgRating}}
            <div style="font-size:11px; color:rgba(255,255,255,0.35);">
                ⭐ {{printf "%.1f" .AvgRating}} · {{.EndorsementCount}} {{if gt .EndorsementCount 1}}{{.T.EndorseEndorsements}}{{else}}{{.T.EndorseEndorsement}}{{end}}
            </div>
            {{end}}
        </div>
        {{range .Endorsements}}
        <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:16px; margin-bottom:8px;">
            <div style="font-size:12px; letter-spacing:1px; margin-bottom:8px;">
                {{$r := .Rating}}{{range seq 1 5}}{{if le . $r}}⭐{{else}}<span style="opacity:0.15;">★</span>{{end}}{{end}}
            </div>
            {{if .Body}}
            <div style="font-size:14px; color:rgba(255,255,255,0.8); line-height:1.5; margin-bottom:8px;">
                "{{.Body}}"
            </div>
            {{end}}
            <div style="font-size:11px; color:rgba(255,255,255,0.3);">
                {{.EndorserName}}{{if .EndorserLocation}} · {{.EndorserLocation}}{{end}}
            </div>
        </div>
        {{end}}
    </div>
    {{end}}

    <!-- ── Request a Quote ── -->
    <div class="pp-section">
        <div class="pp-section-title">
            <span>💬</span> Request a Quote
        </div>

        {{if .QuoteSuccess}}
        <div class="pp-success">✓ {{.QuoteSuccess}}</div>
        {{end}}
        {{if .QuoteError}}
        <div class="pp-error">{{.QuoteError}}</div>
        {{end}}

        {{if not .QuoteSuccess}}
        <form method="POST" action="/biz/{{.Slug}}/quote" autocomplete="on">
            {{.csrfField}}
            <div class="pp-field">
                <label class="pp-label" for="qr-name">Your Name</label>
                <input type="text" name="client_name" id="qr-name" class="pp-input"
                       placeholder="John Smith" autocomplete="name" required>
            </div>
            <div class="pp-field">
                <label class="pp-label" for="qr-phone">Phone</label>
                <input type="tel" name="client_phone" id="qr-phone" class="pp-input"
                       placeholder="(555) 123-4567" autocomplete="tel" inputmode="tel">
            </div>
            <div class="pp-field">
                <label class="pp-label" for="qr-desc">What do you need?</label>
                <textarea name="description" id="qr-desc" class="pp-textarea"
                          placeholder="Describe the work..."></textarea>
            </div>
            <button type="submit" class="pp-btn pp-btn-green">Send Request</button>
        </form>
        {{end}}
    </div>

    <!-- ── Pay an Invoice (collapsed) ── -->
    <details class="pp-section" style="cursor:pointer;">
        <summary class="pp-section-title" style="list-style:none; -webkit-tap-highlight-color:transparent; user-select:none;">
            <span>💳</span> Pay an Invoice
            <span style="margin-left:auto; font-size:14px; color:rgba(255,255,255,0.25); transition:transform 0.2s;">›</span>
        </summary>

        <div style="padding-top:12px;">
            {{if .InvoiceError}}
            <div class="pp-error">Invoice not found. Check your number and phone.</div>
            {{end}}

            <form method="POST" action="/biz/{{.Slug}}/invoice" autocomplete="on">
                {{.csrfField}}
                <div class="pp-field">
                    <label class="pp-label" for="inv-num">Invoice Number</label>
                    <input type="text" name="invoice_number" id="inv-num" class="pp-input"
                           placeholder="INV-0042" required>
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="inv-phone">Your Phone</label>
                    <input type="tel" name="client_phone" id="inv-phone" class="pp-input"
                           placeholder="(555) 123-4567" autocomplete="tel" inputmode="tel">
                </div>
                <button type="submit" class="pp-btn pp-btn-green">Find Invoice</button>
            </form>
        </div>
    </details>

  <!-- ── QR Code ── -->
    <div style="text-align:center; margin-top:24px;">
        <img src="/biz/{{.Slug}}/qr.png" alt="QR Code" width="160" height="160"
             style="border-radius:12px; background:#fff; padding:8px;">
        <div style="font-size:11px; color:rgba(255,255,255,0.3); margin-top:8px;">
            Scan to visit this page
        </div>
    </div>

        <!-- ── Branding ── -->
    <div class="pp-branding">
        <div class="pp-branding-text">Professional invoicing by psiloconvalley</div>
        <a href="/register" class="pp-branding-link">Create Your Business Page →</a>
    </div>

</div>
<script>
function copyText(text, btn) {
    navigator.clipboard.writeText(text).then(function() {
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
    });
}
</script>
</body>
</html>
