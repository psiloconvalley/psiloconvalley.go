<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    {{template "page-head" .}}
    {{template "public-profile-styles" .}}
</head>
<body>

<div class="pp-cosmos"><div class="pp-cosmos-mid"></div></div>
<canvas id="pp-stars"></canvas>

<div class="pp-wrap">

    <!-- ── Business Card ── -->
    <div class="pp-card">
        {{if .Profile.LogoURL}}
        <img src="{{.Profile.LogoURL}}" alt="{{.Profile.Name}}" class="pp-logo">
        {{end}}
        <div class="pp-name">{{.Profile.Name}}</div>
        {{if and .AvgRating .Endorsements}}
        <div class="pp-hero-rating">
            <span class="pp-hero-star">⭐</span>
            {{printf "%.1f" .AvgRating}} · {{.EndorsementCount}} {{if gt .EndorsementCount 1}}{{.T.EndorseEndorsements}}{{else}}{{.T.EndorseEndorsement}}{{end}}
        </div>
        {{end}}
        {{if .Location}}
        <div class="pp-location">📍 {{.Location}}</div>
        {{end}}
        {{if .Profile.ServiceAreas}}
        <div class="pp-service-areas">🗺️ Serving: {{.Profile.ServiceAreas}}</div>
        {{end}}
        {{if .DisplayPhone}}
        <div class="pp-contact">📞 <a href="tel:{{.Profile.Phone}}">{{.DisplayPhone}}</a></div>
        {{end}}
        {{if .Profile.Email}}
        <div class="pp-contact">📧 <a href="mailto:{{.Profile.Email}}">{{.Profile.Email}}</a></div>
        {{end}}
        {{if .Profile.ZelleID}}
        <div class="pp-contact">💸 <a href="#" onclick="copyText('{{.Profile.ZelleID}}', this); return false;">Zelle: {{.Profile.ZelleID}}</a></div>
        {{end}}
        {{if .Profile.VenmoHandle}}
        <div class="pp-contact">💜 <a href="https://venmo.com/{{.Profile.VenmoHandle}}" target="_blank" rel="noopener">Venmo: {{.Profile.VenmoHandle}}</a></div>
        {{end}}
        {{if .Profile.CashAppHandle}}
        <div class="pp-contact">💚 <a href="https://cash.app/{{.Profile.CashAppHandle}}" target="_blank" rel="noopener">CashApp: {{.Profile.CashAppHandle}}</a></div>
        {{end}}
    </div>

    <!-- ── Endorsements (trust before action) ── -->
    {{if .Endorsements}}
    <div class="pp-endorse-section">
        <div class="pp-endorse-label">{{.T.EndorseWhatClients}}</div>
        {{range .Endorsements}}
        <div class="pp-endorse-card">
            <div class="pp-stars">
                {{$r := .Rating}}{{range seq 1 5}}{{if le . $r}}<span class="pp-star-filled">⭐</span>{{else}}<span class="pp-star-empty">★</span>{{end}}{{end}}
            </div>
            {{if .Body}}
            <div class="pp-endorse-body">{{.Body}}</div>
            {{end}}
            <div class="pp-endorse-byline">{{.EndorserName}}{{if .EndorserLocation}} · {{.EndorserLocation}}{{end}}</div>
        </div>
        {{end}}
    </div>
    {{end}}

    <!-- ── Request a Quote ── -->
    <details class="pp-section"{{if or .QuoteError .QuoteSuccess}} open{{end}}>
        <summary class="pp-section-title">
            <span>💬</span> Request a Quote
            <span class="pp-section-chevron">›</span>
        </summary>
        <div class="pp-section-content">
            {{if .QuoteSuccess}}
            <div class="pp-success">✓ {{.QuoteSuccess}}</div>
            {{end}}
            {{if .QuoteError}}
            <div class="pp-error">{{.QuoteError}}</div>
            {{end}}

            {{if not .QuoteSuccess}}
            <form method="POST" action="/biz/{{.Slug}}/quote" autocomplete="on">
                {{.csrfField}}
                <div class="pp-field">
                    <label class="pp-label" for="qr-name">Your Name</label>
                    <input type="text" name="client_name" id="qr-name" class="pp-input"
                           placeholder="John Smith" autocomplete="name" required>
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="qr-phone">Phone</label>
                    <input type="tel" name="client_phone" id="qr-phone" class="pp-input"
                           placeholder="(555) 123-4567" autocomplete="tel" inputmode="tel">
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="qr-desc">What do you need?</label>
                    <textarea name="description" id="qr-desc" class="pp-textarea"
                              placeholder="Describe the work..."></textarea>
                </div>
                <button type="submit" class="pp-btn pp-btn-green">Send Request</button>
            </form>
            {{end}}
        </div>
    </details>

    <!-- ── Pay an Invoice ── -->
    <details class="pp-section"{{if .InvoiceError}} open{{end}}>
        <summary class="pp-section-title">
            <span>💳</span> Pay an Invoice
            <span class="pp-section-chevron">›</span>
        </summary>
        <div class="pp-section-content">
            {{if .InvoiceError}}
            <div class="pp-error">Invoice not found. Check your number and phone.</div>
            {{end}}

            <form method="POST" action="/biz/{{.Slug}}/invoice" autocomplete="on">
                {{.csrfField}}
                <div class="pp-field">
                    <label class="pp-label" for="inv-num">Invoice Number</label>
                    <input type="text" name="invoice_number" id="inv-num" class="pp-input"
                           placeholder="INV-0042" required>
                </div>
                <div class="pp-field">
                    <label class="pp-label" for="inv-phone">Your Phone</label>
                    <input type="tel" name="client_phone" id="inv-phone" class="pp-input"
                           placeholder="(555) 123-4567" autocomplete="tel" inputmode="tel">
                </div>
                <button type="submit" class="pp-btn pp-btn-green">Find Invoice</button>
            </form>
        </div>
    </details>

    <!-- ── QR Code ── -->
    <div class="pp-qr-wrap">
        <img src="/biz/{{.Slug}}/qr.png" alt="QR Code" width="160" height="160" class="pp-qr-img">
        <div class="pp-qr-label">Scan to visit this page</div>
    </div>

    <!-- ── Branding ── -->
    <div class="pp-branding">
        <div class="pp-branding-divider"></div>
        <div class="pp-branding-text">Professional invoicing by psiloconvalley</div>
        <a href="/register" class="pp-branding-link">Create Your Business Page →</a>
    </div>

</div>

<script>
function copyText(text, btn) {
    navigator.clipboard.writeText(text).then(function() {
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
    });
}

(function() {
    var c = document.getElementById('pp-stars');
    if (!c) return;
    var ctx = c.getContext('2d');
    var nodes = [];
    var count = Math.floor(window.innerWidth * window.innerHeight / 8000);
    var linkDist = 120;
    var mouse = { x: -1000, y: -1000 };
    var mouseRadius = 150;

    function resize() {
        c.width = window.innerWidth;
        c.height = window.innerHeight;
    }

    function init() {
        resize();
        nodes = [];
        for (var i = 0; i < count; i++) {
            nodes.push({
                x: Math.random() * c.width,
                y: Math.random() * c.height,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                r: Math.random() * 1.5 + 0.5,
                a: Math.random(),
                d: Math.random() * 0.008 + 0.002,
                dir: Math.random() > 0.5 ? 1 : -1
            });
        }
    }

    function draw() {
        ctx.clearRect(0, 0, c.width, c.height);

        for (var i = 0; i < nodes.length; i++) {
            var n = nodes[i];
            n.x += n.vx;
            n.y += n.vy;
            n.a += n.d * n.dir;
            if (n.a >= 1 || n.a <= 0.1) n.dir *= -1;

            if (n.x < 0) n.x = c.width;
            if (n.x > c.width) n.x = 0;
            if (n.y < 0) n.y = c.height;
            if (n.y > c.height) n.y = 0;

            var dm = Math.hypot(n.x - mouse.x, n.y - mouse.y);
            if (dm < mouseRadius) {
                var push = (1 - dm / mouseRadius) * 0.8;
                n.x += (n.x - mouse.x) / dm * push;
                n.y += (n.y - mouse.y) / dm * push;
            }

            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(74,222,128,' + n.a * 0.85 + ')';
            ctx.fill();

            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r * 3, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(74,222,128,' + n.a * 0.14 + ')';
            ctx.fill();

            for (var j = i + 1; j < nodes.length; j++) {
                var n2 = nodes[j];
                var dx = n.x - n2.x;
                var dy = n.y - n2.y;
                var dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < linkDist) {
                    var alpha = (1 - dist / linkDist) * 0.35 * Math.min(n.a, n2.a);
                    ctx.beginPath();
                    ctx.moveTo(n.x, n.y);
                    ctx.lineTo(n2.x, n2.y);
                    ctx.strokeStyle = 'rgba(74,222,128,' + alpha + ')';
                    ctx.lineWidth = 0.8;
                    ctx.stroke();
                }
            }
        }
        requestAnimationFrame(draw);
    }

    c.addEventListener('pointermove', function(e) {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
    });

    c.addEventListener('pointerleave', function() {
        mouse.x = -1000;
        mouse.y = -1000;
    });

    init();
    window.addEventListener('resize', init);
    c.style.pointerEvents = 'auto';
    c.style.cursor = 'default';
    draw();
})();

document.querySelectorAll('.pp-btn').forEach(function(btn) {
    btn.addEventListener('pointerdown', function(e) {
        var rect = btn.getBoundingClientRect();
        btn.style.setProperty('--x', ((e.clientX - rect.left) / rect.width * 100) + '%');
        btn.style.setProperty('--y', ((e.clientY - rect.top) / rect.height * 100) + '%');
    });
});
</script>
</body>
</html>
